#!/bin/bash
# ade: one command for ADE in any terminal. Hub commands run the hub's own bin/ scripts (the single source of truth);
# project commands copy ade-method and registry files at their pinned tags. Bash 3.2 and Linux bash.
set -u
# names ade uses for typed answers and secrets: never inherited, so an exported one cannot carry a key to a child
unset SECRET ANSWER HUB_ANSWER CHOICE
ADE_VERSION=""   # install.sh stamps this; a repo checkout reads VERSION beside the script
ADE_METHOD_REPO="${ADE_METHOD_REPO:-https://github.com/better-ade/ade-method}"
ADE_METHOD_REF="${ADE_METHOD_REF:-v2.2.0}"
ADE_REGISTRY_REPO="${ADE_REGISTRY_REPO:-https://github.com/better-ade/ade-agent-registry}"
ADE_REGISTRY_REF="${ADE_REGISTRY_REF:-v1.1.0}"

die() { echo "ade: $2" >&2; exit "$1"; }

usage() {
  cat <<'HELP'
usage: ade <command> [args]

Hub commands (run the hub's bin/ scripts):
  work        start or resume a work session (bin/work)
  status      list sessions (bin/sessions)
  dispatch    hand a task to an agent (bin/dispatch)
  notify      send a notification (bin/notify)
  chat        chat with the hub (bin/chat)
  method      the hub's method tools (bin/method)
  keys        ade keys [--missing] | set <tool> | share … | receive …: the one place for your AI tool keys (bin/keys):
              the list, then at a terminal one question to set the missing ones (--missing: no question); set,
              share and receive go to the hub's bin/keys as typed
  models      show or set models (bin/models)
  roles       show or set roles (bin/roles)
  doctor      check the hub's health (bin/doctor)
  sync        sync the hub (bin/sync)
  context     the hub's context store (bin/context)
  agent-run   run an agent (bin/agent)

Orchestrators (one per hub, run by the hub's bin/chat):
  orchestrator  new <name> --hub <path> [--channel telegram] | start | stop | list | logs <name> [-n N] | remove

Hubs:
  ui          ade ui [--detach]: one tmux window, a tab per agent (keys: prefix ? in it); needs tmux 3.2 or newer.
              Click a tab or a button; [≡ menu] or a right click shows every action. ADE_UI_MOUSE=off hides them.
              Beside an IDE: ADE_UI_MOUSE=off (tmux's mouse off), ADE_UI_ARROWS=off (no prefix Left/Right; prefix 0-9
              still switch tabs), or those lines in ~/.config/ade/ui
  dash        ade dash [--once]: the fleet panel (agents, tickets, last events)
  web         ade web [--port N] [--tailnet] [--no-open] | --print-link | --stop: a live, read-only dashboard of the agents
              (state, alerts, events, logs, journal), keys hidden, on 127.0.0.1 behind a random link, opened in your
              browser (--no-open: print the link instead); the page asks for the code shown in this terminal before it
              shows anything; --tailnet: on this machine's Tailscale address instead, for your phone (it asks for the
              code too); --print-link: the running page's address, else nothing and exit 1; --stop: stops the running
              one (Ctrl-C does too)
  setup       ade setup [--check | --test [provider|telegram] | --top | --telegram | --tools | --diagrams]: the guide, one step at a time (resumes where you are)
  claude      ade claude [<folder>] [-- claude args]: the orchestrator at the hub root, as tab 0 of ade ui when tmux is
              there (ADE_UI=off: in this terminal); with a folder, ade work <folder>
  hub         ade hub new <name> [--private|--public] [--dir <folder>] [--persona P --client C --owner O]
              | ade hub import <url|path> [--share|--handover|--clone] [--owner <name>] [--from <login|none>] [--name <new>] [--dir <folder>]
              | ade hub list | ade hub use <path>
  project     ade project add <path-or-git-url>... [--name N] [--no-init] [--yes] | add --scan <folder> | list: load repos
              you already have into the hub as project folders (the hub's bin/new, then the ACCESS.md Code row from the
              repo: remote without credentials, checkout, default branch, CI); a URL is cloned into your code folder
              (ADE_CODE_DIR, else ~/Project, else ~/code); ade project alone: its help
  (none)      ade alone: your workspace, the tab view of ade ui (set-up not finished: the guide's steps)
  home        the hub, its sessions and what to do next (what ade alone prints without a terminal or tmux)

Files (read-only; a path outside the hub and its projects asks first):
  files       ade files [<folder>]: explore the hub and its projects, with name search and preview (ADE_FILES=yazi: yazi, neither read-only nor held to the hub)
  view        ade view [--code] <path[:line[:col]]>: code at the line, Markdown, images and PDFs; o open, f reveal, y copy the path,
              c (or --code) open it in your editor at that line and column. ADE_VIEWER=code: code and text files open in
              the editor by default; images, PDFs and Markdown keep the built-in viewer. ADE_EDITOR picks the editor:
              code (Visual Studio Code, the default), idea or another JetBrains launcher (--line N --column C <path>),
              or a command with {path} {line} {col} (no shell runs it); in a JetBrains terminal, its launcher on PATH
  docs        ade docs [<folder>] | --follow <doc> | --web <doc>: the plans and specs as written (BMAD output, docs/,
              PLAN.md, STATE.md), newest first; Enter views one, ctrl-f follows it (shown again on each save), ctrl-o
              opens it in ade web's Docs page (started on 127.0.0.1 if it is not running); diagrams: ade setup --diagrams

Proof (screenshots as evidence, in <project>/.ade/evidence/; a page or screen shot cannot be redacted):
  shot        ade shot url <address> [--full-page] [--width W] | screen [--yes-screen] | agent <name>, each with [--name N]
              [--tg [caption]]: a page (the hub's headless Chromium), the whole screen (asks first) or an agent's tab
              (keys hidden) as a PNG with a .txt beside it; --tg sends it to you on Telegram when the bot is locked to you

Housekeeping (each lists what it would do first; nothing of yours is deleted):
  clean       ade clean [--yes]: stale locks, old markers, cursors and temp folders, dead ade tmux sessions, clean merged worktrees
  reset       ade reset [--keys] [--hub <path>]: undo ade setup here; --keys forgets its keys; --hub moves that hub to the Trash
  uninstall   ade uninstall [--keys] [--hub <path>]: ade reset, then remove the installed ade
  update      ade update [--check | --rollback | --auto on|off]: ade, the hub, its plugins and Claude Code, with nothing stopped; --rollback: the previous ade; --auto: self-install on or off
  restore     ade restore [--check] [--label <name>]: bring back every connection .ade/connections.json names

Project commands (no hub needed):
  init        copy ade-method at its pinned tag into this project (git top level, or --here); never overwrites
  agent       ade agent list | ade agent add <name>: specialists from ade-agent-registry
  skills      ade skills list | add <plugin> | enable <skill> | disable <skill> | search <word>: skills and plugins on the fly
  connect     ade connect [<service> | status [<service>] | disconnect <service>]: ADE's connectors; each person signs in at their own terminal
  open        open in the ADE app (inside the ADE app only)
  version     print the version
  help        this list

The hub is $ADE_HUB, else the nearest folder above with bin/lib.sh and hub.conf, else the path in ~/.config/ade/hub.
HELP
}

# matches <text> <ERE>: the whole text (newlines included) matches; never a per-line grep
matches() { [[ $1 =~ $2 ]]; }

is_hub() { [ -f "$1/bin/lib.sh" ] && [ -f "$1/hub.conf" ]; }

find_hub() {
  if [ -n "${ADE_HUB:-}" ]; then is_hub "$ADE_HUB" || die 2 "ADE_HUB=$ADE_HUB is not a hub (no bin/lib.sh and hub.conf)"
    echo "$ADE_HUB"; return; fi
  local d="$PWD"
  while [ -n "$d" ]; do is_hub "$d" && { echo "$d"; return; }; [ "$d" = / ] && break; d="$(dirname "$d")"; done
  local cfg="$HOME/.config/ade/hub" h=""
  if [ -f "$cfg" ]; then
    IFS= read -r h < "$cfg"; h="$(printf '%s' "$h" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    # shellcheck disable=SC2088  # a literal ~ in the file is expanded here on purpose
    case "$h" in "~") h="$HOME" ;; "~/"*) h="$HOME/${h#\~/}" ;; esac
    if [ -n "$h" ]; then is_hub "$h" && { echo "$h"; return; }
      # shellcheck disable=SC2088  # the message names the file as the user writes it
      die 2 "~/.config/ade/hub points to $h, which is not a hub"; fi
  fi
  die 2 "no hub found: set ADE_HUB, run ade inside a hub, or put the hub's path in ~/.config/ade/hub (no hub yet: ade hub new <name>)"
}

run_hub() {   # $1 = script name under bin/
  local script="$1" hub; shift; hub="$(find_hub)" || exit $?
  [ "$script" = work ] && claude_update "$hub"
  case "$script" in work|dispatch|agent) conn_gate "$hub" ;; esac
  [ -e "$hub/bin/$script" ] || die 2 "this hub has no bin/$script; update it"
  [ -x "$hub/bin/$script" ] || die 2 "bin/$script is not executable"
  HUB="$hub"; export HUB   # a stale HUB in the caller's environment would win in the hub's lib.sh
  [ "${RUN_HUB_WAIT:-0}" = 1 ] || exec "$hub/bin/$script" "$@"
  "$hub/bin/$script" "$@"   # RUN_HUB_WAIT=1 (ade work, for its tab): ade goes on after the script
}

# mk_tmp: a fresh temp folder under the temp root, or failure (never an empty or current path);
# rm_tmp <path>: removes only a folder mk_tmp made (under the temp root, named ade.*)
TMP_ROOT="${TMPDIR:-/tmp}"; TMP_ROOT="${TMP_ROOT%/}"
mk_tmp() { local d; d="$(mktemp -d "$TMP_ROOT/ade.XXXXXX" 2> /dev/null)" && [ -n "$d" ] && [ -d "$d" ] || return 1; printf '%s' "$d"; }
rm_tmp() { case "${1:-}" in "$TMP_ROOT"/ade.?*) [ -d "$1" ] && rm -rf -- "$1" ;; esac; return 0; }

# writes into a checkout (fix-record-writes): a cloned repository is data, so a link it commits must never make ade
# write outside it. Every Python block that writes a file in a project or hub folder runs through write_py, which puts
# ADE_PY_WRITE in front of it: ade_write makes the temp file with O_EXCL in the same folder (mkstemp), fsyncs it and
# renames it into place, and refuses a target that is not a regular file or a folder (.ade, .claude) that is a link;
# ade_hold locks that folder (flock on the folder itself, so no lock file is left in the project) until the block ends,
# around its read, check and write. A refusal is one line on stderr, exit 1, nothing written.
ADE_PY_WRITE='import fcntl as _fc, os as _os, stat as _st, sys as _sys, tempfile as _tf
class AdeUnsafe(Exception):
    pass
def _ade_hook(t, e, tb, _old=_sys.excepthook):
    if t is AdeUnsafe: _sys.stderr.write("ade: %s\n" % e)
    else: _old(t, e, tb)
_sys.excepthook = _ade_hook
def _ade_shown(p): return "".join(c if " " <= c <= "~" else "?" for c in p)[:200]
def ade_safe(p, guard=True):
    d = _os.path.dirname(_os.path.abspath(p))
    if guard and _os.path.islink(d): raise AdeUnsafe("%s is a symbolic link; nothing written" % _ade_shown(d))
    if _os.path.lexists(d) and not _os.path.isdir(d): raise AdeUnsafe("%s is not a folder; nothing written" % _ade_shown(d))
    if _os.path.lexists(p) and not _st.S_ISREG(_os.lstat(p).st_mode):
        raise AdeUnsafe("%s is not a regular file (a link, or something else); nothing written" % _ade_shown(p))
    return d
_ade_held = []
def ade_hold(p, guard=True):
    d = ade_safe(p, guard); _os.makedirs(d, exist_ok=True); ade_safe(p, guard)
    fd = _os.open(d, _os.O_RDONLY | getattr(_os, "O_DIRECTORY", 0) | getattr(_os, "O_NOFOLLOW", 0))
    _fc.flock(fd, _fc.LOCK_EX); _ade_held.append(fd)
def ade_write(p, data, guard=True):
    d = ade_safe(p, guard); _os.makedirs(d, exist_ok=True); ade_safe(p, guard)
    mode = (_os.lstat(p).st_mode & 0o777) if _os.path.lexists(p) else 0o644
    fd, tmp = _tf.mkstemp(dir=d, prefix="." + _os.path.basename(p) + ".", suffix=".ade-tmp")
    try:
        with _os.fdopen(fd, "wb") as f:
            f.write(data.encode("utf-8") if isinstance(data, str) else data); f.flush(); _os.fsync(f.fileno()); _os.fchmod(f.fileno(), mode)
        _os.replace(tmp, p)
    except BaseException:
        try: _os.unlink(tmp)
        except OSError: pass
        raise
'
write_py() { local src; src="$(cat)"; python3 -c "$ADE_PY_WRITE
$src" "$@"; }

# fetch <repo> <ref>: a temp checkout of repo at ref; prints its path
fetch() {
  local tmp err; tmp="$(mk_tmp)" || die 1 "could not make a temp folder"
  # a pinned public repo: a 401 never prompts for a password nor reaches a credential helper (the keychain)
  if [ -d "$1" ]; then err="$(GIT_TERMINAL_PROMPT=0 git -c credential.helper= clone -q --branch "$2" "$1" "$tmp/src" 2>&1)"
  else err="$(GIT_TERMINAL_PROMPT=0 git -c credential.helper= -c advice.detachedHead=false clone -q --depth 1 --branch "$2" "$1" "$tmp/src" 2>&1)"; fi \
    || { rm_tmp "$tmp"; die 1 "could not fetch $1 at $2: $(printf '%s\n' "$err" | tail -1)"; }
  echo "$tmp/src"
}

# put <src> <dest>: copy unless dest exists; counts KEPT, exits 1 on a failed copy
KEPT=0
put() {
  if [ -e "$2" ]; then echo "kept $2 (already there)"; KEPT=$((KEPT + 1)); return 0; fi
  write_py "$1" "$2" <<'PY' || die 1 "could not copy $2"
import os, sys
src, dest = sys.argv[1], sys.argv[2]; cur = "."
for c in os.path.normpath(dest).split(os.sep)[:-1]:   # every folder on the way: a real folder, never a link
    cur = os.path.join(cur, c)
    if os.path.islink(cur) or (os.path.lexists(cur) and not os.path.isdir(cur)): raise AdeUnsafe("%s is a symbolic link or not a folder; nothing written" % cur)
ade_write(dest, open(src, "rb").read())
PY
  echo "copied $2"
}

# project_root [args]: cd to the git top level, or stay here with --here; outside git without --here, exit 2
project_root() {
  local a top; for a in "$@"; do [ "$a" = --here ] && return 0; done
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || die 2 "not inside a git repository: run ade in a project, or pass --here"
  cd "$top" || die 1 "cannot enter $top"
}

# set_commit_template: git config commit.template .ade/commit-template.txt in this repo, never replacing another value
set_commit_template() {
  local cur; [ -f .ade/commit-template.txt ] || return 0
  git rev-parse --git-dir > /dev/null 2>&1 || { echo "not a git repository: commit.template not set"; return 0; }
  local want="$PWD/.ade/commit-template.txt"   # absolute: git reads commit.template from wherever you commit
  cur="$(git config --local commit.template 2>/dev/null)"
  if [ -n "$cur" ]; then [ "$cur" = "$want" ] || echo "kept commit.template ($cur)"; return 0; fi
  if [ -n "$(git config --global commit.template 2>/dev/null)" ]; then echo "kept your global commit.template ($(git config --global commit.template))"; return 0; fi
  git config --local commit.template "$want" || die 1 "could not set commit.template"
  echo "set commit.template to $want"
}

cmd_init() {
  project_root "$@"
  local f list old=""; INIT_SRC="$(fetch "$ADE_METHOD_REPO" "$ADE_METHOD_REF")" || exit $?
  trap 'rm_tmp "$(dirname "$INIT_SRC")"' EXIT   # global: the trap runs after cmd_init has returned
  local src="$INIT_SRC"
  list="$(dirname "$src")/list"; : > "$list"   # src<TAB>dest, read without a subshell so put's counts and exits hold
  [ -f "$src/rules.md" ] && printf '%s\t%s\n' "$src/rules.md" .ade/rules.md >> "$list"
  for f in "$src"/agents/*.md; do [ -f "$f" ] && printf '%s\t%s\n' "$f" ".ade/agents/$(basename "$f")" >> "$list"; done
  for f in "$src"/bmad/custom/*.toml; do [ -f "$f" ] && printf '%s\t%s\n' "$f" "_bmad/custom/$(basename "$f")" >> "$list"; done
  if [ -d "$src/templates/context" ]; then
    (cd "$src/templates/context" && find . -type f | sort) | while IFS= read -r f; do
      printf '%s\t%s\n' "$src/templates/context/${f#./}" ".ade/context/${f#./}"; done >> "$list"
  fi
  [ -f "$src/templates/standards.md" ] && printf '%s\t%s\n' "$src/templates/standards.md" docs/standards.md >> "$list"
  # ade.json install_templates: { "<file in ade-method>": "<path in the project>" } (ade-method v2.1.0)
  if [ -f "$src/ade.json" ]; then
    python3 - "$src" >> "$list" <<'PY' || die 1 "could not read ade.json install_templates"
import json, os, sys
src = sys.argv[1]
for f, dest in sorted(json.load(open(os.path.join(src, "ade.json"))).get("install_templates", {}).items()):
    p = os.path.normpath(os.path.join(src, f))
    if (not dest or dest.startswith("/") or ".." in dest.split("/") or any(c in dest for c in "\t\n\r")
            or not p.startswith(src + "/") or not os.path.isfile(p)):
        sys.exit("ade: bad install_templates entry %s -> %s" % (f, dest))
    print("%s\t%s" % (p, dest))
PY
  fi
  while IFS="$(printf '\t')" read -r f dest; do put "$f" "$dest"; done < "$list"
  set_commit_template
  [ -f .ade/method-version ] && old="$(cat .ade/method-version)"
  if [ "$KEPT" -gt 0 ] && [ -n "$old" ] && [ "$old" != "$ADE_METHOD_REF" ]; then
    echo "kept files are from $old: .ade/method-version left at $old"
  else
    write_py "$ADE_METHOD_REF" <<'PY' || die 1 "could not write .ade/method-version"
import sys
ade_write(".ade/method-version", sys.argv[1] + "\n")
PY
    conn_record "$PWD" pin ade-method "$ADE_METHOD_REF"
    echo "ade-method $ADE_METHOD_REF recorded in .ade/method-version"
  fi
}

# registry rows as name<TAB>file<TAB>description
registry_rows() {
  python3 -c 'import json,sys
for r in json.load(open(sys.argv[1])).get("roles", []):
    print("%s\t%s\t%s" % (r.get("name",""), r.get("file",""), r.get("description","")))' "$1/registry.json" \
    || die 1 "could not read registry.json"
}

cmd_agent() {
  local sub="${1:-}" src rows name file desc
  case "$sub" in
    list|add) ;;
    *) die 2 "usage: ade agent list | ade agent add <name>" ;;
  esac
  [ "$sub" = add ] && { [ -z "${2:-}" ] || [ "$2" = --here ]; } && die 2 "usage: ade agent add <name> [--here]"
  [ "$sub" = add ] && project_root "$@"
  src="$(fetch "$ADE_REGISTRY_REPO" "$ADE_REGISTRY_REF")" || exit $?
  rows="$(registry_rows "$src")" || exit $?
  if [ "$sub" = list ]; then
    echo "$rows" | while IFS="$(printf '\t')" read -r name file desc; do printf '%-20s %s\n' "$name" "$desc"; done
  else
    file="$(echo "$rows" | awk -F '\t' -v n="$2" '$1 == n { print $2; exit }')"
    if [ -z "$file" ] || [ ! -f "$src/$file" ]; then rm_tmp "$(dirname "$src")"; die 2 "no specialist named $2; ade agent list shows them"; fi
    put "$src/$file" ".ade/agents/$2.md"
    conn_record "$PWD" specialist "$2"; conn_record "$PWD" pin ade-agent-registry "$ADE_REGISTRY_REF"
  fi
  rm_tmp "$(dirname "$src")"
}

# skills on the fly (story A7): BMAD skills via .claude/settings.json skillOverrides (absent = on, "name-only",
# "off"), ade-skills plugins via the marketplace file and the project's enabledPlugins
ADE_SKILLS_REPO="${ADE_SKILLS_REPO:-https://github.com/better-ade/ade-skills}"
ADE_SKILLS_REF="${ADE_SKILLS_REF:-v0.9.0}"   # pinned like the other repos; ADE_SKILLS_REF overrides
SKILLS_USAGE="usage: ade skills list | add <plugin> | enable <skill> | disable <skill> | search <word>"

# skills_py <op> <project> [args]: the one place that reads and writes the settings (atomic; other keys kept)
skills_py() {
  PYTHONIOENCODING=utf-8 write_py "$@" <<'PY'
import difflib, json, os, sys
op, proj = sys.argv[1], sys.argv[2]; args = sys.argv[3:]
sp = os.path.join(proj, ".claude", "settings.json")
if op in ("enable", "disable"): ade_hold(sp)
def settings():
    if not os.path.exists(sp): return {}
    try: d = json.load(open(sp))
    except ValueError: sys.exit("ade: %s is not valid JSON; fix it first" % sp)
    if not isinstance(d, dict): sys.exit("ade: %s is not a JSON object" % sp)
    return d
def skills(d):
    root = os.path.join(proj, ".claude", "skills"); names = set(d.get("skillOverrides", {}) or {})
    if os.path.isdir(root):
        names |= {n for n in os.listdir(root) if os.path.isfile(os.path.join(root, n, "SKILL.md"))}
    return sorted(names)
def plugins(mkt):
    return [(p.get("name", ""), p.get("description", "")) for p in json.load(open(mkt)).get("plugins", []) if p.get("name")]
def closest(word, names):
    c = difflib.get_close_matches(word, names, n=3, cutoff=0.5)
    return " (closest: %s)" % ", ".join(c) if c else ""
def write(d):
    ade_write(sp, json.dumps(d, indent=2) + "\n")
if op == "list":
    d = settings(); ov = d.get("skillOverrides", {}) or {}; en = d.get("enabledPlugins", {}) or {}
    print("BMAD skills (.claude/settings.json skillOverrides):")
    for s in skills(d): print("  %-32s %s" % (s, ov.get(s, "on")))
    if not skills(d): print("  (none in .claude/skills)")
    print("ade-skills plugins:")
    for n, desc in plugins(args[0]):
        print("  %-32s %-14s %s" % (n, "installed" if en.get(n + "@ade-skills") else "not installed", desc))
elif op in ("enable", "disable"):
    name, never = args[0], args[1].split()
    d = settings(); known = skills(d)
    if name not in known: sys.stderr.write("ade: no skill named %s in this project%s\n" % (name, closest(name, known))); sys.exit(2)
    if op == "enable" and name in never:
        sys.stderr.write("ade: %s is on ade-method's never list (bmad.never in ade.json): it stays off\n" % name); sys.exit(2)
    ov = d.get("skillOverrides")
    if op == "enable":
        if isinstance(ov, dict) and name in ov: del ov[name]; write(d)
        print("%s: on" % name)
    else:
        if not isinstance(ov, dict): ov = d["skillOverrides"] = {}
        if ov.get(name) == "off": print("%s: off (already; disable never raises it)" % name)
        else:
            if ov.get(name) != "name-only": ov[name] = "name-only"; write(d)
            print("%s: name-only" % name)
elif op == "plugin":
    names = [n for n, _ in plugins(args[0])]
    if args[1] not in names: sys.stderr.write("ade: no ade-skills plugin named %s%s\n" % (args[1], closest(args[1], names))); sys.exit(2)
elif op == "search":
    w = args[1].lower(); hits = [(n, desc) for n, desc in plugins(args[0]) if w in n.lower() or w in desc.lower()]
    for n, desc in hits: print("%-20s %s" % (n, desc))
    sys.exit(0 if hits else 1)
elif op == "never":
    try: print(" ".join(json.load(open(args[0])).get("bmad", {}).get("never", [])))
    except (OSError, ValueError): sys.exit("ade: could not read ade-method's ade.json")
PY
}

# skills_folder <project>: the hub folder (projects/x or ops/x) that holds this project, else nothing
skills_folder() {
  local hub top="$1" d f c; hub="$(find_hub 2> /dev/null)" || return 0
  case "$top/" in "$hub"/projects/*/*|"$hub"/ops/*/*) f="${top#"$hub"/}"; echo "${f%%/*}/$(echo "$f" | cut -d/ -f2)"; return 0 ;; esac
  for d in "$hub"/projects/*/ "$hub"/ops/*/; do
    [ -f "$d/ACCESS.md" ] || continue
    for c in $(awk -F'|' '/^\|/ { c = $3; gsub(/^[ \t]+|[ \t]+$/, "", c); if (c ~ /^[\/~]/) print c }' "$d/ACCESS.md"); do
      # shellcheck disable=SC2088  # a literal ~ in ACCESS.md is expanded here on purpose
      case "$c" in "~/"*) c="$HOME/${c#\~/}" ;; esac
      [ -d "$c" ] && [ "$(cd "$c" && pwd -P)" = "$top" ] && { f="${d%/}"; echo "${f#"$hub"/}"; return 0; }
    done
  done
}
# skills_hint <project> <text>: through the hub's bin/notify to that folder's sessions (C6), else printed here
skills_hint() {
  local f hub; f="$(skills_folder "$1")"
  echo "$2"
  if [ -n "$f" ] && hub="$(find_hub 2> /dev/null)" && [ -x "$hub/bin/notify" ]; then
    hub_run "$hub" notify "$f" "$2" > /dev/null 2>&1 && echo "told the running sessions of $f (ade notify)"
  fi
  return 0
}

cmd_skills() {
  local sub="${1:-}" top src mkt; [ $# -gt 0 ] && shift
  top="$(git rev-parse --show-toplevel 2> /dev/null)" || top="$(pwd -P)"
  case "$sub" in
    --pin) echo "$ADE_SKILLS_REF"; return 0 ;;
    list|search|add)
      case "$sub" in list) [ $# -eq 0 ] || die 2 "$SKILLS_USAGE" ;; *) [ $# -eq 1 ] && [ -n "$1" ] || die 2 "$SKILLS_USAGE" ;; esac
      [ "$sub" != add ] || project_folder_ok "$top" "skills add"
      if src="$(fetch "$ADE_SKILLS_REPO" "$ADE_SKILLS_REF" 2> /dev/null)"; then
        mkt="$src/.claude-plugin/marketplace.json"; SKILLS_TMP="$(dirname "$src")"; trap 'rm_tmp "$SKILLS_TMP"' EXIT
        [ -f "$mkt" ] || die 1 "ade-skills has no .claude-plugin/marketplace.json at $ADE_SKILLS_REF"
      else   # offline: the marketplace Claude Code installed, when there is one
        mkt="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/marketplaces/ade-skills/.claude-plugin/marketplace.json"
        [ -f "$mkt" ] || die 1 "could not fetch $ADE_SKILLS_REPO at $ADE_SKILLS_REF, and no installed ade-skills marketplace"
        echo "ade: ade-skills unreachable; using the installed marketplace ($mkt)" >&2
      fi
      case "$sub" in
        list) skills_py list "$top" "$mkt"; exit $? ;;
        search) skills_py search "$top" "$mkt" "$1"; exit $? ;;
      esac
      skills_py plugin "$top" "$mkt" "$1" || exit $?
      plugin_add "$top" "$1"
      skills_hint "$top" "plugin $1 installed in $(basename "$top"): run /reload-plugins in its open sessions to load it" ;;
    enable|disable)
      [ $# -eq 1 ] && [ -n "$1" ] || die 2 "$SKILLS_USAGE"
      local never=""
      if [ "$sub" = enable ]; then
        src="$(fetch "$ADE_METHOD_REPO" "$ADE_METHOD_REF")" || exit $?
        never="$(skills_py never "$top" "$src/ade.json")"; local rc=$?; rm_tmp "$(dirname "$src")"; [ "$rc" = 0 ] || exit 1
      fi
      skills_py "$sub" "$top" "$1" "$never" || exit $?
      skills_hint "$top" "skill $1 changed in $(basename "$top"): it applies on the next prompt (Claude Code reloads its settings)" ;;
    *) die 2 "$SKILLS_USAGE" ;;
  esac
}

# project_folder_ok <folder> <command>: a project, never the home folder or / (there, "project scope" would be the
# person's own Claude Code settings for every folder); else exit 2, nothing changed
project_folder_ok() {
  local h; h="$(cd "$HOME" 2> /dev/null && pwd -P)"
  if [ "$1" = / ] || [ "$1" = "$h" ]; then die 2 "ade $2 runs inside a project, not in your home folder or /: cd into the project (a git repository) and run it there; nothing changed"; fi
}
# abs_tool <name> <folder>: the absolute path of a tool on PATH, resolved before ade changes into the folder; a copy
# that lies inside the folder (a repository could ship one) is refused (exit 2, which callers pass on)
abs_tool() {
  local p d; p="$(command -v "$1" 2> /dev/null)" || return 1
  case "$p" in /*) ;; *) p="$(pwd -P)/$p" ;; esac
  d="$(cd "$(dirname "$p")" 2> /dev/null && pwd -P)" || return 1
  case "$d/" in "$2"/*) die 2 "refused: the $1 on PATH ($d/$(basename "$p")) lies inside $2; ade runs only a $1 from outside the project" ;; esac
  printf '%s\n' "$d/$(basename "$p")"
}
# plugin_add <project> <plugin>: the ade-skills marketplace once, the plugin in project scope, then recorded in
# .ade/connections.json (ade skills add, ade connect). Stated limit: Claude Code installs <plugin>@ade-skills from
# whatever marketplace it has under the name ade-skills; ade checks the name exactly, not where it points.
plugin_add() {
  local cl; cl="$(abs_tool claude "$1")" || { [ $? = 2 ] && exit 2; die 2 "claude is not on PATH; install Claude Code first"; }
  if ! "$cl" plugin marketplace list 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "ade-skills") f = 1 } END { exit !f }'; then
    local msrc="$ADE_SKILLS_REPO"; [ "$msrc" = https://github.com/better-ade/ade-skills ] && msrc=better-ade/ade-skills
    "$cl" plugin marketplace add "$msrc" || die 1 "could not add the ade-skills marketplace"
  fi
  "$cl" plugin install "$2@ade-skills" --scope project || exit $?
  conn_record "$1" marketplace ade-skills "$ADE_SKILLS_REPO"; conn_record "$1" plugin "$2" ade-skills "$ADE_SKILLS_REF"
}

cmd_open() {
  [ -n "${ADE_HOOK_BIN:-}" ] || die 2 "ade open works inside the ADE app"
  exec "$ADE_HOOK_BIN" open "$@"
}

# claude_update [hub]: before ade launches Claude Code, `claude update` at most once per 24 h per machine (stamp
# ~/.config/ade/claude-updated, written per attempt), cut off after ADE_CLAUDE_UPDATE_TIMEOUT s (default 60); offline or
# failing prints one line and the installed version runs. ADE_NO_CLAUDE_UPDATE=1 skips it.
claude_update() {
  [ "${ADE_NO_CLAUDE_UPDATE:-}" = 1 ] && return 0
  local cl="" now t=0 stamp="$HOME/.config/ade/claude-updated" lim="${ADE_CLAUDE_UPDATE_TIMEOUT:-60}" pid w rc
  [ -n "${1:-}" ] && cl="$(conf_get "$1" HUB_CLAUDE)"; cl="${cl:-claude}"
  command -v "$cl" > /dev/null 2>&1 || return 0
  now="$(date +%s)"; [ -f "$stamp" ] && t="$(cat "$stamp" 2> /dev/null)"; [[ $t =~ ^[0-9]+$ ]] || t=0
  [ $((now - t)) -lt 86400 ] && return 0
  [[ $lim =~ ^[0-9]+$ ]] || lim=60
  echo "$now" | write_conf_file claude-updated
  "$cl" update > /dev/null 2>&1 < /dev/null & pid=$!
  ( sleep "$lim"; kill "$pid" 2> /dev/null ) > /dev/null 2>&1 & w=$!
  wait "$pid" 2> /dev/null; rc=$?; kill "$w" 2> /dev/null; wait "$w" 2> /dev/null
  if [ "$rc" = 0 ]; then echo "ade: Claude Code is up to date" >&2
  else echo "ade: Claude Code update skipped (offline, failed or over ${lim}s); using the installed version" >&2; fi
  return 0
}

# hub_claude_cmd [hub]: the Claude Code command the hub's bin/work runs, as its lib.sh claude_cmd picks it: AGENT_CLAUDE,
# else HUB_CLAUDE (this machine's .local/hub.conf over hub.conf), else claude. ade work and ade setup --check both check
# this one, so they agree
hub_claude_cmd() {
  local cl=""; [ -n "${1:-}" ] && cl="$(unset HUB_CLAUDE; . "$1/hub.conf" > /dev/null 2>&1
    [ ! -f "$1/.local/hub.conf" ] || . "$1/.local/hub.conf" > /dev/null 2>&1; printf '%s' "${HUB_CLAUDE:-}")"
  printf '%s' "${AGENT_CLAUDE:-${cl:-claude}}"
}
# conf_get <hub> <KEY>: a hub.conf value (sourced in a subshell, as the hub's own scripts read it)
conf_get() {
  case "$2" in *[!A-Z0-9_]*|"") return 1 ;; esac
  ( . "$1/hub.conf" > /dev/null 2>&1; eval "printf '%s' \"\${$2:-}\"" )
}

# ~/.config/ade: the folder 0700, every file in it 0600; write_conf_file <name> < content replaces one atomically
CONF_DIR="$HOME/.config/ade"
write_conf_file() {
  local tmp; ( umask 077; mkdir -p "$CONF_DIR" ) && chmod 700 "$CONF_DIR" || die 1 "cannot create $CONF_DIR"
  tmp="$(umask 077; mktemp "$CONF_DIR/.$1.XXXXXX")" || die 1 "cannot write $CONF_DIR/$1"
  { cat > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$CONF_DIR/$1"; } || { rm -f "$tmp"; die 1 "cannot write $CONF_DIR/$1"; }
}

# orchestrators: ~/.config/ade/orchestrators, one "name<TAB>hub" line each (story A2, .ade/context/hub-interface.md)
ORCH="$CONF_DIR/orchestrators"
orch_hub() { [ -f "$ORCH" ] && awk -F '\t' -v n="$1" '$1 == n { print $2; exit }' "$ORCH"; }
# chat <hub> <args>: the hub's own bin/chat, with HUB exported to that hub; its exit code is returned unchanged
chat() {
  local hub="$1"; shift
  [ -e "$hub/bin/chat" ] || die 2 "this hub has no bin/chat; update it"
  [ -x "$hub/bin/chat" ] || die 2 "bin/chat is not executable"
  ( HUB="$hub"; export HUB; "$hub/bin/chat" "$@" )
}
# orch_state <hub>: "running <since>", "stopped -", "missing -" or "unknown -", from the hub's bin/chat status
orch_state() {
  local first st since
  is_hub "$1" && [ -x "$1/bin/chat" ] || { echo "missing -"; return; }
  first="$(chat "$1" status 2>/dev/null | head -1)"
  st="${first%% *}"; since="$(printf '%s\n' "$first" | sed -n 's/.* since \([^ ]*\).*/\1/p')"
  case "$st" in running|stopped) echo "$st ${since:--}" ;; *) echo "unknown -" ;; esac
}

ORCH_USAGE="usage: ade orchestrator new <name> --hub <path> [--channel telegram] | start|stop|remove <name> | list | logs <name> [-n N]"
cmd_orchestrator() {
  local sub="${1:-}" name hub ch n st since chans channels=""; [ $# -gt 0 ] && shift
  case "$sub" in
    new)
      name="${1:-}"; [ $# -gt 0 ] && shift; hub=""
      while [ $# -gt 0 ]; do case "$1" in
        --hub) [ $# -ge 2 ] || die 2 "--hub needs a path"; hub="$2"; shift 2 ;;
        --channel) [ $# -ge 2 ] || die 2 "--channel needs a name"
          [[ $2 =~ ^[a-z][a-z0-9-]{0,31}$ ]] || die 2 "channel names are lower-case letters, digits and - (e.g. telegram)"
          channels="$channels $2"; shift 2 ;;
        *) die 2 "$ORCH_USAGE" ;;
      esac; done
      [[ $name =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die 2 "orchestrator names are lower-case letters, digits and - (a letter or digit first, at most 64)"
      [ -n "$hub" ] || die 2 "$ORCH_USAGE"
      is_hub "$hub" || die 2 "$hub is not a hub (no bin/lib.sh and hub.conf)"
      hub="$(cd "$hub" && pwd -P)"
      [ -z "$(orch_hub "$name")" ] || die 2 "an orchestrator named $name already exists"
      n="$([ -f "$ORCH" ] && awk -F '\t' -v h="$hub" '$2 == h { print $1; exit }' "$ORCH")"
      [ -z "$n" ] || die 2 "$hub already has an orchestrator ($n); one per hub"
      for ch in $channels; do ADE_ORCHESTRATOR="$name" chat "$hub" setup "$ch" || exit $?; record_channel "$hub" "$ch"; done
      { [ -f "$ORCH" ] && cat "$ORCH"; printf '%s\t%s\n' "$name" "$hub"; } | write_conf_file orchestrators
      echo "orchestrator $name registered for $hub"
      [ -n "$channels" ] || echo "no channel yet: run bin/chat setup telegram in the hub to add one" ;;
    start|stop)
      [ -n "${1:-}" ] && [ $# -eq 1 ] || die 2 "$ORCH_USAGE"
      hub="$(orch_hub "$1")"; [ -n "$hub" ] || die 2 "no orchestrator named $1; ade orchestrator list shows them"
      is_hub "$hub" || die 2 "the hub of $1 ($hub) is gone"
      [ "$sub" = start ] && { conn_gate "$hub"; claude_update "$hub"; }
      chat "$hub" "$sub"; exit $? ;;
    list)
      [ $# -eq 0 ] || die 2 "$ORCH_USAGE"
      printf '%-16s %-8s %-12s %-20s %s\n' NAME STATUS CHANNELS SINCE HUB
      [ -f "$ORCH" ] || return 0
      while IFS="$(printf '\t')" read -r name hub; do
        [ -n "$name" ] || continue
        read -r st since <<EOF
$(orch_state "$hub" < /dev/null)
EOF
        chans="-"; [ "$st" = missing ] || chans="$(conf_get "$hub" HUB_CHANNELS < /dev/null | tr ' ' ',')"
        printf '%-16s %-8s %-12s %-20s %s\n' "$name" "$st" "${chans:--}" "$since" "$hub"
      done < "$ORCH" ;;
    logs)
      name="${1:-}"; [ $# -gt 0 ] && shift; n=50
      [ -n "$name" ] || die 2 "$ORCH_USAGE"
      if [ $# -gt 0 ]; then { [ "$1" = -n ] && [ $# -eq 2 ]; } || die 2 "$ORCH_USAGE"; n="$2"; fi
      matches "$n" '^[1-9][0-9]{0,5}$' || die 2 "-n needs a number of lines"
      hub="$(orch_hub "$name")"; [ -n "$hub" ] || die 2 "no orchestrator named $name; ade orchestrator list shows them"
      is_hub "$hub" || die 2 "the hub of $name ($hub) is gone"
      chat "$hub" logs -n "$n"; exit $? ;;
    remove)
      [ -n "${1:-}" ] && [ $# -eq 1 ] || die 2 "$ORCH_USAGE"
      hub="$(orch_hub "$1")"; [ -n "$hub" ] || die 2 "no orchestrator named $1; ade orchestrator list shows them"
      read -r st since <<EOF
$(orch_state "$hub")
EOF
      if [ "$st" = running ]; then chat "$hub" stop || die 1 "could not stop $1; it stays registered"; fi
      awk -F '\t' -v n="$1" '$1 != n' "$ORCH" | write_conf_file orchestrators
      echo "orchestrator $1 removed (its hub $hub is untouched)" ;;
    *) die 2 "$ORCH_USAGE" ;;
  esac
}

# hubs: ~/.config/ade/hub is the default; ~/.config/ade/hubs lists every hub ade made or was pointed at (story A3)
ADE_HUB_TEMPLATE="${ADE_HUB_TEMPLATE:-better-ade/ade-brain}"
ADE_HUB_TEMPLATE_URL="${ADE_HUB_TEMPLATE_URL:-https://github.com/$ADE_HUB_TEMPLATE}"
hub_label() { local n; n="$(conf_get "$1" HUB_NAME)"; echo "${n:-$(basename "$1")}"; }
default_hub() { local h=""; [ -f "$CONF_DIR/hub" ] && IFS= read -r h < "$CONF_DIR/hub"; printf '%s' "$h"; }
remember_hub() {   # <path>: make it the default and add it to the known list once
  local p="$1"
  { [ -f "$CONF_DIR/hubs" ] && grep -vxF -- "$p" "$CONF_DIR/hubs"; echo "$p"; } | write_conf_file hubs
  echo "$p" | write_conf_file hub
}

cmd_hub() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift
  case "$sub" in
    new) hub_new "$@" ;;
    import) hub_import "$@" ;;
    list)
      [ $# -eq 0 ] || die 2 "usage: ade hub list"
      local d p; d="$(default_hub)"
      { [ -f "$CONF_DIR/hubs" ] && cat "$CONF_DIR/hubs"; [ -n "$d" ] && echo "$d"; } | awk 'NF && !seen[$0]++' |
        while IFS= read -r p; do
          if [ "$p" = "$d" ]; then printf '* '; else printf '  '; fi
          if is_hub "$p"; then echo "$p"; else echo "$p (missing)"; fi
        done ;;
    use)
      [ $# -eq 1 ] || die 2 "usage: ade hub use <path>"
      is_hub "$1" || die 2 "$1 is not a hub (no bin/lib.sh and hub.conf)"
      local p; p="$(cd "$1" && pwd -P)"; remember_hub "$p"; echo "default hub: $p" ;;
    *) die 2 "usage: ade hub new <name> [--private|--public] [--dir <folder>] | ade hub import <url|path> [--share|--handover|--clone] | ade hub list | ade hub use <path>" ;;
  esac
}


# hub_new: the repository (GitHub, after its sign-in step; --no-github, for tests and scripts: a local clone), then
# the hub's own bin/init with answers ade asked and checked, as flags (bin/init asks nothing). A clone that bin/init
# has not finished is marked (.git/ade-hub-new, never committed), so ade hub new <name> again picks up there (A18).
# shellcheck disable=SC2088  # a literal ~ for the person to read
tilde() { case "$1" in "$HOME") printf '~' ;; "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;; *) printf '%s' "$1" ;; esac; }
# hub_first_save <hub> <gh 0|1> <--private|--public>: the hub as bin/init rendered it (its own README, hub.conf's
# neighbours, the first folders) is committed and pushed the hub's own way, bin/sync --yes: hub files only, the
# person's git identity, the hub's pre-commit secret scan. Never without that scan (gitleaks, and the hooks path
# bin/init sets), never a forced push; with --no-github there is no remote and so no push. A push that failed after
# the commit is finished with a plain git push. A hub without bin/sync is left as it is.
hub_first_save() {
  local hub="$1" why later; later="cd $(tilde "$1") && bin/sync --yes && git push"
  [ -x "$hub/bin/sync" ] || return 0
  if ! command -v gitleaks > /dev/null 2>&1 || [ "$(git -C "$hub" config core.hooksPath)" != .githooks ]; then
    echo "Not saved yet: the hub's secret scan (gitleaks) is not set up here, and ade"
    echo "does not commit without it. Later (install gitleaks first): $later"; return 0
  fi
  if [ "$2" = 1 ]; then echo "Saving the hub's first version to your ${3#--} GitHub repository (bin/sync):"
  else echo "Saving the hub's first version (a commit here; no GitHub, so nothing is pushed):"; fi
  until run_logged "$hub" env HUB="$hub" ./bin/sync --yes &&
    { [ -z "$(git -C "$hub" rev-list '@{u}..HEAD' 2> /dev/null)" ] || run_logged "$hub" git push -q; }; do
    why="The hub's first version was not saved: $FAIL_LINE"
    case "$FAIL_TEXT" in *"tell me who you are"*|*"user.email"*|*"user.name"*) why="git has no name and email yet: git config --global user.name and user.email" ;; esac
    failed first-save "$why" "$FAIL_FILE"
    [ "$CHOICE" = retry ] || { echo "Going on; to save it later: $later"; return 0; }
  done
  # bin/sync's PATHS leave hub.conf out on purpose; ade commits nothing more, it says so and how to do it by hand
  git -C "$hub" ls-files --error-unmatch hub.conf > /dev/null 2>&1 || [ ! -f "$hub/hub.conf" ] ||
    echo "hub.conf is not in the saved version (bin/sync leaves it out on purpose); to keep it in git by hand: cd $(tilde "$hub") && git add hub.conf && git commit -m \"Add hub.conf\"$([ "$2" = 1 ] && printf ' && git push')"
}
# repo_failure <name>: after a gh repo create that failed (run_logged), the kind of failure and the line to show
repo_failure() {
  case "$FAIL_TEXT" in
    *"already exists"*) kind="repo-taken"; why="GitHub already has a repository named $1 on your account" ;;
    *"not logged in"*|*"gh auth login"*|*authenticat*|*credentials*|*permission*|*forbidden*|*"http 401"*|*"http 403"*|*"not accessible"*|*saml*)
      kind="repo-auth"; why="GitHub refused: not signed in, or no permission to make $1" ;;
    *) kind="repo-create"; why="GitHub did not make the repository $1: $FAIL_LINE" ;;
  esac
}
hub_again() { printf 'ade hub new %s' "$1"; [ "$2" = "$HOME/hubs" ] || printf ' --dir %s' "$(tilde "$2")"; [ "$3" != --public ] || printf ' --public'; }   # <name> <dir> <vis>
hub_new() {
  local name="${1:-}" vis=--private dir="$HOME/hubs" gh=1 target persona="" client="" owner="" resume=0 v why kind own=0; [ $# -gt 0 ] && shift
  while [ $# -gt 0 ]; do case "$1" in
    --private|--public) vis="$1"; shift ;;
    --persona|--client|--owner) [ $# -ge 2 ] && [ -n "$2" ] || die 2 "$1 needs a value"
      why="$(ask_bad "$2")"; [ -z "$why" ] || die 2 "$1: $why"
      case "$1" in --persona) persona="$2" ;; --client) client="$2" ;; *) owner="$2" ;; esac; shift 2 ;;
    --dir) [ $# -ge 2 ] || die 2 "--dir needs a folder"; dir="$2"; shift 2 ;;
    --no-github) gh=0; shift ;;
    *) die 2 "usage: ade hub new <name> [--private|--public] [--dir <folder>] [--persona P --client C --owner O]" ;;
  esac; done
  matches "$name" '^[a-z0-9][a-z0-9-]{0,63}$' || die 2 "hub names are lower-case letters, digits and - (start with a letter or digit, at most 64; e.g. acme-sre)"
  case "$dir" in /*) ;; *) dir="$PWD/$dir" ;; esac
  target="$dir/$name"
  [ -n "$ASK_AGAIN" ] || own=1
  [ "$own" = 0 ] || ASK_AGAIN="$(hub_again "$name" "$dir" "$vis")"
  if [ -e "$target" ]; then
    [ -f "$target/.git/ade-hub-new" ] || die 2 "$target already exists; pick another name or --dir"
    resume=1; echo "Picking up the hub $name where its set-up stopped ($(tilde "$target"))."
  elif [ "$gh" = 1 ]; then
    github_ready || exit $?
    mkdir -p "$dir" || die 1 "cannot create $dir"
    until run_logged "$dir" gh repo create "$name" --template "$ADE_HUB_TEMPLATE" "$vis" --clone; do
      [ ! -d "$target" ] || rm -rf -- "$target"   # a clone this try left half-made (the folder was not there before it)
      repo_failure "$name"; failed "$kind" "$why" "$FAIL_FILE"
      case "$CHOICE" in sign-in) gh_login || true ;;
        name) ask_hub_name "$dir"; name="$ANSWER"; target="$dir/$name"; [ "$own" = 0 ] || ASK_AGAIN="$(hub_again "$name" "$dir" "$vis")" ;; esac
    done
  else
    mkdir -p "$dir" || die 1 "cannot create $dir"
    git clone -q "$ADE_HUB_TEMPLATE_URL" "$target" || die 1 "could not clone $ADE_HUB_TEMPLATE_URL"
    git -C "$target" remote remove origin 2> /dev/null
  fi
  [ -x "$target/bin/init" ] || die 1 "$target has no bin/init; is $ADE_HUB_TEMPLATE the hub template?"
  [ -d "$target/.git" ] && printf '%s\n' "$name" > "$target/.git/ade-hub-new"
  [ "$resume" = 1 ] || echo "hub $name created in $(tilde "$target")"
  # bin/init needs a persona, the client and the owner: the flags, else asked here; the persona from bin/init --list
  local rows=() n d
  while IFS="$TAB" read -r n d; do matches "$n" '^[a-z0-9][a-z0-9-]{0,63}$' && rows+=("$n|$d"); done < <(
    (cd "$target" && ./bin/init --list < /dev/null) 2> /dev/null | no_ctl | awk '{ n = $1; $1 = ""; sub(/^ +/, ""); print n "\t" $0 }')
  if [ "${#rows[@]}" -gt 0 ]; then
    v=""; [ -z "$persona" ] || v="$(ask_match "$persona" "${rows[@]%%|*}")"
    if [ -z "$v" ]; then [ -z "$persona" ] || echo "$persona is not one of the personas below."
      echo "The kind of teammate this hub's main agent acts as (pick the closest):"
      ask_choice "Kind of teammate" "" "${rows[@]}"; v="$CHOICE"; fi
    persona="$v"
  elif [ -z "$persona" ]; then ask_text "The kind of teammate this hub's main agent acts as:"; persona="$ANSWER"; fi
  [ -n "$client" ] || { ask_text "Who this hub works for (a client or your team; shown in the hub):"; client="$ANSWER"; }
  [ -n "$owner" ] || { ask_text "Owner (your name, as it should appear in the hub):"; owner="$ANSWER"; }
  until RUN_HIDE='^next: ' run_logged "$target" env HUB="$target" ./bin/init --persona "$persona" --client "$client" --owner "$owner" --name "$name" && is_hub "$target"; do
    failed hub-init "The hub's set-up (bin/init) did not finish${FAIL_LINE:+: $FAIL_LINE}" "${FAIL_LINE:+$FAIL_FILE}"
  done
  rm -f "$target/.git/ade-hub-new"
  target="$(cd "$target" && pwd -P)"; remember_hub "$target"
  hub_first_save "$target" "$gh" "$vis"
  echo "default hub: $(tilde "$target")"; [ "${GUIDE_ON:-0}" = 1 ] || echo "next: ade (what to do next)"
}

# hub_import (story I3): someone's hub, cloned to this machine and taken the hub's own way: its bin/setup, then its
# bin/adopt (ade-brain I2, .ade/context/hub-interface.md "ade hub import"). share: join it; handover: it becomes yours;
# clone: a new hub of your own (its own private GitHub repo unless --no-github). Every answer is checked before the
# clone; a clone that is not a hub, has no bin/adopt (older than I2) or whose bin/setup or bin/adopt fails is removed.
IMPORT_USAGE="usage: ade hub import <url|path> [--share|--handover|--clone] [--owner <name>] [--from <login|none>] [--name <new>] [--dir <folder>]"
hub_import() {
  local src="${1:-}" mode="" owner="" name="" from="" dir="$HOME/hubs" gh=1 target why kind adopt repo s; [ $# -gt 0 ] && shift
  case "$src" in ""|-*) die 2 "$IMPORT_USAGE" ;; esac
  why="$(ask_bad "$src")"; [ -z "$why" ] || die 2 "the source: $why"
  while [ $# -gt 0 ]; do case "$1" in
    --share|--handover|--clone) [ -z "$mode" ] || die 2 "one of --share, --handover or --clone"; mode="${1#--}"; shift ;;
    --owner|--name|--from|--dir) [ $# -ge 2 ] && [ -n "$2" ] || die 2 "$1 needs a value"
      why="$(ask_bad "$2")"; [ -z "$why" ] || die 2 "$1: $why"
      case "$1" in --owner) owner="$2" ;; --name) name="$2" ;; --from) from="$2" ;; *) dir="$2" ;; esac; shift 2 ;;
    --no-github) gh=0; shift ;;
    *) die 2 "$IMPORT_USAGE" ;;
  esac; done
  if [ -z "$mode" ]; then
    [ -t 0 ] || die 2 "how to take this hub: pass --share, --handover or --clone ($IMPORT_USAGE)"
    echo "How you take this hub:"
    ask_choice "Mode" "" "share|join it: it stays its owner's hub, you work in it too" \
      "handover|it becomes yours: you are its owner from now on" "clone|a copy of your own: a new hub, its own name and history"
    mode="$CHOICE"
  fi
  [ "$mode" != share ] || [ -z "$owner" ] || die 2 "--owner is for --handover and --clone (a share keeps the owner)"
  [ "$mode" = handover ] || [ -z "$from" ] || die 2 "--from is for --handover (the previous owner's memory folder, or none)"
  [ "$mode" = clone ] || [ "$gh" = 1 ] || die 2 "$IMPORT_USAGE (a share or handover keeps the hub's own repo)"
  case "$dir" in /*) ;; *) dir="$PWD/$dir" ;; esac
  if [ -z "$name" ] && [ "$mode" != clone ]; then name="$(basename "${src%/}")"; name="${name%.git}"; fi
  if [ -z "$name" ]; then ask_text "The new hub's name (lower-case letters, digits and -):"; name="$ANSWER"; fi
  matches "$name" '^[a-z0-9][a-z0-9-]{0,63}$' || die 2 "hub names are lower-case letters, digits and - (start with a letter or digit, at most 64): pass --name"
  target="$dir/$name"
  [ ! -e "$target" ] || die 2 "$target already exists; pick another --name or --dir"
  [ "$mode" != clone ] || [ ! -e "$HOME/.agent-hub/$name" ] || die 2 "a hub named $name is already on this machine ($(tilde "$HOME/.agent-hub/$name")): pick another --name"
  [ "$mode" = share ] || [ -n "$owner" ] || { ASK_AGAIN="ade hub import $src --$mode --name $name"; ask_text "Owner (your name, as it should appear in the hub):"; owner="$ANSWER"; }
  ASK_AGAIN="ade hub import $src --$mode --name $name${owner:+ --owner '$owner'}${from:+ --from $from}"
  if [ "$mode" = clone ] && [ "$gh" = 1 ]; then github_ready || exit $?; fi
  mkdir -p "$dir" || die 1 "cannot create $dir"
  git clone -q -- "$src" "$target" || { rm -rf -- "$target"; die 1 "could not clone $src"; }
  is_hub "$target" || { rm -rf -- "$target"; die 2 "$src is not a hub (no bin/lib.sh and hub.conf); nothing kept"; }
  [ -x "$target/bin/adopt" ] || { rm -rf -- "$target"; die 2 "$src has no bin/adopt (a hub from before ade-brain I2): update that hub first (its owner pulls the latest ade-brain), then import it again; nothing kept"; }
  echo "hub cloned to $(tilde "$target")"
  adopt=(--"$mode"); [ "$mode" = share ] || adopt+=(--owner "$owner"); [ "$mode" != clone ] || adopt+=(--name "$name"); [ -z "$from" ] || adopt+=(--from "$from")
  why=""; for s in setup adopt; do
    if [ "$s" = setup ]; then (cd "$target" && HUB="$target" ./bin/setup < /dev/null) || why="its bin/setup failed"
    else (cd "$target" && HUB="$target" ./bin/adopt "${adopt[@]}" < /dev/null) || why="its bin/adopt ${adopt[0]} did not finish"; fi
    [ -z "$why" ] || { rm -rf -- "$target"; die 1 "the hub was not taken: $why (the lines above say why); the clone is removed (what its bin/setup linked for Claude stays)"; }
  done
  target="$(cd "$target" && pwd -P)"; remember_hub "$target"
  if [ "$mode" = clone ] && [ "$gh" = 1 ]; then repo="$name"
    echo "Making your private GitHub repository $repo for the new hub:"
    until run_logged "$target" gh repo create "$repo" --private --source . --remote origin --push; do
      ASK_AGAIN="cd $(tilde "$target") && gh repo create $repo --private --source . --remote origin --push"
      repo_failure "$repo"; failed "$kind" "$why" "$FAIL_FILE"
      case "$CHOICE" in sign-in) gh_login || true ;; name) ask_text "Another name for the GitHub repository:"; repo="$ANSWER" ;; esac
    done
  fi
  echo "default hub: $(tilde "$target")"; echo "next: ade (what to do next)"
}

# ade with no arguments: what to do next (story A3)
cmd_home() {
  local hub err
  if ! hub="$(find_hub 2> /dev/null)"; then
    err="$(find_hub 2>&1 > /dev/null)"; printf '%s' "$err" | grep -q "no hub found" || echo "$err" >&2
    guide_header; guide_list   # no hub yet: the guide's steps (A18); at a terminal, the offer to start it
    if agent_context; then echo "A person runs ade setup at a terminal to set up; an agent cannot answer for you."; return 0; fi
    if [ -t 0 ] && [ -t 1 ]; then ASK_AGAIN="ade setup"
      ask_yn "Set up now?" y && { guide 1; exit $?; }
      echo "Later: run ade setup; it picks up where you are."; return 0
    fi
    echo "To set up, run ade setup at a terminal; it asks one step at a time."; return 0
  fi
  # The tab view is the default (owner, 2026-11-23): at a terminal, outside an agent session, the ADE app and the
  # tab view itself, and unless ADE_UI=off, ade alone is ade ui once the hub is set up; a hub whose guide has a step
  # left gets the step list and its offer. Everywhere else: the summary (ade home), as before.
  if [ "${ADE_UI:-}" != off ] && [ -t 0 ] && [ -t 1 ] && ! agent_context && ! in_app; then
    if in_ui; then home_summary "$hub" bare; echo "You are in the tab view already; its keys: prefix ?"; return 0; fi
    if ! home_ready "$hub"; then guide_header; guide_list; ASK_AGAIN="ade setup"
      ask_yn "Set up now?" y && { guide 1; exit $?; }
      echo "Later: run ade setup; it picks up where you are."; return 0; fi
    if command -v tmux > /dev/null 2>&1 && (sq "$hub"; sq "$(ade_self)") > /dev/null 2>&1; then conn_gate "$hub"; cmd_ui; exit $?; fi
    home_summary "$hub" bare; command -v tmux > /dev/null 2>&1 || echo "The tab view needs tmux; ade setup --tools installs it."; return 0
  fi
  home_summary "$hub" bare
}
# home_ready <hub>: nothing the guide still has to do here, read from this machine alone (Claude Code installed, the
# hub's agents chosen, a first project); the sign-ins need the network and are not asked for on every ade
home_ready() { command -v claude > /dev/null 2>&1 && [ -n "$(conf_get "$1" HUB_ROOT_PROVIDER)" ] && first_project "$1" > /dev/null; }
# in_ui: inside ade's own tmux server (tab 0 carries ADE_UI_SESSION; every pane carries TMUX with its socket)
in_ui() { [ -n "${ADE_UI_SESSION:-}" ] && return 0; case "${TMUX:-}" in */"$ADE_TMUX_SOCKET",*) return 0 ;; esac; return 1; }
home_summary() {   # <hub> [bare]: the hub, its sessions and what to do next (ade home; ade alone where the tab view is not:
  # bare, and then the next steps do not offer ade, the command just run)
  local out
  echo "hub: $(hub_label "$1") ($1)"; tg_line "$1"
  if [ -x "$1/bin/sessions" ]; then   # a header alone: none running (a bin/sessions that failed is shown as it is)
    if out="$(HUB="$1"; export HUB; "$1/bin/sessions")" && [ "$(printf '%s\n' "$out" | grep -c .)" -le 1 ]; then echo "agents: none running"
    elif [ -n "$out" ]; then printf '%s\n' "$out"; fi; fi
  echo "next:"
  [ "${2:-}" = bare ] || echo "  ade                  open your workspace: a tab per agent (ade ui)"
  echo "  ade work <folder>    start a focus agent on a folder"
  echo "  ade help             every command"
}

# ade claude [<folder>] [-- args]: Claude Code at the hub root as the orchestrator (story A4)
ADE_SKILLS_MARKETPLACE="better-ade/ade-skills"
enable_ade_plugin() {   # <settings.json>: list the ade-skills marketplace and enable ade@ade-skills; other keys kept
  mkdir -p "$(dirname "$1")" || return 1
  write_py "$1" "$ADE_SKILLS_MARKETPLACE" <<'PY'
import json, os, sys
p, repo = sys.argv[1], sys.argv[2]
ade_hold(p)
d = {}
if os.path.exists(p):
    try:
        d = json.load(open(p))
    except ValueError:
        sys.exit("ade: %s is not valid JSON; fix it, then run ade claude again" % p)
    if not isinstance(d, dict):
        sys.exit("ade: %s is not a JSON object" % p)
before = json.dumps(d, sort_keys=True)
d.setdefault("extraKnownMarketplaces", {}).setdefault("ade-skills", {"source": {"source": "github", "repo": repo}})
d.setdefault("enabledPlugins", {}).setdefault("ade@ade-skills", True)
if json.dumps(d, sort_keys=True) != before:
    ade_write(p, json.dumps(d, indent=2) + "\n")
PY
}

# skips_permissions <args>: any spelling that turns permission checks off (sets SKIP_ARG); case and = forms included
skips_permissions() {
  local a l; for a in "$@"; do l="$(printf '%s' "$a" | tr 'A-Z' 'a-z')"
    case "$l" in *skip-permissions*|*bypasspermissions*) SKIP_ARG="$a"; return 0 ;; esac; done; return 1
}

cmd_claude() {
  local a hub model name cl cfg
  skips_permissions "$@" && die 2 "ade claude never skips permissions (refused: $SKIP_ARG)"
  if [ $# -gt 0 ] && [ "$1" != -- ]; then cmd_work "$@"; fi
  # with no arguments, at a terminal: the main agent runs as tab 0 of the hub's ade ui session and the person is
  # attached to it, so every later ade work is a tab beside it. Not inside that session (tab 0 runs this very
  # command), in an agent session, with ADE_UI=off, in the ADE app or without tmux; ade claude -- <args> runs here.
  if [ $# -eq 0 ] && [ -z "${ADE_UI_SESSION:-}" ] && [ -t 0 ] && [ -t 1 ] && ! agent_context && ui_wanted; then
    hub="$(find_hub)" || exit $?
    if (sq "$hub"; sq "$(ade_self)") > /dev/null 2>&1; then conn_gate "$hub"; cmd_ui; exit $?; fi
  fi
  [ $# -gt 0 ] && shift
  hub="$(find_hub)" || exit $?; conn_gate "$hub"
  model="$(conf_get "$hub" HUB_ROOT_MODEL)"; name="$(hub_label "$hub")"
  cl="$(conf_get "$hub" HUB_CLAUDE)"; cl="${cl:-claude}"; cfg="$(conf_get "$hub" HUB_CLAUDE_CONFIG_DIR)"
  command -v "$cl" > /dev/null 2>&1 || die 2 "$cl is not on PATH; install Claude Code first (ade setup does it)"
  claude_update "$hub"
  enable_ade_plugin "$hub/.claude/settings.json" || exit 1
  cd "$hub" || die 1 "cannot enter $hub"
  HUB="$hub"; export HUB; [ -z "$cfg" ] || { CLAUDE_CONFIG_DIR="$cfg"; export CLAUDE_CONFIG_DIR; }
  set -- --remote-control "$name" "$@"; [ -z "$model" ] || set -- --model "$model" "$@"   # opus[1m] never globbed
  exec "$cl" "$@"
}

# ade setup: sign in, providers with live tests, Telegram, the hub, then a guided session (story A5).
# Keys and tokens: read with a hidden prompt into a shell variable (never exported) and written only to the hub's
# bin/keys set <tool> on stdin; never argv, a file, a log or a child's environment.
ADE_CLAUDE_INSTALLER="${ADE_CLAUDE_INSTALLER:-https://claude.ai/install.sh}"
CLAUDE_INSTALL_CMD="curl -fsSL https://claude.ai/install.sh | bash"
KEY_PROVIDERS="anthropic deepseek glm muse gemini"   # the ones that can be signed in with a key
LIVE_PROVIDERS="anthropic gemini deepseek glm muse"
LIVE_TASK="Reply with the word READY and nothing else."

# Asking (story A18): every question ade asks goes through ask_text (free text) or ask_choice (a choice). Answers are
# data: control characters, escape sequences, a leading - and lines over ASK_MAX characters are asked again.
# ASK_TTY=1: the prompt and the answer on /dev/tty (reset, restore, installs), else stdout and stdin.
# End of input: with ASK_EOF=stop (the default) ade stops and says how to come back (ASK_AGAIN, set per command)
# and exits 1; with ASK_EOF=no the question returns 1. ASK_EMPTY_OK=1: Enter is an answer (a typed-back name).
# Callers set these with local, so they never reach a child's environment.
ASK_AGAIN=""; ASK_MAX=200; GUIDE_ON=0
ask_say() { if [ "${ASK_TTY:-0}" = 1 ]; then printf '%s\n' "$1" > /dev/tty; else printf '%s\n' "$1"; fi; }
ask_read() {   # <prompt>: one line into ANSWER, spaces around it trimmed; 1 at end of input
  if [ "${ASK_TTY:-0}" = 1 ]; then printf '%s ' "$1" > /dev/tty; IFS= read -r ANSWER < /dev/tty || { ANSWER=""; return 1; }
  else printf '%s ' "$1"; IFS= read -r ANSWER || { echo; ANSWER=""; return 1; }; [ -t 0 ] || echo; fi
  ANSWER="${ANSWER#"${ANSWER%%[! ]*}"}"; ANSWER="${ANSWER%"${ANSWER##*[! ]}"}"
}
ask_stop() {   # end of input: stop, saying how to come back (ASK_EOF=stop), or 1
  [ "${ASK_EOF:-stop}" = stop ] || return 1
  die 1 "stopped (no answer); to come back, run ${ASK_AGAIN:-the same command again}"
}
ask_bad() {   # <answer>: why it is not taken as data; nothing when it is
  case "$1" in *[[:cntrl:]]*) echo "control characters and escape sequences are not accepted" ;; -*) echo "an answer cannot start with -" ;;
    *) [ "${#1}" -le "$ASK_MAX" ] || echo "that is over $ASK_MAX characters" ;; esac
}
ask_empty() {   # the second empty answer to a question that cannot be skipped: how to leave, once
  EMPTIES=$((EMPTIES + 1)); [ "$EMPTIES" = 2 ] && ask_say "(to leave, press Ctrl-C; ${ASK_AGAIN:-the same command} picks up where you stopped)"; return 0
}
ask_text() {   # <prompt> [default]: free text into ANSWER; empty (with no default) or not data is asked again
  local why EMPTIES=0
  while :; do
    ask_read "$1${2:+ [$2]}" || { ask_stop; return 1; }
    [ -n "$ANSWER" ] || ANSWER="${2:-}"
    if [ -z "$ANSWER" ]; then [ "${ASK_EMPTY_OK:-0}" = 1 ] && return 0; why="an answer is needed"; else why="$(ask_bad "$ANSWER")"; fi
    [ -n "$why" ] || return 0
    ask_say "$why; type it again"; [ -n "$ANSWER" ] || ask_empty
  done
}
ask_norm() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -d ' _-'; }   # case, spaces, - and _ ignored
ask_match() {   # <answer> <name>...: the one name the answer means (its number, the name, the name ignoring case,
  local a="$1" n hit="" k=0 na; shift  # spaces, - and _, or a prefix only one name has); nothing when none or several
  if matches "$a" '^[0-9]{1,4}$'; then a=$((10#$a)); [ "$a" -ge 1 ] && [ "$a" -le $# ] && { shift $((a - 1)); printf '%s' "$1"; }; return 0; fi
  for n in "$@"; do [ "$a" = "$n" ] && { printf '%s' "$n"; return 0; }; done
  a="$(ask_norm "$a")"; [ -n "$a" ] || return 0
  for n in "$@"; do [ "$a" = "$(ask_norm "$n")" ] && { printf '%s' "$n"; return 0; }; done
  for n in "$@"; do na="$(ask_norm "$n")"; case "$na" in "$a"*) hit="$n"; k=$((k + 1)) ;; esac; done
  [ "$k" = 1 ] && printf '%s' "$hit"; return 0
}
# ask_tokens <answer> <count>: the answer's tokens (spaces or commas between); with ASK_RANGE=1 (ade project add --scan)
# all is every number and 2-4 is 2 3 4
ask_tokens() {
  local t a b
  for t in $(printf '%s' "$1" | tr ',' ' '); do
    if [ "${ASK_RANGE:-0}" = 1 ] && [ "$t" = all ]; then seq 1 "$2"
    elif [ "${ASK_RANGE:-0}" = 1 ] && matches "$t" '^[0-9]{1,4}-[0-9]{1,4}$' && a=$((10#${t%-*})) && b=$((10#${t#*-})) && [ "$a" -ge 1 ] && [ "$a" -le "$b" ] && [ "$b" -le "$2" ]; then seq "$a" "$b"
    else printf '%s\n' "$t"; fi
  done
}
# ask_choice <prompt> <default name or ""> <name[|description]>...: the chosen name into CHOICE. The choices are
# numbered (ASK_INLINE=1: a yes/no question, no list); ASK_MULTI=1: several, separated by spaces or commas, into
# CHOICE as one line (Enter: none, unless a default). Anything else is asked again with one line saying what is accepted.
ask_choice() {
  local q="$1" def="$2" c names=() w=0 i=0 why tok hit got EMPTIES=0; shift 2
  for c in "$@"; do names+=("${c%%|*}"); [ "${#names[$i]}" -le "$w" ] || w="${#names[$i]}"; i=$((i + 1)); done
  if [ "${ASK_INLINE:-0}" != 1 ]; then i=0
    for c in "$@"; do i=$((i + 1)); case "$c" in *"|"*) ask_say "$(printf '  %d) %-*s  %s' "$i" "$w" "${c%%|*}" "${c#*|}")" ;; *) ask_say "  $i) $c" ;; esac; done
    if [ -n "$def" ]; then q="$q [$def]:"; elif [ "${ASK_MULTI:-0}" = 1 ]; then q="$q:"; else q="$q (1-$#):"; fi
  fi
  while :; do
    ask_read "$q" || { ask_stop; return 1; }
    [ -n "$ANSWER" ] || ANSWER="$def"
    why="$(ask_bad "$ANSWER")"
    if [ -n "$why" ]; then ask_say "$why; type it again"; continue; fi
    if [ "${ASK_MULTI:-0}" = 1 ]; then got=""
      for tok in $(ask_tokens "$ANSWER" $#); do hit="$(ask_match "$tok" "${names[@]}")"; [ -n "$hit" ] || { got=-; break; }; got="${got:+$got }$hit"; done
      [ "$got" != - ] && { CHOICE="$got"; return 0; }
    else hit=""; [ -z "$ANSWER" ] || hit="$(ask_match "$ANSWER" "${names[@]}")"; [ -n "$hit" ] && { CHOICE="$hit"; return 0; }; fi
    if [ "${ASK_INLINE:-0}" = 1 ]; then ask_say "accepted: y or n (yes or no)"
    else ask_say "accepted: a number from 1 to $#, a name from the list (any case) or its start"; fi
    [ -n "$ANSWER" ] || ask_empty
  done
}
ask_yn() {   # <question> <y|n>: a yes/no question, the default in capitals; 0 = yes
  local ASK_INLINE=1 d=no hint="[y/N]"; [ "$2" = y ] && { d=yes; hint="[Y/n]"; }
  ask_choice "$1 $hint" "$d" yes no && [ "$CHOICE" = yes ]
}
ask() { ask_text "$1"; }   # ask <prompt>: one answer into ANSWER; end of input stops setup
ask_secret() {   # ask_secret <prompt>: a hidden answer into SECRET (not echoed, not exported)
  local rc=0
  if [ -t 0 ]; then
    # echo goes off before the prompt shows, so keys typed (or pasted) the moment it appears are never echoed
    # Ctrl-C stops ade (130), echo back on: a handled INT would let read go on with echo on and show the next key typed
    stty -echo 2> /dev/null; trap 'stty echo 2> /dev/null' EXIT TERM; trap 'stty echo 2> /dev/null; echo; die 130 "stopped (Ctrl-C); that key was not stored"' INT
    printf '%s ' "$1"; IFS= read -rs SECRET || rc=1
    stty echo 2> /dev/null; trap - EXIT INT TERM
  else printf '%s ' "$1"; IFS= read -r SECRET || rc=1; fi
  echo; [ "$rc" = 0 ] || die 1 "stopped: no answer"
}
yes_no() { ask_yn "$1" n; }

# When a step of the guide fails (A18b): one plain line saying what went wrong, where the details are, then a numbered
# question, the same everywhere. FAILS has one row per kind of failure: kind|default|choice=what it does;... A new step
# adds its row and calls failed. "stop" (exit 1), the end of input (1) and Ctrl-C (130) leave ade with the line on how
# to come back. A tool that owns the terminal (a sign-in, an installer, a session) keeps its own lines on the screen;
# a tool that asks nothing runs through run_logged, and its lines go to ~/.config/ade/last-failure when it fails.
FAILS='
live-top-account|retry|sign-in=sign in with a different Claude account;retry=try again;another=use another AI service;go-on=go on without the test
live-top-key|retry|key=enter the key again;retry=try again;another=use another AI service;go-on=go on without the test
live-top-check|retry|key=enter the key again;retry=try again;another=use another AI service
live-focus-account|retry|sign-in=sign in with a different Claude account;retry=try again;skip=leave this service out
live-focus-key|retry|key=enter the key again;retry=try again;skip=leave this service out
install|retry|retry=try again;manual=show the command to install it yourself;stop=stop here
sign-in|sign-in|sign-in=sign in again;key=use an API key instead;stop=stop here
gh-sign-in|sign-in|sign-in=sign in again;stop=stop here
repo-taken|name|name=pick another name;retry=try again;stop=stop here
repo-auth|sign-in|sign-in=sign in to GitHub again;retry=try again;stop=stop here
repo-create|retry|retry=try again;name=pick another name;stop=stop here
hub-init|retry|retry=try again from where it stopped;stop=stop here
first-save|retry|retry=try again;go-on=go on (save it later, with the command shown);stop=stop here
session|go-on|again=start it again;go-on=go on (this step stays not done);stop=stop here
tg-token|token|token=enter the token again;later=finish Telegram later;stop=stop here
bun|retry|retry=try again;manual=show the manual steps;stop=stop here
tg-bun|retry|retry=try again;manual=show the manual steps;later=skip Telegram for now;stop=stop here
tg-step|retry|retry=try again;later=finish Telegram later;stop=stop here
tg-wait|again|again=show the step again;later=finish Telegram later;stop=stop here
key-store|key|key=enter it again;stop=stop here
project|skip|retry=try again;skip=skip this one and go on with the rest;stop=stop here
'
# plain <text>: text from another tool as one line ade may print: ASCII only, no control character, key-shaped text hidden
plain() { printf '%s' "$1" | LC_ALL=C tr -cd ' -~' | tr -s ' ' | cut -c1-4000 | redact; }
# failed <kind> <what went wrong> [where the details are] [default] [one more line]: the answer in CHOICE (never stop)
failed() {
  local row o opts=() bye="stopped; to come back, run ${ASK_AGAIN:-the same command again}"
  row="$(printf '%s\n' "$FAILS" | awk -F '|' -v k="$1" '$1 == k { print $2 "|" $3; exit }')"
  printf '%s\n' "$(plain "$2")" | cut -c1-80; printf 'details: %s\n' "${3:-in the lines above, from the tool itself}" | cut -c1-80
  [ -z "${5:-}" ] || echo "$5"
  while IFS= read -r o; do [ -z "$o" ] || opts+=("${o%%=*}|${o#*=}"); done <<EOF
$(printf '%s' "${row#*|}" | tr ';' '\n')
EOF
  trap 'echo; die 130 "$bye"' INT
  ask_choice "What now?" "${4:-${row%%|*}}" "${opts[@]}" || die 1 "$bye"
  trap - INT; [ "$CHOICE" != stop ] || die 1 "$bye"
}
# run_logged <folder> <command...>: a tool that asks nothing, run in that folder with no input. Its lines are shown when
# it works; when it fails they go to ~/.config/ade/last-failure (0600, key-shaped text hidden), FAIL_LINE is its last
# line and FAIL_TEXT all of it in lower case, for the caller to tell one failure from another. RUN_HIDE (an extended
# regex, set by the caller) leaves matching lines out of what is shown; a failure's file keeps every line.
# shellcheck disable=SC2088  # a literal ~ for the person to read
FAIL_FILE="~/.config/ade/last-failure"; FAIL_LINE=""; FAIL_TEXT=""
run_logged() {
  local d="$1" out rc; shift; FAIL_LINE=""; FAIL_TEXT=""
  out="$( (cd "$d" && "$@") 2>&1 < /dev/null)"; rc=$?
  if [ "$rc" = 0 ]; then [ -z "$out" ] || printf '%s\n' "$out" | no_ctl | { if [ -n "${RUN_HIDE:-}" ]; then grep -Ev -- "$RUN_HIDE" || :; else cat; fi; }; return 0; fi
  printf '%s\n' "$out" | no_ctl | LC_ALL=C redact | write_conf_file last-failure
  FAIL_LINE="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -1)"; [ -n "$FAIL_LINE" ] || FAIL_LINE="exit $rc"
  FAIL_TEXT="$(printf '%s' "$out" | LC_ALL=C tr 'A-Z' 'a-z')"; return "$rc"
}
hub_run() { local hub="$1" s="$2"; shift 2; [ -x "$hub/bin/$s" ] || die 2 "this hub has no bin/$s; update it"; ( HUB="$hub"; export HUB; "$hub/bin/$s" "$@" ); }

# key_put <hub> <tool>: SECRET to the hub's bin/keys set <tool> on its stdin, then SECRET is emptied. The hub's own
# prompt and "stored" line (it writes them even when the value comes on stdin) are not shown: the person was asked
# once, by ade. KEY_ERR is the hub's last line when it failed, with the value itself and key-shaped text hidden.
KEY_ERR=""
key_put() {
  local err rc
  err="$(printf '%s\n' "$SECRET" | hub_run "$1" keys set "$2" 2>&1 > /dev/null)"; rc=$?
  [ -z "$SECRET" ] || err="${err//"$SECRET"/<hidden>}"
  SECRET=""; KEY_ERR=""
  [ "$rc" = 0 ] || KEY_ERR="$(plain "$(printf '%s\n' "$err" | sed 's/^value for [A-Za-z0-9._-]*: *//' | grep -v '^[[:space:]]*$' | tail -1)")"
  return "$rc"
}
store_key() {   # store_key <hub> <tool> [once]: hidden prompt, then the hub's bin/keys set <tool> on stdin; 1 = skipped;
  # with once (ade keys), a failed store is said in one line (never the value) and returns 2, with no question
  local hub="$1" tool="$2" rc
  while :; do
    ask_secret "Paste the $tool key (hidden; empty skips):"
    [ -n "$SECRET" ] || { SECRET=""; return 1; }
    key_put "$hub" "$tool"; rc=$?
    [ "$rc" != 0 ] || break
    [ -z "${3:-}" ] || { echo "The $tool key was not stored (the hub's bin/keys set $tool, exit $rc${KEY_ERR:+: $KEY_ERR})"; return 2; }
    failed key-store "The $tool key was not stored (the hub's bin/keys set $tool, exit $rc)"
  done
  record_key "$hub" "$tool"
  echo "$tool key stored in the hub's key store"
}

# ade keys (A26): the hub's list; at a terminal, when an AI tool key is missing, one question, then each missing one at
# ade's hidden prompt (store_key once), then the list again. --missing: no question (a terminal only, else exit 2).
# Not a terminal, or an agent session: the hub's bin/keys as before (exec). Any other arguments: passed through unchanged.
# The missing ones are KEYS_ASKED the list does not show as "<tool> stored", as key_stored reads it; a tool name never
# comes from the hub's output. Not anthropic (optional: the Claude login serves; ade keys set anthropic stores one) and
# not telegram (a chat token). ade setup keeps its own KEY_PROVIDERS.
KEYS_ASKED="deepseek glm muse gemini"
keys_terminal() { [ -t 0 ] && [ -t 1 ] && ! agent_context; }
keys_list() {   # <hub>: the hub's list as it printed it; KEYS_MISSING: the missing tools; the list's exit code
  local out rc p; KEYS_MISSING=""
  out="$(hub_run "$1" keys < /dev/null; rc=$?; echo "x$rc")"; rc="${out##*x}"; out="${out%x*}"
  printf '%s' "$out"; case "$out" in ""|*$'\n') ;; *) echo ;; esac   # a list without its last newline still ends a line
  [ "$rc" = 0 ] || return "$rc"
  for p in $KEYS_ASKED; do
    printf '%s\n' "$out" | awk -v n="$p" '$1 == n && $2 == "stored" { f = 1 } END { exit !f }' || KEYS_MISSING="${KEYS_MISSING:+$KEYS_MISSING }$p"
  done
}
cmd_keys() {
  local only=0 hub p rc bad=0
  # each run_hub is followed by exit: an exported RUN_HUB_WAIT=1 would otherwise come back into the guided part
  if [ $# -eq 1 ] && [ "$1" = --missing ]; then only=1; elif [ $# -gt 0 ]; then run_hub keys "$@"; exit $?; fi
  if ! keys_terminal; then
    [ "$only" = 0 ] || die 2 "ade keys --missing asks for each key at a terminal (it refuses pipes and agent sessions); nothing changed"
    run_hub keys; exit $?; fi
  hub="$(find_hub)" || exit $?
  [ -e "$hub/bin/keys" ] || die 2 "this hub has no bin/keys; update it"; [ -x "$hub/bin/keys" ] || die 2 "bin/keys is not executable"
  keys_list "$hub" || exit $?
  if [ -z "$KEYS_MISSING" ]; then [ "$only" = 0 ] || echo "no AI tool key is missing"; return 0; fi
  echo "missing: $(printf '%s' "$KEYS_MISSING" | sed 's/ /, /g')"
  [ "$only" = 1 ] || ( ASK_EOF=no; ask_yn "Set the missing keys now?" n ) || return 0
  for p in $KEYS_MISSING; do
    store_key "$hub" "$p" once; rc=$?
    case "$rc" in 1) echo "$p: skipped" ;; 2) bad=1 ;; esac
  done
  echo; keys_list "$hub" || exit $?
  [ "$bad" = 0 ] || exit 1
}

# live_test <hub> <provider>: one tiny read-only task in a throwaway folder through the hub's bin/agent --live-test.
# Prints "<p>: ready (Ns)" or "<p>: failed (<reason>)" (not with a third argument: the caller says it, live_failed);
# returns 0 only when ready. LIVE_RAW is the engine's last line as it came.
SCRUB_VARS="ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_CUSTOM_HEADERS CLAUDE_CODE_OAUTH_TOKEN
  CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX DEEPSEEK_API_KEY GEMINI_API_KEY GOOGLE_API_KEY ZAI_API_KEY GLM_API_KEY
  TELEGRAM_BOT_TOKEN"
# redact: hide key-shaped strings and Telegram bot tokens in text ade prints
redact() { sed -E 's#bot[0-9]+:[A-Za-z0-9_-]+#bot<hidden>#g; s#(sk|pk|ak|key)-[A-Za-z0-9_-]{8,}#<hidden key>#g; s#[A-Za-z0-9_-]{32,}#<hidden>#g'; }
live_test() {
  local hub="$1" p="$2" tmp out rc t0 why
  LIVE_RAW="no temp folder"
  tmp="$(mk_tmp)" || { [ -n "${3:-}" ] || echo "$p: failed (no temp folder)"; return 1; }
  t0=$(date +%s)
  # run from the throwaway folder only; no provider key or backend switch from this shell reaches the test
  out="$(cd "$tmp" && { unset $SCRUB_VARS; printf '%s\n' "$LIVE_TASK" | AGENT_TIMEOUT=120 hub_run "$hub" agent --live-test "$p" --dir "$tmp"; } 2>&1)"; rc=$?
  rm_tmp "$tmp"
  if [ "$rc" = 0 ] && printf '%s\n' "$out" | tr -d '\r' | grep -qx '[[:space:]]*READY[[:space:]]*'; then
    echo "$p: ready ($(( $(date +%s) - t0 ))s)"; return 0; fi
  LIVE_RAW="$(printf '%s\n' "$out" | tr -d '\r' | grep -v '^[[:space:]]*$' | tail -1)"
  why="$(printf '%s\n' "$LIVE_RAW" | redact | cut -c1-200)"
  [ "$rc" = 0 ] && [ -n "$why" ] && { why="no READY line; it said: $why"; LIVE_RAW="no READY line; it said: $LIVE_RAW"; }
  [ -n "$LIVE_RAW" ] || LIVE_RAW="exit $rc"
  [ -n "${3:-}" ] || echo "$p: failed (${why:-exit $rc})"; return 1
}
# live_explain <provider> <account|key>: the failed test in plain words, from LIVE_RAW: LIVE_LINE (a usage limit and when
# it resets, a sign-in problem, else the engine's reason), LIVE_KIND (limit, sign-in, other) and LIVE_DETAILS (the
# file the hub named when it is there, its folder when the name was hidden, else the command that shows the message)
LIVE_RAW=""; LIVE_LINE=""; LIVE_KIND=other; LIVE_DETAILS=""
LIMIT_RE='(hit|reached|exceeded|over) [a-z0-9 -]*limit|usage limit|rate limit|limit reached|out of (credits|quota)'
SIGNIN_RE='not (signed|logged) in|/login|(sign-in|login|session|token) (has |is )?(expired|revoked)|authentication|unauthori[sz]ed|invalid (api )?key|key was rejected|(^|[^0-9])401([^0-9]|$)'
RESETS_RE='[Rr]esets? ([A-Za-z0-9 :,]*[A-Za-z0-9]( \([A-Za-z0-9_/+-]+\))?)'
PATH_RE='^/[A-Za-z0-9_./@%+=:,-]+$'
live_explain() {
  local p="$1" raw msg low d when=""
  raw="$(printf '%s' "$LIVE_RAW" | LC_ALL=C tr -cd ' -~' | tr -s ' ' | cut -c1-4000)"
  msg="$(plain "${raw%%; details: *}")"; msg="${msg#agent: }"
  case "$msg" in "live test of "*" failed: "*) msg="${msg#live test of * failed: }" ;; esac
  low="$(printf '%s' "$msg" | tr 'A-Z' 'a-z')"
  if matches "$low" "$LIMIT_RE"; then LIVE_KIND=limit
    if [ "$2" = account ]; then LIVE_LINE="This Claude account has reached its limit"; else LIVE_LINE="The $p key has reached its limit"; fi
    matches "$msg" "$RESETS_RE" && when="${BASH_REMATCH[1]}"
    [ $((${#LIVE_LINE} + ${#when} + 12)) -le 80 ] || when="${when%% (*}"
    [ -z "$when" ] || LIVE_LINE="$LIVE_LINE; it resets $when"
  elif matches "$low" "$SIGNIN_RE"; then LIVE_KIND=sign-in
    if [ "$2" = account ]; then LIVE_LINE="Claude Code is not signed in, or its sign-in has expired"; else LIVE_LINE="The $p key was not accepted"; fi
  else LIVE_KIND=other; LIVE_LINE="$p: ${msg:-the live test failed}"; fi
  d=""; case "$raw" in *"; details: /"*) d="/${raw##*; details: /}" ;; esac
  LIVE_DETAILS="ade setup --test $p shows the engine's own message"
  if matches "$d" "$PATH_RE" && [ -f "$d" ]; then LIVE_DETAILS="$(tilde "$d")"
  elif matches "${d%/*}" "$PATH_RE" && [ -d "${d%/*}" ]; then LIVE_DETAILS="the newest file in $(tilde "${d%/*}")"; fi
}
# live_failed <hub> <provider> <account|key|""> <top|focus>: says why, asks, and does it. 0 = the test passed after
# all; 1 = another service (top) or left out (focus); 3 = go on without the test (the everything agent only, and
# never GLM or Muse: story A5 lets only a tested service into a role)
live_failed() {
  local hub="$1" p="$2" how="$3" role="$4" kind note def
  [ -n "$how" ] || { if [ "$p" = anthropic ] && ! key_stored "$hub" anthropic; then how=account; else how=key; fi; }
  while :; do kind="live-$role-$how"; note=""
    case "$role:$p" in top:glm|top:muse) kind="live-top-check"; note="$p cannot be the everything agent until its live check passes" ;;
      focus:*) note="A focus agent uses a service only once its test passed, so $p cannot go on untested." ;; esac
    live_explain "$p" "$how"; def=retry; [ "$LIVE_KIND" = other ] || def="$how"; [ "$def" != account ] || def=sign-in
    failed "$kind" "$LIVE_LINE" "$LIVE_DETAILS" "$def" "$note"
    case "$CHOICE" in
      sign-in) claude_login || { echo "the Claude sign-in did not finish"; continue; } ;;
      key) unsign "$p"; sign_in "$hub" "$p" key || continue ;;
      another|skip) return 1 ;; go-on) return 3 ;;
    esac
    live_test "$hub" "$p" quiet && return 0
  done
}

# claude_login: Claude Code's own sign-in, on the person's terminal, as step 2 of the guide runs it; ade reads, stores
# and prints nothing of it. 1 = it did not finish (or an agent asked: a person signs in)
claude_login() {
  if agent_context; then echo "a person signs in to Claude, at a terminal; an agent cannot"; return 1; fi
  claude auth login
}
claude_signed_in() { if [ -n "${1:-}" ]; then hub_claude "$1" auth status; else claude auth status; fi > /dev/null 2>&1; }   # [hub]
key_stored() { hub_run "$1" keys 2> /dev/null | awk -v n="$2" '$1 == n && $2 == "stored" { f = 1 } END { exit !f }'; }

# sign_in <hub> <provider> [account|key]: account = Claude Code's own login (ade stores nothing); else a key
SIGNED=""; SIGN_HOW=""   # SIGN_HOW: account or key, when sign_in settled it for Claude Code
sign_in() {
  local hub="$1" p="$2" how="${3:-}"; SIGN_HOW=""
  case " $SIGNED " in *" $p "*) return 0 ;; esac
  if [ "$p" = anthropic ]; then
    if [ -z "$how" ]; then
      if claude_signed_in || key_stored "$hub" anthropic; then SIGNED="$SIGNED $p"; return 0; fi
      ask_choice "Claude Code: sign in with" account "account|your Claude account" "key|an Anthropic API key"; how="$CHOICE"
    fi
    if [ "$how" = account ]; then
      until claude_signed_in || claude auth login; do failed sign-in "The Claude sign-in did not finish"; [ "$CHOICE" = sign-in ] || { how=key; break; }; done
      [ "$how" = key ] || { SIGNED="$SIGNED $p"; SIGN_HOW=account; return 0; }
    fi
    SIGN_HOW=key
  fi
  if [ "$p" = gemini ] && command -v "${ADE_GEMINI_CLI:-gemini}" > /dev/null 2>&1; then
    ask_choice "Gemini: sign in with" account "account|your Google account in the Gemini CLI" "key|a Gemini API key"
    case "$CHOICE" in key) ;; *) echo "The Gemini CLI opens: pick \"Login with Google\", then leave it (/quit); ade stores nothing."
      until "${ADE_GEMINI_CLI:-gemini}"; do failed sign-in "The Gemini sign-in did not finish"; [ "$CHOICE" = sign-in ] || break; done
      [ "$CHOICE" = key ] || { SIGNED="$SIGNED $p"; return 0; } ;; esac
  fi
  store_key "$hub" "$p" || { echo "$p: skipped (no key)"; return 1; }
  SIGNED="$SIGNED $p"
}

unsign() { SIGNED=" $(printf '%s' " $SIGNED " | sed "s/ $1 / /g") "; }   # a failed provider asks for its key again
READY=""
provider_ready() {   # sign in, then the live test once per provider; READY collects the ones that passed
  case " $READY " in *" $2 "*) echo "$2: ready (tested above)"; return 0 ;; esac
  sign_in "$@" || return 1
  live_test "$1" "$2" quiet || live_failed "$1" "$2" "${3:-}" focus || { unsign "$2"; return 1; }
  READY="$READY $2"
}

# conf_set <hub> <KEY> <value>: replace or add one hub.conf line (shell-quoted), atomically
conf_set() {
  write_py "$1/hub.conf" "$2" "$3" <<'PY' || die 1 "could not write hub.conf"
import os, re, shlex, sys
p, k, v = sys.argv[1:4]
ade_hold(p, guard=False)
lines = open(p).read().splitlines(); line = "%s=%s" % (k, shlex.quote(v)); done = False
for i, l in enumerate(lines):
    if re.match(r"^%s=" % re.escape(k), l):
        lines[i] = line; done = True
if not done:
    lines.append(line)
ade_write(p, "\n".join(lines) + "\n", guard=False)
PY
}

setup_top() {   # the everything agent: exactly one; GLM and Muse only after their live check passes
  local hub="$1" p how rc old
  while :; do
    echo "Your everything agent (the orchestrator) is the one agent you talk to; it hands"
    echo "work to the others. Pick the AI service it uses (one; later: ade setup --top):"
    ask_choice "Pick one" "" "claude-account|Claude account in Claude Code (Pro, Max, Team, Enterprise)" \
      "anthropic-key|Anthropic API key in Claude Code" "deepseek|DeepSeek" "glm|GLM (needs the live check)" "muse|Muse (needs the live check)"
    how=""; case "$CHOICE" in
      claude-account) p=anthropic; how=account ;; anthropic-key) p=anthropic; how=key ;; *) p="$CHOICE" ;;
    esac
    sign_in "$hub" "$p" $how || continue
    how="${SIGN_HOW:-$how}"; rc=0; live_test "$hub" "$p" quiet || { live_failed "$hub" "$p" "${how:-key}" top; rc=$?; }
    [ "$rc" != 1 ] || { unsign "$p"; continue; }
    conf_set "$hub" HUB_ROOT_PROVIDER "$p"
    conn_record "$hub" top "$p" "${how:-key}" "$(conf_get "$hub" HUB_ROOT_MODEL)"
    [ "${how:-key}" = account ] && record_account "$hub"; record_services "$hub"
    if [ "$rc" = 0 ]; then READY="$READY $p"; untested "$hub" ""
      old="$(conf_get "$hub" HUB_PROVIDERS_ALLOWED)"   # the new top plus the old list
      conf_set "$hub" HUB_PROVIDERS_ALLOWED "$(printf '%s\n' $p $old | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//')"
      echo "everything agent: $p"; return 0; fi
    # chosen, not tested: recorded as that (HUB_PROVIDERS_UNTESTED) and kept out of the roles, which take tested ones only
    untested "$hub" "$p"; drop_role "$hub" "$p"
    echo "everything agent: $p (not tested; to test it later: ade setup --test)"
    echo "Until its test passes, your focus agents do not use $p."; return 0
  done
}
# untested <hub> <provider or "">: HUB_PROVIDERS_UNTESTED in hub.conf, the everything agent chosen without a passed live
# test (empty: none); written only when it changes
untested() { [ "$(conf_get "$1" HUB_PROVIDERS_UNTESTED)" = "$2" ] || conf_set "$1" HUB_PROVIDERS_UNTESTED "$2"; }

setup_focus() {   # focus agents: several; each signed in and live-tested; only ready ones enter the roles
  local hub="$1" p allowed="" top unt
  echo "Your focus agents each do one piece of work. Pick the AI services they may use;"
  echo "each one is signed in and tried once, so you know it works:"
  local ASK_MULTI=1
  ask_choice "Pick any (numbers or names, spaces between; Enter for none)" "" "anthropic|Claude Code" "gemini|Gemini (Gemini CLI)" \
    "deepseek|DeepSeek" "glm|GLM (needs the live check)" "muse|Muse (needs the live check)"
  ASK_MULTI=0
  for p in $CHOICE; do provider_ready "$hub" "$p" || true; done
  top="$(conf_get "$hub" HUB_ROOT_PROVIDER)"; unt="$(conf_get "$hub" HUB_PROVIDERS_UNTESTED)"
  [ -z "$unt" ] || case " $READY " in *" $unt "*) untested "$hub" ""; unt="" ;; esac   # it passed here
  [ "$top" != "$unt" ] || top=""   # an everything agent that is not tested is in no role
  for p in $top $READY; do case " $allowed " in *" $p "*) ;; *) allowed="${allowed:+$allowed }$p" ;; esac; done
  conf_set "$hub" HUB_PROVIDERS_ALLOWED "$allowed"
  for p in $READY; do   # the sign-in kind: an account when Claude Code (or the Gemini CLI) is signed in without a stored key
    case "$p" in anthropic|gemini) if key_stored "$hub" "$p"; then conn_record "$hub" focus "$p" key; else conn_record "$hub" focus "$p" account; fi ;;
      *) conn_record "$hub" focus "$p" key ;; esac
  done
  echo "AI services your agents use: ${allowed:-none yet} (change it later; ade roles shows it)"
}

# Telegram (the guide's last step, and ade setup --telegram): from a bot token to a bot that passed the hub's test and a
# session that keeps running. The state alone says what is left (tg_left), so running it again resumes there and
# shows nothing that is done. ade carries out what a program can (the key store, bun, claude plugin install, bin/chat
# stop and test, hub.conf, bin/schedule install), each said in a line before and checked after; what only a person
# can do inside a Claude Code session (bin/chat start at a terminal, /telegram:access pair and policy) is shown one
# step at a time, then checked with the hub's bin/chat status. Never the hub's bin/chat setup (its list of every step).
# The lock (only the person's account reaches the bot) and the chat's mode are the hub's to decide: ade reads them from
# bin/chat status ("locked to you" / "not locked" on the telegram line, and the "mode:" line), never from access.json.
# The telegram line is read whole, exactly: anything else on it (a trailing space, a leftover escape sequence, other
# words) is not a lock. Only a hub whose status has no "mode:" line at all (an older one) is read as before: the policy
# allowlist with "groups: 0" is the lock, and no mode is shown.
TG_PLUGIN="telegram@claude-plugins-official"
TG_RUN=unknown; TG_POLICY=none; TG_LOCK=unknown; TG_MODE=""; TG_WHY=""; TG_STALE=""; TG_MODELINE=0
# tg_chat <hub>: TG_RUN (running, unconnected, stopped, unknown), TG_POLICY (none, or the policy's name), TG_LOCK (yes:
# the whole line is "telegram: policy allowlist, groups: 0, locked to you"; old: it is "telegram: policy allowlist,
# groups: 0" with nothing after; else no), TG_MODELINE (1 when the status has a "mode:" line), TG_MODE (the mode a
# start would use; empty when the hub does not say), TG_WHY (conf: HUB_CHAT_MODE set it; unlocked; locked) and
# TG_STALE (the running session's mode when it differs)
tg_chat() {
  local out first pol tl ml
  out="$(hub_run "$1" chat status 2> /dev/null < /dev/null | no_ctl)"; first="$(printf '%s\n' "$out" | head -1)"
  case "$first" in *"channel not connected"*) TG_RUN=unconnected ;; running*|*": running"*) TG_RUN=running ;;
    stopped*|*": stopped"*) TG_RUN=stopped ;; *) TG_RUN=unknown ;; esac
  pol="$(printf '%s\n' "$out" | sed -n 's/^telegram: policy \([a-z]*\).*/\1/p' | head -1)"; TG_POLICY="${pol:-none}"
  tl="$(printf '%s\n' "$out" | grep '^telegram: policy ' | head -1)"; ml="$(printf '%s\n' "$out" | grep '^mode: ' | head -1)"
  case "$tl" in "telegram: policy allowlist, groups: 0, locked to you") TG_LOCK=yes ;;
    "telegram: policy allowlist, groups: 0") TG_LOCK=old ;; *) TG_LOCK=no ;; esac
  TG_MODE=""; TG_WHY=""; TG_STALE=""; TG_MODELINE=0; [ -z "$ml" ] || TG_MODELINE=1
  case "$ml" in "mode: auto ("*) TG_MODE=auto ;; "mode: manual ("*) TG_MODE=manual ;; "mode: acceptEdits ("*) TG_MODE=acceptEdits ;;
    "mode: plan ("*) TG_MODE=plan ;; esac
  [ -n "$TG_MODE" ] || return 0
  case "$ml" in "mode: $TG_MODE (HUB_CHAT_MODE)"*) TG_WHY=conf ;; "mode: manual (not locked"*) TG_WHY=unlocked ;; *) TG_WHY=locked ;; esac
  for tl in auto manual acceptEdits plan; do case "$ml" in *"; the running session is in $tl: "*) TG_STALE="$tl" ;; esac; done
}
# tg_locked: the hub says only the person's account reaches the bot. A hub that names a mode must say "locked to you";
# only one with no "mode:" line (an older hub) is read by its policy: allowlist, no groups
tg_locked() { [ "$TG_LOCK" = yes ] || { [ "$TG_LOCK" = old ] && [ "$TG_MODELINE" = 0 ]; }; }
# tg_auto_means <first words>: what auto mode means, said before the chat switches to it
tg_auto_means() {
  echo "$1 the chat runs in auto mode: your main agent acts on your"
  echo "Telegram messages without asking at the terminal. Claude Code's auto mode still"
  echo "refuses risky actions. To turn it off: HUB_CHAT_MODE=manual in hub.conf."
}
tg_bun() { tool_present bun || [ -x "$HOME/.bun/bin/bun" ]; }
tg_left() {   # <hub>: the first thing not done (token bun plugin start pair allowlist test service); nothing when all is
  local hub="$1"
  key_stored "$hub" telegram < /dev/null || { echo token; return 0; }
  tg_bun || { echo bun; return 0; }
  plugin_version "$hub" "$hub" "$TG_PLUGIN" > /dev/null || { echo plugin; return 0; }
  tg_chat "$hub"
  # not locked: the person's steps. A bot that already passed its test (HUB_CHAT=telegram) and still has the policy
  # allowlist stays on, in manual mode, and says so (tg_line); ade setup --telegram offers the lock again (tg_finish)
  if [ "$TG_POLICY" != allowlist ] || { ! tg_locked && [ "$(conf_get "$hub" HUB_CHAT)" != telegram ]; }; then
    if [ "$TG_RUN" != running ]; then echo start; elif [ "$TG_POLICY" = none ]; then echo pair; else echo allowlist; fi
    return 0
  fi
  [ "$(conf_get "$hub" HUB_CHAT)" = telegram ] || { echo test; return 0; }   # written once the test passed
  [ "$TG_RUN" = running ] || echo service
}
tg_what() {   # <id>: the one thing that is left, as what to do
  case "$1" in token) echo "enter your bot's token" ;; bun) echo "install bun" ;; plugin) echo "install the Telegram plugin" ;;
    start) echo "start your bot's session" ;; pair) echo "pair your Telegram account" ;;
    allowlist) echo "allow only your account" ;; test) echo "pass the bot's test" ;; service) echo "start it in the background" ;; esac
}
tg_state() {   # <hub>: on, "not finished: <what is left>" or off; 0 only when on
  local left; left="$(tg_left "$1")"
  [ -n "$left" ] || { echo on; return 0; }
  if [ "$left" = token ] && [ "$(conf_get "$1" HUB_CHAT)" != telegram ]; then echo off; else echo "not finished: $(tg_what "$left")"; fi
  return 1
}
tg_later() { echo "Telegram is not finished: $(tg_what "$1"), then ade setup --telegram"; }
tg_hub_cd() {   # <hub>: what to type to enter the hub
  case "$1" in *[!A-Za-z0-9_./@%+=:,-]*) printf 'cd %s' "$(shq "$1")" ;; *) printf 'cd %s' "$(tilde "$1")" ;; esac
}
tg_show() {   # <hub> <start|pair|allowlist>: that one step, with the exact text to type and where
  case "$2" in
    start) echo "Your turn: open a second terminal window (keep this one open) and type:"
      echo "  $(tg_hub_cd "$1") && bin/chat start"
      echo "Claude Code opens there with your bot attached. Leave it open." ;;
    pair) echo "Your turn: in Telegram, send your bot any message. It replies with a pairing"
      echo "code. In the Claude Code window you opened, type (with your code):"
      echo "  /telegram:access pair <code>" ;;
    allowlist) echo "Your turn: in the same Claude Code window, type:"
      echo "  /telegram:access policy allowlist"
      echo "After this, only your Telegram account reaches your main agent."
      # what the lock brings, before the person locks: a hub that picks the mode by the lock switches to auto
      if [ "$TG_WHY" = unlocked ]; then tg_auto_means "Once it is locked,"
      elif [ "$TG_WHY" = conf ]; then echo "The chat stays in $TG_MODE mode (HUB_CHAT_MODE in hub.conf)."; fi ;;
  esac
}
tg_seen() {   # <start|pair|allowlist>: what the hub's bin/chat status says now, for the line when the step is not done
  case "$1:$TG_RUN" in
    start:unconnected) echo "The session runs, but your bot has not connected to it yet" ;;
    start:*) echo "The session with your bot is not running yet" ;;
    pair:*) echo "Your Telegram account is not paired yet" ;;
    *) if [ "$TG_POLICY" = allowlist ]; then echo "The bot is not locked to your account alone yet (policy allowlist, not locked)"
      else echo "The bot is not locked to your account yet (now: $TG_POLICY)"; fi ;;
  esac
}
tg_person() {   # <hub> <step>: shown, waited for, checked (bin/chat status); 1 = finish Telegram later
  local hub="$1" id="$2" ok
  agent_context && { echo "The next step is for a person, at a terminal; an agent cannot do it."; return 1; }
  while :; do
    [ "$id" != allowlist ] || tg_chat "$hub"
    tg_show "$hub" "$id"
    ask_read "Press Enter when done (or type later):" || { ask_stop; return 1; }
    [ "$ANSWER" != later ] || return 1
    tg_chat "$hub"; ok=0
    case "$id" in start) [ "$TG_RUN" = running ] && ok=1 ;; pair) [ "$TG_POLICY" != none ] && ok=1 ;; allowlist) tg_locked && ok=1 ;; esac
    [ "$ok" = 0 ] || break
    failed tg-wait "$(tg_seen "$id")" "the hub's own words: ade chat status"
    [ "$CHOICE" = again ] || return 1
  done
  case "$id" in start) echo "checked: the session is running, with your bot connected" ;; pair) echo "checked: your Telegram account is paired" ;;
    allowlist) echo "checked: only your account reaches the bot" ;; esac
}
tg_wait_running() {   # <hub>: up to ADE_TG_WAIT seconds (default 30) for bin/chat status to say running
  local n="${ADE_TG_WAIT:-30}" i=0; matches "$n" '^[0-9]{1,3}$' || n=30
  while :; do tg_chat "$1"; [ "$TG_RUN" = running ] && return 0; [ "$i" -lt "$n" ] || return 1; i=$((i + 1)); sleep 1; done
}
tg_auto() {   # <hub> <step>: one step ade does itself: said, done, checked; 1 = finish Telegram later
  local hub="$1" id="$2" out rc
  while :; do
    case "$id" in
      bun) echo "Next: bun, the program the Telegram plugin runs on."
        bun_install tg-bun; rc=$?   # the tools step installs bun; here only when it is missing all the same
        if tg_bun; then echo "checked: bun is installed"; return 0; fi
        [ "$rc" = 2 ] || return 1   # it failed, and the person chose the manual steps or later
        failed tg-bun "bun is not installed yet; the Telegram plugin runs on it" "ade setup --tools installs it too"
        [ "$CHOICE" != manual ] || { bun_manual; return 1; } ;;
      plugin) echo "Next: the Telegram plugin for Claude Code, installed for your user."
        run_logged "$hub" hub_claude "$hub" plugin install "$TG_PLUGIN" --scope user > /dev/null; rc=$?
        if plugin_version "$hub" "$hub" "$TG_PLUGIN" > /dev/null; then echo "checked: the Telegram plugin is installed"; return 0; fi
        if [ "$rc" != 0 ]; then failed tg-step "The Telegram plugin was not installed: $FAIL_LINE" "$FAIL_FILE"
        else failed tg-step "Claude Code does not list the Telegram plugin as installed" "claude plugin list shows what is installed"; fi ;;
      test) tg_chat "$hub"
        if [ "$TG_RUN" != stopped ]; then echo "Next: closing the session in your other window, so the hub can test the bot."
          hub_run "$hub" chat stop > /dev/null 2>&1 < /dev/null; tg_chat "$hub"; fi
        if [ "$TG_RUN" = stopped ]; then
          echo "Next: the test. Your bot sends you a message in Telegram: reply to it with"
          echo "anything. The hub waits for your reply (up to two minutes)."
          out="$(hub_run "$hub" chat test telegram 2>&1 < /dev/null)"; rc=$?
          if [ "$rc" = 0 ]; then conf_set "$hub" HUB_CHAT telegram; echo "checked: your bot's message reached you, and your reply reached the hub"; return 0; fi
          out="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -1)"; out="${out#chat: }"
          failed tg-step "The test did not pass: ${out:-bin/chat test in the hub, exit $rc}" "ade setup --test telegram runs it alone"
        else failed tg-step "The session in your other window is still running" "close it there (type /exit), then try again"; fi ;;
      service) echo "Next: your hub keeps the session with your bot running, in the background."
        if run_logged "$hub" env HUB="$hub" ./bin/schedule install > /dev/null && tg_wait_running "$hub"; then
          echo "checked: the session is running in the background"; return 0; fi
        failed tg-step "The background session has not started${FAIL_LINE:+: $FAIL_LINE}" "ade chat logs shows the hub's own lines" ;;
    esac
    [ "$CHOICE" = retry ] || return 1
  done
}
tg_token() {   # <hub>: the token, asked once (hidden), to the hub's key store on stdin; 1 = skipped (Enter)
  local hub="$1" rc
  echo "In Telegram, open @BotFather and send /newbot, then give your bot a name."
  echo "BotFather replies with the bot's token. Paste it here; it is not shown, and it"
  echo "goes only to the hub's key store."
  while :; do
    ask_secret "Bot token (hidden; Enter skips):"
    [ -n "$SECRET" ] || return 1
    key_put "$hub" telegram; rc=$?
    [ "$rc" != 0 ] || break
    failed tg-token "The token was not stored: ${KEY_ERR:-bin/keys set telegram in the hub, exit $rc}"
    [ "$CHOICE" = token ] || return 2
  done
  record_key "$hub" telegram; echo "checked: the token is in the hub's key store"
}
setup_telegram() {
  local hub="$1" left rc did=0 ASK_AGAIN="ade setup --telegram"
  left="$(tg_left "$hub")"
  if [ "$left" = token ]; then
    yes_no "Do you want to reach your main agent from Telegram?" || { echo "Telegram skipped (later: ade setup --telegram)"; return 0; }
    tg_token "$hub"; rc=$?
    [ "$rc" != 1 ] || { echo "Telegram skipped (no token; later: ade setup --telegram)"; return 0; }
    [ "$rc" = 0 ] || { tg_later token; return 0; }
  fi
  while :; do
    left="$(tg_left "$hub")"
    case "$left" in
      "") break ;;
      token) tg_later token; return 0 ;;   # the key store no longer lists it
      start|pair|allowlist) did=1; tg_person "$hub" "$left" || { tg_later "$left"; return 0; } ;;
      *) did=1; tg_auto "$hub" "$left" || { tg_later "$left"; return 0; } ;;
    esac
  done
  record_channel "$hub" telegram; record_services "$hub"
  tg_finish "$hub" "$did" || return 0
  echo "Telegram is working: your bot passed its test, and its session is running."
}
# tg_finish <hub> <did>: the bot passed its test and its session runs. A bot that is not locked to the person is offered
# the lock; a session started before the lock (or before the hub chose modes this way) is restarted so the new mode
# applies, when the main agent is idle (never interrupted: else the person is told how); then, when this run did
# something, what the mode means. 1 = finish Telegram later (said).
tg_finish() {
  local hub="$1" did="$2"
  tg_chat "$hub"
  if ! tg_locked; then did=1
    tg_person "$hub" allowlist || { tg_later allowlist; return 1; }
    tg_chat "$hub"
  fi
  if [ -n "$TG_STALE" ]; then did=1
    if orch_idle "$hub"; then
      [ "$TG_MODE:$TG_WHY" != auto:locked ] || tg_auto_means "After the restart"
      echo "Next: restarting the session with your bot, so it runs in $TG_MODE mode."
      hub_run "$hub" chat stop > /dev/null 2>&1 < /dev/null
      if run_logged "$hub" env HUB="$hub" ./bin/schedule install > /dev/null && tg_wait_running "$hub" && [ -z "$TG_STALE" ]; then
        echo "checked: the session is running again, in $TG_MODE mode"
      else echo "The session did not restart${FAIL_LINE:+: $FAIL_LINE}; ade setup --telegram tries again"; return 1; fi
    else
      echo "The session with your bot still runs in $TG_STALE mode, and your main agent is"
      echo "busy, so ade does not restart it. When it is idle, type:"
      echo "  ade chat stop && ade setup --telegram"
      return 1
    fi
  fi
  [ "$did" = 1 ] || return 0
  case "$TG_MODE:$TG_WHY" in
    auto:locked) echo "The chat now runs in auto mode: your main agent acts on your Telegram"
      echo "messages without asking at the terminal. Claude Code's auto mode still refuses"
      echo "risky actions. To turn it off: HUB_CHAT_MODE=manual in hub.conf." ;;
    *:conf) echo "The chat runs in $TG_MODE mode (HUB_CHAT_MODE in hub.conf)." ;;
  esac
  return 0
}

setup_check() {   # one line per step; reads only
  local hub="" n=0 keys="" p ch d unt cl
  hub="$(find_hub 2> /dev/null)" || hub=""; cl="$(hub_claude_cmd "$hub")"   # the command ade work runs
  if command -v "$cl" > /dev/null 2>&1; then echo "claude code: installed ($(command -v "$cl"))"; else echo "claude code: missing ($cl)"; fi
  if command -v claude > /dev/null 2>&1 && claude_signed_in; then echo "sign-in: signed in (account)"
  else
    [ -n "$hub" ] && for p in $KEY_PROVIDERS; do key_stored "$hub" "$p" && keys="${keys:+$keys, }$p"; done
    if [ -n "$keys" ]; then echo "sign-in: signed in (key: $keys)"; else echo "sign-in: not signed in"; fi
  fi
  editor_line
  if [ -z "$hub" ]; then echo "hub: none (ade hub new <name>)"; echo "projects: none"; echo "channel: none"; echo "telegram: off"; return 0; fi
  unt="$(conf_get "$hub" HUB_PROVIDERS_UNTESTED)"; echo "hub: $hub${unt:+ ($unt: not tested; ade setup --test)}"
  for d in "$hub"/projects/*/; do [ -d "$d" ] && n=$((n + 1)); done; echo "projects: $n"
  ch="$(conf_get "$hub" HUB_CHANNELS)"; echo "channel: ${ch:-none}"
  tg_line "$hub"
}
# tg_line <hub>: "telegram: on (auto)", "on (manual: not locked)", "on (<mode>)" (HUB_CHAT_MODE; or the running
# session's mode with ": restart for <mode>" when it started before the lock), "on" (a hub that names no mode),
# "on (lock unclear: ade chat status)" (the hub's lines do not say locked, and do not say manual either),
# "telegram: not finished: <what is left> (ade setup --telegram)" or "telegram: off"
tg_line() {
  local st; st="$(tg_state "$1")"
  case "$st" in "not finished"*) echo "telegram: $st (ade setup --telegram)" | cut -c1-80 ;;
    on) tg_chat "$1"
      if ! tg_locked && [ "$TG_MODE:$TG_WHY" != manual:unlocked ]; then echo "telegram: on (lock unclear: ade chat status)"
      elif [ -z "$TG_MODE" ]; then echo "telegram: on"
      elif [ -n "$TG_STALE" ]; then echo "telegram: on ($TG_STALE: restart for $TG_MODE, ade setup --telegram)"
      elif [ "$TG_WHY" = unlocked ]; then echo "telegram: on (manual: not locked)"
      else echo "telegram: on ($TG_MODE)"; fi ;;
    *) echo "telegram: $st" ;; esac
}

# setup_test: --test [provider|telegram]: re-run live tests; changes nothing, but for an everything agent that was
# chosen without its test (A18b): once it passes, it is no longer recorded as untested and enters the roles
setup_test() {
  local hub what="${1:-}" p rc=0 unt old; hub="$(find_hub)" || exit $?; unt="$(conf_get "$hub" HUB_PROVIDERS_UNTESTED)"
  case "$what" in
    telegram) hub_run "$hub" chat test telegram; return $? ;;
    "") what="$(conf_get "$hub" HUB_PROVIDERS_ALLOWED) $unt"; [ -n "${what// /}" ] || what=anthropic ;;
    *) case " $LIVE_PROVIDERS " in *" $what "*) ;; *) die 2 "unknown provider $what (known: $LIVE_PROVIDERS, telegram)" ;; esac ;;
  esac
  for p in $what; do live_test "$hub" "$p" || { rc=1; continue; }
    [ "$p" = "$unt" ] || continue
    untested "$hub" ""; old="$(conf_get "$hub" HUB_PROVIDERS_ALLOWED)"
    conf_set "$hub" HUB_PROVIDERS_ALLOWED "$(printf '%s\n' $p $old | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//')"
    echo "$p: tested now; your focus agents may use it"
  done
  return $rc
}

SETUP_PROMPT="Run the ADE setup guide for this hub. Ask me in plain words about my projects and my work first. Then propose a plan and carry it out one step at a time, and ask before each change (wait for my yes): 1) ade init in each project; 2) ade agent add for the specialists each project needs; 3) ade skills add for useful ade-skills plugins; 4) set the role models with bin/models; 5) do not set up Telegram here: say that the guide offers it next, once this session ends (ade setup --telegram, at my own terminal). Say what each step changes before you run it."

# ADE Computer (A18): the image marks itself with this file (.ade/context/hub-interface.md)
ADE_COMPUTER_MARKER="${ADE_COMPUTER_MARKER:-/etc/ade-computer}"
in_computer() { [ -f "$ADE_COMPUTER_MARKER" ]; }

# GitHub (A18): a hub needs it. gh's own check and gh's own browser sign-in, on the person's terminal; ade never reads,
# stores or prints a token or a password (never gh auth token, never --show-token, never --with-token).
GH_HOST=github.com
gh_signed_in() { gh auth status --hostname "$GH_HOST" > /dev/null 2>&1 < /dev/null; }
gh_account() { gh api user --jq .login 2> /dev/null < /dev/null | head -1 | no_ctl | tr -d ' ' | cut -c1-39; }   # the name, or nothing
# in an ADE Computer gh's output passes through this relay unchanged (stdin stays the terminal), and the one-time
# code it prints is shown again in block letters, large enough to copy by hand
IFS= read -r -d '' GH_RELAY <<'PY' || true
import fcntl, os, re, select, sys, termios
F = dict(zip("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-", (
 " ### |#   #|#####|#   #|#   #", "#### |#   #|#### |#   #|#### ", " ####|#    |#    |#    | ####", "#### |#   #|#   #|#   #|#### ",
 "#####|#    |#### |#    |#####", "#####|#    |#### |#    |#    ", " ####|#    |#  ##|#   #| ####", "#   #|#   #|#####|#   #|#   #",
 "#####|  #  |  #  |  #  |#####", "#####|   # |   # |#  # | ##  ", "#   #|#  # |###  |#  # |#   #", "#    |#    |#    |#    |#####",
 "#   #|## ##|# # #|#   #|#   #", "#   #|##  #|# # #|#  ##|#   #", " ### |#   #|#   #|#   #| ### ", "#### |#   #|#### |#    |#    ",
 " ### |#   #|# # #|#  # | ## #", "#### |#   #|#### |#  # |#   #", " ####|#    | ### |    #|#### ", "#####|  #  |  #  |  #  |  #  ",
 "#   #|#   #|#   #|#   #| ### ", "#   #|#   #|#   #| # # |  #  ", "#   #|#   #|# # #|## ##|#   #", "#   #| # # |  #  | # # |#   #",
 "#   #| # # |  #  |  #  |  #  ", "#####|   # |  #  | #   |#####", " ### |#  ##|# # #|##  #| ### ", "  #  | ##  |  #  |  #  | ### ",
 " ### |#   #|  ## | #   |#####", "#### |    #| ### |    #|#### ", "#   #|#   #|#####|    #|    #", "#####|#    |#### |    #|#### ",
 " ### |#    |#### |#   #| ### ", "#####|    #|   # |  #  |  #  ", " ### |#   #| ### |#   #| ### ", " ### |#   #| ####|    #| ### ",
 "     |     |#### |     |     ")))
def big(c):
    rows = ["  " + " ".join(F[ch].split("|")[r] for ch in c) for r in range(5)]
    return ("\nYour one-time code, large:\n\n" + "\n".join(r.rstrip() for r in rows) + "\n\n  " + " ".join(c) + "\n\n").encode()
m, s = os.openpty()
try: fcntl.ioctl(s, termios.TIOCSWINSZ, fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))
except OSError: pass
pid = os.fork()
if pid == 0:
    os.close(m); os.dup2(s, 1); os.dup2(s, 2)
    if s > 2: os.close(s)
    os.execvp(sys.argv[1], sys.argv[1:])
os.close(s); seen = set(); tail = b""
while True:
    try: d = os.read(m, 4096)
    except OSError: break
    if not d: break
    os.write(1, d); tail = (tail + d)[-256:]
    for x in re.finditer(rb"code: ([A-Z0-9]{4}-[A-Z0-9]{4})", tail):
        if x.group(1) not in seen: seen.add(x.group(1)); os.write(1, big(x.group(1).decode()).replace(b"\n", b"\r\n"))
_, st = os.waitpid(pid, 0)
sys.exit(os.WEXITSTATUS(st) if os.WIFEXITED(st) else 1)
