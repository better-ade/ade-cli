connect_sources() {
  CONNECT_OTHER=""
  [ "$ADE_SKILLS_REPO" = "$CONNECT_DEFAULT_REPO" ] || CONNECT_OTHER="recipes from $ADE_SKILLS_REPO (ADE_SKILLS_REPO)"
  [ "$ADE_RELEASES_BASE" = "$CONNECT_DEFAULT_RELEASES" ] || CONNECT_OTHER="${CONNECT_OTHER:+$CONNECT_OTHER and }release.json from $ADE_RELEASES_BASE (ADE_RELEASES_BASE)"
  CONNECT_OTHER="$(printf '%s' "$CONNECT_OTHER" | no_ctl | tr -d '\t\n')"
