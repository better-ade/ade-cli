            text.append(line[last:m.start()]); sty.extend([st] * (m.start() - last)); last = m.end()
            if m.group(3) == "m" and not m.group(2): st = sgr(m.group(1), st)
        text.append(line[last:]); sty.extend([st] * (len(line) - last)); text = "".join(text).replace("\t", " ")
