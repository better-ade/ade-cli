  if [ "$fixed" = 0 ]; then port="${ADE_WEB_PORT:-8765}"; { matches "$port" '^[1-9][0-9]{3,4}$' && [ "$port" -ge 1024 ] && [ "$port" -le 65535 ]; } || port=8765; fi
