    t.raw()
    msg = [l for l in r.stdout.decode("utf-8", "replace").splitlines() if l.strip()]
    return shown(" · ".join(msg[-2:])) if msg else ""
ACTS = {"o": "open", "f": "reveal", "y": "copy"}

def label(name, p):
    s = shown(name)
