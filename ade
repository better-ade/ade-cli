# github_ready: gh installed (after a yes, from the package manager) and signed in (gh's browser flow), else one line
# saying how to come back: exit 2 without a terminal or in an agent session, 1 when it did not finish
# gh_login: GitHub's own sign-in on the person's terminal (GH_LOGIN_BROWSER: in an ADE Computer, what opens the address)
GH_LOGIN_BROWSER=""
gh_login() {
  if agent_context; then echo "a person signs in to GitHub, at a terminal; an agent cannot"; return 1; fi
  if in_computer; then GH_BROWSER="${GH_LOGIN_BROWSER:-true}" python3 -I -c "$GH_RELAY" gh auth login --hostname "$GH_HOST" --git-protocol https --web
  else gh auth login --hostname "$GH_HOST" --git-protocol https --web; fi
}
github_ready() {
  if ! command -v gh > /dev/null 2>&1; then
    echo "The GitHub CLI (gh) is not installed; ade installs it with your package manager."
    while :; do tools_install gh || true; hash -r
      command -v gh > /dev/null 2>&1 && break
      if agent_context || ! [ -t 0 ]; then die 2 "your hub needs the GitHub CLI (gh); once it is installed, run $ASK_AGAIN"; fi
      failed install "The GitHub CLI (gh) is not installed yet; your hub needs it"
      [ "$CHOICE" = retry ] || { echo "To install it yourself, run (macOS; other systems: https://cli.github.com):"; echo "  brew install gh"; die 1 "then run $ASK_AGAIN"; }
    done
  fi
  gh_signed_in && return 0
  echo "Your hub needs GitHub: it is a private repository on your GitHub account,"
  echo "which keeps the hub's memory and lets you restore the hub on another computer."
  in_computer && echo "The sign-in stays in this computer's home folder; nothing is copied out of it."
  agent_context && die 2 "a person signs in to GitHub, at a terminal; an agent cannot (refused in a Claude Code session); then run $ASK_AGAIN"
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || die 2 "the GitHub sign-in needs you at a terminal; run $ASK_AGAIN there"
  echo "This runs GitHub's own sign-in (gh auth login --web): it shows a one-time code"
  echo "to type at github.com/login/device, on this machine or any other device."
  echo "ade never asks for a password or a token, and never sees one."
  if in_computer; then GH_LOGIN_BROWSER=true   # gh opens nothing unless the person asks for this computer's browser
    [ -n "${DISPLAY:-}" ] && ask_yn "Open the GitHub address in this computer's browser?" y && GH_LOGIN_BROWSER=xdg-open; fi
  until { gh_login; gh_signed_in; }; do failed gh-sign-in "The GitHub sign-in did not finish; your hub needs GitHub"; done
}

# The guide (A18): ade setup walks from nothing to a working hub. The steps are listed with their state; each step
# not done says what it is and what it changes, runs, and is checked; done steps are skipped, so ade setup again
# resumes. Optional steps are offered in a run that did a required step. Step ids: .ade/context/hub-interface.md.
GUIDE_STEPS="claude-code claude-sign-in github hub tools project telegram"
GUIDE_OPTIONAL="tools telegram"
guide_title() {
  case "$1" in claude-code) echo "Claude Code" ;; claude-sign-in) echo "Sign in to Claude" ;; github) echo "Sign in to GitHub" ;;
    hub) echo "Your hub" ;; tools) echo "Your tools (optional)" ;; project) echo "Your first project" ;; telegram) echo "Telegram (optional)" ;; esac
}
guide_hub() { (find_hub) 2> /dev/null; }
first_project() { local d; for d in "$1"/projects/*/; do [ -d "$d" ] && { basename "$d"; return 0; }; done; return 1; }
guide_state() {   # <step>: its state in a few words; 0 when it is done (an optional one: when it is on)
  local hub p a; hub="$(guide_hub)" || hub=""
  case "$1" in
    claude-code) command -v claude > /dev/null 2>&1 && { echo installed; return 0; }; echo "not installed" ;;
    claude-sign-in) command -v claude > /dev/null 2>&1 && claude_signed_in && { echo "signed in (account)"; return 0; }
      [ -n "$hub" ] && for p in $KEY_PROVIDERS; do key_stored "$hub" "$p" && { echo "signed in (key: $p)"; return 0; }; done
      echo "not signed in" ;;
    github) command -v gh > /dev/null 2>&1 || { echo "GitHub CLI not installed"; return 1; }
      gh_signed_in && { a="$(gh_account)"; echo "signed in${a:+ as $a}"; return 0; }; echo "not signed in" ;;
    hub) [ -n "$hub" ] || { echo "none yet"; return 1; }
      [ -n "$(conf_get "$hub" HUB_ROOT_PROVIDER)" ] && { a="$(conf_get "$hub" HUB_PROVIDERS_UNTESTED)"; echo "$(hub_label "$hub") ($(tilde "$hub"))${a:+; $a not tested}"; return 0; }
      echo "$(hub_label "$hub"): its agents are not chosen yet" ;;
    tools) [ -n "$hub" ] || { echo "none yet"; return 1; }
      p="$(connectors_py "$hub/.ade/connectors.json" get 2> /dev/null | paste -sd , - | sed 's/,/, /g')"
      a="$(tools_py "$hub/.ade/tools.json" get 2> /dev/null | paste -sd , - | sed 's/,/, /g')"
      [ -n "$p$a" ] || { echo "none yet"; return 1; }
      echo "${p:+connected: $p}${p:+${a:+; }}${a:+noted: $a}"; return 0 ;;
    project) [ -n "$hub" ] && p="$(first_project "$hub")" && { echo "$p"; return 0; }; echo "none yet" ;;
    telegram) [ -n "$hub" ] || { echo off; return 1; }; tg_state "$hub"; return $? ;;
  esac
  return 1
}
guide_header() {
  local n; n="$(echo $GUIDE_STEPS | wc -w | tr -d ' ')"
  if in_computer; then echo "Welcome to your ADE Computer. The set-up guide (ade setup), $n steps:"
  else echo "ADE set-up guide (ade setup): $n steps from nothing to a working hub"; fi
}
guide_list() {
  local id n=0 st mark
  for id in $GUIDE_STEPS; do n=$((n + 1)); if st="$(guide_state "$id")"; then mark=x; else mark=" "; fi
    printf '  [%s] %d. %-22s %s\n' "$mark" "$n" "$(guide_title "$id")" "$st" | cut -c1-80; done
}
guide_about() {   # <step>: what it is and what it changes, before it runs
  case "$1" in
    claude-code) echo "Claude Code is the agent ADE runs. This installs it with its official"
      echo "installer, after your yes." ;;
    claude-sign-in) echo "Claude Code works with your Claude account or with an API key. The account"
      echo "sign-in is Claude Code's own, in your browser; ade stores nothing." ;;
    hub) echo "Your hub is where ADE keeps its memory: a folder in ~/hubs, saved in a private"
      echo "repository on your GitHub. ADE sets it up, then you pick its agents." ;;
    tools) echo "Optional: the tools you use for this work. ade connects the ones it has a recipe"
      echo "for (you sign in yourself, here) and notes the rest by name only; Enter skips." ;;
    project) echo "ADE opens Claude Code at your hub: it asks about your work and sets up your"
      echo "first project with you, asking before each change. /exit comes back here." ;;
    telegram) echo "Optional: a Telegram bot of your own lets you reach your main agent. A yes asks"
      echo "for the bot's token (hidden), then goes one step at a time; no skips it." ;;
  esac   # github: github_ready says what it is and what it runs
}
guide_install_claude() {
  local proto="=https"; file_urls_ok && proto="=https,file"   # file:// only for tests
  case "$ADE_CLAUDE_INSTALLER" in https://*) ;; file://*) [ "$proto" != "=https" ] || die 1 "the installer must be an https URL (got $ADE_CLAUDE_INSTALLER)" ;;
    *) die 1 "the installer must be an https URL (got $ADE_CLAUDE_INSTALLER)" ;; esac
  local rc why
  yes_no "Claude Code is not installed. Install it now? This runs: curl -fsSL $ADE_CLAUDE_INSTALLER | bash" ||
    die 1 "install Claude Code yourself, then run ade setup again: $CLAUDE_INSTALL_CMD"
  PATH="$HOME/.local/bin:$PATH"
  while :; do
    curl --proto "$proto" --proto-redir "$proto" --tlsv1.2 -fsSL "$ADE_CLAUDE_INSTALLER" | bash; rc=$?; hash -r
    why="The installer ran, but claude is not on PATH yet"; [ "$rc" = 0 ] || why="The Claude Code installer did not finish (exit $rc)"
    if [ "$rc" = 0 ] && command -v claude > /dev/null 2>&1; then break; fi
    failed install "$why"
    [ "$CHOICE" = retry ] || { echo "To install it yourself, run:"; echo "  $CLAUDE_INSTALL_CMD"; die 1 "then run ade setup again (in a new terminal, so claude is found)"; }
  done
  claude_update
}
ask_hub_name() {   # <folder>: a hub name into ANSWER, asked until it is valid and free in that folder
  while :; do
    ask_text "Name for your hub (lower-case letters, digits and -, e.g. acme-sre):"
    if ! matches "$ANSWER" '^[a-z0-9][a-z0-9-]{0,63}$'; then ask_say "lower-case letters, digits and - only, at most 64; type it again"
    elif [ -e "$1/$ANSWER" ]; then ask_say "$(tilde "$1/$ANSWER") is taken; type another name"; else return 0; fi
  done
}
guide_new_hub() {   # a hub whose set-up stopped is picked up; else a name, asked until it is a free, valid one
  local d name=""
  for d in "$HOME"/hubs/*/; do [ -f "$d.git/ade-hub-new" ] && { name="$(basename "$d")"; break; }; done
  [ -n "$name" ] || { ask_hub_name "$HOME/hubs"; name="$ANSWER"; }
  (hub_new "$name") || exit $?
}
# guide_git_identity (A22): the hub's first save is a git commit in the person's own name, and a raw machine has no git
# name or email yet, so before the hub step the guide asks for what git lacks and sets it with git config --global.
# Known: in git's config, or in both GIT_AUTHOR_<X> and GIT_COMMITTER_<X>; git's own guess (user@host) is not asked for.
git_known() { [ -n "$(git config --get "user.$1" 2> /dev/null)" ] || { [ -n "$(printenv "GIT_AUTHOR_$2")" ] && [ -n "$(printenv "GIT_COMMITTER_$2")" ]; }; }
guide_git_identity() {
  git_known name NAME && git_known email EMAIL && return 0
  echo "Your hub's commits carry your name and email, and git has none yet here."
  echo "This sets them for git on this computer (git config --global user.name and user.email)."
  if ! git_known name NAME; then ask_text "Your name, for git commits:"
    git config --global user.name "$ANSWER" || die 1 "git could not save your name; run git config --global user.name \"Your Name\", then ade setup"; fi
  if ! git_known email EMAIL; then
    while ask_text "Your email, for git commits:"; ! matches "$ANSWER" '^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$'; do
      ask_say "that is not an email address (like you@example.com); type it again"; done
    git config --global user.email "$ANSWER" || die 1 "git could not save your email; run git config --global user.email you@example.com, then ade setup"; fi
  echo "checked: git commits here are by $(git config --get user.name 2> /dev/null || echo "${GIT_AUTHOR_NAME:-}") <$(git config --get user.email 2> /dev/null || echo "${GIT_AUTHOR_EMAIL:-}")>"
}
guide_run() {   # <step>: the step itself; it stops ade (exit) when it cannot finish
  local hub rc
  case "$1" in
    claude-code) guide_install_claude ;;
    claude-sign-in) ask_choice "How do you use Claude?" account "account|your Claude account (Pro, Max, Team or Enterprise)" \
        "key|an API key, which you will be asked for at step 4"
      [ "$CHOICE" = key ] && return 0
      agent_context && die 2 "a person signs in to Claude; an agent cannot; then run ade setup"
      until claude auth login; do failed sign-in "The Claude sign-in did not finish"; [ "$CHOICE" = sign-in ] || return 0; done ;;
    github) github_ready ;;
    hub) guide_hub > /dev/null || { guide_git_identity; guide_new_hub; }
      hub="$(find_hub)" || exit $?
      [ -n "$(conf_get "$hub" HUB_ROOT_PROVIDER)" ] || { setup_top "$hub"; setup_focus "$hub"; } ;;
    project) while :; do ( cmd_claude -- --permission-mode default "$SETUP_PROMPT" ); rc=$?; [ "$rc" != 0 ] || break
        failed session "Claude Code stopped early (exit $rc)"
        [ "$CHOICE" != go-on ] || { echo "Going on; this step is not done: ade setup comes back to it."; break; }
      done ;;
    tools) hub="$(find_hub)" || exit $?; guide_tools "$hub" ;;
    telegram) hub="$(find_hub)" || exit $?; setup_telegram "$hub" ;;
  esac
}
# guide_tools <hub> (A23): which tools the person uses. The list is the recipes at the pinned ade-skills tag, checked as
# ade connect checks them: ready ones not connected yet, then held ones ("coming") not noted yet, then other. A ready
# pick runs ade connect <service> itself, in the hub (the person signs in at this terminal); a coming or other pick is
# noted by name in the hub's .ade/tools.json. Nothing secret passes through: names only, an answer shaped like an
# address, key or token is refused and never shown. Enter, the end of input or no terminal skips it.
guide_tools() {
  local hub="$1" conn noted rows tag sv ti jb st items=() ready=" " coming=" " pick notes="" n out
  if ! { [ -t 0 ] && : < /dev/tty; } 2> /dev/null; then echo "skipped: no terminal here; run ade setup at a terminal later to pick your tools"; return 0; fi
  conn="$(connectors_py "$hub/.ade/connectors.json" get)" || { echo "skipped: the hub's .ade/connectors.json is not valid (above)"; return 0; }
  noted="$(tools_py "$hub/.ade/tools.json" get)" || { echo "skipped: the hub's .ade/tools.json is not valid (above)"; return 0; }
  rows="$( (connect_recipes 2> /dev/null; printf '%s' "$CONNECT_ROWS") )" || { echo "skipped: the tool list could not be read; ade connect says why"; return 0; }
  connect_sources   # the list comes from these: said before it is shown
  for n in $conn; do echo "done: $n (connected)"; done
  [ -z "$noted" ] || echo "noted: $(printf '%s\n' "$noted" | paste -sd , - | sed 's/,/, /g')"
  for st in ready held; do
    while IFS="$US" read -r tag sv ti jb _ pick _; do
      [ "$tag" = ok ] && [ "$pick" = "$st" ] || continue
      if [ "$st" = ready ]; then connect_has "$conn" "$sv" && continue; ready="$ready$sv "; items+=("$sv|$ti ($jb)")
      else connect_has "$noted" "$sv" && continue; coming="$coming$sv "; items+=("$sv|$ti ($jb), coming: noted, not connected yet"); fi
    done <<EOF
$rows
EOF
  done
  items+=("other|another tool: you type its name")
  CHOICE=""; ASK_MULTI=1 ASK_EOF=no ask_choice "Which tools do you use for this work? Pick any (numbers or names, spaces between; Enter skips)" "" "${items[@]}" || CHOICE=""
  [ -n "$CHOICE" ] || { echo "skipped: nothing picked; ade setup offers your tools again"; return 0; }
  for pick in $(printf '%s\n' $CHOICE | awk '!seen[$0]++'); do
    case "$ready" in *" $pick "*) echo
      if ( cd "$hub" && connect_service "$pick" ); then :; else echo "$pick: not connected; ade connect $pick (in $(tilde "$hub")) tries again"; fi
      continue ;; esac
    case "$coming" in *" $pick "*) notes="$notes $pick"; continue ;; esac
    [ "$pick" = other ] || continue
    while ASK_EOF=no ASK_EMPTY_OK=1 ask_text "Its name (several: commas between; Enter: none):"; do
      [ -n "$ANSWER" ] || break
      if out="$(tool_names "$ANSWER")"; then notes="$notes $out"; break; fi
      ask_say "names only (letters, digits, spaces and -, at most 32 each): no address, key or token; type it again"
    done; ANSWER=""
  done
  [ -n "$notes" ] || return 0
  # shellcheck disable=SC2086  # the names are checked words
  tools_py "$hub/.ade/tools.json" add $notes > /dev/null || return 0
  for n in $notes; do echo "$n: not connected yet; noted (.ade/tools.json in your hub)"; done
}
# tool_names <answer>: the names in it (commas between), each lower-cased with spaces as -, ^[a-z][a-z0-9-]{0,31}$;
# exit 1, printing nothing, when one is not a plain name or looks like a key or token (a part of 24 or more characters,
# or of 16 or more with a digit in it)
tool_names() {
  local part w out="" parts=() words=()
  IFS=, read -ra parts <<< "$1"   # split without globbing: the answer is data, never a pattern for the folder
  for part in "${parts[@]}"; do
    part="$(printf '%s' "$part" | sed 's/^ *//; s/ *$//')"; [ -n "$part" ] || continue
    matches "$part" '^[A-Za-z][A-Za-z0-9 -]{0,31}$' || return 1
    IFS=' -' read -ra words <<< "$part"
    for w in "${words[@]}"; do
      [ "${#w}" -lt 24 ] || return 1; { [ "${#w}" -ge 16 ] && matches "$w" '[0-9]'; } && return 1
    done
    w="$(printf '%s' "$part" | tr 'A-Z ' 'a-z-' | tr -s '-')"; matches "$w" '^[a-z][a-z0-9-]{0,31}$' || return 1
    out="$out $w"
  done
  [ -n "$out" ] || return 1; printf '%s\n' "${out# }"
}
guide_checked() {   # <step>: one line, after the step, from its state now
  local st; if st="$(guide_state "$1")"; then
    case "$1" in claude-code) echo "checked: Claude Code is installed" ;; claude-sign-in) echo "checked: signed in to Claude ${st#signed in }" ;;
      github) echo "checked: $st to GitHub" | sed 's/^checked: signed in as \(.*\) to GitHub$/checked: signed in to GitHub as \1/' ;;
      hub) echo "checked: your hub is $st" ;; tools) echo "checked: your tools: $st" ;; project) echo "checked: your first project is $st" ;; telegram) echo "checked: Telegram is on" ;; esac
  else
    case "$1" in claude-sign-in) echo "checked: your key is asked at step 4, once your hub is made" ;;
      project) echo "checked: no project yet; ade setup comes back to this step" ;;
      tools) echo "checked: no tools connected or noted yet" ;;
      telegram) case "$st" in off) echo "checked: Telegram is off" ;; *) echo "checked: Telegram is not finished; ade setup --telegram comes back to it" ;; esac ;;
      *) echo "checked: $(guide_title "$1"): $st" ;; esac
  fi
}
guide() {   # [1: the list is already shown]: exit 0 at the end, 1 when a step stopped, 2 when refused
  local id n=0 total did=0 herr left="" hub st
  herr="$( (find_hub) 2>&1 > /dev/null)"
  if [ -n "$herr" ] && ! printf '%s' "$herr" | grep -q "no hub found"; then echo "$herr" >&2; exit 2; fi
  ASK_AGAIN="ade setup"; GUIDE_ON=1; total="$(echo $GUIDE_STEPS | wc -w | tr -d ' ')"
  [ "${1:-0}" = 1 ] || { guide_header; guide_list; }
  agent_context && die 2 "ade setup asks a person at a terminal; it refuses inside a Claude Code session (an agent cannot answer for you)"
  setup_tools_steps
  for id in $GUIDE_STEPS; do n=$((n + 1))
    if [ "$id" = tools ]; then   # offered in every run once the hub is there: what is connected, and the rest
      guide_hub > /dev/null || continue
      echo; echo "Step $n of $total: $(guide_title "$id")"; guide_about "$id"; guide_run "$id"; guide_checked "$id"; continue
    fi
    st="$(guide_state "$id")" && continue
    # an optional step: offered in a run that did a required step, and picked up again once it was started
    case " $GUIDE_OPTIONAL " in *" $id "*) [ "$did" = 1 ] || case "$st" in "not finished"*) ;; *) continue ;; esac ;; *) did=1 ;; esac
    echo; echo "Step $n of $total: $(guide_title "$id")"; guide_about "$id"
    guide_run "$id"; guide_checked "$id"
  done
  n=0; for id in $GUIDE_STEPS; do n=$((n + 1)); case " $GUIDE_OPTIONAL " in *" $id "*) continue ;; esac
    guide_state "$id" > /dev/null || { left="$n ($(guide_title "$id"))"; break; }; done
  echo
  if [ -n "$left" ]; then echo "Not finished: step $left; run ade setup to pick up there."; return 0; fi
  hub="$(guide_hub)"; echo "All set: your hub $(hub_label "$hub") is ready ($(tilde "$hub"))."
  echo "next: type ade to open your workspace (your main agent, and a tab per agent)"
}

cmd_setup() {
  local mode="${1:-}" hub name
  case "$mode" in
    --check) [ $# -eq 1 ] || die 2 "usage: ade setup --check"; setup_check; return 0 ;;
    --test) [ $# -le 2 ] && { [ $# -eq 1 ] || [ -n "$2" ]; } || die 2 "usage: ade setup --test [provider|telegram]"; setup_test "${2:-}"; exit $? ;;
    --tools) { [ $# -eq 1 ] || { [ $# -eq 2 ] && { [ "$2" = required ] || [ "$2" = extras ]; }; }; } || die 2 "usage: ade setup --tools [required|extras]"
      setup_tools "${2:-}"; return ;;
    --diagrams) [ $# -eq 1 ] || die 2 "usage: ade setup --diagrams"; setup_diagrams; return ;;
    --top|--telegram) [ $# -eq 1 ] || die 2 "usage: ade setup $mode"; hub="$(find_hub)" || exit $?
      if [ "$mode" = --top ]; then setup_top "$hub"; else setup_telegram "$hub"; fi; return ;;
    "") ;;
    *) die 2 "usage: ade setup [--check | --test [provider|telegram] | --top | --telegram | --tools | --diagrams]" ;;
  esac
  guide
}

# ade ui / ade dash: a tmux workspace with a tab per agent, on ade's own tmux server (tmux -L ade), so its key table
# and theme never touch the user's tmux (story A6; hub calls in .ade/context/hub-interface.md)
ADE_TMUX_SOCKET="${ADE_TMUX_SOCKET:-ade}"
ui_tmux() { tmux -L "$ADE_TMUX_SOCKET" "$@"; }
# ui_session <hub>: ade-<name>-<6 hex of the hub path's checksum>, so two hubs with one name never share a session
ui_session() { echo "ade-$(hub_label "$1" | tr -c 'A-Za-z0-9-\n' '-')-$(printf '%s' "$1" | cksum | awk '{ printf "%06x", $1 % 16777216 }')"; }
ade_self() {   # the absolute path of this script, for the commands tmux runs
  local p="$0" l; while [ -L "$p" ]; do l="$(readlink "$p")"; case "$l" in /*) p="$l" ;; *) p="$(dirname "$p")/$l" ;; esac; done
  echo "$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
}
need_tmux() {
  command -v tmux > /dev/null 2>&1 && return 0
  local how="install tmux with your package manager"
  if [ "$(uname)" = Darwin ]; then how="brew install tmux"
  elif command -v apt-get > /dev/null 2>&1; then how="sudo apt-get install tmux"
  elif command -v dnf > /dev/null 2>&1; then how="sudo dnf install tmux"
  elif command -v pacman > /dev/null 2>&1; then how="sudo pacman -S tmux"; fi
  die 2 "ade ui needs tmux: $how"
}
# need_tmux_32: ade ui's popups (display-popup) need tmux 3.2 or newer; an older one stops here, before anything
# starts. A version tmux -V does not give as numbers (master) is let through.
tmux_v() { local v; v="$(tmux -V 2> /dev/null < /dev/null | head -1 | no_ctl | cut -c1-40)"; echo "${v#tmux }"; }
# tmux_at_least <major> <minor>: the tmux here is that version or newer (one tmux -V does not give as numbers: yes)
tmux_at_least() {
  local v; v="$(tmux_v)"; [[ $v =~ ([0-9]+)\.([0-9]+) ]] || return 0
  [ "${BASH_REMATCH[1]}" -gt "$1" ] || { [ "${BASH_REMATCH[1]}" = "$1" ] && [ "${BASH_REMATCH[2]}" -ge "$2" ]; }
}
need_tmux_32() {
  local v; tmux_at_least 3 2 && return 0; v="$(tmux_v)"
  local how="use your package manager, or build a newer one (https://github.com/tmux/tmux/wiki/Installing)"
  [ "$(uname)" = Darwin ] && how="brew upgrade tmux"
  die 1 "ade ui needs tmux 3.2 or newer (found $v) for its popups; to update tmux: $how"
}
# ui_opt <ADE_UI_MOUSE|ADE_UI_ARROWS>: on or off. The variable, else its NAME=off line in ~/.config/ade/ui (read as
# text, never run), else on.
ui_opt() {
  local v="${!1:-}"
  [ -n "$v" ] || [ ! -f "$CONF_DIR/ui" ] || v="$(sed -n "s/^$1=//p" "$CONF_DIR/ui" 2> /dev/null | tail -1 | tr -d '\r' | sed 's/[[:space:]]*$//')"
  if [ "$v" = off ]; then echo off; else echo on; fi
}
# ui_ide_hint: in a JetBrains terminal, once (~/.config/ade/hints), how to turn off what may clash with the IDE
ui_ide_hint() {
  [ "${TERMINAL_EMULATOR:-}" = JetBrains-JediTerm ] || return 0
  [ "$(ui_opt ADE_UI_MOUSE)" = on ] || [ "$(ui_opt ADE_UI_ARROWS)" = on ] || return 0
  [ -f "$CONF_DIR/hints" ] && grep -qxF ui-jetbrains "$CONF_DIR/hints" && return 0
  echo "ade ui: in a JetBrains terminal, the mouse and prefix Left/Right may clash with the IDE; to turn them off: ADE_UI_MOUSE=off ADE_UI_ARROWS=off, or those lines in ~/.config/ade/ui (said once)" >&2
  { [ -f "$CONF_DIR/hints" ] && cat "$CONF_DIR/hints"; echo ui-jetbrains; } | write_conf_file hints
}
# ui_live <hub>: the session name when ade's tmux server runs that hub's session (quietly nothing otherwise)
ui_live() { command -v tmux > /dev/null 2>&1 || return 1; local s; s="$(ui_session "$1")"; ui_tmux has-session -t "=$s" 2> /dev/null && echo "$s"; }
# Focus work opens a tab, never a new window. in_app: an ADE desktop app terminal, as the hub's bin/work tells it (there
# bin/work opens a sub-terminal of the caller's tab, and ade changes nothing).
in_app() { [ -n "${ADE_HOOK_BIN:-}" ] && [ -f "$ADE_HOOK_BIN" ] && [ -x "$ADE_HOOK_BIN" ] && [ -n "${ADE_HOOK_PORT:-}" ] && [ -n "${ADE_HOOK_TOKEN:-}" ] && [ -n "${ADE_PTY_ID:-}" ]; }
# ui_wanted: 0 when ade's tabs are the place for a session: not with ADE_UI=off, not in the ADE app, not when the caller
# chose a terminal (AGENT_TERMINAL; tmux counts only with ade's own session, as tab 0 sets it), and only with tmux
# (without it: one line on how to get tabs, and everything as before)
ui_wanted() {
  [ "${ADE_UI:-}" != off ] || return 1; in_app && return 1
  case "${AGENT_TERMINAL:-}" in "") ;; tmux) [ -n "${ADE_UI_SESSION:-}" ] || return 1 ;; *) return 1 ;; esac
  command -v tmux > /dev/null 2>&1 && return 0
  echo "ade: tabs for focus work need tmux; ade setup --tools installs it" >&2; return 1
}
# orchestrator_runs <hub>: a Claude Code session with this hub's Remote Control name is alive (ade claude outside
# tmux, or the hub's bin/chat start); the hub's bin/work tells a running session the same way
orchestrator_runs() { pgrep -f -- "--remote-control $(hub_label "$1")( |\$)" > /dev/null 2>&1; }
# ui_ensure <hub> <session> [place]: the hub's ade ui session, made detached when it is not there (UI_MADE=1). Tab 0
# runs the orchestrator (ade claude); with "place" it only keeps the orchestrator's place (ade ui --place), for when
# one already runs outside tmux: ade never starts a second one.
UI_MADE=0
ui_ensure() {
  local hub="$1" s="$2" conf run=claude; UI_MADE=0
  ui_tmux has-session -t "=$s" 2> /dev/null && return 0
  [ "${3:-}" != place ] || run="ui --place"
  claude_update "$hub"; ui_hint_count
  conf="$CONF_DIR/ui-$s.tmux.conf"; ui_conf "$hub" "$s" | write_conf_file "ui-$s.tmux.conf"
  ui_tmux new-session -d -s "$s" -n orchestrator -c "$hub" \
    "exec env AGENT_TERMINAL=tmux ADE_UI_SESSION=$s ADE_HUB=$(sq "$hub") $(sq "$(ade_self)") $run" || die 1 "tmux could not start $s"
  ui_tmux source-file "$conf" || die 1 "tmux could not load $conf"
  ui_tmux set-environment -t "=$s" AGENT_TERMINAL tmux; ui_tmux set-environment -t "=$s" ADE_UI_SESSION "$s"
  ui_tmux set-environment -t "=$s" ADE_HUB "$hub"; UI_MADE=1
}
# ade work <folder> [...]: the hub's bin/work, its session a tab of the hub's ade ui session (made when it is not
# there). bin/work gets AGENT_TERMINAL=tmux, ADE_UI_SESSION and TMUX (the socket of ade's own tmux server, so its
# plain tmux reaches that server). The hub's tmux mode looks for a session named ade-<hub name>, which is not ade's
# session name, so it opens a detached session of its own there: ade takes that session's window into the ade ui
# session as a tab named after the folder. A hub that opens the tab itself leaves nothing to take in.
cmd_work() {
  local hub s sock before n a tab="" rc RUN_HUB_WAIT=0 cl
  # the hub's Claude Code command first: without it nothing starts (no tab, no session; ade setup --check agrees)
  # (--claude CMD is the one bin/work runs instead; a Gemini session runs no Claude Code and bin/work checks its CLI)
  if [ $# -gt 0 ] && hub="$(find_hub 2> /dev/null)"; then cl="$(hub_claude_cmd "$hub")"; a=""
    for n in "$@"; do case "$a" in --claude) cl="$n" ;; --provider) [ "$n" != gemini ] || cl="" ;; esac; a="$n"; done
    { [ "$(conf_get "$hub" HUB_PROVIDER)" = gemini ] && ! printf ' %s ' "$@" | grep -q -- ' --provider '; } && cl=""
    [ -z "$cl" ] || command -v "$cl" > /dev/null 2>&1 || die 2 "Claude Code ($cl) is not installed here, so nothing was started; to install it: ade setup"; fi
  ui_wanted || run_hub work "$@"
  hub="$(find_hub 2> /dev/null)" || run_hub work "$@"
  (sq "$hub"; sq "$(ade_self)") > /dev/null 2>&1 || run_hub work "$@"   # a path tmux cannot take: as before
  s="$(ui_session "$hub")"
  if orchestrator_runs "$hub"; then ui_ensure "$hub" "$s" place; else ui_ensure "$hub" "$s"; fi
  sock="$(ui_tmux display-message -p -t "=$s:" '#{socket_path}' 2> /dev/null)"
  case "${TMUX:-}" in "$sock",*) ;; *) [ -z "$sock" ] || { TMUX="$sock"; export TMUX; } ;; esac
  AGENT_TERMINAL=tmux; ADE_UI_SESSION="$s"; export AGENT_TERMINAL ADE_UI_SESSION
  before="$(ui_tmux list-sessions -F '#{session_name}' 2> /dev/null)"
  RUN_HUB_WAIT=1; run_hub work "$@"; rc=$?
  [ "$rc" = 0 ] || exit "$rc"
  for a in "$@"; do matches "$a" '^(projects|ops)/[A-Za-z0-9_-][A-Za-z0-9._-]*$' && tab="$a"; done
  while IFS= read -r n; do
    [ -n "$n" ] && [ "$n" != "$s" ] || continue
    printf '%s\n' "$before" | grep -qxF -- "$n" && continue
    ui_tmux rename-window -t "=$n:" "${tab:-$n}" 2> /dev/null
    ui_tmux move-window -d -s "=$n:" -t "=$s:" 2> /dev/null || echo "ade: $n stays a tmux session of its own (it could not be moved into $s)" >&2
  done <<EOF
$(ui_tmux list-sessions -F '#{session_name}' 2> /dev/null)
EOF
  [ "$UI_MADE" != 1 ] || echo "ade: ${tab:-the focus work} is a tab in $s; ade ui shows it" >&2
  exit 0
}
sq() {   # a path quoted for a tmux command; anything tmux or the shell could expand is refused
  case "$1" in *"'"*|*'"'*|*'$'*|*'\'*|*'#'*|*'`'*) die 2 "ade ui does not support this path (quotes, \$, \\, # or backticks): $1" ;; esac
  printf "'%s'" "$1"
}

# theme: ~/.config/ade/theme (key=colour lines); a colour must be a tmux colour word or #rrggbb, else the default stays
THEME_KEYS="bg fg accent orchestrator busy idle blocked unread"
theme_get() {
  local v="" d; case "$1" in bg) d="#1e1e2e" ;; fg) d="#cdd6f4" ;; accent) d="#89b4fa" ;; orchestrator) d="#cba6f7" ;;
    busy) d="#f9e2af" ;; idle) d="#a6e3a1" ;; blocked) d="#f38ba8" ;; unread) d="#fab387" ;; *) return 1 ;; esac
  [ -f "$CONF_DIR/theme" ] && v="$(sed -n "s/^$1=//p" "$CONF_DIR/theme" | tail -1)"
  matches "$v" '^(#[0-9a-fA-F]{6}|[a-z]+[0-9]*)$' || v="$d"; printf '%s' "$v"
}
theme_env() { local k; for k in $THEME_KEYS; do printf 'ADE_THEME_%s=%s\n' "$k" "$(theme_get "$k")"; done; }

# ui_data <hub> <dir> [session]: what the bar and the dash render, as files in <dir>
ui_data() {
  local hub="$1" d="$2" s="${3:-}" n
  hub_run "$hub" sessions > "$d/sessions" 2> /dev/null || : > "$d/sessions"
  : > "$d/unread"
  if [ -x "$hub/bin/inbox" ]; then
    for n in main $(awk 'NR > 1 { print $1 }' "$d/sessions"); do printf '%s\t%s\n' "$n" "$(hub_run "$hub" inbox --count "$n" 2> /dev/null | head -1)" >> "$d/unread"; done
  fi
  if [ -x "$hub/bin/dispatch" ] && hub_run "$hub" dispatch --list > "$d/tickets" 2> /dev/null; then :; else echo "unavailable" > "$d/tickets"; fi
  if [ -n "$s" ]; then ui_tmux list-windows -t "=$s" -F "#{window_index}	#{window_name}	#{window_active}" > "$d/windows" 2> /dev/null || : > "$d/windows"; fi
  theme_env > "$d/theme"
  update_badge > "$d/updates" 2> /dev/null || : > "$d/updates"
  printf '%s\n' "${AGENT_STATE:-$HOME/.agent-hub/$(hub_label "$hub")}/events.jsonl" > "$d/events_path"
  hub_label "$hub" > "$d/name"
}

# ui_bar <hub> <session>: the tab bar, from data cached for 2 s in ~/.config/ade/ui-cache/<session> (every attached
# client redraws every 2 s; the hub's scripts run once per period, not once per client)
# U5: [width] (#{client_width}), [mouse] (#{mouse}; none: ADE_UI_MOUSE) and [ranges] (1: tmux 3.4's user ranges)
# choose the buttons
ui_bar() {
  local c="$CONF_DIR/ui-cache/$2" now t=0 w="${3:-}" m="${4:-}" r="${5:-1}"; now="$(date +%s)"
  [[ $w =~ ^[0-9]{1,5}$ ]] || w=""; case "$m" in 1|on) m=1 ;; 0|off) m=0 ;; *) [ "$(ui_opt ADE_UI_MOUSE)" = on ] && m=1 || m=0 ;; esac
  [ "$r" = 1 ] || r=0
  [ -f "$c/at" ] && t="$(cat "$c/at" 2> /dev/null)"; [[ $t =~ ^[0-9]+$ ]] || t=0
  local keep="${ADE_UI_CACHE_SECONDS:-2}"; [[ $keep =~ ^[0-9]+$ ]] || keep=2
  if [ $((now - t)) -ge "$keep" ] || [ ! -f "$c/sessions" ]; then
    ( umask 077; mkdir -p "$c" ) || return 1; ui_data "$1" "$c" "$2"; echo "$now" > "$c/at"
  else ui_tmux list-windows -t "=$2" -F "#{window_index}	#{window_name}	#{window_active}" > "$c/windows" 2> /dev/null; fi
  ui_actions "" | awk -F '\t' '$2 != "-" { print $1 "\t" $2 }' > "$c/buttons"
  ui_render bar "$c" "$w" "$m" "$r"
}

ui_render() {   # ui_render bar|dash <dir> [width mouse(1/0) ranges(1/0)]
  PYTHONIOENCODING=utf-8 python3 - "$1" "$2" "${ADE_NOW:-}" "${3:-}" "${4:-0}" "${5:-0}" <<'PY'
import datetime, json, os, sys
mode, d, now = sys.argv[1], sys.argv[2], sys.argv[3]
BAR_WIDTH, BAR_MOUSE, BAR_RANGES = int(sys.argv[4] or 999), sys.argv[5] == "1", sys.argv[6] == "1"
def read(n):
    try: return open(os.path.join(d, n), encoding="utf-8").read().splitlines()
    except OSError: return []
theme = {l.split("=", 1)[0][len("ADE_THEME_"):]: l.split("=", 1)[1] for l in read("theme") if "=" in l}
rows = []
head = (read("sessions") or [""])[0].split()
tok_i = head.index("TOKENS") if "TOKENS" in head else None   # usage, when the hub's bin/sessions reports it
for l in read("sessions")[1:]:
    f = l.split()
    if len(f) >= 7:
        name, folder, started, role, status = f[0], f[1], f[4], f[5], f[6]
        ticket = "" if name == folder.rsplit("/", 1)[-1] else name
        tok = f[tok_i] if tok_i is not None and len(f) > tok_i and f[tok_i] != "-" else ""
        rows.append(dict(name=name, folder=folder, started=started, role="" if role == "-" else role, status=status, ticket=ticket, tokens=tok))
show_tok = any(r["tokens"] for r in rows)
unread = {}
for l in read("unread"):
    k, _, v = l.partition("\t")
    unread[k] = int(v) if v.strip().isdigit() else 0
ICON = {"busy": "⟳", "idle": "○", "blocked": "⚠"}
def state(s): return s if s in ICON else "idle"
def ts(s):
    try: return datetime.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ")
    except ValueError: return None
t_now = ts(now) if now else datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)
def age(s):
    t = ts(s)
    if not t or not t_now: return "-"
    m = max(0, int((t_now - t).total_seconds() // 60))
    return "%dm" % m if m < 60 else "%dh%02dm" % (m // 60, m % 60)
def find(win):
    folder, _, ticket = win.partition(":")
    for r in rows:
        if r["folder"] == folder and (r["ticket"] == ticket or not ticket):
            return r
    return None
if mode == "bar":
    out = []
    for l in read("windows"):
        p = l.split("\t")
        if len(p) < 3: continue
        idx, win, active = p
        bg = theme["accent"] if active == "1" else theme["bg"]
        fg_txt = theme["bg"] if active == "1" else None
        if idx == "0":
            label, col, n = "● 0 orchestrator", theme["orchestrator"], unread.get("main", 0)
        else:
            r = find(win)
            st = state(r["status"]) if r else "idle"
            folder, _, ticket = win.partition(":")
            parts = [folder] + ([r["role"]] if r and r["role"] else []) + ([ticket] if ticket else [])
            label, col, n = "%s %s %s" % (ICON[st], idx, " · ".join(parts)), theme[st], unread.get(r["name"], 0) if r else 0
        tab = "#[range=window|%s]#[bg=%s]#[fg=%s]%s" % (idx, bg, col, label.replace("#", "##"))
        if n > 0: tab += " #[fg=%s]✉%d" % (theme["unread"], n)
        out.append(tab + "#[norange] ")
    if BAR_MOUSE:   # U5: the buttons, only with the mouse on; [+ ...] is range=left, [≡ menu] range=right (tmux 3.2)
        btn = lambda rng, text: "#[range=%s][%s]#[norange]" % (rng, text)
        if BAR_WIDTH < 100 or not BAR_RANGES: row = [btn("left", "+"), btn("right", "≡ menu")]
        else: row = [btn("left" if k == "n" else "user|k-" + k, b) for k, b in (l.split("\t", 1) for l in read("buttons") if "\t" in l)]
        out.append("#[bg=%s]#[fg=%s]" % (theme["bg"], theme["accent"]) + " ".join(row))
    ups = (read("updates") or ["0"])[0].strip()
    if ups.isdigit() and int(ups) > 0: out.append("#[fg=%s]⬆ %s update%s (ade update)" % (theme["accent"], ups, "" if ups == "1" else "s"))
    print(" ".join(out))
else:
    name = (read("name") or ["hub"])[0]
    color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    def c(s, code): return "\033[%sm%s\033[0m" % (code, s) if color else s
    print(c("ADE fleet · %s" % name, "1"))
    print(""); print(c("AGENTS", "1"))
    try: width = int(os.environ.get("COLUMNS") or 0) or os.get_terminal_size().columns
    except OSError: width = 80
    narrow = width < 70   # the sidebar: one compact line per agent, ticket and event
    if rows and not narrow: print(("    %-24s %-10s %-8s %-7s" % ("FOLDER", "ROLE", "TICKET", "RUN") + ("  TOKENS" if show_tok else "")).rstrip())
    if not rows: print("  (no focus agents running)")
    for r in rows:
        st = state(r["status"])
        mark = "  ✉%d" % unread[r["name"]] if unread.get(r["name"], 0) > 0 else ""
        if narrow: print("  %s %s" % (ICON[st], " · ".join(x for x in (r["folder"], r["role"], r["ticket"], age(r["started"]), r["tokens"]) if x)) + mark)
        else: print(("  %s %-24s %-10s %-8s %-7s" % (ICON[st], r["folder"], r["role"] or "-", r["ticket"] or "-", age(r["started"]))
                     + ("  %-6s" % (r["tokens"] or "-") if show_tok else "")).rstrip() + mark)
    print(""); print(c("TICKETS", "1"))
    t = read("tickets")
    if t == ["unavailable"]: print("  (this hub's bin/dispatch has no --list yet)")
    elif not t: print("  (none ready or waiting)")
    for l in t:
        p = l.split("\t")
        if len(p) == 3 and p != ["unavailable"]:
            if narrow: print("  %s %s %s" % (p[0], p[1], p[2]))
            else: print("  %-8s %-8s %s%s" % (p[0], p[1], p[2], "   approve: prefix a" if p[0] == "waiting" else ""))
    print(""); print(c("EVENTS (last 8)", "1"))
    ev = []
    path = (read("events_path") or [""])[0]
    try:
        for l in open(path, encoding="utf-8").read().splitlines()[-8:]:
            try: e = json.loads(l)
            except ValueError: continue
            tm = ts(str(e.get("time", "")))
            text = " ".join(str(e.get("text", "")).split())[:80]
            hm = tm.strftime("%H:%M") if tm else "--:--"
            who = str(e.get("from", "?")).rstrip("/").rsplit("/", 1)[-1] or "?"; kind = str(e.get("kind", "?"))
            # a plain sentence: "api pushed feat/1.2", "db idle", "web blocked: <reason>"
            if kind in ("idle", "ended"): line = "%s %s" % (who, kind)
            elif kind == "blocked": line = "%s blocked: %s" % (who, text) if text else "%s blocked" % who
            else: line = ("%s %s %s" % (who, kind, text)).rstrip()
            ev.append(("  %s %s" % (hm, line))[:width - 1])
    except OSError:
        pass
    print("\n".join(ev) if ev else "  (no events)")
PY
}

UI_KEYS="  prefix n   new agent: pick a folder, then a role
  prefix a   approve a waiting ticket (type its ref back)
  prefix t   tickets ready and waiting
  prefix p   preview the current agent's plan
  prefix f   show or hide the fleet sidebar (ade dash)
  prefix e   files: explore and view the hub and its projects
  prefix v   docs: the plans and specs as written (live)
  prefix l   links: open a file path or URL shown in this pane
             in files and links, c: open in your editor
  prefix ?   this help
  prefix 0-9, Left, Right   switch tabs
  prefix d   detach (agents keep running)"

# ui_actions <run>: the one table of ade ui's actions (U5), a line each: key, button (- for none), menu label, the tmux
# command. The prefix key, the bar's button and the menu item are all made from it, so a click runs what its key runs.
ui_actions() {
  local run="$1"
  printf '%s\t%s\t%s\t%s\n' \
    n "+ agent" "new agent" "run-shell \"$run ui --menu new\"" \
    t tickets "tickets" "display-popup -E -w 80% -h 60% \"$run ui --tickets\"" \
    e files "files" "display-popup -E -w 90% -h 90% \"$run files\"" \
    a approve "approve a ticket" "run-shell \"$run ui --menu approve\"" \
    f dash "fleet sidebar (dash)" "run-shell \"$run ui --sidebar\"" \
    p - "preview this agent's plan" "run-shell \"$run ui --menu preview #{window_index}\"" \
    l - "links in this pane" "run-shell \"$run ui --menu links #{pane_id}\"" \
    v - "docs" "display-popup -E -w 90% -h 90% \"$run docs\"" \
    "?" "? keys" "keys" "display-popup -E -w 66 -h 17 \"$run ui --keys\"" \
    d - "detach (agents keep running)" "detach-client"
}
tq() { local v="${1//\\/\\\\}"; printf '"%s"' "${v//\"/\\\"}"; }   # one tmux argument, double-quoted
UI_HINT="Click a tab or a button; right click for every action. Keys: ? keys"
# ui_hint_due: the first-run line (U5) shows in the first 3 sessions ade makes, until a click hides it (ui-click lines,
# one per session, and ui-click-off in ~/.config/ade/hints); never with the mouse off
ui_hint_due() {
  local n=0; [ "$(ui_opt ADE_UI_MOUSE)" = on ] || return 1
  [ -f "$CONF_DIR/hints" ] || return 1; grep -qxF ui-click-off "$CONF_DIR/hints" && return 1
  n="$(grep -cxF ui-click "$CONF_DIR/hints")"; [ "$n" -ge 1 ] && [ "$n" -le 3 ]
}
ui_hint_count() {   # a new session: one more ui-click line (up to 4, the one that ends it)
  local n=0; [ "$(ui_opt ADE_UI_MOUSE)" = on ] || return 0
  [ -f "$CONF_DIR/hints" ] && { grep -qxF ui-click-off "$CONF_DIR/hints" && return 0; n="$(grep -cxF ui-click "$CONF_DIR/hints")"; }
  [ "$n" -le 3 ] || return 0
  { [ -f "$CONF_DIR/hints" ] && cat "$CONF_DIR/hints"; echo ui-click; } | write_conf_file hints
}
ui_hint_off() {
  [ -f "$CONF_DIR/hints" ] && grep -qxF ui-click-off "$CONF_DIR/hints" && return 0
  { [ -f "$CONF_DIR/hints" ] && cat "$CONF_DIR/hints"; echo ui-click-off; } | write_conf_file hints
}

ui_conf() {   # ui_conf <hub> <session>: the tmux config ade ui loads
  local hub="$1" s="$2" run k b l c menu tab ranges=0 clip lines=on
  run="ADE_HUB=$(sq "$hub") $(sq "$(ade_self)")"
  tmux_at_least 3 4 && ranges=1   # user ranges (one per button) came in tmux 3.4; 3.2 and 3.3 get [+] [≡ menu]
  ui_hint_due && lines=2
  menu="display-menu -x M -y S -T $(tq "#[align=centre]ade: prefix + the key")"
  while IFS="$(printf '\t')" read -r k b l c; do menu="$menu $(tq "$l") $(tq "$k") $(tq "$c")"; done <<EOF
$(ui_actions "$run")
EOF
  # a tab's menu: its window by id; its name only in the title and the y/n prompt, both formats tmux expands itself
  tab="display-menu -t= -x W -y W -T $(tq "#[align=centre]#{window_index}:#{window_name}") $(tq "go to it") $(tq g) $(tq "select-window -t #{window_id}")"
  tab="$tab $(tq "preview its plan") $(tq p) $(tq "$(ui_actions "$run" | awk -F '\t' '$1 == "p" { print $4 }')")"
  tab="$tab $(tq "links in its pane") $(tq l) $(tq "$(ui_actions "$run" | awk -F '\t' '$1 == "l" { print $4 }')") \"\""
  tab="$tab $(tq "#{?#{==:#{window_index},0},,close it}") $(tq x) $(tq "confirm-before -p \"close ##{b:window_name}? y/n\" \"kill-window -t #{window_id}\"")"
  cat <<CONF
# written by ade ui for $s; ade's own tmux server (tmux -L $ADE_TMUX_SOCKET)
set -g status $lines
set -g status-interval 2
set -g status-style "bg=$(theme_get bg),fg=$(theme_get fg)"
set -g status-left-length 600
set -g status-right ""
set -g window-status-format ""
set -g window-status-current-format ""
set -g status-left "#($run ui --bar $s #{client_width} #{mouse} $ranges)"
set -g destroy-unattached off
set -g mouse $(ui_opt ADE_UI_MOUSE)
set -g set-titles on
CONF
  [ "$lines" = 2 ] && echo "set -g status-format[1] $(tq "#[align=centre]$UI_HINT  (a click here hides this line)")"
  while IFS="$(printf '\t')" read -r k b l c; do echo "bind-key -T prefix $k $c"; done <<EOF
$(ui_actions "$run")
EOF
  if [ "$(ui_opt ADE_UI_ARROWS)" = on ]; then printf '%s\n' "bind-key -T prefix Left previous-window" "bind-key -T prefix Right next-window"
  else printf '%s\n' "bind-key -r -T prefix Left select-pane -L" "bind-key -r -T prefix Right select-pane -R"; fi
  # U5, the mouse: [+ ...] and [≡ menu] are the bar's left and right ranges; the other buttons user ranges k-<key>
  echo "bind-key -T root MouseDown1StatusLeft $(ui_actions "$run" | awk -F '\t' '$1 == "n" { print $4 }')"
  for k in MouseDown1StatusRight MouseDown3StatusLeft MouseDown3StatusRight MouseDown3StatusDefault; do echo "bind-key -T root $k $menu"; done
  echo "bind-key -T root MouseDown1Status if-shell -F \"#{m:k-*,#{mouse_status_range}}\" {"
  while IFS="$(printf '\t')" read -r k b l c; do [ "$b" = - ] || [ "$k" = n ] || echo "    if-shell -F \"#{==:#{mouse_status_range},k-$k}\" { $c }"; done <<EOF
$(ui_actions "$run")
EOF
  printf '%s\n' "  } { select-window -t= }" "bind-key -T root MouseDown3Status {" "  if-shell -F \"#{m:k-*,#{mouse_status_range}}\" { $menu } { $tab }" "}"
  echo "bind-key -T root MouseDown1StatusDefault if-shell -F \"#{==:#{status},2}\" { set-option -g status on ; run-shell -b \"$run ui --hint-off\" }"
  # the wheel scrolls a pane's history (once a session: how to get back), a drag selects and copies
  cat <<'CONF'
bind-key -T root WheelUpPane if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } {
  copy-mode -e
  if-shell -F "#{?@ade-scrolled,0,1}" {
    set-option @ade-scrolled 1
    display-message "scrolling: q or Esc to return"
  }
}
bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel
bind-key -T copy-mode-vi Escape send-keys -X cancel
CONF
  clip="$(clip_cmd)" && echo "set -s copy-command $(tq "$clip")"
  return 0
}

ui_menu() {   # ui_menu new|role <folder>|approve|preview <index>
  local hub run d f r items; hub="$(find_hub)" || exit $?; run="ADE_HUB=$(sq "$hub") $(sq "$(ade_self)")"
  set -- "$@"; local what="${1:-}"; [ $# -gt 0 ] && shift
  case "$what" in
    new)
      set --; for d in "$hub"/projects/*/ "$hub"/ops/*/; do [ -d "$d" ] || continue; f="${d%/}"; f="${f#"$hub"/}"
        [[ $f =~ ^(projects|ops)/[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || continue   # never a name tmux or the shell could run
        set -- "$@" "$f" "" "run-shell \"$run ui --menu role $f\""; done
      [ $# -gt 0 ] || { ui_tmux display-message "no folders in this hub (projects/ or ops/)"; return 0; }
      ui_tmux display-menu -T "New agent: folder" "$@" ;;
    role)
      f="${1:-}"; matches "$f" '^(projects|ops)/[A-Za-z0-9_-][A-Za-z0-9._-]*$' || die 2 "not a folder: $f"
      items="$(hub_run "$hub" roles 2> /dev/null | awk '/^[a-z][a-z0-9-]* / { print $1 }')"
      [ -n "$items" ] || items="builder routine reviewer architect triage"
      set --; for r in $items; do set -- "$@" "$r" "" "run-shell -b \"$run work --role $r $f\""; done
      set -- "$@" "(no role)" "" "run-shell -b \"$run work $f\""
      ui_tmux display-menu -T "New agent: role for $f" "$@" ;;
    approve)
      d="$(mk_tmp)" || die 1 "could not make a temp folder"; ui_data "$hub" "$d"; set --
      while IFS="$(printf '\t')" read -r st r f; do
        [ "$st" = waiting ] || continue
        matches "$r" '^[A-Za-z0-9][A-Za-z0-9._/-]*$' && matches "$f" '^(projects|ops)/[A-Za-z0-9_-][A-Za-z0-9._-]*$' || continue
        set -- "$@" "$r  $f" "" "display-popup -E -w 80% -h 50% \"$run dispatch --approve $r $f\""
      done < "$d/tickets"; rm_tmp "$d"
      [ $# -gt 0 ] || { ui_tmux display-message "no ticket is waiting for you"; return 0; }
      ui_tmux display-menu -T "Approve a ticket" "$@" ;;
    preview)
      f="$(ui_tmux display-message -p -t ":${1:-0}" '#{window_name}' 2> /dev/null)"; f="${f%%:*}"
      [ "${1:-0}" != 0 ] && [ -n "$f" ] || f=.
      ui_tmux display-popup -E -w 90% -h 90% "$run ui --preview $f" ;;
    links)   # the pane and its last 2000 lines into a temp folder, then the picker in a popup (it removes the folder)
      matches "${1:-}" '^%[0-9]+$' || die 2 "not a pane: $(printf '%s' "${1:-}" | no_ctl)"
      d="$(mk_tmp)" || die 1 "could not make a temp folder"; sq "$d" > /dev/null
      ui_tmux capture-pane -p -J -S -2000 -t "$1" > "$d/pane" 2> /dev/null || : > "$d/pane"
      ui_tmux display-message -p -t "$1" '#{pane_current_path}' > "$d/cwd" 2> /dev/null || : > "$d/cwd"
      ui_tmux display-popup -E -w 90% -h 80% "$run ui --links $(sq "$d")" || rm_tmp "$d" ;;
    *) die 2 "usage: ade ui --menu new|role <folder>|approve|preview <index>|links <pane>" ;;
  esac
}

ui_preview() {   # the agent's plan: <folder>/PLAN.md, else its STATE.md; glow when installed, else plain text
  local hub p f; hub="$(find_hub)" || exit $?; f="${1:-.}"
  case "$f" in */..*|..*|/*) die 2 "not a folder: $f" ;; esac
  for p in "$hub/$f/PLAN.md" "$hub/$f/STATE.md"; do [ -f "$p" ] && break; done
  [ -f "$p" ] || { echo "no plan for $f yet (no PLAN.md or STATE.md)"; [ -t 0 ] && read -r _; return 0; }
  p="$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
  if command -v glow > /dev/null 2>&1; then glow -p "$p"; else cat "$p"; [ -t 0 ] && { printf '\n(Enter closes) '; read -r _; }; fi
  return 0
}

ui_links() {   # <the folder ui --menu links made>: the paths and URLs in that capture, picked by number
  local d="$1" cwd=""
  case "$d" in "$TMP_ROOT"/ade.?*) ;; *) die 2 "usage: ade ui --links <the folder ade ui --menu links made>" ;; esac
  case "$d" in */..|*/../*) die 2 "usage: ade ui --links <the folder ade ui --menu links made>" ;; esac
  [ -f "$d/pane" ] || die 2 "no pane capture in $(printf '%s' "$d" | no_ctl)"
  [ -f "$d/cwd" ] && IFS= read -r cwd < "$d/cwd"
  [ -n "$cwd" ] && [ -d "$cwd" ] || cwd="$( (find_hub) 2> /dev/null)" || cwd="$PWD"
  ROOTS="$(files_roots "$cwd")"; files_py pick "$d/pane" "$cwd"; rm_tmp "$d"
}
ui_sidebar() {
  local id; need_tmux
  id="$(ui_tmux list-panes -F '#{pane_id} #{pane_title}' 2> /dev/null | awk '$2 == "ade-dash" { print $1; exit }')"
  if [ -n "$id" ]; then ui_tmux kill-pane -t "$id"; return; fi
  id="$(ui_tmux split-window -h -d -l 44 -P -F '#{pane_id}' "$(sq "$(ade_self)") dash")" || die 1 "could not open the sidebar"
  ui_tmux select-pane -t "$id" -T ade-dash
}

cmd_ui() {
  local hub s d detach=0
  case "${1:-}" in
    --bar) [ -n "${2:-}" ] || die 2 "usage: ade ui --bar <session> [width] [mouse] [ranges]"; hub="$(find_hub)" || exit $?
      ui_bar "$hub" "$2" "${3:-}" "${4:-}" "${5:-}"; return 0 ;;
    --hint-off) ui_hint_off; return 0 ;;
    --tab-name) matches "${2:-}" '^(projects|ops)/[A-Za-z0-9_-][A-Za-z0-9._-]*$' || die 2 "usage: ade ui --tab-name <folder> [ticket]"
      echo "$2${3:+:$3}"; return 0 ;;
    --menu) shift; ui_menu "$@"; return ;;
    --preview) ui_preview "${2:-}"; return ;;
    --sidebar) ui_sidebar; return ;;
    --links) ui_links "${2:-}"; return ;;
    --keys) echo "ade ui keys:"
      if [ "$(ui_opt ADE_UI_ARROWS)" = on ]; then echo "$UI_KEYS"; else echo "${UI_KEYS/prefix 0-9, Left, Right   /prefix 0-9   }"; fi
      [ -t 0 ] && read -r _; return 0 ;;
    --tickets) hub="$(find_hub)" || exit $?; d="$(mk_tmp)" || die 1 "could not make a temp folder"; ui_data "$hub" "$d"
      ui_render dash "$d" | awk '/^TICKETS/ { on = 1 } /^EVENTS/ { on = 0 } on'; rm_tmp "$d"; [ -t 0 ] && read -r _; return 0 ;;
    --session) hub="$(find_hub)" || exit $?; ui_session "$hub"; return 0 ;;
    --place) echo "Your main agent is running in another terminal. This tab is its place:"   # tab 0, made by ade work
      echo "close it there, then press Enter here to start it in this tab."
      read -r _ || true; cmd_claude; return ;;
    --detach) detach=1 ;;
    "") ;;
    *) die 2 "usage: ade ui [--detach]" ;;
  esac
  need_tmux; need_tmux_32; hub="$(find_hub)" || exit $?; s="$(ui_session "$hub")"
  sq "$hub" > /dev/null; sq "$(ade_self)" > /dev/null   # checked here: inside $(...) a refusal would only end a subshell
  ui_ensure "$hub" "$s"; ui_ide_hint
  [ "$detach" = 1 ] && { echo "ade ui: session $s (attach with: ade ui)"; return 0; }
  TMUX=""; export TMUX; exec tmux -L "$ADE_TMUX_SOCKET" attach-session -t "=$s"
}

dash_reexec() {   # a running ade dash re-execs itself once ade update renamed a new version into place
  local self v; [ -n "$ADE_VERSION" ] || return 0; self="$(ade_self)"
  v="$(sed -n 's/^ADE_VERSION="\([^"]*\)".*/\1/p' "$self" 2> /dev/null | head -1)"
  [ -n "$v" ] && [ "$v" != "$ADE_VERSION" ] || return 0
  echo "ade dash: ade $v is installed; restarting"; rm_tmp "$DASH_DIR"; exec "$self" dash
}
cmd_dash() {
  local hub d once=0; [ "${1:-}" = --once ] && once=1
  [ $# -eq 0 ] || [ "$once" = 1 ] || die 2 "usage: ade dash [--once]"
  hub="$(find_hub)" || exit $?; DASH_DIR="$(mk_tmp)" || die 1 "could not make a temp folder"; d="$DASH_DIR"; trap 'rm_tmp "$DASH_DIR"' EXIT
  while :; do
    ui_data "$hub" "$d"
    if [ "$once" = 1 ]; then ui_render dash "$d"; return 0; fi
    printf '\033[H\033[2J'; ui_render dash "$d"; sleep 2
    dash_reexec
  done
}

# ade clean, ade reset, ade uninstall (story A9). None of them deletes a user's file: clean removes only ade's and the
# hub's own markers, temp folders and dead tmux sessions, and clean merged worktrees (git worktree remove); reset
# --hub moves the hub to the Trash. Contract: .ade/context/hub-interface.md.
CLEAN_USAGE="usage: ade clean [--yes]"
ADE_TRASH_CLI="${ADE_TRASH_CLI:-trash}"   # macOS: the trash command used when installed, else Finder
SERVICE_JOBS="chat monitor"
KEY_TOOLS="anthropic deepseek glm muse gemini telegram"
REINSTALL="curl -fsSL https://raw.githubusercontent.com/better-ade/ade-cli/main/install.sh | bash"
MOVED_LOG="$HOME/.local/share/ade/moved-hubs"   # path<TAB>where<TAB>UTC time of each hub reset --hub moved
TAB="$(printf '\t')"

# shq <text>: single-quoted for a shell line the user may copy
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
# confirm <question>: yes or no (Enter, or no answer, is no); ade clean and ade restore, at a terminal
confirm() { local ASK_EOF=no; ask_yn "$1" n; }
# reset and uninstall ask a person at a terminal: answers come from /dev/tty, never a pipe or an agent session
agent_context() { [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CLAUDE_CODE_SESSION_ID:-}${CLAUDE_PID:-}${CLAUDE_CODE_CHILD_SESSION:-}${CLAUDE_CODE_EXECPATH:-}" ]; }
tty_ready() {
  agent_context && die 2 "ade $1 asks a person at a terminal; it refuses inside a Claude Code session (an agent cannot answer for you); nothing changed"
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || die 2 "ade $1 asks a person at a terminal; it refuses piped or missing answers; nothing changed"
}
tty_ask() { local ASK_TTY=1 ASK_EOF=no ASK_EMPTY_OK=1; ask_text "$1" || ANSWER=""; }   # a name typed back; Enter or no answer is ""
tty_confirm() { local ASK_TTY=1 ASK_EOF=no; ask_yn "$1" n; }
# known_hubs [extra]: every hub ade knows here, once each (physical paths): the current one, the default, the hub
# list, the orchestrators' hubs and the extra one
known_hubs() {
  local h
  { (find_hub) 2> /dev/null; echo; default_hub; echo; [ -f "$CONF_DIR/hubs" ] && cat "$CONF_DIR/hubs"
    [ -f "$ORCH" ] && awk -F '\t' '{ print $2 }' "$ORCH"; [ -n "${1:-}" ] && echo "$1"; } |
    while IFS= read -r h; do is_hub "$h" && (cd "$h" && pwd -P); done | awk 'NF && !seen[$0]++'
}
# journal_line <hub> <text>: one entry in the hub's journal (bin/journal ade <text>); a hub without one is skipped
journal_line() { [ -x "$1/bin/journal" ] || return 0; ( HUB="$1"; export HUB; "$1/bin/journal" ade "$2" ) > /dev/null 2>&1 < /dev/null || true; }
hub_state() { echo "${AGENT_STATE:-$HOME/.agent-hub/$(hub_label "$1")}"; }
HUB_LOCKS="sync.lock dispatch.lock chat/lock"   # under the hub's state folder; each holds its owner's pid
lock_pid_live() { local p=""; [ -f "$1/pid" ] && { IFS= read -r p < "$1/pid" || [ -n "$p" ]; }; matches "$p" '^[0-9]+$' && ps -p "$p" > /dev/null 2>&1; }

# --- ade clean ---
C_KIND=(); C_PATH=(); C_DESC=(); C_EXTRA=()
clean_add() { C_KIND+=("$1"); C_PATH+=("$2"); C_DESC+=("$3"); C_EXTRA+=("${4:-}"); }
lock_stale() {   # <lock dir>: 0 when its owner is gone (a pid that names no process; no pid and over 2 minutes old)
  local p=""; [ -f "$1/pid" ] && { IFS= read -r p < "$1/pid" || [ -n "$p" ]; }
  if matches "$p" '^[0-9]+$'; then ! ps -p "$p" > /dev/null 2>&1; return; fi
  [ -n "$(find "$1" -maxdepth 0 -mmin +2 2> /dev/null)" ]
}
# access_rows <ACCESS.md>: "<checkout>\t<branch>" for each row of the hub's Repo | Checkout | Branch table
access_rows() {
  awk -F '|' 'function t(s) { gsub(/^[ \t`]+|[ \t`]+$/, "", s); return s }
    cc && $0 !~ /^[ \t]*\|/ { cc = 0; bc = 0; next }
    cc { c = t($cc); if (c == "" || c ~ /^:?-+:?$/) next; print c "\t" (bc ? t($bc) : ""); next }
    { for (i = 1; i <= NF; i++) { f = t($i); if (f == "Checkout") cc = i; if (f == "Branch") bc = i } }' "$1"
}
base_branch() {   # <checkout> [named]: the named branch when it exists, else origin's HEAD, else main or master
  local c="$1" b="${2:-}"
  if [ -n "$b" ] && git -C "$c" rev-parse -q --verify "refs/heads/$b" > /dev/null 2>&1; then echo "$b"; return; fi
  b="$(git -C "$c" symbolic-ref -q --short refs/remotes/origin/HEAD 2> /dev/null)"; b="${b#origin/}"
  for b in $b main master; do git -C "$c" rev-parse -q --verify "refs/heads/$b" > /dev/null 2>&1 && { echo "$b"; return; }; done
}
pane_in() {   # <folder>: 0 when a live tmux pane (ade's server or the default one) has its working folder in it
  local p; while IFS= read -r p; do case "$p/" in "$1"/*) return 0 ;; esac; done <<EOF
$PANE_CWDS
EOF
  return 1
}
wt_consider() {   # a worktree block of <checkout>: removable only when every condition holds (see the design note)
  local st tip lb rb
  [ -n "$WT" ] && [ "$WT_FIRST" = 0 ] && [ -n "$WT_BR" ] && [ "$WT_LOCK" = 0 ] && [ -d "$WT" ] && [ "$WT_BR" != "$WT_BASE" ] || return 0
  tip="$(git -C "$WT_C" rev-parse -q --verify "refs/heads/$WT_BR" 2> /dev/null)" || return 0
  lb="$(git -C "$WT_C" rev-parse -q --verify "refs/heads/$WT_BASE" 2> /dev/null)"; rb="$(git -C "$WT_C" rev-parse -q --verify "refs/remotes/origin/$WT_BASE" 2> /dev/null)"
  [ "$tip" != "$lb" ] && [ "$tip" != "$rb" ] || return 0   # a branch with no commits of its own is not "merged":
  git -C "$WT_C" rev-list --first-parent "$lb" 2> /dev/null | grep -qxF -- "$tip" && return 0   # nor one the base only passed
  git -C "$WT_C" merge-base --is-ancestor "$tip" "$lb" 2> /dev/null || { [ -n "$rb" ] && git -C "$WT_C" merge-base --is-ancestor "$tip" "$rb" 2> /dev/null; } || return 0
  st="$(git -C "$WT" status --porcelain --ignored 2> /dev/null)" && [ -z "$st" ] || return 0   # ignored files (.env) count
  pane_in "$WT" && return 0
  clean_add worktree "$WT" "merged worktree $WT (branch $WT_BR is in $WT_BASE; no changes, no ignored files; the branch stays)" "$WT_C"
}
clean_worktrees() {   # <checkout> <named base branch>
  local line; WT_C="$1"; WT=""; WT_FIRST=1; WT_BR=""; WT_LOCK=0
  git -C "$WT_C" rev-parse --git-dir > /dev/null 2>&1 || return 0
  WT_BASE="$(base_branch "$WT_C" "$2")"; [ -n "$WT_BASE" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) [ -n "$WT" ] && { wt_consider; WT_FIRST=0; }; WT="${line#worktree }"; WT_BR=""; WT_LOCK=0 ;;
      "branch refs/heads/"*) WT_BR="${line#branch refs/heads/}" ;;
      locked*|prunable*) WT_LOCK=1 ;;
    esac
  done <<EOF
$(git -C "$WT_C" worktree list --porcelain 2> /dev/null)
EOF
  wt_consider
}
temp_old() { [ -z "$(find "$1" -mmin -1440 2> /dev/null | head -1)" ]; }   # nothing in it changed for a day
clean_scan() {
  C_KIND=(); C_PATH=(); C_DESC=(); C_EXTRA=(); CLEAN_HUBS="$(known_hubs)"
  local h s l f c b states="" sess panes
  PANE_CWDS=""; command -v tmux > /dev/null 2>&1 && PANE_CWDS="$( { tmux list-panes -a -F '#{pane_current_path}'; ui_tmux list-panes -a -F '#{pane_current_path}'; } 2> /dev/null < /dev/null)"
  while IFS= read -r h <&3; do
    [ -n "$h" ] || continue
    s="$(hub_state "$h")"
    case "$states" in *"|$s|"*) ;; *) states="$states|$s|"
      for l in $HUB_LOCKS; do [ -d "$s/$l" ] && [ ! -e "$s/$l.gc" ] && lock_stale "$s/$l" && clean_add lock "$s/$l" "stale lock $s/$l (its owner is gone)"; done
      [ -d "$s/dispatch" ] && while IFS= read -r -d '' f; do clean_add file "$f" "dispatch start marker $f (over 2 minutes old)"; done < <(find "$s/dispatch" -mindepth 1 -maxdepth 1 -type f -mmin +2 -print0 2> /dev/null)
      [ -d "$s/events-seen" ] && while IFS= read -r -d '' f; do clean_add file "$f" "event cursor $f (unused for 7 days)"; done < <(find "$s/events-seen" -mindepth 1 -maxdepth 1 -type f -mmin +10080 -print0 2> /dev/null) ;;
    esac
    for f in "$h"/projects/*/ACCESS.md; do
      [ -f "$f" ] || continue
      while IFS="$TAB" read -r c b <&4; do
        # shellcheck disable=SC2088  # a literal ~ in ACCESS.md is expanded here on purpose
        case "$c" in "~/"*) c="$HOME/${c#\~/}" ;; esac
        [ -d "$c" ] && clean_worktrees "$c" "$b" < /dev/null
      done 4<<EOF
$(access_rows "$f")
EOF
    done
  done 3<<EOF
$CLEAN_HUBS
EOF
  while IFS= read -r -d '' f; do temp_old "$f" && clean_add temp "$f" "temp folder $f (made by ade, nothing in it changed for a day)"
  done < <(find "$TMP_ROOT" -mindepth 1 -maxdepth 1 -type d -name 'ade.?*' -user "$(id -u)" -mmin +1440 -print0 2> /dev/null)
  command -v tmux > /dev/null 2>&1 || return 0
  while IFS= read -r sess <&3; do
    case "$sess" in ade-?*) ;; *) continue ;; esac
    panes="$(ui_tmux list-panes -s -t "=$sess" -F '#{pane_dead}' 2> /dev/null < /dev/null)"
    [ -n "$panes" ] && ! printf '%s\n' "$panes" | grep -qvx 1 && clean_add tmux "$sess" "tmux session $sess (no live agent)"
  done 3<<EOF
$(ui_tmux list-sessions -F '#{session_name}' 2> /dev/null < /dev/null)
EOF
}
clean_do() {   # <index>: one planned item; 0 = done
  local k="${C_KIND[$1]}" p="${C_PATH[$1]}" rc
  case "$k" in
    lock) mkdir "$p.gc" 2> /dev/null || return 1   # the hub's guard: one checker at a time, around check and removal
      rc=1; if lock_stale "$p"; then rm -f -- "$p/pid" "$p/start"; rmdir -- "$p" 2> /dev/null && rc=0; fi
      rmdir -- "$p.gc" 2> /dev/null; return $rc ;;
    file) rm -f -- "$p" ;;
    temp) temp_old "$p" || return 1; rm_tmp "$p"; [ ! -e "$p" ] ;;
    tmux) ui_tmux kill-session -t "=$p" < /dev/null ;;
    worktree) git -C "${C_EXTRA[$1]}" worktree remove "$p" > /dev/null 2>&1 < /dev/null ;;
  esac
}
cmd_clean() {
  local yes=0 n i done=0 kept=0 h
  while [ $# -gt 0 ]; do case "$1" in --yes|-y) yes=1; shift ;; *) die 2 "$CLEAN_USAGE" ;; esac; done
  clean_scan; n=${#C_KIND[@]}
  [ "$n" -gt 0 ] || { echo "nothing to clean"; return 0; }
  echo "ade clean:"; i=0; while [ "$i" -lt "$n" ]; do echo "  - ${C_DESC[$i]}"; i=$((i + 1)); done
  echo "It never touches your files, uncommitted or ignored work, unmerged branches or a live agent."
  if [ "$yes" = 0 ]; then
    if [ -t 0 ]; then confirm "Clean these?" || { echo "nothing changed"; return 1; }
    else echo "nothing changed; run ade clean --yes to do it"; return 0; fi
  fi
  i=0; while [ "$i" -lt "$n" ]; do
    if clean_do "$i"; then done=$((done + 1)); else kept=$((kept + 1)); echo "kept ${C_PATH[$i]} (it changed since the check)"; fi
    i=$((i + 1)); done
  echo "cleaned $done item(s)${kept:+; $kept kept}" | sed 's/; 0 kept$//'
  [ "$done" -gt 0 ] || return 0
  while IFS= read -r h; do [ -n "$h" ] && journal_line "$h" "ade clean: removed $done item(s) (stale locks, old markers and cursors, temp folders, dead tmux sessions, merged worktrees)"; done <<EOF
$CLEAN_HUBS
EOF
  return 0
}

# --- ade reset and ade uninstall ---
has_ade_plugin() {   # <settings.json>: 0 when enabledPlugins has ade@ade-skills
  [ -f "$1" ] && python3 -c 'import json, sys
try: d = json.load(open(sys.argv[1]))
except Exception: sys.exit(1)
e = d.get("enabledPlugins") if isinstance(d, dict) else None
sys.exit(0 if isinstance(e, dict) and "ade@ade-skills" in e else 1)' "$1" 2> /dev/null
}
drop_ade_plugin() {   # <settings.json>: removes only enabledPlugins["ade@ade-skills"]; every other key is kept
  write_py "$1" <<'PY'
import json, os, sys
p = sys.argv[1]; ade_hold(p); d = json.load(open(p)); d["enabledPlugins"].pop("ade@ade-skills", None)
ade_write(p, json.dumps(d, indent=2) + "\n")
PY
}
service_files() {   # <hub>: the chat and monitor service files of this hub (launchd plists and systemd user units)
  local n j f la="${AGENT_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}" sd="$HOME/.config/systemd/user"; n="$(hub_label "$1")"
  for j in $SERVICE_JOBS; do for f in "$la/ai.agent-hub.$n.$j.plist" "$sd/ai.agent-hub.$n.$j.service"; do [ -f "$f" ] && echo "$f"; done; done
}
remove_service() {   # <file>: unload it (launchctl bootout / systemctl --user disable --now), then remove the file
  local b; b="$(basename "$1")"
  case "$1" in
    *.plist) command -v launchctl > /dev/null 2>&1 && launchctl bootout "gui/$(id -u)/${b%.plist}" > /dev/null 2>&1 ;;
    *.service) command -v systemctl > /dev/null 2>&1 && systemctl --user disable --now "$b" > /dev/null 2>&1 ;;
  esac
  rm -f -- "$1"
}
key_records() {   # the keys ade setup stored, "<hub>\t<tool>" lines (names only), for hubs and tools ade knows
  local h t; [ -f "$CONF_DIR/keys-set" ] || return 0
  while IFS="$TAB" read -r h t; do
    case " $KEY_TOOLS " in *" $t "*) is_hub "$h" && printf '%s\t%s\n' "$h" "$t" ;; esac
  done < "$CONF_DIR/keys-set" | awk 'NF && !seen[$0]++'
}
record_key() {   # <hub> <tool>: notes (names only, never a value) that ade setup stored this key, for ade reset --keys
  local line; line="$(printf '%s\t%s' "$1" "$2")"
  { [ -f "$CONF_DIR/keys-set" ] && grep -vxF -- "$line" "$CONF_DIR/keys-set"; echo "$line"; } | write_conf_file keys-set
}
dev_of() {   # <path>: the device of the path, or of its nearest existing parent
  local p="$1"; while [ ! -e "$p" ] && [ "$p" != / ]; do p="$(dirname "$p")"; done
  python3 -c 'import os, sys; print(os.stat(sys.argv[1]).st_dev)' "$p"
}
TRASH_ROOT="$HOME/.local/share/ade/trash"
on_macos() { [ "$(uname 2> /dev/null)" = Darwin ]; }

# hub_trash_check <hub>: refuses (exit 2) a hub whose work is not safe elsewhere, or that is in use; nothing has changed
hub_trash_check() {
  local h="$1" home st s l x n
  home="$(cd "$HOME" 2> /dev/null && pwd -P)" || die 2 "cannot resolve the home folder; nothing changed"
  case "$h" in /|"$home") die 2 "ade never moves $h; nothing changed" ;; esac
  case "$home/.config/ade/" in "$h"/*) die 2 "$h holds your home or ade's config; ade never moves it; nothing changed" ;; esac
  [ "$(git -C "$h" rev-parse --show-toplevel 2> /dev/null)" = "$h" ] ||
    die 2 "$h is not a git repository of its own, so ade cannot tell whether its work is saved; nothing changed"
  st="$(git -C "$h" status --porcelain --ignored 2> /dev/null)" || die 2 "git status failed in $h; nothing changed"
  [ -z "$st" ] || die 2 "$h has uncommitted or ignored files (git status --ignored: $(printf '%s\n' "$st" | head -3 | cut -c4- | tr '\n' ' ')); a moved hub keeps only what git has elsewhere; nothing changed"
  [ -z "$(git -C "$h" stash list 2> /dev/null)" ] || die 2 "$h has stashed changes (git stash list); nothing changed"
  n="$(git -C "$h" worktree list --porcelain 2> /dev/null | grep -c '^worktree ')"
  [ "$n" -le 1 ] || die 2 "$h has $((n - 1)) linked worktree(s) (git worktree list); remove them first; nothing changed"
  x="$(find "$h" -mindepth 2 -path "$h/.git" -prune -o -name .git -print 2> /dev/null | head -1)"
  [ -z "$x" ] || die 2 "$h holds another repository ($x); ade cannot check it; nothing changed"
  [ -n "$(git -C "$h" remote 2> /dev/null)" ] || die 2 "$h is not pushed anywhere (no remote); push it first; nothing changed"
  [ -z "$(git -C "$h" log HEAD --branches --tags --not --remotes --oneline 2> /dev/null | head -1)" ] ||
    die 2 "$h has commits not pushed (git log HEAD --branches --tags --not --remotes); push them first; nothing changed"
  ui_live "$h" > /dev/null && die 2 "$h has a live ade ui session; close it first; nothing changed"
  [ -z "$(hub_run "$h" sessions 2> /dev/null < /dev/null | awk 'NR > 1 && /(^|[ \t])(busy|idle|blocked)([ \t]|$)/')" ] ||
    die 2 "$h has a live agent (bin/sessions); stop it first; nothing changed"
  s="$(hub_state "$h")"; for l in $HUB_LOCKS; do lock_pid_live "$s/$l" && die 2 "$h is in use: $s/$l has a live owner; nothing changed"; done
  if ! on_macos && [ "$(dev_of "$(dirname "$h")")" != "$(dev_of "$TRASH_ROOT")" ]; then
    die 2 "$h is on another filesystem than ade's trash ($TRASH_ROOT); ade moves only by rename; move it yourself; nothing changed"; fi
  return 0
}
# to_trash <folder>: moves it to the Trash (never deletes): macOS the trash command or Finder; elsewhere a rename into
# ~/.local/share/ade/trash/<name>-<UTC time>/. Prints where it went and how to restore it. 0 moved, 1 still there,
# 3 partly moved.
TRASHED=""
to_trash() {
  local p="$1" base dest clash=0; base="$(basename "$p")"
  if on_macos; then
    dest="$HOME/.Trash/$base"; [ -e "$dest" ] && clash=1
    if command -v "$ADE_TRASH_CLI" > /dev/null 2>&1; then "$ADE_TRASH_CLI" "$p" > /dev/null 2>&1 < /dev/null
    else osascript -e 'on run argv' -e 'tell application "Finder" to delete (POSIX file (item 1 of argv) as alias)' -e 'end run' "$p" > /dev/null 2>&1 < /dev/null; fi
    [ ! -e "$p" ] || { echo "could not move $p to the Trash; it is still at $p"; return 1; }
    TRASHED="the Trash"
    if [ "$clash" = 1 ]; then echo "moved $p to the Trash (another $base was already there, so the Trash renamed it)"
    else echo "moved $p to the Trash: $dest"; TRASHED="$dest"; fi
    echo "  to restore: in Finder, open the Trash, select $base and choose File > Put Back"
    [ "$clash" = 0 ] && [ -e "$dest" ] && echo "  or: mv $(shq "$dest") $(shq "$p")"
    return 0
  fi
  dest="$TRASH_ROOT/$base-$(date -u +%Y%m%dT%H%M%SZ)"
  ( umask 077; mkdir -p "$TRASH_ROOT" ) 2> /dev/null || { echo "cannot make $TRASH_ROOT; $p is still at $p"; return 1; }
  [ ! -e "$dest" ] || { echo "$dest already exists; $p is still at $p (run it again in a second)"; return 1; }
  mv -- "$p" "$dest" 2> /dev/null
  if [ ! -e "$p" ] && [ -d "$dest" ]; then
    TRASHED="$dest"; echo "moved $p to ade's trash: $dest (nothing was deleted)"; echo "  to restore: mv $(shq "$dest") $(shq "$p")"; return 0; fi
  if [ ! -e "$dest" ]; then echo "could not move $p to $dest; it is still at $p"; return 1; fi
  echo "moved only part of $p: some of it is in $dest, the rest is still at $p; nothing was deleted (move the rest by hand)"; return 3
}

# installed_self: the installed ade file ade uninstall removes; a checkout (no stamped version) is refused
installed_self() {
  local p; p="$(ade_self)"
  [ -n "$ADE_VERSION" ] || die 2 "this ade runs from a checkout ($(dirname "$p")); a checkout is never removed (delete it yourself)"
  [ -f "$p" ] || die 1 "cannot find the installed ade ($p)"
  printf '%s' "$p"
}

cmd_reset() {   # cmd_reset reset|uninstall [--keys] [--hub <path>]
  local mode="$1" keys=0 hubp="" self="" label="" usage h n f st since conf=0 i rc=0 stopfail=0
  shift; usage="usage: ade $mode [--keys] [--hub <path>]"
  while [ $# -gt 0 ]; do case "$1" in
    --keys) keys=1; shift ;;
    --hub) [ $# -ge 2 ] && [ -n "$2" ] || die 2 "--hub needs a path"; hubp="$2"; shift 2 ;;
    *) die 2 "$usage" ;;
  esac; done
  [ "$mode" = uninstall ] && { self="$(installed_self)" || exit $?; }
  if [ -n "$hubp" ]; then
    if [ ! -e "$hubp" ] && [ -f "$MOVED_LOG" ] && f="$(awk -F '\t' -v p="$hubp" '$1 == p { w = $2 } END { print w }' "$MOVED_LOG")" && [ -n "$f" ]; then
      echo "nothing to do for $hubp: ade reset already moved it to $f"; hubp=""
    else
      is_hub "$hubp" || die 2 "$hubp is not a hub (no bin/lib.sh and hub.conf)"
      hubp="$(cd "$hubp" && pwd -P)" || die 2 "cannot enter $hubp"; hub_trash_check "$hubp"; label="$(hub_label "$hubp")"
    fi
  fi
  # the plan
  local hubs orch="" svcs="" sets="" krecs="" plan=""
  hubs="$(known_hubs "$hubp")"
  if [ -f "$ORCH" ]; then while IFS="$TAB" read -r n h; do
    [ -n "$n" ] || continue; read -r st since <<EOF
$(orch_state "$h" < /dev/null)
EOF
    [ "$st" = running ] && orch="$orch$n$TAB$h
"; done < "$ORCH"; fi
  while IFS= read -r h; do [ -n "$h" ] || continue
    svcs="$svcs$(service_files "$h")
"; has_ade_plugin "$h/.claude/settings.json" && sets="$sets$h/.claude/settings.json
"; done <<EOF
$hubs
EOF
  svcs="$(printf '%s' "$svcs" | grep -v '^$')"; sets="$(printf '%s' "$sets" | grep -v '^$')"; orch="$(printf '%s' "$orch" | grep -v '^$')"
  [ "$keys" = 1 ] && krecs="$(key_records)"
  [ -d "$CONF_DIR" ] && conf=1
  while IFS="$TAB" read -r n h; do [ -n "$n" ] && plan="$plan  - stop orchestrator $n (hub $h)
"; done <<EOF
$orch
EOF
  while IFS= read -r f; do [ -n "$f" ] && plan="$plan  - remove the service $f
"; done <<EOF
$svcs
EOF
  while IFS= read -r f; do [ -n "$f" ] && plan="$plan  - remove the ade@ade-skills plugin entry from $f
"; done <<EOF
$sets
EOF
  [ -n "$krecs" ] && plan="$plan  - ask, one key at a time, to forget the keys ade setup stored: $(printf '%s\n' "$krecs" | awk -F '\t' '{ printf "%s%s", (NR > 1 ? ", " : ""), $2 }')
"
  [ -n "$hubp" ] && plan="$plan  - run the hub's bin/schedule uninstall (all its jobs), then move the hub $hubp to the Trash (after you type its name, $label); it is never deleted
"
  [ "$conf" = 1 ] && plan="$plan  - remove $CONF_DIR (the default hub, the hub list, the orchestrator registry; names only)
"
  [ -n "$self" ] && plan="$plan  - remove ade itself ($self)
"
  [ -n "$plan" ] || { echo "nothing to reset"; return 0; }
  echo "ade $mode will:"; printf '%s' "$plan"
  echo "It keeps your hubs${hubp:+ (but this one, moved to the Trash)}, projects, keys${krecs:+ you do not forget} and Claude Code."
  tty_ready "$mode"
  tty_confirm "Go ahead?" || { echo "nothing changed"; return 1; }
  if [ -n "$hubp" ]; then
    tty_ask "Type the hub name ($label) to move $hubp to the Trash:"
    [ "$ANSWER" = "$label" ] || die 1 "the name did not match; nothing changed"
  fi
  # the work: orchestrators, services, settings, keys, the hub, then ade's own config and binary; the journal says
  # only what happened (never written into the hub that moves, so a restored hub is as clean as it was)
  local did=""
  while IFS="$TAB" read -r n h; do [ -n "$n" ] || continue
    if chat "$h" stop < /dev/null; then echo "stopped orchestrator $n"; else echo "could not stop orchestrator $n (its hub's bin/chat stop failed)"; stopfail=1; fi
  done <<EOF
$orch
EOF
  [ -n "$orch" ] && [ "$stopfail" = 0 ] && did="${did}orchestrators stopped, "
  while IFS= read -r f; do [ -n "$f" ] || continue; remove_service "$f"; echo "removed the service $f"; done <<EOF
$svcs
EOF
  if printf '%s\n' "$svcs" | grep -q '\.service$' && command -v systemctl > /dev/null 2>&1; then systemctl --user daemon-reload > /dev/null 2>&1; fi
  [ -n "$svcs" ] && did="${did}services removed, "
  while IFS= read -r f; do [ -n "$f" ] || continue
    if drop_ade_plugin "$f"; then echo "removed the ade@ade-skills entry from $f"; else echo "could not change $f; left as it was"; fi
  done <<EOF
$sets
EOF
  [ -n "$sets" ] && did="${did}ade plugin entry removed, "
  i=0
  while IFS="$TAB" read -r h n <&3; do [ -n "$h" ] || continue
    if tty_confirm "Forget the $n key in $h?"; then
      if hub_run "$h" keys forget "$n" < /dev/null; then echo "forgot the $n key"; i=$((i + 1)); else echo "bin/keys could not forget the $n key; it is kept"; fi
    else echo "kept the $n key"; fi
  done 3<<EOF
$krecs
EOF
  [ "$i" -gt 0 ] && did="${did}$i key(s) forgotten, "
  if [ -n "$hubp" ]; then
    if [ "$stopfail" = 1 ]; then echo "kept $hubp where it is: an orchestrator did not stop"; did="${did}hub $hubp kept (an orchestrator did not stop), "; rc=1
    else
      while IFS= read -r h; do [ -n "$h" ] && [ "$h" != "$hubp" ] && journal_line "$h" "ade $mode: moving the hub $hubp to the Trash"; done <<EOF
$hubs
EOF
      [ -x "$hubp/bin/schedule" ] && { hub_run "$hubp" schedule uninstall < /dev/null > /dev/null 2>&1 || echo "the hub's bin/schedule uninstall failed; its jobs may still be loaded"; }
      to_trash "$hubp"; case $? in
        0) did="${did}hub $hubp moved to $TRASHED, "
          ( umask 077; mkdir -p "$(dirname "$MOVED_LOG")" && printf '%s\t%s\t%s\n' "$hubp" "$TRASHED" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$MOVED_LOG" ) 2> /dev/null ;;
        3) did="${did}moving the hub $hubp to the Trash FAILED part way (see its two places), "; rc=1 ;;
        *) did="${did}moving the hub $hubp to the Trash FAILED (it is still there), "; rc=1 ;;
      esac
    fi
  fi
  if [ "$conf" = 1 ]; then
    if [ "$rc" != 0 ] || [ "$stopfail" = 1 ]; then echo "kept $CONF_DIR (a step above failed; fix it, then run ade $mode again)"; rc=1
    else case "$CONF_DIR" in "$HOME"/.config/ade) rm -rf -- "$CONF_DIR" && { echo "removed $CONF_DIR"; did="${did}~/.config/ade removed, "; } ;; esac; fi
  fi
  if [ -n "$self" ] && [ "$rc" = 0 ]; then
    if rm -f -- "$self"; then did="${did}ade uninstalled, "; else echo "could not remove $self"; rc=1; fi
  fi
  did="${did%, }"
  while IFS= read -r h; do [ -n "$h" ] && [ "$h" != "$hubp" ] && [ -d "$h" ] && journal_line "$h" "ade $mode: ${did:-nothing changed}"; done <<EOF
$hubs
EOF
  [ -n "$self" ] && [ "$rc" = 0 ] && echo "ade is removed. To install it again: $REINSTALL"
  [ -n "$self" ] && [ "$rc" != 0 ] && echo "ade is still installed (a step above failed)"
  return $rc
}

# connections (story A10): <folder>/.ade/connections.json names what the work depends on, never a secret, an email or
# an account id; ade restore compares it with this machine and walks each gap (.ade/context/hub-interface.md). The
# record comes from a cloned repo: it is data, checked value by value where it is read, and rejected whole on any
# failure (nothing in a rejected record is used)
US="$(printf '\037')"   # the field separator of conn_py get and conn_state (never in a checked value)
conn_py() {   # conn_py <record file> <op> [args]: get prints US-separated lines; the other ops update the record
  CONN_BUILTIN="$ADE_SKILLS_REPO" write_py "$@" <<'PY'
import json, os, re, sys
p, op, a = sys.argv[1], sys.argv[2], sys.argv[3:]
if op != "get": ade_hold(p)   # read, check and write under one lock: two runs never lose an entry
NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}")
REF = re.compile(r"v[0-9]{1,9}\.[0-9]{1,9}\.[0-9]{1,9}")
GH = re.compile(r"https://github\.com/([A-Za-z0-9_.-]{1,100})/([A-Za-z0-9_.-]{1,100})")
SHORT = re.compile(r"([A-Za-z0-9_.-]{1,100})/([A-Za-z0-9_.-]{1,100})")
LABEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9 ._-]{0,39}")
FP = re.compile(r"[0-9a-f]{16}")
BOT = re.compile(r"@[A-Za-z0-9_]{1,64}")
MODEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:\[\]-]{0,63}")
SIGN_IN, SERVICES, PINS = ("account", "key"), ("chat", "monitor", "sync"), ("ade-method", "ade-agent-registry", "ade-skills")
MAX_LIST, MAX_BYTES = 64, 65536
safe = lambda s: re.sub(r"[^\x20-\x7e]", "?", s)[:200]   # a path in a message: no control character reaches the terminal
class Bad(Exception):
    pass
def gh(repo):   # owner/repo of a GitHub repo (lower case, no .git), else None
    m = GH.fullmatch(repo) or SHORT.fullmatch(repo)
    if not m or any(x in (".", "..") for x in m.groups()):
        return None
    o, r = m.group(1).lower(), m.group(2).lower()
    r = r[:-4] if r.endswith(".git") else r
    return "%s/%s" % (o, r) if r else None
def text(v, rx, what):
    if not isinstance(v, str) or len(v) > 200 or not rx.fullmatch(v):
        raise Bad("%s is not valid" % what)
    return v
def items(v, what):
    if not isinstance(v, list) or len(v) > MAX_LIST:
        raise Bad("%s is not a list of at most %d" % (what, MAX_LIST))
    return v
def obj(v, what, need, may=()):
    if not isinstance(v, dict):
        raise Bad("%s is not an object" % what)
    if set(v) - set(need) - set(may):
        raise Bad("%s has a key ade does not know" % what)
    if set(need) - set(v):
        raise Bad("%s lacks %s" % (what, ", ".join(sorted(set(need) - set(v)))))
    return v
def unique(v, what):
    if len(set(v)) != len(v):
        raise Bad("%s names one thing twice" % what)
def check(d):
    obj(d, "the record", ("format",), ("account", "top", "focus", "channels", "marketplaces", "plugins", "specialists", "pins", "services"))
    if type(d["format"]) is not int or d["format"] != 1:
        raise Bad("format is not 1")
    if "account" in d:
        acc = obj(d["account"], "account", ("label", "fingerprint"))
        text(acc["label"], LABEL, "account.label"); text(acc["fingerprint"], FP, "account.fingerprint")
    if "top" in d:
        t = obj(d["top"], "top", ("provider", "sign_in"), ("model",))
        text(t["provider"], NAME, "top.provider")
        if t["sign_in"] not in SIGN_IN: raise Bad("top.sign_in is not account or key")
        if "model" in t: text(t["model"], MODEL, "top.model")
    for i, f in enumerate(items(d.get("focus", []), "focus")):
        obj(f, "focus[%d]" % i, ("provider", "sign_in")); text(f["provider"], NAME, "focus[%d].provider" % i)
        if f["sign_in"] not in SIGN_IN: raise Bad("focus[%d].sign_in is not account or key" % i)
    unique([f["provider"] for f in d.get("focus", [])], "focus")
    for i, c in enumerate(items(d.get("channels", []), "channels")):
        obj(c, "channels[%d]" % i, ("type",), ("bot",)); text(c["type"], NAME, "channels[%d].type" % i)
        if c.get("bot", "") != "": text(c["bot"], BOT, "channels[%d].bot" % i)
    unique([c["type"] for c in d.get("channels", [])], "channels")
    builtin = gh(os.environ.get("CONN_BUILTIN", "")) or os.environ.get("CONN_BUILTIN", "")
    names = ["ade-skills"]
    for i, m in enumerate(items(d.get("marketplaces", []), "marketplaces")):
        obj(m, "marketplaces[%d]" % i, ("name", "repo")); n = text(m["name"], NAME, "marketplaces[%d].name" % i)
        if not isinstance(m["repo"], str) or len(m["repo"]) > 200: raise Bad("marketplaces[%d].repo is not valid" % i)
        if m["repo"] == "local":
            if n != "ade-skills": raise Bad("marketplaces[%d].repo is local, which only the built-in ade-skills can be" % i)
        elif gh(m["repo"]) is None:
            raise Bad("marketplaces[%d].repo is not https://github.com/<owner>/<repo> or <owner>/<repo>" % i)
        elif n == "ade-skills" and gh(m["repo"]) != builtin:
            raise Bad("marketplaces[%d] binds the name ade-skills to another repo than the built-in ade-skills (ADE_SKILLS_REPO)" % i)
        names.append(n)
    unique([m["name"] for m in d.get("marketplaces", [])], "marketplaces")
    for i, g in enumerate(items(d.get("plugins", []), "plugins")):
        obj(g, "plugins[%d]" % i, ("name", "marketplace", "ref"))
        text(g["name"], NAME, "plugins[%d].name" % i); text(g["ref"], REF, "plugins[%d].ref" % i)
        if text(g["marketplace"], NAME, "plugins[%d].marketplace" % i) not in names:
            raise Bad("plugins[%d].marketplace is not in marketplaces" % i)
    unique(["%s@%s" % (g["name"], g["marketplace"]) for g in d.get("plugins", [])], "plugins")
    for i, s in enumerate(items(d.get("specialists", []), "specialists")):
        text(s, NAME, "specialists[%d]" % i)
    pins = d.get("pins", {})
    obj(pins, "pins", (), PINS)
    for k, v in pins.items():
        text(v, REF, "pins.%s" % k)
    for i, s in enumerate(items(d.get("services", []), "services")):
        if s not in SERVICES: raise Bad("services[%d] is not chat, monitor or sync" % i)
def pairs(kv):
    seen = {}
    for k, v in kv:
        if k in seen: raise Bad("a key appears twice in one object")
        seen[k] = v
    return seen
d = {"format": 1}
if os.path.exists(p):
    try:
        if os.path.getsize(p) > MAX_BYTES: raise Bad("the file is larger than %d bytes" % MAX_BYTES)
        with open(p) as fh:
            d = json.load(fh, object_pairs_hook=pairs)
        check(d)
    except (Bad, ValueError, OSError, RecursionError) as e:
        why = str(e) if isinstance(e, Bad) else "it is not valid JSON"
        sys.exit("ade: %s is not a valid connections record (%s); nothing in it is used: fix it, or remove it and run ade setup" % (safe(p), why))
elif op == "get":
    sys.exit(0)
if op == "get":
    out = lambda *f: print("\x1f".join((list(f) + ["", "", ""])[:4]))   # always four fields
    if "account" in d: out("account", d["account"]["label"], d["account"]["fingerprint"])
    if "top" in d: out("provider", d["top"]["provider"], d["top"]["sign_in"], "top")
    for f in d.get("focus", []): out("provider", f["provider"], f["sign_in"], "focus")
    for m in d.get("marketplaces", []): out("marketplace", m["name"], m["repo"])
    for g in d.get("plugins", []): out("plugin", g["name"], g["marketplace"], g["ref"])
    for c in d.get("channels", []): out("channel", c["type"], c.get("bot", ""))
    for s in d.get("services", []): out("service", s)
    sys.exit(0)
def put(lst, item, key):
    l = d.setdefault(lst, [])
    l[:] = [x for x in l if x.get(key) != item[key]] + [item]
if op == "account":
    old = d.get("account") or {}
    d["account"] = {"label": old.get("label") or a[1], "fingerprint": a[0]}
elif op == "label":
    if "account" not in d: sys.exit("ade: no account in %s yet; ade setup records it" % safe(p))
    d["account"]["label"] = a[0]
elif op == "top":
    d["top"] = {"provider": a[0], "sign_in": a[1]}
    if a[2]: d["top"]["model"] = a[2]
elif op == "focus":
    put("focus", {"provider": a[0], "sign_in": a[1]}, "provider")
elif op == "channel":
    put("channels", {"type": a[0], "bot": a[1]}, "type")
elif op == "marketplace":   # only a public GitHub repo is recorded; anything else (a path, a URL with a user) is local
    put("marketplaces", {"name": a[0], "repo": a[1] if GH.fullmatch(a[1]) and gh(a[1]) else "local"}, "name")
elif op == "plugin":
    put("plugins", {"name": a[0], "marketplace": a[1], "ref": a[2]}, "name")
    d.setdefault("pins", {})["ade-skills"] = a[2]
elif op == "specialist":
    s = d.setdefault("specialists", [])
    if a[0] not in s:
        s.append(a[0]); s.sort()
elif op == "pin":
    d.setdefault("pins", {})[a[0]] = a[1]
elif op == "services":
    d["services"] = sorted(set(a))
else:
    sys.exit("ade: unknown record operation %s" % op)
try:
    check(d)
except Bad as e:   # what this machine has does not fit the record (an override such as ADE_SKILLS_REF=main): not recorded
    sys.exit("ade: not recorded in %s: %s" % (safe(p), e))
ade_write(p, json.dumps(d, indent=2, sort_keys=True) + "\n")
PY
}
conn_record() { local f="$1/.ade/connections.json"; shift; conn_py "$f" "$@" > /dev/null || echo "ade: could not update $f" >&2; return 0; }
no_ctl() { LC_ALL=C tr -d '\000-\010\013-\037\177'; }   # printed text from a record, a manifest or a tool: no control characters
# hub_claude <hub> <args>: claude with the hub's Claude Code config folder (HUB_CLAUDE_CONFIG_DIR) when it has one
hub_claude() { local cfg; cfg="$(conf_get "$1" HUB_CLAUDE_CONFIG_DIR)"; shift
  if [ -n "$cfg" ]; then CLAUDE_CONFIG_DIR="$cfg" claude "$@"; else claude "$@"; fi; }
hub_claude_dir() { local cfg; cfg="$(conf_get "$1" HUB_CLAUDE_CONFIG_DIR)"; echo "${cfg:-${CLAUDE_CONFIG_DIR:-}}"; }
# account_fp [hub]: a one-way fingerprint of the signed-in Claude account (organisation and user id; never stored
# raw); empty when not signed in with an account
account_fp() {
  local dir="${CLAUDE_CONFIG_DIR:-}"
  [ -n "${1:-}" ] && dir="$(hub_claude_dir "$1")"
  python3 - "${dir:-$HOME}/.claude.json" <<'PY' 2> /dev/null
import hashlib, json, sys
try:
    a = json.load(open(sys.argv[1])).get("oauthAccount") or {}
except Exception:
    sys.exit(0)
if a.get("accountUuid") and a.get("organizationUuid"):
    print(hashlib.sha256(("ade-account-v1:%s:%s" % (a["organizationUuid"], a["accountUuid"])).encode()).hexdigest()[:16])
PY
}
record_account() {   # <hub>: the signed-in account's fingerprint, with a default label the user can change
  local f; f="$(account_fp "$1")"; [ -n "$f" ] || return 0
  conn_record "$1" account "$f" "account-${f:0:6}"
}
record_services() {   # <hub>: the hub's services found here (chat, monitor, sync); an empty scan keeps the old list
  local j list="" la="${AGENT_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}" n; n="$(hub_label "$1")"
  for j in chat monitor sync; do
    [ -f "$la/ai.agent-hub.$n.$j.plist" ] || [ -f "$HOME/.config/systemd/user/ai.agent-hub.$n.$j.service" ] && list="$list $j"; done
  [ -z "$list" ] || conn_record "$1" services $list
}
service_present() { local n; n="$(hub_label "$1")"; [ -f "${AGENT_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}/ai.agent-hub.$n.$2.plist" ] || [ -f "$HOME/.config/systemd/user/ai.agent-hub.$n.$2.service" ]; }
record_channel() {   # <hub> <type>: the bot's public name from the hub (bin/chat info <type>), never the token
  local bot; bot="$(hub_run "$1" chat info "$2" 2> /dev/null < /dev/null | awk '$1 == "bot" { print $2; exit }')"
  conn_record "$1" channel "$2" "$bot"
}
# plugin_version <hub> <folder> <name@marketplace>: prints the installed version for that folder (unknown when Claude
# Code did not say); 1 when it is not installed there. Project-scoped installs count only in their own folder.
plugin_version() {
  local dir; dir="$(hub_claude_dir "$1")"
  python3 - "${dir:-$HOME/.claude}/plugins/installed_plugins.json" "$2" "$3" <<'PY' 2> /dev/null
import json, os, re, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
pl = d.get("plugins", d) if isinstance(d, dict) else {}
es = pl.get(sys.argv[3]) if isinstance(pl, dict) else None
for e in (es if isinstance(es, list) else [es] if isinstance(es, dict) else []):
    if not isinstance(e, dict):
        continue
    pp = e.get("projectPath")
    if e.get("scope") in ("project", "local") and (not isinstance(pp, str) or os.path.realpath(pp) != sys.argv[2]):
        continue
    v = e.get("version")
    print(v if isinstance(v, str) and re.fullmatch(r"[0-9A-Za-z.+_-]{1,40}", v) else "unknown"); sys.exit(0)
sys.exit(1)
PY
}
# repo_url <record repo>: what git and claude are given: local is this machine's ade-skills (ADE_SKILLS_REPO), owner/repo
# a GitHub URL; the record's checker already allowed only these forms
repo_url() { case "$1" in local) echo "$ADE_SKILLS_REPO" ;; https://*) echo "$1" ;; *) echo "https://github.com/$1" ;; esac; }
mkt_present() {   # <hub> <name>: the marketplace is known to Claude Code here (a whole word of marketplace list)
  command -v claude > /dev/null 2>&1 || return 1
  hub_claude "$1" plugin marketplace list 2> /dev/null < /dev/null | awk -v n="$2" '{ for (i = 1; i <= NF; i++) if ($i == n) f = 1 } END { exit !f }'
}
# conn_dirs <hub>: the hub, then each of its folders (projects/*, ops/*, and the git checkouts their ACCESS.md lists)
# that has a record; physical paths, once each
conn_dirs() {
  local h="$1" d c
  { (cd "$h" && pwd -P)
    for d in "$h"/projects/*/ "$h"/ops/*/; do [ -d "$d" ] || continue; (cd "$d" && pwd -P)
      [ -f "$d/ACCESS.md" ] || continue
      while IFS= read -r c; do
        # shellcheck disable=SC2088  # a literal ~ in ACCESS.md is expanded here on purpose
        case "$c" in "~/"*) c="$HOME/${c#\~/}" ;; esac
        [ -d "$c" ] && [ "$(git -C "$c" rev-parse --show-toplevel 2> /dev/null)" = "$(cd "$c" && pwd -P)" ] && (cd "$c" && pwd -P)
      done <<EOF
$(awk -F'|' '/^\|/ { c = $3; gsub(/^[ \t]+|[ \t]+$/, "", c); if (c ~ /^[\/~]/) print c }' "$d/ACCESS.md")
EOF
    done; } | awk 'NF && !seen[$0]++' | while IFS= read -r d; do
      case "$d" in *[[:cntrl:]]*) continue ;; esac; [ -f "$d/.ade/connections.json" ] && echo "$d"; done
}
conn_where() { local h; h="$(cd "$1" && pwd -P)"; [ "$2" = "$h" ] && return 0; case "$2" in "$h"/*) echo " in ${2#"$h"/}" ;; "$HOME"/*) echo " in ~/${2#"$HOME"/}" ;; *) echo " in $2" ;; esac; }

# the account question (AC3): remembered per machine in ~/.config/ade/accounts as hub<TAB>recorded<TAB>current<TAB>continue
acct_ok() { [ -f "$CONF_DIR/accounts" ] && grep -qxF -- "$(printf '%s\t%s\t%s\tcontinue' "$1" "$2" "$3")" "$CONF_DIR/accounts"; }
acct_question() {   # <hub> <label> <recorded fp>: 0 once answered (continue, or signed in to the recorded one); a terminal only
  local h="$1" label="$2" rec="$3" cur; cur="$(account_fp "$h")"
  if [ -n "$cur" ]; then echo "This hub was set up with $label; Claude Code here is signed in to another account."
  else echo "This hub was set up with $label; Claude Code here is not signed in to an account."; fi
  local ASK_TTY=1 ASK_EOF=no; CHOICE=""
  ask_choice "Continue with the current account, or sign in to the recorded one?" "" "continue|with the current account, and reconnect everything" \
    "sign-in|to the recorded account" || CHOICE=""
  case "$CHOICE" in
    continue) { [ -f "$CONF_DIR/accounts" ] && cat "$CONF_DIR/accounts"; printf '%s\t%s\t%s\tcontinue\n' "$h" "$rec" "$cur"; } | write_conf_file accounts
      echo "continuing with this account; run ade restore to reconnect everything"; return 0 ;;
    sign-in) command -v claude > /dev/null 2>&1 || die 2 "claude is not on PATH; install Claude Code first"
      hub_claude "$h" auth login < /dev/tty || die 1 "the sign-in did not finish"
      [ "$(account_fp "$h")" = "$rec" ] && { echo "signed in to $label"; return 0; }
      die 1 "Claude Code is still signed in to another account than $label" ;;
  esac
  return 1
}
conn_account() {   # <hub>: "label<US>fingerprint" from the hub's record; 1 (the reason on stderr) when it is not valid
  local out; out="$(conn_py "$1/.ade/connections.json" get)" || return 1
  printf '%s\n' "$out" | awk -F "$US" '$1 == "account" { print $2 FS $3; exit }'
}
conn_gate() {   # <hub>: before a command that needs a connection; asks the account question (a person at a terminal)
  local f="$1/.ade/connections.json" acct label rec cur
  [ -f "$f" ] || return 0
  acct="$(conn_account "$1")" || die 1 "nothing runs until .ade/connections.json is fixed (ade restore --check shows why)"
  IFS="$US" read -r label rec <<EOF
$acct
EOF
  [ -n "$rec" ] || return 0; cur="$(account_fp "$1")"
  [ "$cur" = "$rec" ] || acct_ok "$1" "$rec" "$cur" && return 0
  agent_context && die 2 "this hub was set up with $label and Claude Code here is on another account; a person answers that at a terminal (ade restore), an agent cannot"
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || die 2 "this hub was set up with $label and Claude Code here is on another account; answer at a terminal (ade restore)"
  acct_question "$1" "$label" "$rec" && return 0
  die 2 "answer the account question first (ade restore asks it again)"
}

# conn_state <hub>: one line per connection, fields kind name state detail folder data (US-separated); state
# ready|missing|different|unknown; data is the marketplace repo or the plugin ref. 1 when a record is not valid.
conn_state() {
  local h="$1" k a b c cur dir recs="" out v st why hp
  while IFS= read -r dir; do [ -n "$dir" ] || continue
    out="$(conn_py "$dir/.ade/connections.json" get)" || return 1
    [ -z "$out" ] || recs="$recs$(printf '%s\n' "$out" | D="$dir" awk '{ print $0 "\037" ENVIRON["D"] }')
"
  done <<EOF
$(conn_dirs "$h")
EOF
  hp="$(cd "$h" && pwd -P)"
  conn_line() { printf '%s\037%s\037%s\037%s\037%s\037%s\n' "$@"; }   # kind name state detail folder [data]
  while IFS="$US" read -r k a b c dir <&3; do
    [ -n "$k" ] || continue
    [ "$dir" = "$hp" ] || case "$k" in marketplace|plugin) ;; *) continue ;; esac   # a project names its plugins only
    case "$k" in
      account) cur="$(account_fp "$h")"
        if [ "$cur" = "$b" ]; then conn_line account "$a" ready "" "$dir" ""
        elif acct_ok "$h" "$b" "$cur"; then conn_line account "$a" different "continuing with this account" "$dir" ""
        elif [ -z "$cur" ]; then conn_line account "$a" missing "not signed in" "$dir" ""
        else conn_line account "$a" different "another account is signed in" "$dir" ""; fi ;;
      provider)
        if [ "$b" = account ]; then
          case "$a" in anthropic) if command -v claude > /dev/null 2>&1 && claude_signed_in "$h" < /dev/null; then st=ready; why=""
              else st=missing; why="not signed in"; fi ;;
            *) st=unknown; why="signed in through its own CLI" ;; esac
          conn_line provider "$a" "$st" "$why" "$dir" ""
        elif key_stored "$h" "$a" < /dev/null; then conn_line key "$a" ready "" "$dir" ""
        else conn_line key "$a" missing "" "$dir" ""; fi ;;
      marketplace) if mkt_present "$h" "$a"; then st=ready; else st=missing; fi
        conn_line marketplace "$a" "$st" "$(repo_url "$b")" "$dir" "$b" ;;
      plugin) if v="$(plugin_version "$h" "$dir" "$a@$b")"; then
          if [ "v$v" = "$c" ]; then st=ready; why="$c"
          else st=different; case "$v" in unknown) why="recorded $c, installed unknown" ;; *) why="recorded $c, installed v$v" ;; esac; fi
        else st=missing; why="$c"; fi
        conn_line plugin "$a@$b" "$st" "$why" "$dir" "$c" ;;
      channel) if [ "$a" != telegram ]; then st=unknown; why="bin/chat setup $a restores it"
        elif key_stored "$h" telegram < /dev/null; then st=ready; why="$b"; else st=missing; why="$b"; fi
        conn_line channel "$a" "$st" "$why" "$dir" "" ;;
      service) if service_present "$h" "$a"; then st=ready; else st=missing; fi
        conn_line service "$a" "$st" "" "$dir" "" ;;
    esac
  done 3<<EOF
$recs
EOF
}
conn_gap() { case "$3" in missing) return 0 ;; different) [ "$4" != "continuing with this account" ] ;; *) return 1 ;; esac; }

drop_role() {   # <hub> <provider>: takes a provider out of HUB_PROVIDERS_ALLOWED
  local old new; old="$(conf_get "$1" HUB_PROVIDERS_ALLOWED)"
  new="$(printf '%s\n' $old | awk -v p="$2" 'NF && $0 != p' | tr '\n' ' ' | sed 's/ $//')"
  [ "$new" = "$old" ] || conf_set "$1" HUB_PROVIDERS_ALLOWED "$new"
}
# mkt_add <hub> <name> <repo> <ref>: a marketplace other than the built-in ade-skills is added only when its name is
# typed back; at the recorded tag when it is still published (a git URL with #<tag>), else the latest with a warning
mkt_add() {
  local h="$1" m="$2" url; url="$(repo_url "$3")"
  if [ "$m" != ade-skills ]; then
    tty_ask "The marketplace $m comes from $url, which is not ade's own. Type its name ($m) to add it:"
    [ "$ANSWER" = "$m" ] || { RESULT="skipped (the name was not typed back)"; return 1; }
  fi
  local src="$url"
  if [ -n "${4:-}" ]; then
    if git ls-remote --exit-code --tags -- "$url" "refs/tags/$4" > /dev/null 2>&1 < /dev/null; then
      case "$url" in https://*) src="${url%.git}.git#$4" ;; esac
    else echo "ade: $m $4 is no longer published; adding its latest" >&2; fi
  fi
  hub_claude "$h" plugin marketplace add -- "$src" < /dev/null > /dev/null || { RESULT="failed (could not add the $m marketplace)"; return 1; }
}
# restore_plugin <hub> <folder> <name> <marketplace> <ref> <repo>: the marketplace when missing, then the plugin in
# its folder; ready only when the installed version is the recorded one
restore_plugin() {
  local h="$1" dir="$2" n="$3" m="$4" ref="$5" repo="$6" v
  command -v claude > /dev/null 2>&1 || { RESULT="failed (claude is not installed)"; return 1; }
  if mkt_present "$h" "$m"; then
    git ls-remote --exit-code --tags -- "$(repo_url "$repo")" "refs/tags/$ref" > /dev/null 2>&1 < /dev/null ||
      echo "ade: $n@$m $ref is no longer published; installing the latest" >&2
  else mkt_add "$h" "$m" "$repo" "$ref" || return 1; fi
  (cd "$dir" && hub_claude "$h" plugin install --scope project -- "$n@$m" < /dev/null > /dev/null) || { RESULT="failed (claude plugin install $n@$m)"; return 1; }
  v="$(plugin_version "$h" "$dir" "$n@$m")" || { RESULT="failed ($n@$m is still not installed)"; return 1; }
  if [ "v$v" = "$ref" ]; then RESULT=ready; return 0; fi
  case "$v" in unknown) RESULT="different (recorded $ref, installed unknown)" ;; *) RESULT="different (recorded $ref, installed v$v)" ;; esac
  return 1
}

RESTORE_USAGE="usage: ade restore [--check] [--label <name>]"
cmd_restore() {
  local check=0 label="" hub f lines k n st det dir data gaps=0 needs="" fixed=0 out where
  while [ $# -gt 0 ]; do case "$1" in
    --check) check=1; shift ;;
    --label) [ $# -ge 2 ] || die 2 "$RESTORE_USAGE"; label="$2"; shift 2
      matches "$label" '^[A-Za-z0-9][A-Za-z0-9 ._-]{0,39}$' || die 2 "a label is letters, digits, spaces, . _ - (at most 40)" ;;
    *) die 2 "$RESTORE_USAGE" ;;
  esac; done
  hub="$(find_hub)" || exit $?; f="$hub/.ade/connections.json"
  [ -f "$f" ] || die 2 "no .ade/connections.json in $hub; ade setup writes one"
  if [ -n "$label" ]; then conn_py "$f" label "$label" > /dev/null || exit 1; echo "account label: $label"; return 0; fi
  if [ "$check" = 1 ]; then
    lines="$(conn_state "$hub")" || exit 1
    while IFS="$US" read -r k n st det dir data; do [ -n "$k" ] || continue
      echo "$k $n$(conn_where "$hub" "$dir"): $st${det:+ ($det)}"; conn_gap "$k" "$n" "$st" "$det" && gaps=$((gaps + 1)); done <<EOF
$lines
EOF
    [ "$gaps" = 0 ]; return
  fi
  lines="$(conn_state "$hub")" || exit 1
  while IFS="$US" read -r k n st det dir data; do [ -n "$k" ] && conn_gap "$k" "$n" "$st" "$det" && gaps=$((gaps + 1)); done <<EOF
$lines
EOF
  [ "$gaps" -gt 0 ] || { echo "nothing to restore: every connection in .ade/connections.json is ready here"; return 0; }
  # every answer comes from a person at this terminal: never a pipe, never an agent session (as ade reset)
  tty_ready restore; exec < /dev/tty
  echo "ade restore found:"
  while IFS="$US" read -r k n st det dir data; do [ -n "$k" ] && conn_gap "$k" "$n" "$st" "$det" && echo "  - $k $n$(conn_where "$hub" "$dir"): $st${det:+ ($det)}"; done <<EOF
$lines
EOF
  # the account first: nothing (a key, a plugin, a Telegram pairing) is restored under an account the user did not choose
  while IFS="$US" read -r k n st det dir data; do
    [ "$k" = account ] && conn_gap "$k" "$n" "$st" "$det" || continue
    local acct; acct="$(conn_account "$hub")" || exit 1
    IFS="$US" read -r n data <<EOF
$acct
EOF
    acct_question "$hub" "$n" "$data" || die 2 "the account step was skipped; nothing else was restored (run ade restore again to answer it)"
    echo "account $n: ready"; fixed=$((fixed + 1))
  done <<EOF
$lines
EOF
  local svc=""
  while IFS="$US" read -r k n st det dir data <&4; do
    [ -n "$k" ] && [ "$k" != account ] && conn_gap "$k" "$n" "$st" "$det" || continue
    RESULT=skipped; where="$(conn_where "$hub" "$dir")"
    case "$k" in
      provider) if confirm "Sign in to Claude Code with your account now?"; then
          if hub_claude "$hub" auth login && claude_signed_in "$hub"; then RESULT=ready; else RESULT="failed (the sign-in did not finish)"; fi; fi ;;
      key) if confirm "Restore the $n key (a hidden prompt, then a live test)?"; then
          if store_key "$hub" "$n"; then
            if out="$(live_test "$hub" "$n")"; then RESULT=ready; echo "$out"
            else echo "$out"; RESULT="failed (${out#"$n: failed ("}"; RESULT="${RESULT%)}"
              drop_role "$hub" "$n"; echo "$n is left out of the roles (HUB_PROVIDERS_ALLOWED) until its live test passes"; fi
          fi; fi ;;
      marketplace)   # restored with its plugin when one of its plugins is missing too
        printf '%s\n' "$lines" | awk -F "$US" -v m="$n" -v d="$dir" '$1 == "plugin" && $3 != "ready" && $5 == d { split($2, x, "@"); if (x[2] == m) f = 1 } END { exit !f }' && continue
        if confirm "Add the marketplace $n from $det$where?"; then mkt_add "$hub" "$n" "$data" "" && RESULT=ready; fi ;;
      plugin) local pm="${n#*@}" prepo
        prepo="$(printf '%s\n' "$lines" | awk -F "$US" -v m="$pm" '$1 == "marketplace" && $2 == m { print $6; exit }')"
        [ -n "$prepo" ] || prepo=local   # a plugin of the built-in ade-skills with no marketplace line
        confirm "Install the plugin $n at $data$where, from the marketplace $pm ($(repo_url "$prepo"))?" &&
          restore_plugin "$hub" "$dir" "${n%@*}" "$pm" "$data" "$prepo" ;;
      channel) if confirm "Restore $n (its bot token at a hidden prompt, then pairing this device again)?"; then
          ask_secret "Bot token for ${det:-the bot} (hidden):"
          if [ -z "$SECRET" ]; then RESULT=skipped
          else printf '%s\n' "$SECRET" | hub_run "$hub" keys set telegram > /dev/null; local rc=$?; SECRET=""
            if [ "$rc" != 0 ]; then RESULT="failed (bin/keys could not store the token)"
            elif hub_run "$hub" chat setup telegram --repair; then RESULT=ready; record_key "$hub" telegram
            else RESULT="failed (bin/chat setup telegram --repair)"; fi
          fi; fi ;;
      service) svc="$svc $n"; continue ;;
    esac
    echo "$k $n$where: $RESULT"
    if [ "$RESULT" = ready ]; then fixed=$((fixed + 1)); else needs="$needs, $k $n$where ($RESULT)"; fi
  done 4<<EOF
$lines
EOF
  if [ -n "$svc" ]; then
    RESULT=skipped
    if confirm "Reinstall the services ($(echo $svc | sed 's/ /, /g')) for this platform (bin/schedule install)?"; then
      if hub_run "$hub" schedule install < /dev/null > /dev/null; then RESULT=ready; for n in $svc; do service_present "$hub" "$n" || RESULT="failed ($n is still not installed)"; done
      else RESULT="failed (bin/schedule install)"; fi
    fi
    echo "services$svc: $RESULT"
    if [ "$RESULT" = ready ]; then fixed=$((fixed + 1)); else needs="$needs, services$svc ($RESULT)"; fi
  fi
  journal_line "$hub" "ade restore: $fixed connection(s) restored${needs:+; still needs the owner: ${needs#, }}"
  if [ -n "$needs" ]; then echo "still needs you: ${needs#, }"; return 1; fi
  echo "every connection is ready"
}

# connectors (story A16; contract: ade-skills .ade/context/connectors.md): a recipe per service in ade-skills
# (plugins/guard/connectors/<service>.json, format 1) says how a person signs in; ade reads recipes only at the pinned
# ade-skills tag, each one only when its sha256 matches that release's release.json, and runs nothing from one. The
# project commits names only, in <folder>/.ade/connectors.json; no secret ever passes through ade.
CONNECT_SINCE=0.7.0   # the first ade-skills release that ships recipes (no override: the pin check stays on)
CONNECT_USAGE="usage: ade connect [<service> | status [<service>] | disconnect <service>]"
CONNECT_DEFAULT_REPO=https://github.com/better-ade/ade-skills CONNECT_DEFAULT_RELEASES=https://github.com
# the variables a Claude Code session sets (the same ten as ade key, A13): any one set, even empty, is an agent session
CONNECT_SESSION_VARS="CLAUDECODE CLAUDE_CODE_CHILD_SESSION CLAUDE_PID CLAUDE_CODE_SESSION_ID CLAUDE_CODE_BRIDGE_SESSION_ID
  CLAUDE_PROJECT_DIR CLAUDE_PLUGIN_ROOT CLAUDE_CODE_EXECPATH CLAUDE_CODE_SSE_PORT CLAUDE_CODE_ENTRYPOINT"
# connect_tty <what>: a person at a terminal. This stops accidents; an agent running as you can get round it (a
# pseudo-terminal with these variables unset passes).
connect_tty() {
  local v; for v in $CONNECT_SESSION_VARS; do
    printenv "$v" > /dev/null 2>&1 && die 2 "ade $1 asks a person at a terminal; it refuses inside a Claude Code session ($v is set); nothing changed"; done
  tty_ready "$1"
}
# names_py <record> <key> get|add <name>...: a names-only record, {"format": 1, "<key>": [...]}, checked whole on every
# read (sorted, unique, at most 64 names ^[a-z][a-z0-9-]{0,31}$, at most 64 KiB); add holds the folder's lock, reads,
# checks and writes through ade_write, only when a name is new. Exit 2 with the reason when it is not exactly that shape.
# connectors_py: .ade/connectors.json (A16); tools_py: the hub's .ade/tools.json (A23).
connectors_py() { names_py "$1" connectors "${@:2}"; }
tools_py() { names_py "$1" tools "${@:2}"; }
names_py() {
  write_py "$@" <<'PY'
import json, os, re, sys
p, key, op, a = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
NAME = re.compile(r"[a-z][a-z0-9-]{0,31}")
safe = lambda s: re.sub(r"[^\x20-\x7e]", "?", s)[:200]
class Bad(Exception):
    pass
def pairs(kv):
    seen = {}
    for k, v in kv:
        if k in seen: raise Bad("a key appears twice")
        seen[k] = v
    return seen
def check(d):
    if not isinstance(d, dict) or set(d) != {"format", key}: raise Bad("it must hold exactly format and %s" % key)
    if type(d["format"]) is not int or d["format"] != 1: raise Bad("format is not 1")
    c = d[key]
    if not isinstance(c, list): raise Bad("%s is not a list of at most 64 names" % key)
    if len(c) > 64: raise Bad("it would hold more than 64 names")
    if not all(isinstance(n, str) and NAME.fullmatch(n) for n in c): raise Bad("a name is not ^[a-z][a-z0-9-]{0,31}$")
    if c != sorted(set(c)): raise Bad("the names are not sorted and unique")
def refuse(why):
    sys.stderr.write("ade: %s is not a valid %s record (%s); nothing in it is used\n" % (safe(p), key, why)); sys.exit(2)
def load():
    if not (os.path.lexists(p) or os.path.islink(os.path.dirname(p))): return {"format": 1, key: []}
    try:
        if os.path.islink(p) or os.path.islink(os.path.dirname(p)) or not os.path.isfile(p): raise Bad("it is not a plain file")
        if os.path.getsize(p) > 65536: raise Bad("it is larger than 64 KiB")
        with open(p, encoding="utf-8") as fh: d = json.load(fh, object_pairs_hook=pairs)
        check(d); return d
    except (Bad, ValueError, OSError, RecursionError) as e:
        refuse(e if isinstance(e, Bad) else "it is not valid JSON")
d = load()
if op == "get":
    for n in d[key]: print(n)
elif op == "add":
    ade_hold(p); d = load()   # read again under the lock: two runs never lose a name
    new = sorted(set(n for n in a if n not in d[key]))
    if new:
        d[key] = sorted(d[key] + new)
        try: check(d)
        except Bad as e:
            sys.stderr.write("ade: %s not changed: %s\n" % (safe(p), e)); sys.exit(2)
        ade_write(p, json.dumps(d) + "\n"); print("added")
PY
}
# recipes_py <checkout> <file> <sha256>...: each recipe against format 1 (contract amendment 1, section 1 "Checks"),
# with the rules in the order and, where sensible, the words of ade-skills' own checker
# (plugins/guard/scripts/check-recipe.sh). Each file is opened without following a link, its bytes hashed and compared
# with release.json before they are parsed. Prints one line per recipe, US-separated: ok service title job tier state
# held kind plugin cli connector admin reaches docs revoke q1id q1ask q2id q2ask, or refused <service> <reason>. A
# failure across files prints "folder<US><US><reason>" alone and exits 3 (the whole folder is refused). Deliberately
# stricter than the checker: every string is printable ASCII; sign_in.plugin equals the service for every kind; the
# guard's hook files must be regular files, not links. Nothing in a recipe is ever run.
recipes_py() {
  python3 -I - "$@" <<'PY'
import hashlib, json, os, re, stat, sys, unicodedata
MAX_BYTES = 65536
NAME = r"[a-z][a-z0-9-]{0,31}"
CONNECTOR = r"[A-Za-z0-9_]{1,40}"
TOP = {"format", "service", "title", "job", "tier", "state", "held", "sign_in", "questions", "guard", "hosts", "pages", "reaches"}
TOP_REQUIRED = TOP - {"held"}
JOBS = {"tickets", "code", "mail", "chat"}
STATES = {"ready", "held"}
KINDS = {"plugin", "cli", "claude-ai"}
SIGN_IN = {"kind", "plugin", "cli", "connector", "admin"}
CLIS = {"gh"}
QUESTION = {"id", "ask", "to"}
TARGETS = {"gate"}
GUARD = {"prefixes", "read", "commands"}
PROGRAMS = {"gh", "git"}
LISTS = {"free", "deny"}
FREE_ENTRY = {"words", "flags", "args"}
ARGS = {"any", "none", "names"}
PAGES = {"docs", "revoke"}
LINE_MAX = 200
TITLE_MAX = 40
BAD_CATEGORIES = {"Cc", "Cf", "Cs", "Co", "Cn", "Zl", "Zp"}
PLUGIN_PREFIX = re.compile(r"mcp__plugin_(%s)_([A-Za-z0-9-]{1,40})__" % NAME)
TOOL = re.compile(r"[A-Za-z][A-Za-z0-9_-]{0,127}")
WORD = re.compile(r"[a-z][a-z0-9-]*")
FLAG = re.compile(r"(-[A-Za-z0-9]+|--[a-z0-9][a-z0-9-]*)(=[A-Za-z0-9._,-]*)?")
DENY_ELEMENT = re.compile(r"[a-z][a-z0-9-]*|-[A-Za-z0-9]|--[a-z0-9][a-z0-9-]*")
HOST = re.compile(r"(?=.{1,253}$)[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+")
URL = re.compile(r"https://([a-z0-9.-]+)(/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?")
HOOK_FILES = ["plugins/guard/hooks/hooks.json", "plugins/guard/hooks/guard.sh"]
class Bad(Exception):
    pass
def no(why):
    raise Bad(why)
def show(v):
    try: return re.sub(r"[^\x20-\x7e]", "?", json.dumps(v, ensure_ascii=True))[:120]
    except (TypeError, ValueError): return "?"
def is_int(v): return isinstance(v, int) and not isinstance(v, bool)
def one_of(v, allowed): return isinstance(v, str) and v in allowed
def text_ok(v, where):   # every string, keys too: refused, never stripped; ade also holds recipes to printable ASCII
    if isinstance(v, dict):
        for k, x in v.items(): text_ok(k, where + " key"); text_ok(x, where)
    elif isinstance(v, list):
        for x in v: text_ok(x, where)
    elif isinstance(v, str):
        for c in v:
            cat = unicodedata.category(c)
            if cat in BAD_CATEGORIES: no("%s holds the character U+%04X (category %s), which a recipe may not hold" % (where, ord(c), cat))
            if not " " <= c <= "~": no("%s holds the character U+%04X; a recipe is printable ASCII" % (where, ord(c)))
def obj(v, where, allowed, required=()):
    if not isinstance(v, dict): no("%s is not an object" % where)
    extra = sorted(set(v) - set(allowed))
    if extra: no("%s has an unknown field %s" % (where, show(extra[0])))
    for k in sorted(required):
        if k not in v: no("%s has no %s" % (where, show(k)))
    return v
def line(v, where, most=LINE_MAX):
    if not isinstance(v, str) or not v.strip(): no("%s is not a non-empty string" % where)
    if len(v) > most: no("%s is longer than %d characters" % (where, most))
    return v
def names(v, where, pattern):
    if not isinstance(v, list): no("%s is not a list" % where)
    for x in v:
        if not isinstance(x, str) or not pattern.fullmatch(x): no("%s has an entry that is not allowed: %s" % (where, show(x)))
