def png(w, h, rows):
    def chunk(t, d): return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(b"".join(b"\0" + r for r in rows), 6)) + chunk(b"IEND", b""))
if op == "xwd":
    no = "this display's picture format is not one ade reads (xwd: 24 or 32 bits a pixel); install ImageMagick (import) instead; nothing saved"
    d = open(A[0], "rb").read(512 << 20)
    if len(d) < 100: die(1, no)
    (hs, ver, fmt, depth, w, h, xoff, order, unit, bitorder, pad, bpp, bpl, vclass, rm, gm, bm, bits, cmap, ncol) = struct.unpack(">20I", d[:80])
    step = bpp // 8; off = hs + ncol * 12
    if ver != 7 or fmt != 2 or bpp not in (24, 32) or (rm, gm, bm) != (0xff0000, 0xff00, 0xff) or not (0 < w <= 16384 and 0 < h <= 16384) \
       or bpl < w * step or len(d) < off + bpl * h: die(1, no)
    r0, g0, b0 = (2, 1, 0) if order == 0 else (step - 3, step - 2, step - 1)
    rows = []
    for y in range(h):
        row = d[off + y * bpl:off + y * bpl + w * step]; line = bytearray(w * 3)
        line[0::3] = row[r0::step]; line[1::3] = row[g0::step]; line[2::3] = row[b0::step]; rows.append(bytes(line))
    open(A[1], "wb").write(png(w, h, rows)); sys.exit(0)

