DOC = {".pdf", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".tif", ".tiff", ".heic", ".txt", ".text", ".md", ".markdown",
       ".rtf", ".csv", ".tsv", ".log", ".json", ".yaml", ".yml", ".toml", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
       ".odt", ".ods", ".odp", ".pages", ".numbers", ".mp3", ".m4a", ".aac", ".wav", ".flac", ".ogg", ".opus", ".mp4", ".m4v",
       ".mov", ".mkv", ".webm", ".avi"}
PROG = {".app", ".command", ".tool", ".terminal", ".pkg", ".mpkg", ".prefpane", ".saver", ".kext", ".scptd", ".workflow",
        ".action", ".bundle", ".plugin", ".framework", ".appex", ".xpc", ".qlgenerator", ".mdimporter", ".dmg", ".zip",
        ".fileloc", ".webloc", ".inetloc", ".url", ".mobileconfig", ".desktop", ".appimage", ".jar", ".scpt", ".applescript"}
