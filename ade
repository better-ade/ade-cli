# ade web (story A19, docs/notes/A19-web-view.md): a read-only page of the hub's agents and logs, served by python3's
# standard library on 127.0.0.1, or with --tailnet on this machine's Tailscale address only. The address carries a
# random token; ~/.config/ade/web (0600: the server's pid, then the address) is there while it runs.
WEB_LINK="$CONF_DIR/web"
WEB_USAGE="usage: ade web [--port N] [--tailnet] [--no-open] | ade web --print-link | ade web --stop"
# web_link: the running server's address: line 2 of the link file, while the pid on line 1 lives and the address still
# answers (a pid can be another program's after a crash or a restart of the machine); a stale file is removed
web_link() {
  local pid="" url="" at
  [ -f "$WEB_LINK" ] || return 1
  { IFS= read -r pid; IFS= read -r url; } < "$WEB_LINK" 2> /dev/null
  if matches "$pid" '^[0-9]+$' && kill -0 "$pid" 2> /dev/null && matches "$url" '^http://[0-9.]+:[0-9]+/\?k=[A-Za-z0-9_-]+$'; then
    at="${url#http://}"; at="${at%%/*}"
    if ( exec 3<> "/dev/tcp/${at%:*}/${at##*:}" ) 2> /dev/null; then printf '%s\n' "$url"; return 0; fi
  fi
