}
cmd_update() {
  local check=0 rc=0 hub="" p plugins s line
  local usage="usage: ade update [--check | --rollback | --auto on|off]"
  while [ $# -gt 0 ]; do case "$1" in --check) check=1; shift ;; --rollback) [ $# -eq 1 ] && [ "$check" = 0 ] || die 2 "$usage"; self_rollback; return ;;
    --auto) [ $# -eq 2 ] && [ "$check" = 0 ] || die 2 "$usage"
      case "$2" in on|off) echo "$2" | write_conf_file auto-update ;; *) die 2 "$usage" ;; esac
      if [ "$2" = on ]; then echo "auto-update on: ade patch and minor releases install themselves (from a terminal, never in an agent session)"
      else echo "auto-update off: ade only tells you about a new release (ade update installs it)"; fi; return 0 ;;
    *) die 2 "$usage" ;; esac; done
  UPD_CHANGED=""; RESTART_NEEDED=0
  self_update "$check" || rc=1
  hub="$( (find_hub) 2> /dev/null)" || hub=""
  [ -n "$hub" ] && { hub_update "$hub" "$check" || rc=1; }
  plugins="$(ade_plugins)"
  if command -v claude > /dev/null 2>&1; then
    for p in $plugins; do
      if [ "$check" = 1 ]; then echo "plugin $p: claude plugin update"
      elif claude plugin update "$p" < /dev/null > /dev/null 2>&1; then echo "plugin $p: updated"; else echo "plugin $p: update failed"; fi
    done
    [ "$check" = 0 ] && [ -n "$plugins" ] && UPD_CHANGED="$UPD_CHANGED, plugins"
    if [ "$check" = 1 ]; then echo "Claude Code: claude update (running sessions keep their version until they restart)"
    else ( unset ADE_NO_CLAUDE_UPDATE; rm -f "$CONF_DIR/claude-updated"; claude_update "$hub" ) && UPD_CHANGED="$UPD_CHANGED, Claude Code (on restart)"; fi
  fi
  if [ -n "$hub" ] && s="$(ui_live "$hub")"; then
    if [ "$check" = 1 ]; then echo "ade ui: reloads its theme and keys (tmux source-file; stays attached)"
    else ui_conf "$hub" "$s" | write_conf_file "ui-$s.tmux.conf"; ui_tmux source-file "$CONF_DIR/ui-$s.tmux.conf" < /dev/null && echo "ade ui: reloaded (still attached)"; fi
  fi
  [ "$check" = 1 ] && return 0
  [ -n "$hub" ] && restart_parts "$hub"
  if [ -n "$hub" ] && [ -n "$UPD_CHANGED" ] && [ -x "$hub/bin/notify" ]; then
    line="ade update: ${UPD_CHANGED#, }; applies on your next prompt"; case "$UPD_CHANGED" in *plugins*) line="$line (run /reload-plugins for the plugins)" ;; esac
    hub_run "$hub" notify all "$line" < /dev/null > /dev/null 2>&1 || echo "ade: bin/notify failed"
  fi
  return $rc
}

# release manifests and update notifications (story A12): release.json of each better-ade component in use, fetched
# at most once a day by a detached job (one 2 s budget for all of them; offline = try tomorrow), so no command ever
# waits for the network; the next command reads the cache: a banner once per new version (security: every command).
# ade-cli patch and minor releases install themselves in a detached job started from a terminal (never an agent),
# majors and min_supported jumps ask first; ade update --auto off (or ADE_NO_AUTO_UPDATE=1) keeps notify-only.
MANIFEST_SINCE=0.2.0   # the first ade-cli release with release.json: from it on, no valid manifest = nothing installed
ADE_RELEASES_BASE="${ADE_RELEASES_BASE:-https://github.com}"
UPD_DIR="$CONF_DIR/updates"
COMPONENTS="ade-cli ade-brain ade-method ade-skills ade-agent-registry"
ver_ge() { ! ver_gt "$2" "$1"; }
sha256_of() { if command -v shasum > /dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1; else sha256sum "$1" | cut -d' ' -f1; fi; }
# manifest_py <release.json> <component> <version|latest> [file name]: checks that the manifest is for exactly that
# component (and version); prints the file's sha256 when a name is given, else "version urgency min summary" (tabs;
# "-" for an empty field; no control character). Any url in it is ignored: the file always comes from its tag.
# 1 with the reason on stdout when it is not such a manifest.
manifest_py() {
  python3 - "$@" <<'PY' 2> /dev/null
import json, os, re, sys
p, comp, ver = sys.argv[1:4]; name = sys.argv[4] if len(sys.argv) > 4 else ""
SEMVER = re.compile(r"[0-9]{1,9}\.[0-9]{1,9}\.[0-9]{1,9}")
def no(why):
    print(why); sys.exit(1)
try:
    if os.path.getsize(p) > 65536: no("it is larger than 64 KiB")
    d = json.load(open(p))
except (OSError, ValueError):
    no("it is not valid JSON")
if not isinstance(d, dict): no("it is not a JSON object")
if d.get("component") != comp: no("it is not the manifest of %s" % comp)
v = d.get("version")
if not isinstance(v, str) or not SEMVER.fullmatch(v): no("its version is not X.Y.Z")
if ver != "latest" and v != ver: no("it is the manifest of another version than %s" % ver)
if name:
    for f in d.get("files") if isinstance(d.get("files"), list) else []:
        if isinstance(f, dict) and f.get("name") == name:
            sha = f.get("sha256")
            if isinstance(sha, str) and re.fullmatch(r"[0-9a-f]{64}", sha): print(sha); sys.exit(0)
    no("it names no sha256 for %s" % name)
clean = lambda s: re.sub(r"\s+", " ", re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", s)).strip()[:160] or "-"
urg = d.get("urgency") if d.get("urgency") in ("normal", "security") else "normal"
mins = d.get("min_supported") if isinstance(d.get("min_supported"), str) and SEMVER.fullmatch(d["min_supported"]) else "-"
summ = clean(d["summary"]) if isinstance(d.get("summary"), str) else "-"
print("\t".join((v, urg, mins, summ)))
PY
}
# release_sha <version> <tmp folder>: the sha256 of ade in the per-version release.json, which must exist from
# MANIFEST_SINCE on; prints the reason and returns 1 when it cannot be had (nothing may be installed then)
release_sha() {
  local v="$1" out
  ver_ge "$v" "$MANIFEST_SINCE" || return 0   # an older release has no manifest: shebang, bash -n and ade version only
  dl "$ADE_RELEASES_BASE/better-ade/ade-cli/releases/download/v$v/release.json" "$2/release.json" ||
    { echo "there is no release.json for ade $v (every release from $MANIFEST_SINCE on has one)"; return 1; }
  out="$(manifest_py "$2/release.json" ade-cli "$v" ade)" || { echo "its release.json is not valid: $out"; return 1; }
  echo "$out"
}
comp_installed() {   # <component> <hub>: the installed version (X.Y.Z), or nothing when it is not in use here
  local v="" top
  case "$1" in
    ade-cli) v="$ADE_VERSION" ;;
    ade-brain) [ -n "$2" ] && [ -f "$2/VERSION" ] && v="$(tr -d ' \r\n' < "$2/VERSION")" ;;
    ade-method) top="$(git rev-parse --show-toplevel 2> /dev/null)" && [ -f "$top/.ade/method-version" ] && v="$(tr -d ' \r\n' < "$top/.ade/method-version")" ;;
    ade-skills) [ -n "$(ade_plugins)" ] && v="$ADE_SKILLS_REF" ;;
    ade-agent-registry) top="$(git rev-parse --show-toplevel 2> /dev/null)" && [ -d "$top/.ade/agents" ] && v="$ADE_REGISTRY_REF" ;;
  esac
  v="${v#v}"; matches "$v" '^[0-9]+\.[0-9]+\.[0-9]+$' && echo "$v"
}
fetch_manifest() {   # <component>: its latest release.json, checked, into $UPD_DIR/<c>.latest; TERM stops the request
  local c="$1" tmp proto="=https" line cp=""
  file_urls_ok && proto="=https,file"
