  ip=""; [ "$state" != Running ] || ip="$(tailscale ip -4 2> /dev/null)" || ip=""
  [ -n "$ip" ] || die 1 "Tailscale is not signed in (or not running) on this machine, and ade never signs in for you. Sign in with: tailscale up, then: ade web --tailnet"
  web_tailnet_ip "$ip" || die 1 "tailscale ip -4 did not print one address in 100.64.0.0/10: not a Tailscale address, so nothing was started"
  printf '%s %s\n' "$ip" "${name:--}"
}
cmd_web() {
  local port="" fixed=0 mode=local link=0 hub bind=127.0.0.1 name=- t
  while [ $# -gt 0 ]; do
    case "$1" in
      --port) { [ $# -ge 2 ] && matches "$2" '^[1-9][0-9]{3,4}$' && [ "$2" -ge 1024 ] && [ "$2" -le 65535 ]; } || die 2 "$WEB_USAGE (N: a port from 1024 to 65535)"
