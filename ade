}
# connect_recipes: the pinned ade-skills checkout, its release.json and every recipe checked; CONNECT_ROWS holds the
# recipes_py lines (refused ones too). Exit 2 when the pin cannot carry verified recipes.
connect_recipes() {
  local ref="$ADE_SKILLS_REF" ver src m f b svc sha why ok="" shas d
  matches "$ref" '^v[0-9]+\.[0-9]+\.[0-9]+$' || die 2 "ade connect reads recipes only at a vX.Y.Z tag of ade-skills; ADE_SKILLS_REF=$(printf '%s' "$ref" | LC_ALL=C tr -c 'A-Za-z0-9._/-' '?') is not one"
