        "$gh" auth login --hostname github.com < /dev/tty || die 1 "the gh sign-in did not finish; run gh auth login --hostname github.com, then ade connect $name again"
        connect_gh_signed_in "$gh" || die 1 "gh is still not signed in to github.com; run gh auth login --hostname github.com, then ade connect $name again"
      else ANSWER=""; die 1 "gh is not signed in to github.com: run gh auth login --hostname github.com yourself, then ade connect $name again"; fi ;;
    claude-ai) printf 'Nothing to run here: the %s connector is on in your Claude account (claude.ai, Settings, Connectors), and is shared by every folder of that account; ade cannot see that sign-in.\n' "$R_CONNECTOR" ;;
  esac
  added="$(connectors_py "$top/.ade/connectors.json" add "$name")" || exit 2
  if [ "$added" = added ]; then
    local hub; hub="$( (find_hub) 2> /dev/null)" && journal_line "$hub" "ade connect: $name connected in $(basename "$top")"
  fi
  echo "$name: connected in $top (.ade/connectors.json)"
  echo "next: ade connect status $name"
}

connect_status() {
  local top names want="${1:-}" n st why gaps=0 p gh v
  [ -z "$want" ] || connect_name "$want"
  connect_sources
  top="$(connect_folder)"; names="$(connectors_py "$top/.ade/connectors.json" get)" || exit 2
  [ -n "$names" ] || { echo "no connectors recorded in $top (.ade/connectors.json)"; [ -z "$want" ] || exit 1; return 0; }
  if [ -n "$want" ]; then connect_has "$names" "$want" || { echo "connector $want: not in $top/.ade/connectors.json"; exit 1; }; names="$want"; fi
  connect_recipes
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if ! connect_row "$n"; then st=missing; why="no verified recipe at ade-skills $ADE_SKILLS_REF"
    elif [ "$R_STATE" = held ]; then st=missing; why="held: $R_HELD"
    else st=""; why=""
      for p in guard $R_PLUGIN; do connect_installed "$top" "$p" || { st=missing; why="plugin $p is not installed here"; break; }; done
      if [ -z "$st" ]; then case "$R_KIND" in
        cli) gh="$(abs_tool gh "$top" 2> /dev/null)"; v=$?
             if [ "$v" = 2 ]; then st=missing; why="the gh on PATH lies inside $top; ade does not run it"
             elif [ "$v" != 0 ]; then st=missing; why="gh is not installed: ade setup --tools"
             elif connect_gh_signed_in "$gh"; then st=ready; v="$(gh_token_env)" && why="the sign-in comes from $v"
             else st=missing; why="gh is not signed in to github.com: gh auth login --hostname github.com"; fi ;;
        plugin) st=unknown; why="ade cannot see this sign-in; /mcp in Claude Code shows it" ;;
        *) st=unknown; why="the sign-in is in your Claude account; ade cannot see it" ;;
      esac; fi
    fi
    echo "connector $n: $st${why:+ ($why)}" | no_ctl
    case "$st" in missing|outside) gaps=$((gaps + 1)) ;; esac
  done <<EOF
$names
EOF
  [ "$gaps" = 0 ] || exit 1
}

connect_disconnect() {
  local name="${1:-}" top cl
  [ -n "$name" ] || die 2 "$CONNECT_USAGE"; connect_name "$name"
  connect_sources
  connect_tty "connect disconnect"
  top="$(connect_folder)"; project_folder_ok "$top" "connect disconnect"
  connect_recipes; connect_pick "$name"
  case "$R_KIND" in
    plugin) tty_confirm "Sign out of $name in Claude Code (claude mcp logout plugin:$R_PLUGIN:$R_PLUGIN)?" || { ANSWER=""; echo "stopped: nothing changed"; exit 1; }; ANSWER=""
      cl="$(abs_tool claude "$top")" || { [ $? = 2 ] && exit 2; die 1 "claude is not on PATH; install Claude Code first"; }
      (cd "$top" && "$cl" mcp logout "plugin:$R_PLUGIN:$R_PLUGIN" < /dev/null) || die 1 "claude mcp logout plugin:$R_PLUGIN:$R_PLUGIN failed"
      echo "$name: signed out (claude mcp logout plugin:$R_PLUGIN:$R_PLUGIN)" ;;
    cli) echo "$name: ade changes nothing (the gh sign-in is shared by every folder of this machine user); to sign out there: gh auth logout --hostname github.com" ;;
    *) printf '%s: ade changes nothing (the %s connector is shared by every folder of your Claude account); to sign out: the connector settings of your Claude account (claude.ai, Settings, Connectors)\n' "$name" "$R_CONNECTOR" ;;
  esac
  if [ -n "$R_REVOKE" ]; then printf 'to revoke its access at %s too: %s\n' "$R_TITLE" "$R_REVOKE" | no_ctl; fi
  echo "the record (.ade/connectors.json) is left as it is: dropping $name from this project is a reviewed edit of that file"
}

cmd_connect() {
  [ $# -gt 0 ] || { connect_list; return; }
  case "$1" in
    status) [ $# -le 2 ] || die 2 "$CONNECT_USAGE"; [ $# -eq 1 ] || connect_name "$2"; connect_status "${2:-}" ;;
    disconnect) [ $# -eq 2 ] || die 2 "$CONNECT_USAGE"; connect_disconnect "$2" ;;
    test|--check) die 2 "ade connect $1 is not in this version of ade yet" ;;
    *) [ $# -eq 1 ] || die 2 "$CONNECT_USAGE"; connect_service "$1" ;;
  esac
}

# ade update (story A11): everything current while every session, agent and orchestrator keeps running. ade itself is
# replaced by one rename (bash reads a script as it runs it, so the running file is never written); nothing is killed.
ADE_CLI_BASE="${ADE_CLI_BASE:-https://raw.githubusercontent.com/better-ade/ade-cli}"
RESTART_FILES="bin/chat bin/chat.py bin/brain bin/brain.py"   # the orchestrator's code: a running one needs a restart
ver_gt() { awk -v a="$1" -v b="$2" 'BEGIN { split(a, x, "."); split(b, y, "."); for (i = 1; i <= 3; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 }; exit 1 }'; }
# file:// URLs only in the test suite: ADE_TEST_ALLOW_FILE_URLS=1 counts only with the marker ADE_TEST_SUITE=1 (tests
# only; tests/helpers.sh sets it), and ade says so on stderr whenever both are set
file_urls_ok() { [ "${ADE_TEST_ALLOW_FILE_URLS:-}" = 1 ] && [ "${ADE_TEST_SUITE:-}" = 1 ]; }
dl() {   # dl <url> [file]: https only, redirects too (file:// for tests), never more than ADE_UPDATE_TIMEOUT seconds;
  # ADE_DL_MAX caps the size of the download (curl --max-filesize) and is checked again after it
  local proto="=https" max=(); file_urls_ok && proto="=https,file"
  [ -z "${ADE_DL_MAX:-}" ] || max=(--max-filesize "$ADE_DL_MAX")
  if [ -n "${2:-}" ]; then curl --proto "$proto" --proto-redir "$proto" -fsSL "${max[@]+"${max[@]}"}" --max-time "${ADE_UPDATE_TIMEOUT:-20}" "$1" -o "$2" 2> /dev/null || return 1
    [ -z "${ADE_DL_MAX:-}" ] || [ "$(wc -c < "$2" | tr -d ' ')" -le "$ADE_DL_MAX" ]
  else curl --proto "$proto" --proto-redir "$proto" -fsSL "${max[@]+"${max[@]}"}" --max-time "${ADE_UPDATE_TIMEOUT:-20}" "$1" 2> /dev/null; fi
}
latest_version() { local v; v="$(dl "$ADE_CLI_BASE/main/VERSION" | tr -d ' \r\n')"; matches "$v" '^[0-9]+\.[0-9]+\.[0-9]+$' && echo "$v"; }
UPD_CHANGED=""
ADE_END_MARKER="# ade: end of file (ade update checks this line; keep it last)"
# temp files of an update: a trap removes every one on EXIT, INT and TERM (one path per line in UPD_TMPS)
UPD_TMPS=""
upd_cleanup() { local f; while IFS= read -r f; do [ -n "$f" ] && rm -rf -- "$f"; done <<EOF2
$UPD_TMPS
EOF2
  UPD_TMPS=""; }
upd_track() { UPD_TMPS="$UPD_TMPS$1
"; }
upd_traps() { trap upd_cleanup EXIT; trap 'upd_cleanup; exit 130' INT; trap 'upd_cleanup; exit 143' TERM; }
upd_untrap() { upd_cleanup; trap - EXIT INT TERM; }
# ade_check <file> <version>: the file is a whole ade script (its shebang, bash -n, the end-of-file marker as its last
# line) and, run with bash (never made executable for this), says it is that version; prints the reason when not
ade_check() {
  [ "$(head -1 "$1")" = "#!/bin/bash" ] || { echo "it is not the ade script"; return 1; }
  bash -n "$1" 2> /dev/null || { echo "it does not parse (bash -n)"; return 1; }
  [ "$(tail -1 "$1")" = "$ADE_END_MARKER" ] || { echo "it is cut short (no end-of-file marker)"; return 1; }
  [ "$(bash "$1" version 2> /dev/null < /dev/null)" = "ade $2" ] || { echo "ade version does not say $2"; return 1; }
}
# ade_put <new file> <installed path>: keeps the installed file as .ade.prev beside it (not executable), then renames
# a copy of the new one into place; the copy is made executable only now, after its check
ade_put() {
  local new="$1" self="$2" dir prev put; dir="$(dirname "$self")"
  prev="$(mktemp "$dir/.ade-prev.XXXXXX")" && upd_track "$prev" && put="$(mktemp "$dir/.ade-update.XXXXXX")" && upd_track "$put" || return 1
  cp "$self" "$prev" && chmod 644 "$prev" && cp "$new" "$put" && chmod 755 "$put" || return 1
  mv -f "$prev" "$dir/.ade.prev" && mv -f "$put" "$self"
}
self_update() {   # <check 0|1> [version]: 1 = the new file failed a check (the old one stays)
  local v="${2:-}" self tmp why want
  if [ -z "$ADE_VERSION" ]; then echo "ade: a checkout ($(dirname "$(ade_self)")); update it with git pull"; return 0; fi
  [ -n "$v" ] || v="$(latest_version)" || { echo "ade: could not read the latest version (offline?); ade $ADE_VERSION stays"; return 0; }
  matches "$v" '^[0-9]+\.[0-9]+\.[0-9]+$' || { echo "ade: $v is not a version; ade $ADE_VERSION stays"; return 1; }
  if ! ver_gt "$v" "$ADE_VERSION"; then   # never a downgrade: only --rollback puts an older ade back
    if [ "$v" = "$ADE_VERSION" ]; then echo "ade $ADE_VERSION is current"
    else echo "ade: $v is older than the installed $ADE_VERSION; refused (ade update --rollback puts the kept previous version back)"; fi
    return 0; fi
  [ "$1" = 1 ] && { echo "ade $ADE_VERSION -> $v"; return 0; }
  self="$(ade_self)"; upd_traps
  # the download and its check happen in a private temp folder, never in a folder on PATH
  tmp="$(mk_tmp)" || { upd_untrap; echo "ade: no temp folder; ade $ADE_VERSION stays"; return 1; }; upd_track "$tmp"
  # A12: from MANIFEST_SINCE on the release's own release.json (component ade-cli, version $v) names the sha256; the
  # file always comes from its tag (a url in the manifest is ignored), and anything short of a match installs nothing
  if ! want="$(release_sha "$v" "$tmp")"; then upd_untrap; echo "ade: $want; nothing installed, ade $ADE_VERSION stays"; return 1; fi
  if ! dl "$ADE_CLI_BASE/v$v/ade" "$tmp/raw"; then upd_untrap; echo "ade: could not download ade $v; ade $ADE_VERSION stays"; return 1; fi
  if [ -n "$want" ] && [ "$(sha256_of "$tmp/raw")" != "$want" ]; then
    upd_untrap; echo "ade: the download of ade $v does not match its sha256 in release.json; nothing installed, ade $ADE_VERSION stays"; return 1; fi
  sed "s/^ADE_VERSION=\"\"/ADE_VERSION=\"$v\"/" "$tmp/raw" > "$tmp/ade"; chmod 600 "$tmp/ade"
  if ! why="$(ade_check "$tmp/ade" "$v")"; then upd_untrap; echo "ade: the new ade $v failed its check ($why); ade $ADE_VERSION stays"; return 1; fi
  ade_put "$tmp/ade" "$self" || { upd_untrap; echo "ade: could not rename the new ade into place; ade $ADE_VERSION stays"; return 1; }
  upd_untrap
  echo "ade $ADE_VERSION -> $v (renamed into place; a running ade keeps its code until it restarts; ade update --rollback returns to $ADE_VERSION)"
  UPD_CHANGED="$UPD_CHANGED, ade $v"
}
self_rollback() {   # ade update --rollback: the kept previous version (.ade.prev) back into place; the current one is kept instead
  local self prev pv why; [ -n "$ADE_VERSION" ] || die 2 "a checkout ($(dirname "$(ade_self)")) has no kept version; use git"
  self="$(ade_self)"; prev="$(dirname "$self")/.ade.prev"
  [ -f "$prev" ] || die 1 "no previous version is kept ($prev); nothing changed"
  pv="$(sed -n 's/^ADE_VERSION="\([^"]*\)".*/\1/p' "$prev" 2> /dev/null | head -1)"
  matches "$pv" '^[0-9]+\.[0-9]+\.[0-9]+$' || die 1 "the kept previous version has no version stamp; nothing changed"
  # a version older than the end-of-file marker has none: its shebang, bash -n and its own version line are checked
  [ "$(head -1 "$prev")" = "#!/bin/bash" ] && bash -n "$prev" 2> /dev/null && [ "$(bash "$prev" version 2> /dev/null < /dev/null)" = "ade $pv" ] ||
    die 1 "the kept previous version ($pv) failed its check; nothing changed"
  upd_traps; local tmp; tmp="$(mk_tmp)" || { upd_untrap; die 1 "no temp folder; nothing changed"; }; upd_track "$tmp"
  cp "$prev" "$tmp/ade" || { upd_untrap; die 1 "could not copy $prev; nothing changed"; }
  ade_put "$tmp/ade" "$self" || { upd_untrap; die 1 "could not rename the previous ade into place; nothing changed"; }
  upd_untrap; echo "ade $ADE_VERSION -> $pv (rolled back; ade update --rollback again returns to $ADE_VERSION)"
}
RESTART_NEEDED=0
hub_update() {   # <hub> <check>: git pull --ff-only, then bin/method sync; 1 = refused (the hub is unchanged)
  local h="$1" up old new rs st f
  git -C "$h" rev-parse --show-toplevel > /dev/null 2>&1 || { echo "hub: not a git repository; skipped"; return 0; }
  up="$(git -C "$h" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2> /dev/null)" || { echo "hub: no upstream branch; skipped"; return 0; }
  old="$(git -C "$h" rev-parse HEAD)"
  if [ "$2" = 1 ]; then
    rs="$(git -C "$h" ls-remote "${up%%/*}" "refs/heads/${up#*/}" 2> /dev/null < /dev/null | awk '{ print $1; exit }')"
    if [ -z "$rs" ]; then echo "hub: could not reach ${up%%/*}"; elif [ "$rs" = "$old" ]; then echo "hub: current"
    else echo "hub: new commits on $up (git pull --ff-only, then bin/method sync)"; fi; return 0
  fi
  # untracked files (a journal entry, a scratch note) never block; git merge --ff-only refuses to overwrite one itself
  st="$(git -C "$h" status --porcelain --untracked-files=no 2> /dev/null)"
  [ -z "$st" ] || { echo "hub: it has local changes (git status); commit or stash them, then ade update again; the hub is unchanged"; return 1; }
  git -C "$h" fetch -q 2> /dev/null < /dev/null || { echo "hub: could not fetch (offline?); unchanged"; return 0; }
  git -C "$h" merge-base --is-ancestor HEAD "$up" ||
    { echo "hub: not a fast-forward (it has commits $up does not); merge or rebase it yourself; the hub is unchanged"; return 1; }
  git -C "$h" merge -q --ff-only "$up" > /dev/null 2>&1 ||
    { echo "hub: git merge --ff-only failed (an untracked file in the way?); the hub is unchanged"; return 1; }
  new="$(git -C "$h" rev-parse HEAD)"
  if [ "$new" = "$old" ]; then echo "hub: current"
  else echo "hub: updated ($(git -C "$h" rev-list --count "$old..$new") commit(s))"; UPD_CHANGED="$UPD_CHANGED, the hub"
    for f in $RESTART_FILES; do git -C "$h" diff --name-only "$old" "$new" | grep -qxF -- "$f" && RESTART_NEEDED=1; done; fi
  [ -x "$h/bin/method" ] && { hub_run "$h" method sync < /dev/null > /dev/null 2>&1 || echo "hub: bin/method sync failed"; }
  return 0
}
ade_plugins() { python3 -c 'import json, sys
try: d = json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
for k in sorted(d.get("plugins", d) or {}):
    if k.endswith("@ade-skills"): print(k)' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json" 2> /dev/null; }
orch_idle() { hub_run "$1" sessions 2> /dev/null < /dev/null | awk '$1 == "main" { for (i = 2; i <= NF; i++) if ($i == "idle") f = 1 } END { exit !f }'; }
restart_parts() {   # <hub>: a running orchestrator on new code restarts only when idle; a busy one is left for later
  local h="$1" st since p="$CONF_DIR/restart-pending"
  [ "$RESTART_NEEDED" = 1 ] || { [ -f "$p" ] && grep -qxF -- "$h" "$p"; } || return 0
  read -r st since <<EOF
$(orch_state "$h" < /dev/null)
EOF
  if [ "$st" = running ] && ! orch_idle "$h"; then
    { [ -f "$p" ] && grep -vxF -- "$h" "$p"; echo "$h"; } | write_conf_file restart-pending
    echo "orchestrator: busy on the old bin/chat; it restarts when it is idle (the next ade update), never interrupted"; return 0
  fi
  if [ "$st" = running ]; then
    if chat "$h" stop < /dev/null > /dev/null && chat "$h" start < /dev/null > /dev/null; then
      echo "orchestrator: idle, restarted on the new bin/chat"; journal_line "$h" "ade update: restarted the orchestrator for the new bin/chat (it was idle)"
    else echo "orchestrator: the restart failed; run ade orchestrator start"; fi
  fi
  [ -f "$p" ] && grep -vxF -- "$h" "$p" | write_conf_file restart-pending
  return 0
}
cmd_update() {
  local check=0 rc=0 hub="" p plugins s line
  local usage="usage: ade update [--check | --rollback | --auto on|off]"
  while [ $# -gt 0 ]; do case "$1" in --check) check=1; shift ;; --rollback) [ $# -eq 1 ] && [ "$check" = 0 ] || die 2 "$usage"; self_rollback; return ;;
    --auto) [ $# -eq 2 ] && [ "$check" = 0 ] || die 2 "$usage"
      case "$2" in on|off) echo "$2" | write_conf_file auto-update ;; *) die 2 "$usage" ;; esac
      if [ "$2" = on ]; then echo "auto-update on: ade patch and minor releases install themselves (from a terminal, never in an agent session)"
      else echo "auto-update off: ade only tells you about a new release (ade update installs it)"; fi; return 0 ;;
    *) die 2 "$usage" ;; esac; done
  UPD_CHANGED=""; RESTART_NEEDED=0
  self_update "$check" || rc=1
  hub="$( (find_hub) 2> /dev/null)" || hub=""
  [ -n "$hub" ] && { hub_update "$hub" "$check" || rc=1; }
  plugins="$(ade_plugins)"
  if command -v claude > /dev/null 2>&1; then
    for p in $plugins; do
      if [ "$check" = 1 ]; then echo "plugin $p: claude plugin update"
      elif claude plugin update "$p" < /dev/null > /dev/null 2>&1; then echo "plugin $p: updated"; else echo "plugin $p: update failed"; fi
    done
    [ "$check" = 0 ] && [ -n "$plugins" ] && UPD_CHANGED="$UPD_CHANGED, plugins"
    if [ "$check" = 1 ]; then echo "Claude Code: claude update (running sessions keep their version until they restart)"
    else ( unset ADE_NO_CLAUDE_UPDATE; rm -f "$CONF_DIR/claude-updated"; claude_update "$hub" ) && UPD_CHANGED="$UPD_CHANGED, Claude Code (on restart)"; fi
  fi
  if [ -n "$hub" ] && s="$(ui_live "$hub")"; then
    if [ "$check" = 1 ]; then echo "ade ui: reloads its theme and keys (tmux source-file; stays attached)"
    else ui_conf "$hub" "$s" | write_conf_file "ui-$s.tmux.conf"; ui_tmux source-file "$CONF_DIR/ui-$s.tmux.conf" < /dev/null && echo "ade ui: reloaded (still attached)"; fi
  fi
  [ "$check" = 1 ] && return 0
  [ -n "$hub" ] && restart_parts "$hub"
  if [ -n "$hub" ] && [ -n "$UPD_CHANGED" ] && [ -x "$hub/bin/notify" ]; then
    line="ade update: ${UPD_CHANGED#, }; applies on your next prompt"; case "$UPD_CHANGED" in *plugins*) line="$line (run /reload-plugins for the plugins)" ;; esac
    hub_run "$hub" notify all "$line" < /dev/null > /dev/null 2>&1 || echo "ade: bin/notify failed"
  fi
  return $rc
}

# release manifests and update notifications (story A12): release.json of each better-ade component in use, fetched
# at most once a day by a detached job (one 2 s budget for all of them; offline = try tomorrow), so no command ever
# waits for the network; the next command reads the cache: a banner once per new version (security: every command).
# ade-cli patch and minor releases install themselves in a detached job started from a terminal (never an agent),
# majors and min_supported jumps ask first; ade update --auto off (or ADE_NO_AUTO_UPDATE=1) keeps notify-only.
MANIFEST_SINCE=0.2.0   # the first ade-cli release with release.json: from it on, no valid manifest = nothing installed
ADE_RELEASES_BASE="${ADE_RELEASES_BASE:-https://github.com}"
UPD_DIR="$CONF_DIR/updates"
COMPONENTS="ade-cli ade-brain ade-method ade-skills ade-agent-registry"
ver_ge() { ! ver_gt "$2" "$1"; }
sha256_of() { if command -v shasum > /dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1; else sha256sum "$1" | cut -d' ' -f1; fi; }
# manifest_py <release.json> <component> <version|latest> [file name]: checks that the manifest is for exactly that
# component (and version); prints the file's sha256 when a name is given, else "version urgency min summary" (tabs;
# "-" for an empty field; no control character). Any url in it is ignored: the file always comes from its tag.
# 1 with the reason on stdout when it is not such a manifest.
manifest_py() {
  python3 - "$@" <<'PY' 2> /dev/null
import json, os, re, sys
p, comp, ver = sys.argv[1:4]; name = sys.argv[4] if len(sys.argv) > 4 else ""
SEMVER = re.compile(r"[0-9]{1,9}\.[0-9]{1,9}\.[0-9]{1,9}")
def no(why):
    print(why); sys.exit(1)
try:
    if os.path.getsize(p) > 65536: no("it is larger than 64 KiB")
    d = json.load(open(p))
except (OSError, ValueError):
    no("it is not valid JSON")
if not isinstance(d, dict): no("it is not a JSON object")
if d.get("component") != comp: no("it is not the manifest of %s" % comp)
v = d.get("version")
if not isinstance(v, str) or not SEMVER.fullmatch(v): no("its version is not X.Y.Z")
if ver != "latest" and v != ver: no("it is the manifest of another version than %s" % ver)
if name:
    for f in d.get("files") if isinstance(d.get("files"), list) else []:
        if isinstance(f, dict) and f.get("name") == name:
            sha = f.get("sha256")
            if isinstance(sha, str) and re.fullmatch(r"[0-9a-f]{64}", sha): print(sha); sys.exit(0)
    no("it names no sha256 for %s" % name)
clean = lambda s: re.sub(r"\s+", " ", re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", s)).strip()[:160] or "-"
urg = d.get("urgency") if d.get("urgency") in ("normal", "security") else "normal"
mins = d.get("min_supported") if isinstance(d.get("min_supported"), str) and SEMVER.fullmatch(d["min_supported"]) else "-"
summ = clean(d["summary"]) if isinstance(d.get("summary"), str) else "-"
print("\t".join((v, urg, mins, summ)))
PY
}
# release_sha <version> <tmp folder>: the sha256 of ade in the per-version release.json, which must exist from
# MANIFEST_SINCE on; prints the reason and returns 1 when it cannot be had (nothing may be installed then)
release_sha() {
  local v="$1" out
  ver_ge "$v" "$MANIFEST_SINCE" || return 0   # an older release has no manifest: shebang, bash -n and ade version only
  dl "$ADE_RELEASES_BASE/better-ade/ade-cli/releases/download/v$v/release.json" "$2/release.json" ||
    { echo "there is no release.json for ade $v (every release from $MANIFEST_SINCE on has one)"; return 1; }
  out="$(manifest_py "$2/release.json" ade-cli "$v" ade)" || { echo "its release.json is not valid: $out"; return 1; }
  echo "$out"
}
comp_installed() {   # <component> <hub>: the installed version (X.Y.Z), or nothing when it is not in use here
  local v="" top
  case "$1" in
    ade-cli) v="$ADE_VERSION" ;;
    ade-brain) [ -n "$2" ] && [ -f "$2/VERSION" ] && v="$(tr -d ' \r\n' < "$2/VERSION")" ;;
    ade-method) top="$(git rev-parse --show-toplevel 2> /dev/null)" && [ -f "$top/.ade/method-version" ] && v="$(tr -d ' \r\n' < "$top/.ade/method-version")" ;;
    ade-skills) [ -n "$(ade_plugins)" ] && v="$ADE_SKILLS_REF" ;;
    ade-agent-registry) top="$(git rev-parse --show-toplevel 2> /dev/null)" && [ -d "$top/.ade/agents" ] && v="$ADE_REGISTRY_REF" ;;
  esac
  v="${v#v}"; matches "$v" '^[0-9]+\.[0-9]+\.[0-9]+$' && echo "$v"
}
fetch_manifest() {   # <component>: its latest release.json, checked, into $UPD_DIR/<c>.latest; TERM stops the request
  local c="$1" tmp proto="=https" line cp=""
  file_urls_ok && proto="=https,file"
  tmp="$(mktemp "$UPD_DIR/.$c.XXXXXX")" || return 1
  trap '[ -z "$cp" ] || kill "$cp" 2> /dev/null; rm -f "$tmp"; exit 1' TERM
  curl --proto "$proto" --proto-redir "$proto" -fsSL --connect-timeout 2 --max-time 2 \
    "$ADE_RELEASES_BASE/better-ade/$c/releases/latest/download/release.json" -o "$tmp" 2> /dev/null < /dev/null & cp=$!
  if wait "$cp" && line="$(manifest_py "$tmp" "$c" latest)"; then printf '%s\n' "$line" > "$tmp.ok" && mv -f "$tmp.ok" "$UPD_DIR/$c.latest"; fi
  rm -f "$tmp" "$tmp.ok"
}
update_fetch_all() {   # the detached job: every component in use, side by side, within one 2-second budget
  local hub c pids="" w
  hub="$( (find_hub) 2> /dev/null)" || hub=""
  for c in $COMPONENTS; do
    comp_installed "$c" "$hub" > /dev/null 2>&1 || continue
    fetch_manifest "$c" & pids="$pids $!"
  done
  [ -n "$pids" ] || return 0
  # shellcheck disable=SC2086  # pids is a list on purpose
  { sleep 2; kill $pids 2> /dev/null; } & w=$!
  # shellcheck disable=SC2086
  wait $pids 2> /dev/null; kill "$w" 2> /dev/null; wait "$w" 2> /dev/null
}
auto_on() { [ "${ADE_NO_AUTO_UPDATE:-}" != 1 ] && [ "$(cat "$CONF_DIR/auto-update" 2> /dev/null)" != off ]; }
UPD_HUB=""; UPD_HUB_SET=0
upd_hub() { [ "$UPD_HUB_SET" = 1 ] || { UPD_HUB="$( (find_hub) 2> /dev/null)" || UPD_HUB=""; UPD_HUB_SET=1; }; }
update_check() {   # before a command: what the cache says (no request here), and once a day the detached fetch
  [ "${ADE_NO_UPDATE_CHECK:-}" = 1 ] && return 0
  ( umask 077; mkdir -p "$UPD_DIR" ) 2> /dev/null || return 0
  local now t
  update_auto_report
  now="$(date +%s)"; t="$(cat "$UPD_DIR/checked" 2> /dev/null)"; matches "$t" '^[0-9]+$' || t=0
  # a fetch job that died left its lock: after a minute it is stale
  [ -n "$(find "$UPD_DIR/fetching" -maxdepth 0 -mmin +1 2> /dev/null)" ] && rmdir "$UPD_DIR/fetching" 2> /dev/null
  if [ $((now - t)) -ge 86400 ] && mkdir "$UPD_DIR/fetching" 2> /dev/null; then
    echo "$now" > "$UPD_DIR/checked"
    ( trap '' HUP INT; update_fetch_all; rmdir "$UPD_DIR/fetching" ) < /dev/null > /dev/null 2>&1 &
  fi
  update_auto
  update_banners
  return 0
}
update_banners() {   # one line per component with a newer cached release, once per version (security: every command)
  local c ver urg min sum seen inst line
  for c in $COMPONENTS; do
    [ -f "$UPD_DIR/$c.latest" ] || continue
    IFS="$TAB" read -r ver urg min sum < "$UPD_DIR/$c.latest" || [ -n "$ver" ] || continue
    [ "$sum" = - ] && sum=""
    seen="$(cat "$UPD_DIR/$c.seen" 2> /dev/null)"
    [ "$urg" = security ] || [ "$ver" != "$seen" ] || continue
    upd_hub; inst="$(comp_installed "$c" "$UPD_HUB" 2> /dev/null)" || continue
    if ver_gt "$ver" "$inst"; then
      # one line of at most 80 columns (A18): the versions and the command, never the release's own text
      line="ade: $c $ver is out (you have $inst)$([ "$urg" = security ] && echo ' [security update]'): run ade update"
      [ "${#line}" -le 80 ] || line="ade: a newer $c is out: run ade update"; echo "$line" >&2
      [ "$ver" != "$seen" ] && update_telegram "$UPD_HUB" "$c $ver is out (you have $inst)${sum:+: $sum}"
    fi
    echo "$ver" > "$UPD_DIR/$c.seen"
  done
}
# update_auto: a newer ade-cli patch or minor release (or a security one) installs itself through self_update (the
# manifest's sha256, A11's rename) in a detached job; only when a person runs ade at a terminal, never in an agent
# session; once per version; the next command says how it went (update_auto_report)
update_auto() {
  local ver urg min sum
  [ -n "$ADE_VERSION" ] && [ -f "$UPD_DIR/ade-cli.latest" ] || return 0
  IFS="$TAB" read -r ver urg min sum < "$UPD_DIR/ade-cli.latest" || [ -n "$ver" ] || return 0
  ver_gt "$ver" "$ADE_VERSION" && auto_on || return 0
  agent_context && return 0
  [ -t 0 ] && [ -t 2 ] || return 0
  [ "$(cat "$UPD_DIR/ade-cli.tried" 2> /dev/null)" = "$ver" ] && return 0
  echo "$ver" > "$UPD_DIR/ade-cli.tried"
  if [ "$(major_of "$ver")" != "$(major_of "$ADE_VERSION")" ] || { [ "$min" != - ] && ver_gt "$min" "$ADE_VERSION"; }; then
    echo "ade: ade $ver is out (you have $ADE_VERSION); it asks first: run ade update" | cut -c1-80 >&2
    upd_hub; update_telegram "$UPD_HUB" "ade $ver is out (you have $ADE_VERSION); it needs ade update by hand"
    echo "$ver" > "$UPD_DIR/ade-cli.seen"; return 0
  fi
  mkdir "$UPD_DIR/installing" 2> /dev/null || return 0
  echo "ade: ade $ver is out (you have $ADE_VERSION); installing it in the background" | cut -c1-80 >&2
  echo "$ver" > "$UPD_DIR/ade-cli.seen"
  ( trap '' HUP INT; self_update 0 "$ver" > "$UPD_DIR/auto.log" 2>&1; echo "exit $?" >> "$UPD_DIR/auto.log"; rmdir "$UPD_DIR/installing" ) < /dev/null > /dev/null 2>&1 &
}
update_auto_report() {   # a finished auto-install, once: every line it printed (a failure keeps its reason)
  local f="$UPD_DIR/auto.log" last
  [ -f "$f" ] && [ ! -d "$UPD_DIR/installing" ] || return 0
  last="$(tail -1 "$f")"
  if [ "$last" = "exit 0" ]; then sed '$d' "$f" | no_ctl | sed 's/^ade: //; s/^/ade: auto-update: /' >&2
    upd_hub; update_telegram "$UPD_HUB" "ade updated itself: $(sed '$d' "$f" | tail -1 | no_ctl)"
  else sed '$d' "$f" | no_ctl | sed 's/^ade: //; s/^/ade: the auto-update failed: /' >&2; fi
  rm -f "$f"
}
major_of() { echo "${1%%.*}"; }
update_telegram() {   # <hub> <text>: one line through the orchestrator's channel when the hub has one (bin/chat send)
  [ -n "$1" ] && [ -n "$(conf_get "$1" HUB_CHANNELS)" ] && [ -x "$1/bin/chat" ] || return 0
  hub_run "$1" chat send "$2" < /dev/null > /dev/null 2>&1 || true
}
update_badge() {   # the number of components with a newer release, for ade ui's tab bar
  local hub n=0 c inst ver; hub="$( (find_hub) 2> /dev/null)" || hub=""
  for c in $COMPONENTS; do
    [ -f "$UPD_DIR/$c.latest" ] || continue; inst="$(comp_installed "$c" "$hub" 2> /dev/null)" || continue
    IFS="$TAB" read -r ver _ < "$UPD_DIR/$c.latest"; ver_gt "$ver" "$inst" && n=$((n + 1))
  done
  echo "$n"
}

# ade files, ade view and the link picker (story A15): read-only. The roots are the hub, the checkouts its ACCESS.md
# files list and the project of the working folder; a path outside them, or a link leading out of them, opens only
# after a yes typed at a terminal (never an agent or a pipe). Names and contents are data: no control character
# reaches the screen, and a path reaches a tool after "--", or absolute for the ones without it (xdg-open).
# The tools ade installs (Homebrew or apt, after a yes): .ade/context/hub-interface.md.
FILES_USAGE="usage: ade files [<folder>]"
VIEW_USAGE="usage: ade view [--code] <path[:line[:col]]>"
ROOTS=""
files_roots() {   # [folder]: physical paths of the hub, its checkouts and that folder's git project, one per line
  local hub f c b top
  if hub="$( (find_hub) 2> /dev/null)"; then
    (cd "$hub" && pwd -P)
    for f in "$hub"/projects/*/ACCESS.md "$hub"/ops/*/ACCESS.md; do
      [ -f "$f" ] || continue
      while IFS="$TAB" read -r c b; do
        # shellcheck disable=SC2088  # a literal ~ in ACCESS.md is expanded here on purpose
        case "$c" in "~/"*) c="$HOME/${c#\~/}" ;; esac
        [ -n "$c" ] && [ -d "$c" ] && (cd "$c" && pwd -P)
      done <<EOF
$(access_rows "$f")
EOF
    done
  fi
  top="$(cd "${1:-.}" 2> /dev/null && git rev-parse --show-toplevel 2> /dev/null)" && (cd "$top" && pwd -P)
  return 0
}
on_ssh() { [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; }
# files_confirm <question>: a yes typed at a terminal; anything else exits 2 with nothing opened
files_confirm() {
  agent_context && die 2 "$1: ade asks a person at a terminal first; refused inside a Claude Code session (an agent cannot answer for you); nothing opened"
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || die 2 "$1: ade asks a person at a terminal first; refused without one; nothing opened"
  tty_confirm "$1. Open it anyway?" || die 2 "nothing opened"
}
# files_target <path[:line[:col]]> <folder it is relative to>: FT_PATH FT_LINE, then (after a yes when it leads out of
# the roots) FT_KIND (dir pdf image markdown text binary unreadable) FT_CTL (control characters in it) FT_OPENABLE (o may open it: a document)
# FT_SHOWN and FT_SHOWN_REAL are the names as Python's shown() draws them (control, C1, bidi and zero-width characters
# and bytes that are not UTF-8 become ?): every message that names a file uses them, never the raw name
files_target() {
  local out w
  out="$(files_py where "$1" "$2")" || exit 2
  IFS="$US" read -r FT_PATH FT_LINE w FT_REAL FT_SHOWN FT_SHOWN_REAL FT_COL <<EOF
$out
EOF
  [ "$w" != missing ] || die 2 "no such file or folder: $FT_SHOWN"
  case "$w" in
    out) files_confirm "$FT_SHOWN is outside the hub and its projects" ;;
    link-out) files_confirm "$FT_SHOWN is a link to $FT_SHOWN_REAL, outside the hub and its projects" ;;
  esac
  IFS="$US" read -r FT_KIND FT_CTL FT_OPENABLE <<EOF
$(files_py kind "$FT_PATH")
EOF
  [ "$FT_KIND" != unreadable ] || die 1 "cannot read $FT_SHOWN (not a readable regular file)"
}
hint_once() {   # <tool> <what ade does without it>: one line, the first time only (~/.config/ade/hints)
  [ -f "$CONF_DIR/hints" ] && grep -qxF -- "$1" "$CONF_DIR/hints" && return 0
  echo "ade: $1 is not installed, so $2; ade setup --tools installs it (said once)" >&2
  { [ -f "$CONF_DIR/hints" ] && cat "$CONF_DIR/hints"; echo "$1"; } | write_conf_file hints
}

cmd_files() {
  [ "${1:-}" = --act ] && { shift; files_act "$@"; return; }
  [ $# -le 1 ] || die 2 "$FILES_USAGE"
  local d
  if [ $# -eq 1 ]; then d="$1"; [ -n "$d" ] || die 2 "$FILES_USAGE"; else d="$( (find_hub) 2> /dev/null)" || d="$PWD"; fi
  ROOTS="$(files_roots .)"; files_target "$d" "$PWD"
  [ "$FT_KIND" = dir ] || die 2 "not a folder: $FT_SHOWN (ade view shows a file)"
  files_explore "$FT_PATH"
}
# files_explore <folder>: the built-in browser (read-only, held to the roots), on a terminal only. yazi only when the
# user asks for it with ADE_FILES=yazi: it is neither read-only nor held to the hub and its projects
YAZI_WARNING="yazi is neither read-only nor held to the hub and its projects: it can delete, rename, move and run commands, and walks anywhere without asking"
files_explore() {
  { [ -t 0 ] && [ -t 1 ]; } || die 2 "ade files needs a terminal (ade view <file> prints one file)"
  if [ "${ADE_FILES:-}" = yazi ]; then
    if command -v yazi > /dev/null 2>&1; then echo "ade: ADE_FILES=yazi: $YAZI_WARNING (not read-only)" >&2; yazi -- "$1"; return; fi
    echo "ade: ADE_FILES=yazi, but yazi is not installed; the built-in browser instead" >&2
  fi
  files_py explore "$1"
}

cmd_view() {
  local cwd="" arg="" n=0 code=0
  while [ $# -gt 0 ]; do case "$1" in
    --code) code=1; shift ;;
    --cwd) [ $# -ge 2 ] && [ -n "$2" ] && [ -d "$2" ] || die 2 "$VIEW_USAGE (--cwd needs a folder)"; cwd="$(cd -- "$2" && pwd)"; shift 2 ;;
    --) shift; [ $# -eq 1 ] || die 2 "$VIEW_USAGE"; arg="$1"; n=$((n + 1)); shift ;;
    *) arg="$1"; n=$((n + 1)); shift ;;
  esac; done
  [ "$n" = 1 ] && [ -n "$arg" ] || die 2 "$VIEW_USAGE"
  ROOTS="$(files_roots "${cwd:-.}")"; files_target "$arg" "${cwd:-$PWD}"
  # Visual Studio Code: asked for (--code), or the default for code and text files at a terminal (ADE_VIEWER=code)
  [ "$code" = 1 ] || { [ "${ADE_VIEWER:-}" = code ] && [ "$FT_KIND" = text ] && [ -t 1 ] && code=1; }
  if [ "$code" = 1 ]; then view_code "$FT_LINE" "$FT_COL" && return 0; echo "ade: $CODE_WHY; the built-in viewer instead" >&2; fi
  case "$FT_KIND" in
    dir) files_explore "$FT_PATH" ;;
    text|markdown) view_text ;;
    *)   # the page folder is ade's: made here, removed here even when the window is closed (Python removes it too)
      view_traps; VIEW_TMP="$(mk_tmp)" || die 1 "could not make a temp folder"
      ADE_SHOW_TMP="$VIEW_TMP" files_py show "$FT_KIND" "$FT_PATH" "$FT_OPENABLE"; local rc=$?
      rm_tmp "$VIEW_TMP"; trap - HUP TERM INT; return $rc ;;
  esac
}
# view_text: code at its line (bat, else less -N), Markdown through glow (else plain), from a copy without control
# characters when the file holds any (removed again even when the window is closed: HUP, TERM, INT). Every pager is
# less in secure mode (LESSSECURE=1: no v, !, |, :e; no LESSOPEN preprocessor), whatever PAGER says
VIEW_TMP=""
view_traps() { trap 'rm_tmp "$VIEW_TMP"; exit 129' HUP; trap 'rm_tmp "$VIEW_TMP"; exit 143' TERM; trap 'rm_tmp "$VIEW_TMP"; exit 130' INT; }
view_text() {
  local src="$FT_PATH" b l="$FT_LINE" rc
  if [ "$FT_CTL" = 1 ]; then
    view_traps; VIEW_TMP="$(mk_tmp)" || die 1 "could not make a temp folder"; src="$VIEW_TMP/$(basename "$FT_PATH")"; no_ctl < "$FT_PATH" > "$src"
    echo "ade: this file holds control characters; they are not shown" >&2
  fi
  # story U6: a diagram stays its code here, with a line under it that says the browser draws it
  if [ "$FT_KIND" = markdown ] && grep -Eq '^ {0,3}(```|~~~)[ ]*mermaid' -- "$src" 2> /dev/null; then
    if [ -z "${VIEW_TMP:-}" ]; then view_traps; VIEW_TMP="$(mk_tmp)" || die 1 "could not make a temp folder"; fi
    b="$VIEW_TMP/diagram-$(basename "$FT_PATH")"
    awk '{ print } /^ *(```|~~~) *mermaid/ && !in_m { in_m = 1; next } in_m && /^ *(```|~~~) *$/ { in_m = 0; print "diagram: w draws it in the browser (ade docs --web)" }' "$src" > "$b" && src="$b"
  fi
  LESSSECURE=1; LESSOPEN=""; LESSCLOSE=""; export LESSSECURE LESSOPEN LESSCLOSE
  if [ "$FT_KIND" = markdown ] && [ "$l" = 0 ] && command -v glow > /dev/null 2>&1; then PAGER="less -r" glow -p -- "$src"; rc=$?
  elif b="$(tool_bin bat)"; then
    if [ "$l" -gt 0 ]; then "$b" --style=numbers --highlight-line "$l" --pager "less -RF +${l}g" -- "$src"; else "$b" --style=numbers --pager "less -RF" -- "$src"; fi; rc=$?
  elif [ "$FT_KIND" = markdown ] && [ "$l" = 0 ]; then hint_once glow "Markdown is shown as plain text"; less -- "$src"; rc=$?
  else
    hint_once bat "code has no syntax colours (less -N)"
    if [ "$l" -gt 0 ]; then less -N "+${l}g" -- "$src"; else less -N -- "$src"; fi; rc=$?
  fi
  rm_tmp "$VIEW_TMP"; trap - HUP TERM INT; return $rc
}

# The editor c runs (U1). ADE_EDITOR: code (the default), a JetBrains launcher (run as <launcher> --line N --column C
# <path>), or a command with {path} and, if wanted, {line} and {col}. Without ADE_EDITOR, a JetBrains terminal
# (TERMINAL_EMULATOR=JetBrains-JediTerm) uses the first launcher on PATH, else code. No shell ever runs it: a template
# is split on spaces into words, each placeholder is replaced inside its word, and the path is always one argument;
# a value with ; | & $ < > quotes, a backslash or a backtick outside the placeholders is refused.
JB_LAUNCHERS="idea pycharm webstorm goland rider clion phpstorm rubymine fleet"
ED_KIND=""; ED_CMD=""; ED_FROM=""; ED_WORDS=()
# editor_pick: ED_KIND code|jetbrains|template|none|refused, ED_CMD (the command as given), ED_FROM ADE_EDITOR|
# jetbrains|default, ED_WORDS (a template's words); CODE_WHY says why for none and refused
editor_pick() {
  local e="${ADE_EDITOR:-}" rest l; ED_CMD=""; ED_WORDS=(); CODE_WHY=""
  if [ -n "$e" ]; then ED_FROM=ADE_EDITOR
    rest="${e//\{path\}/}"; rest="${rest//\{line\}/}"; rest="${rest//\{col\}/}"
    case "$rest" in *[\;\|\&\$\`\<\>\'\"\\]*|*[[:cntrl:]]*)
      ED_KIND=refused; CODE_WHY="ADE_EDITOR is refused: ; | & \$ < > quotes, backslashes and backticks are not allowed outside {path} {line} {col} (no shell runs it)"; return 0 ;; esac
    case "$e" in
      *'{path}'*) IFS=' ' read -r -a ED_WORDS <<< "$e"; ED_CMD="${ED_WORDS[0]:-}"
        case "$ED_CMD" in ""|*'{'*) ED_KIND=refused; CODE_WHY="ADE_EDITOR is refused: it must start with the command, before {path}"; return 0 ;; esac
        ED_KIND=template; return 0 ;;
      code|*/code) ED_KIND=code; ED_CMD="$e"; return 0 ;;
    esac
    case " $JB_LAUNCHERS " in *" ${e##*/} "*) ED_KIND=jetbrains; ED_CMD="$e"; return 0 ;; esac
    ED_KIND=refused; CODE_WHY="ADE_EDITOR is refused: use code, a JetBrains launcher ($JB_LAUNCHERS) or a command with {path}"; return 0
  fi
  if [ "${TERMINAL_EMULATOR:-}" = JetBrains-JediTerm ]; then ED_FROM=jetbrains
    for l in $JB_LAUNCHERS; do command -v "$l" > /dev/null 2>&1 && { ED_KIND=jetbrains; ED_CMD="$l"; return 0; }; done
    command -v code > /dev/null 2>&1 && { ED_KIND=code; ED_CMD=code; return 0; }
    ED_KIND=none; CODE_WHY="no JetBrains launcher ($JB_LAUNCHERS) or code command is installed"; return 0
  fi
  ED_FROM=default; ED_KIND=code; ED_CMD=code
  command -v code > /dev/null 2>&1 || { ED_KIND=none; CODE_WHY="Visual Studio Code (the code command) is not installed; ade setup --tools installs it"; }
}
ed_label() { if [ "$ED_KIND" = code ]; then echo "Visual Studio Code"; else echo "${ED_CMD##*/}"; fi; }
# editor_line: what ade setup --check says c uses
editor_line() {
  local how n; editor_pick; n="${ED_CMD##*/}"
  case "$ED_KIND" in
    refused) echo "editor: refused ($CODE_WHY)"; return 0 ;;
    none) echo "editor: none (c prints the path; set ADE_EDITOR or install code)"; return 0 ;; esac
  case "$ED_FROM" in ADE_EDITOR) how=ADE_EDITOR ;; jetbrains) how="JetBrains, found in this terminal" ;; *) how="Visual Studio Code" ;; esac
  [ "$ED_FROM:$ED_KIND" != jetbrains:code ] || how="Visual Studio Code, no JetBrains launcher found"
  if command -v "$ED_CMD" > /dev/null 2>&1; then echo "editor: $n ($how; c in ade files and ade view)"; else echo "editor: $n ($how; not installed)"; fi
}
# editor_bin: the chosen editor's command as an absolute path (ED_BIN). Never a copy that lies inside the hub or a
# project being viewed, or a link from there: a repository must not choose the program ade runs.
ED_BIN=""
editor_bin() {
  local c w n="${ED_CMD##*/}"; ED_BIN=""
  case "$ED_KIND" in none|refused) return 1 ;; esac
  c="$(command -v "$ED_CMD" 2> /dev/null)"
  case "$c" in /*) [ -x "$c" ] && [ ! -d "$c" ] ;; *) false ;; esac || {
    if [ "$ED_KIND:$ED_FROM" = code:default ]; then CODE_WHY="Visual Studio Code (the code command) is not installed; ade setup --tools installs it"
    else CODE_WHY="$n is not installed (not on PATH)"; fi; return 1; }
  w="$(files_py where "$c" / | awk -F "$US" '{ print $3 }')"
  [ "$w" = out ] || { CODE_WHY="the $n command on PATH is inside the hub or project being viewed, so ade does not run it"; return 1; }
  ED_BIN="$c"
}
# ed_sub <word> <path> <line> <col>: each {path} {line} {col} replaced left to right; what is put in is never scanned again
ed_sub() {
  local w="$1" out="" r
  while :; do
    case "$w" in *'{'*) ;; *) break ;; esac
    out="$out${w%%\{*}"; r="${w#*\{}"
    case "$r" in path\}*) out="$out$2"; w="${r#path\}}" ;; line\}*) out="$out$3"; w="${r#line\}}" ;;
      col\}*) out="$out$4"; w="${r#col\}}" ;; *) out="$out{"; w="$r" ;; esac
  done
  printf '%s' "$out$w"
}
# view_code <line> <col>: FT_PATH (files_target checked it) in the chosen editor: a folder as a folder, a file at its
# line and column (code --goto <path>:<line>:<col>; <launcher> --line N --column C <path>; a template's words). The
# path is absolute and one argument, never a shell string. 1 = not opened, CODE_WHY says why (no editor, one inside
# the project, ADE_EDITOR refused, over SSH with no display)
view_code() {
  local l="${1:-0}" c="${2:-0}" w; local -a argv; [ "$l" -gt 0 ] || l=1; [ "$c" -gt 0 ] || c=1
  editor_pick
  case "$ED_KIND" in none|refused) return 1 ;; esac
  if [ "$ED_KIND" != template ] && on_ssh && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] \
    && ! { [ "$ED_KIND" = code ] && [ "${TERM_PROGRAM:-}" = vscode ]; } && ! { [ "$ED_KIND" = jetbrains ] && [ "${TERMINAL_EMULATOR:-}" = JetBrains-JediTerm ]; }; then
    CODE_WHY="over SSH with no display, $(ed_label) cannot open here"; return 1; fi
  editor_bin || return 1
  case "$ED_KIND" in
    code) if [ "$FT_KIND" = dir ]; then argv=("$FT_PATH"); else argv=(--goto "$FT_PATH:$l:$c"); fi ;;
    jetbrains) if [ "$FT_KIND" = dir ]; then argv=("$FT_PATH"); else argv=(--line "$l" --column "$c" "$FT_PATH"); fi ;;
    template) argv=(); for w in "${ED_WORDS[@]:1}"; do [ -n "$w" ] || continue; argv+=("$(ed_sub "$w" "$FT_PATH" "$l" "$c")"); done ;;
  esac
  "$ED_BIN" "${argv[@]}" || { CODE_WHY="$(ed_label) did not open it (${ED_CMD##*/} failed)"; return 1; }
}
# files_act open|reveal|copy|url <absolute path, or an http(s) URL>: the default app (never a program), the file
# manager, the clipboard, the browser; over SSH the path and a copy command instead.
# files_act code <absolute path> [line [col]]: the chosen editor (view_code); any regular file or folder
ACT_USAGE="usage: ade files --act open|reveal|copy|url <path> | --act code <path> [line [col]]"
files_act() {
  [ $# -eq 2 ] || { [ "${1:-}" = code ] && [ $# -ge 3 ] && [ $# -le 4 ] && matches "$3" '^[0-9]{1,9}$' && matches "${4:-0}" '^[0-9]{1,9}$'; } || die 2 "$ACT_USAGE"
  local act="$1" p="$2" shown
  case "$act" in
    url)   # plain printable ASCII only: no space, control, bidi or zero-width character can hide where it goes
      case "$p" in http://?*|https://?*) ;; *) die 2 "not a web link (http or https)" ;; esac
      [ -z "$(printf '%s' "$p" | LC_ALL=C tr -d '!-~')" ] || die 2 "a web link must be plain ASCII (no spaces, control, bidi or zero-width characters); nothing opened"
      FT_PATH="$p"; FT_SHOWN="$p" ;;
    open|reveal|copy|code) case "$p" in /*) ;; *) die 2 "not an absolute path" ;; esac
      ROOTS="$(files_roots .)"; files_target "$p" / ;;
    *) die 2 "$ACT_USAGE" ;;
  esac
  shown="$FT_SHOWN"
  if [ "$act" = code ]; then
    if view_code "${3:-0}" "${4:-0}"; then echo "opened in $(ed_label): $shown"
    else echo "$CODE_WHY; the path: $shown$([ "${3:-0}" -gt 0 ] && printf ':%s' "$3")$([ "${4:-0}" -gt 0 ] && printf ':%s' "$4")"; fi
    return 0
  fi
  if on_ssh; then
    echo "over SSH: $shown"
    [ "$act" = url ] || echo "to copy it to this computer: scp -s $(shq "$(uname -n 2> /dev/null || echo host):$FT_REAL") ."
    return 0
  fi
  [ "$act" = open ] && [ "$FT_OPENABLE" != 1 ] &&
    die 2 "$shown: o opens documents only (PDF, images, text, office, audio, video), never a program or a file that installs, mounts, unpacks or points elsewhere; f shows it in its folder"
  case "$act" in
    copy) clip_copy "$FT_PATH" && echo "copied the path: $shown" ;;
    *) if on_macos; then
        case "$act" in url) open "$FT_PATH" ;; open) open -- "$FT_PATH" ;; reveal) open -R -- "$FT_PATH" ;; esac
      else
        command -v xdg-open > /dev/null 2>&1 || die 2 "xdg-open is not installed (xdg-utils); the path: $shown"
        if [ "$act" = reveal ]; then xdg-open "$(dirname "$FT_PATH")"; else xdg-open "$FT_PATH"; fi
      fi ;;
  esac
}
clip_cmd() {   # the clipboard command here (pbcopy, wl-copy, xclip, xsel), or none (exit 1); ade ui's drag copies with it too
  if on_macos && command -v pbcopy > /dev/null 2>&1; then echo pbcopy
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy > /dev/null 2>&1; then echo wl-copy
  elif command -v xclip > /dev/null 2>&1; then echo "xclip -selection clipboard"
  elif command -v xsel > /dev/null 2>&1; then echo "xsel --clipboard --input"
  else return 1; fi
}
clip_copy() {   # <path>: onto the clipboard on stdin (clip_cmd), shell-quoted unless it is plain; none: say so
  local c v="$1"
  [ -z "$(printf '%s' "$v" | LC_ALL=C tr -d 'A-Za-z0-9_./@%+=:,-')" ] || v="$(shq "$v")"
  c="$(clip_cmd)" || { echo "no clipboard tool here (pbcopy, wl-copy, xclip or xsel); the path: ${FT_SHOWN:-$1}"; return 1; }
  printf '%s' "$v" | $c   # c: one of clip_cmd's commands, split into its words on purpose
}

# the tools ade uses: the required ones (checked by install.sh and ade setup) and the viewer extras (one step in ade
# setup); ade setup --tools installs what is missing with Homebrew (macOS) or apt (Ubuntu), after a yes at a terminal;
# bun comes from its own release (bun_install), with neither
REQUIRED_TOOLS="git python3 curl tmux gh gitleaks bun"   # curl before bun: bun_fetch downloads with it (A22)
EXTRA_TOOLS="yazi bat glow poppler chafa code"
tool_bin() { local c; for c in "$1" $([ "$1" = bat ] && echo batcat); do command -v "$c" 2> /dev/null && return 0; done; return 1; }   # Ubuntu names bat batcat
tool_present() { case "$1" in poppler) command -v pdftotext && command -v pdftoppm ;; *) tool_bin "$1" ;; esac > /dev/null 2>&1; }
tools_missing() { local t out=""; for t in "$@"; do tool_present "$t" || out="${out:+$out }$t"; done; echo "$out"; }
tool_what() {
  case "$1" in
    git) echo "required: hubs and projects are git repositories" ;; python3) echo "required: ade reads JSON with it" ;;
    curl) echo "required: ade downloads bun, Claude Code and its updates with it" ;;
    tmux) echo "required: ade ui" ;; gh) echo "required: ade hub new on GitHub" ;;
    gitleaks) echo "required: the hub's secret scan before each save" ;; bun) echo "required: the Telegram plugin runs on it" ;;
    yazi) echo "extra: ade files with ADE_FILES=yazi; not read-only" ;; bat) echo "extra: syntax colours in ade view, else less -N" ;;
    glow) echo "extra: Markdown rendered in ade view, else plain text" ;; poppler) echo "extra: PDF pages in ade view (pdftotext, pdftoppm)" ;;
    chafa) echo "extra: images on more terminals" ;; code) echo "extra: Visual Studio Code, for c in ade files and ade view" ;;
  esac
}
tool_pkg() { case "$1:$2" in brew:python3) echo python ;; brew:code) echo visual-studio-code ;; apt:poppler) echo poppler-utils ;; apt:yazi|apt:glow|apt:code) ;; *) echo "$2" ;; esac; }   # <brew|apt> <tool>
tool_page() {   # <tool>: where to get a tool apt does not have
  case "$1" in yazi) echo "https://github.com/sxyazi/yazi/releases (ade works without it)" ;; glow) echo "https://github.com/charmbracelet/glow/releases (ade works without it)" ;; esac
}
tools_report() {   # ade doctor: each tool, installed or missing
  local t; echo "ade tools:"
  for t in $REQUIRED_TOOLS $EXTRA_TOOLS; do
    if tool_present "$t"; then printf '  %-8s installed\n' "$t"; else printf '  %-8s missing (%s)\n' "$t" "$(tool_what "$t")"; fi
  done
  # Playwright's Chromium (ade shot): the hub's browser, found where the hub finds it; ade setup --tools does not install it
  if shot_py chromium > /dev/null 2>&1; then printf '  %-8s installed\n' chromium
  else printf '  %-8s missing (%s)\n' chromium "extra: ade shot url and ade shot agent; npx -y @playwright/mcp install-browser chromium"; fi
  # story U6: the diagram drawer (mermaid), pinned by its sha256; ade setup --diagrams fetches it
  if mermaid_present; then printf '  %-8s installed\n' mermaid
  else printf '  %-8s missing (%s)\n' mermaid "extra: diagrams in ade web's Docs page; ade setup --diagrams adds it"; fi
  [ -z "$(tools_missing $REQUIRED_TOOLS $EXTRA_TOOLS)" ] || echo "  ade setup --tools installs what is missing"
}
# install_why <file> <packages>: a failed install in one plain line, from the installer's own message; nothing when
# it is not one of the known ones. Homebrew: Command Line Tools that are too old, and a tap that is not trusted yet
# (Homebrew ignores a third-party tap until the person runs brew trust). ade says it and changes neither.
TOOLS_WHY=""
install_why() {
  local t; [ -n "$1" ] && [ -f "$1" ] || return 0
  t="$(LC_ALL=C tr -cd '\n -~' < "$1" | tr 'A-Z' 'a-z')"
  case "$t" in
    *"command line tools"*) echo "Homebrew needs newer Command Line Tools: run softwareupdate --install -a" ;;
    *"not trusted"*|*"tap trust"*) case "$2" in *" "*) echo "Homebrew does not trust one of its taps yet (see brew trust)" ;; *) echo "Homebrew does not trust the ${2##*/} tap yet" ;; esac ;;
  esac
}
tools_install() {   # <tool>...: the packages (pkgs_install), then bun from its release (bun_install); 1 = one is not installed
  local t bun=0 rc=0 others=(); TOOLS_WHY=""
  for t in "$@"; do if [ "$t" = bun ]; then bun=1; else others+=("$t"); fi; done
  [ "${#others[@]}" = 0 ] || pkgs_install "${others[@]}" || rc=1
  [ "$bun" = 0 ] || bun_install || rc=1
  return "$rc"
}
pkgs_install() {   # <tool>...: one question at a terminal, then brew install or apt-get install -y; 1 = not installed
  local m="" t p pkgs="" cmd pre rc tmp; TOOLS_WHY=""
  if on_macos; then command -v brew > /dev/null 2>&1 && m=brew; elif command -v apt-get > /dev/null 2>&1; then m=apt; fi
  if [ -z "$m" ]; then
    if on_macos; then echo "Homebrew is not installed (https://brew.sh), so ade cannot install: $*"
    else echo "no apt-get here, so ade cannot install: $*; use your package manager"; fi
    return 1
  fi
  for t in "$@"; do p="$(tool_pkg "$m" "$t")"
    if [ -n "$p" ]; then pkgs="${pkgs:+$pkgs }$p"
    elif [ "$t" = code ]; then echo "code: Visual Studio Code is not in apt; get it from https://code.visualstudio.com/download (ade adds no repository; ade works without it)"
    else echo "$t: not in apt; get it from $(tool_page "$t")"; fi
  done
  [ -n "$pkgs" ] || return 1
  # apt (A22): apt-get update first, always (a raw Ubuntu has no package lists yet, so install alone cannot find a
  # package), then apt-get install -y; with sudo unless ade runs as root, and nothing without either
  if [ "$m" = brew ]; then cmd="brew install $pkgs"; pre=""
  elif [ "$(id -u)" = 0 ]; then cmd="apt-get install -y $pkgs"; pre="apt-get update"
  else cmd="sudo apt-get install -y $pkgs"; pre="sudo apt-get update"
    command -v sudo > /dev/null 2>&1 || { echo "there is no sudo here, so ade cannot install: $pkgs; as root, run: apt-get update && apt-get install -y $pkgs"; return 1; }
  fi
  local all="${pre:+$pre && }$cmd"
  if agent_context; then echo "ade installs nothing from an agent session; run it yourself at a terminal: $all"; return 1; fi
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || { echo "to install them, run at a terminal: $all (or ade setup --tools)"; return 1; }
  tty_confirm "Install $pkgs now? This runs: $all" || { echo "nothing installed (later: ade setup --tools)"; return 1; }
  tmp="$(mk_tmp)" || tmp=""
  # pre, cmd: ade's own words (the package names above), split on purpose. Their lines are shown as they come and kept,
  # so a failure can be said in one plain line (install_why); ade repairs nothing itself (no brew trust)
  if [ -n "$pre" ]; then
    if [ -n "$tmp" ]; then $pre < /dev/tty 2>&1 | tee "$tmp/out"; rc="${PIPESTATUS[0]}"; else $pre < /dev/tty; rc=$?; fi
    if [ "$rc" != 0 ]; then [ -z "$tmp" ] || rm_tmp "$tmp"
      TOOLS_WHY="$pre failed (exit $rc), so nothing is installed; check the network and apt's sources"; echo "$TOOLS_WHY"; return 1; fi
  fi
  if [ -n "$tmp" ]; then $cmd < /dev/tty 2>&1 | tee "$tmp/out"; rc="${PIPESTATUS[0]}"; else $cmd < /dev/tty; rc=$?; fi
  if [ "$rc" = 0 ]; then [ -z "$tmp" ] || rm_tmp "$tmp"; echo "installed: $pkgs"; return 0; fi
  TOOLS_WHY="$(install_why "${tmp:+$tmp/out}" "$pkgs")"; [ -z "$tmp" ] || rm_tmp "$tmp"
  [ -n "$TOOLS_WHY" ] || TOOLS_WHY="$cmd failed (exit $rc)"
  echo "$TOOLS_WHY"; return 1
}
# bun (the Telegram plugin runs on it) is a required tool that ade installs itself, with neither Homebrew nor the Xcode
# Command Line Tools: the release zip for this OS and CPU from bun's GitHub release, its sha256 checked against the
# SHASUMS256.txt of that release, the one program in it put at ~/.bun/bin/bun (0755), where the hub's bin/chat finds it
# once ~/.bun/bin is on PATH. No script is piped to a shell, and Homebrew is never asked for bun. A bun already on PATH
# (Homebrew's, or any other) or in ~/.bun/bin is left alone. The version is pinned on the next line and nowhere else.
BUN_VERSION="1.4.4"   # the newest release at least two weeks old on 2026-11-23 (released 2026-10-22)
BUN_RELEASES="https://github.com/oven-sh/bun/releases"
BUN_RC_MARK="# added by ade: bun"
BUN_WHY=""; BUN_DETAILS=""
# bun_path: a bun in ~/.bun/bin that is not on PATH is found by ade and by what it runs (the hub's bin/chat); a bun
# already on PATH stays the one that is found. BUN_PATH_ADDED=1: ade put it there, so the person's own PATH lacks it
# and setup writes the start-file line (bun_rc), whoever installed bun
BUN_PATH_ADDED=""
bun_path() { command -v bun > /dev/null 2>&1 || ! [ -x "$HOME/.bun/bin/bun" ] || { PATH="$HOME/.bun/bin:$PATH"; export PATH; hash -r; BUN_PATH_ADDED=1; }; }
# bun_rc_due: bun is in ~/.bun/bin, the person's PATH lacks it, and this is a person at a terminal (setup then adds the line)
bun_rc_due() { [ "$BUN_PATH_ADDED" = 1 ] && [ -x "$HOME/.bun/bin/bun" ] && ! agent_context; }
bun_asset() {   # the release zip for this OS and CPU, without .zip; 1 = bun has none that ade knows
  local os cpu; os="$(uname -s 2> /dev/null)"; cpu="$(uname -m 2> /dev/null)"
  case "$os" in Darwin) os=darwin ;; Linux) os=linux ;; *) return 1 ;; esac
  case "$cpu" in arm64|aarch64) cpu=aarch64 ;; x86_64|amd64) cpu=x64 ;; *) return 1 ;; esac
  # an Intel shell on Apple silicon (Rosetta): the Apple silicon bun, as bun's own installer picks
  if [ "$os-$cpu" = darwin-x64 ] && [ "$(sysctl -n sysctl.proc_translated 2> /dev/null)" = 1 ]; then cpu=aarch64; fi
  echo "bun-$os-$cpu"
}
bun_get() {   # <url> <file>: https only, redirects too (file:// for tests); curl's own reason in <file>.err
  local proto="=https"; file_urls_ok && proto="=https,file"
  curl --proto "$proto" --proto-redir "$proto" --tlsv1.2 -fsSL --connect-timeout 20 --max-time 900 "$1" -o "$2" 2> "$2.err" < /dev/null
}
bun_fetch() {   # the pinned bun into ~/.bun/bin/bun; 1 = nothing installed, BUN_WHY (one plain line) and BUN_DETAILS say why
  local a tmp url want got dest="$HOME/.bun/bin"; BUN_WHY=""; BUN_DETAILS="bun's releases: github.com/oven-sh/bun/releases"
  a="$(bun_asset)" || { BUN_WHY="bun has no download for this computer ($(uname -s 2> /dev/null) $(uname -m 2> /dev/null))"; BUN_DETAILS="https://bun.sh/docs/installation lists the computers bun runs on"; return 1; }
  tmp="$(mk_tmp)" || { BUN_WHY="ade could not make a temp folder for the download"; return 1; }
  url="$BUN_RELEASES/download/bun-v$BUN_VERSION"
  if ! bun_get "$url/$a.zip" "$tmp/bun.zip"; then BUN_WHY="The download of bun $BUN_VERSION did not finish"; BUN_DETAILS="$(plain "$(tail -1 "$tmp/bun.zip.err" 2> /dev/null)")"
  elif ! bun_get "$url/SHASUMS256.txt" "$tmp/sums"; then BUN_WHY="The download of bun's SHASUMS256.txt did not finish; nothing installed"; BUN_DETAILS="$(plain "$(tail -1 "$tmp/sums.err" 2> /dev/null)")"
  else
    want="$(awk -v f="$a.zip" '$2 == f || $2 == "*" f { print $1; exit }' "$tmp/sums" 2> /dev/null)"; got="$(sha256_of "$tmp/bun.zip" 2> /dev/null)"
    if ! matches "$want" '^[0-9a-f]{64}$'; then BUN_WHY="SHASUMS256.txt names no sha256 for $a.zip; nothing installed"
    elif [ "$got" != "$want" ]; then BUN_WHY="$a.zip does not match its sha256; nothing installed"; BUN_DETAILS="SHASUMS256.txt of bun-v$BUN_VERSION names another sha256 for it"
    elif ! bun_unzip "$tmp/bun.zip" "$a/bun" "$tmp/bun"; then BUN_WHY="$a.zip could not be unpacked; nothing installed"
    elif ! chmod 755 "$tmp/bun" || [ "$("$tmp/bun" --version 2> /dev/null < /dev/null)" != "$BUN_VERSION" ]; then
      BUN_WHY="bun $BUN_VERSION does not run on this computer; nothing installed"; BUN_DETAILS="https://bun.sh/docs/installation lists the computers bun runs on"
    elif ! { mkdir -p "$dest" && cp "$tmp/bun" "$dest/bun.ade-tmp" && chmod 755 "$dest/bun.ade-tmp" && mv -f "$dest/bun.ade-tmp" "$dest/bun"; } 2> /dev/null; then
      rm -f "$dest/bun.ade-tmp"; BUN_WHY="ade could not write ~/.bun/bin/bun; nothing installed"; BUN_DETAILS="check that you can write in ~/.bun"
    fi
  fi
  [ -n "$BUN_DETAILS" ] || BUN_DETAILS="curl gave no reason; check the network"
  rm_tmp "$tmp"; [ -z "$BUN_WHY" ]
}
bun_unzip() {   # <zip> <member> <file>: that one member, as a file, and nothing else from the zip
  python3 -I - "$@" 2> /dev/null <<'PY' && [ -s "$3" ]
import sys, zipfile
z = zipfile.ZipFile(sys.argv[1]); i = z.getinfo(sys.argv[2])
if i.is_dir() or i.file_size > 1 << 30: sys.exit(1)
with z.open(i) as src, open(sys.argv[3], "wb") as dst:
    for block in iter(lambda: src.read(1 << 20), b""): dst.write(block)
PY
}
# bun_rc: ~/.bun/bin is not on PATH: this ade's own PATH (and so what it runs), and one marked line in the person's
# shell start file (~/.zshrc for zsh, ~/.bashrc for bash, ~/.profile otherwise), said first and never added twice
bun_rc() {
  local f line
  case ":$PATH:" in *":$HOME/.bun/bin:"*) [ "$BUN_PATH_ADDED" = 1 ] || return 0 ;; *) PATH="$HOME/.bun/bin:$PATH"; export PATH; hash -r ;; esac
  case "${SHELL:-}" in */zsh) f=.zshrc ;; */bash) f=.bashrc ;; *) f=.profile ;; esac
  ! grep -qF '.bun/bin' "$HOME/$f" 2> /dev/null && ! grep -qF 'BUN_INSTALL' "$HOME/$f" 2> /dev/null || return 0
  # shellcheck disable=SC2016  # the line as it goes into the file: the shell that reads it expands it
  line='export PATH="$HOME/.bun/bin:$PATH"'"   $BUN_RC_MARK"
  # shellcheck disable=SC2088  # a literal ~ for the person to read
  echo "~/.bun/bin is not on your PATH: ade adds one line to ~/$f, so a new"
  echo "terminal finds bun (this ade already does):"; echo "  $line"
  { { [ ! -s "$HOME/$f" ] || [ -z "$(tail -c 1 "$HOME/$f")" ] || echo; } && printf '%s\n' "$line"; } 2> /dev/null >> "$HOME/$f" ||
    echo "ade could not write ~/$f; add that line to it yourself"
}
bun_manual() {   # the manual steps: the same download, check and place, by hand; never a script piped to a shell
  local a; echo "To install bun $BUN_VERSION yourself:"
  if a="$(bun_asset)"; then
    echo "  1. from $BUN_RELEASES/tag/bun-v$BUN_VERSION"; echo "     download $a.zip and SHASUMS256.txt"
    echo "  2. shasum -a 256 $a.zip must print the sha256 that"; echo "     SHASUMS256.txt has for it"
    echo "  3. unzip $a.zip && mkdir -p ~/.bun/bin &&"; echo "     mv $a/bun ~/.bun/bin/bun"
  else echo "  https://bun.sh/docs/installation lists the computers bun runs on"; fi
  echo "then run ${ASK_AGAIN:-ade setup --tools}"
}
# bun_install [kind of failure]: after a yes at a terminal. 0 = installed and found; 1 = it failed and the person chose
# the manual steps (shown) or to go on; 2 = not tried (no yes, no terminal, an agent session). A failure goes through
# failed: try again, the manual steps, stop.
bun_install() {
  local kind="${1:-bun}"
  if agent_context; then echo "ade installs nothing from an agent session; run it yourself at a terminal: ade setup --tools"; return 2; fi
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || { echo "to install bun, run at a terminal: ade setup --tools"; return 2; }
  echo "bun $BUN_VERSION: ade downloads it from github.com/oven-sh/bun, checks its sha256 and"
  # shellcheck disable=SC2088  # a literal ~ for the person to read
  echo "puts it in ~/.bun/bin/bun. Homebrew is not used, and no script is run."
  tty_confirm "Install bun now?" || { echo "nothing installed (later: ade setup --tools)"; return 2; }
  while :; do
    echo "downloading bun $BUN_VERSION from github.com/oven-sh/bun"
    if bun_fetch; then bun_rc; hash -r; echo "installed: bun $BUN_VERSION in ~/.bun/bin/bun"; return 0; fi
    failed "$kind" "$BUN_WHY" "$BUN_DETAILS"
    [ "$CHOICE" = retry ] || { [ "$CHOICE" != manual ] || bun_manual; return 1; }
  done
}
setup_tools() {   # [required|extras]: ade setup --tools; what is missing, after a yes
  local req ext ASK_AGAIN="ade setup --tools"
  req="$(tools_missing $REQUIRED_TOOLS)"; ext="$(tools_missing $EXTRA_TOOLS)"
  case "${1:-}" in required) ext="" ;; extras) req="" ;; esac
  ! bun_rc_due || bun_rc
  [ -n "$req$ext" ] || { echo "tools: everything ade uses is installed"; return 0; }
  [ -n "$req" ] && echo "missing tools ade needs: $req"
  [ -n "$ext" ] && echo "missing viewer extras (ade works without them): $ext"
  case " $ext " in *" yazi "*) echo "  ade files uses yazi only with ADE_FILES=yazi: $YAZI_WARNING." ;; esac
  # shellcheck disable=SC2086  # tool names, one word each
  tools_install $req $ext
}
setup_tools_steps() {   # the first steps of ade setup: the required tools, then the viewer extras as one yes/no
  local req ext
  req="$(tools_missing $REQUIRED_TOOLS)"; ext="$(tools_missing $EXTRA_TOOLS)"
  ! bun_rc_due || bun_rc
  # shellcheck disable=SC2086
  [ -n "$req" ] && { echo "missing tools ade needs: $req"; tools_install $req || true; }
  # shellcheck disable=SC2086
  [ -n "$ext" ] && { echo "The viewer extras (ade files and ade view work without them): $ext"
    case " $ext " in *" yazi "*) echo "  ade files uses yazi only with ADE_FILES=yazi: $YAZI_WARNING." ;; esac
    tools_install $ext || true; }
  return 0
}

# files_py <op> [args]: where, kind, explore, show, pick. Run with -I (never a module from the folder being browsed);
# stdin stays the terminal. It opens files for reading only and writes only in its own temp folder.
files_py() {
  local src; IFS= read -r -d '' src <<'PY' || true
import base64, glob, os, re, select, shutil, signal, subprocess, sys, tempfile, termios, time
for s in (sys.stdout, sys.stderr): s.reconfigure(encoding="utf-8", errors="replace")
CHILD = []   # the tool running now (pdftoppm, chafa): stopped before a temp folder is removed
def _closed(n, _):   # a closed window (HUP) or a kill (TERM): the finally blocks still run, once
    for _s in (signal.SIGHUP, signal.SIGTERM): signal.signal(_s, signal.SIG_IGN)
    raise SystemExit(128 + n)
def run(cmd, **kw):   # a tool, remembered while it runs (an interruption leaves it for drop() to stop)
    c = subprocess.Popen(cmd, **kw); CHILD.append(c); rc = c.wait(); CHILD.remove(c); return rc
def drop(d):   # stop the running tool, then remove the folder (it may still have been writing into it)
    for c in list(CHILD):
        try: c.kill(); c.wait()
        except OSError: pass
    for _ in range(20):
        shutil.rmtree(d, ignore_errors=True)
        if not os.path.exists(d): return
        time.sleep(0.05)
for _s in (signal.SIGHUP, signal.SIGTERM): signal.signal(_s, _closed)
sys.stdin.reconfigure(encoding="utf-8", errors="replace")
op, A = sys.argv[1], sys.argv[2:]
ADE = [os.environ.get("ADE_BASH") or "bash", os.environ.get("ADE_SELF") or "ade"]
HOME = os.path.realpath(os.path.expanduser("~"))
def wide(r): return r in ("", "/", HOME) or HOME.startswith(r.rstrip("/") + "/")   # /, the home folder or a parent of it
ROOTS = [r.rstrip("/") for r in os.environ.get("ADE_ROOTS", "").split("\n") if r and not wide(r)]   # never wide
TMP = os.environ.get("ADE_TMP_ROOT") or "/tmp"
# drawn as ?: C0, DEL, C1, zero-width and bidi controls (a name that reads as another), and bytes that are not UTF-8
CTL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u200b-\u200f\u202a-\u202e\u2066-\u2069\udc80-\udcff]")
BAD = re.compile(rb"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
IMG = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".tif", ".tiff", ".heic")
# o opens documents only (an allow list, compared without case on the real path); nothing in a program's folder
DOC = {".pdf", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".tif", ".tiff", ".heic", ".txt", ".text", ".md", ".markdown",
       ".rtf", ".csv", ".tsv", ".log", ".json", ".yaml", ".yml", ".toml", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
       ".odt", ".ods", ".odp", ".pages", ".numbers", ".mp3", ".m4a", ".aac", ".wav", ".flac", ".ogg", ".opus", ".mp4", ".m4v",
       ".mov", ".mkv", ".webm", ".avi"}
PROG = {".app", ".command", ".tool", ".terminal", ".pkg", ".mpkg", ".prefpane", ".saver", ".kext", ".scptd", ".workflow",
        ".action", ".bundle", ".plugin", ".framework", ".appex", ".xpc", ".qlgenerator", ".mdimporter", ".dmg", ".zip",
        ".fileloc", ".webloc", ".inetloc", ".url", ".mobileconfig", ".desktop", ".appimage", ".jar", ".scpt", ".applescript"}
def in_program(real): return any(os.path.splitext(c)[1].lower() in PROG for c in real.split("/") if c)
def openable(p):   # a regular, non-executable document file, not inside a bundle, by its real path
    real = os.path.realpath(p)
    if in_program(real) or not os.path.isfile(real) or os.access(real, os.X_OK): return False
    return os.path.splitext(real)[1].lower() in DOC
AGENT = any(os.environ.get(v) for v in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SESSION_ID"))
def shown(s): return CTL.sub("?", s)
def inside(p): return any(p == r or p.startswith(r + "/") for r in ROOTS)
def where(p):   # in, out (not under a root) or link-out (a link under a root that leads out), and the real path
    real = os.path.realpath(p)
    if inside(real): return "in", real
    lex = os.path.join(os.path.realpath(os.path.dirname(p)), os.path.basename(p))
    return ("link-out" if inside(lex) and os.path.islink(lex) else "out"), real
def kind(p):
    if os.path.isdir(p): return "dir"
    if not os.path.isfile(p): return "unreadable"   # a pipe, a socket or a device: never opened (a pipe would block)
    try:
        with open(p, "rb") as f: head = f.read(8192)
    except OSError: return "unreadable"
    ext = os.path.splitext(p)[1].lower()
    if head.startswith(b"%PDF") or ext == ".pdf": return "pdf"
    if ext in IMG or head.startswith((b"\x89PNG\r\n\x1a\n", b"\xff\xd8\xff", b"GIF87a", b"GIF89a")): return "image"
    if b"\0" in head: return "binary"
    return "markdown" if ext in (".md", ".markdown") else "text"
def human(n):
    for u in ("bytes", "KB", "MB", "GB"):
        if n < 1024 or u == "GB": return ("%d %s" % (n, u)) if u == "bytes" else ("%.1f %s" % (n, u))
        n /= 1024.0
def dims(p):
    try:
        with open(p, "rb") as f: h = f.read(32)
    except OSError: return ""
    if h.startswith(b"\x89PNG") and len(h) >= 24: return "%dx%d png" % (int.from_bytes(h[16:20], "big"), int.from_bytes(h[20:24], "big"))
    if h[:6] in (b"GIF87a", b"GIF89a"): return "%dx%d gif" % (int.from_bytes(h[6:8], "little"), int.from_bytes(h[8:10], "little"))
    return os.path.splitext(p)[1].lstrip(".").lower() or "image"
def size():   # the terminal's size; one that reports none (a bare pty): COLUMNS and LINES, else 80x24
    try: c, r = os.get_terminal_size(sys.stdout.fileno())
    except OSError: c, r = 0, 0
    env = lambda k, d: int(os.environ[k]) if os.environ.get(k, "").isdigit() else d
    return (c or env("COLUMNS", 80)), (r or env("LINES", 24))
def rel(p):   # a path as the root it is under names it (hub/projects/api), else whole
    real = os.path.realpath(p)
    for r in sorted(ROOTS, key=len, reverse=True):
        if real == r or real.startswith(r + "/"): return os.path.basename(r) + real[len(r):]
    return p
def fit(s, n):   # a title that fits: the start is dropped, never the file name
    return s if len(s) <= n else "…" + s[len(s) - n + 1:]
def hyper(p, text):   # OSC 8: a file:// link where the terminal draws them (never inside tmux)
    e = os.environ.get
    if not sys.stdout.isatty() or e("TMUX") or not (e("TERM_PROGRAM") in ("iTerm.app", "WezTerm", "ghostty", "vscode") or e("VTE_VERSION") or e("KITTY_WINDOW_ID") or e("WT_SESSION")):
        return text
    return "\x1b]8;;file://%s\x1b\\%s\x1b]8;;\x1b\\" % (re.sub(r"[^A-Za-z0-9/._~-]", lambda m: "".join("%%%02X" % b for b in m.group(0).encode()), p), text)
def gfx():   # how this terminal draws an image: chafa, chafa-symbols (in tmux), iterm, kitty or none (over SSH always none)
    e = os.environ.get; chafa = shutil.which("chafa")
    if e("SSH_CONNECTION") or e("SSH_CLIENT") or e("SSH_TTY"): return "none"
    if e("TMUX"): return "chafa-symbols" if chafa else "none"
    if e("TERM_PROGRAM") in ("iTerm.app", "WezTerm") or e("LC_TERMINAL") == "iTerm2": return "chafa" if chafa else "iterm"
    if e("TERM_PROGRAM") == "ghostty" or e("TERM", "") in ("xterm-kitty", "xterm-ghostty") or e("KITTY_WINDOW_ID"): return "chafa" if chafa else "kitty"
    return "none"
def render(img, mode, cols, rows):
    if mode.startswith("chafa"):
        sys.stdout.flush()
        return run(["chafa", "--size", "%dx%d" % (cols, max(4, rows - 4))] + (["--format", "symbols"] if mode == "chafa-symbols" else []) + ["--", img]) == 0
    with open(img, "rb") as f: data = f.read()
    if mode == "iterm":
        sys.stdout.write("\x1b]1337;File=inline=1;size=%d;preserveAspectRatio=1:%s\x07\r\n" % (len(data), base64.b64encode(data).decode())); return True
    if mode == "kitty" and data.startswith(b"\x89PNG"):
        b = base64.b64encode(data).decode(); parts = [b[i:i + 4096] for i in range(0, len(b), 4096)]
        for i, c in enumerate(parts): sys.stdout.write("\x1b_G%sm=%d;%s\x1b\\" % ("f=100,a=T," if i == 0 else "", 0 if i == len(parts) - 1 else 1, c))
        sys.stdout.write("\r\n"); return True
    return False

class Term:   # the terminal in cbreak mode, read one key at a time; typed-ahead keys are kept (TCSANOW)
    def __init__(s): s.fd = sys.stdin.fileno(); s.old = termios.tcgetattr(s.fd)
    def raw(s):
        a = termios.tcgetattr(s.fd); a[3] &= ~(termios.ICANON | termios.ECHO); a[6][termios.VMIN] = 1; a[6][termios.VTIME] = 0
        termios.tcsetattr(s.fd, termios.TCSANOW, a)
    def cooked(s): termios.tcsetattr(s.fd, termios.TCSANOW, s.old)
    def ready(s): return select.select([s.fd], [], [], 0.05)[0]
    def key(s):
        b = os.read(s.fd, 1)
        if not b or b in (b"\x04", b"\x03"): return "quit"
        if b == b"\x1b":
            if s.ready() and os.read(s.fd, 1) in (b"[", b"O") and s.ready():
                return {b"A": "up", b"B": "down", b"C": "right", b"D": "left"}.get(os.read(s.fd, 1), "")
            return "esc"
        if b in (b"\r", b"\n"): return "enter"
        if b in (b"\x7f", b"\x08"): return "back"
        return b.decode("latin-1")
    def line(s, prompt):   # a line typed at the bottom row; esc or ^D cancel (None)
        buf = ""
        while True:
            cols, rows = size()
            sys.stdout.write("\x1b[%d;1H\x1b[K%s%s" % (rows, prompt, shown(buf)[-(cols - len(prompt) - 1):])); sys.stdout.flush()
            k = s.key()
            if k == "enter": return buf
            if k in ("esc", "quit"): return None
            if k == "back": buf = buf[:-1]
            elif len(k) == 1 and k.isprintable(): buf += k
    def ask(s, text):   # y at the bottom row; an agent session never answers
        if AGENT: return False
        cols, rows = size()
        sys.stdout.write("\x1b[%d;1H\x1b[K%s [y/N] " % (rows, shown(text)[:max(10, cols - 8)])); sys.stdout.flush()
        return s.key() in ("y", "Y")

def act(t, a, p):   # o f y through ade files --act (its checks, its tools); the last lines it printed
    t.cooked(); sys.stdout.write("\r\n"); sys.stdout.flush()
    r = subprocess.run(ADE + ["files", "--act", a, p], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    t.raw()
    msg = [l for l in r.stdout.decode("utf-8", "replace").splitlines() if l.strip()]
    return shown(" · ".join(msg[-2:])) if msg else ""
ACTS = {"o": "open", "f": "reveal", "y": "copy", "c": "code"}   # c: the editor (ADE_EDITOR; default Visual Studio Code)

def label(name, p):
    s = shown(name)
    if os.path.islink(p):
        w, _ = where(p)
        return s + ("" if w == "in" else " (outside: not followed)") + " -> " + shown(os.readlink(p))
    return s + ("/" if os.path.isdir(p) else "")
def listing(d):
    try: names = os.listdir(d)
    except OSError: return None
    names = sorted((n for n in names if n != ".git"), key=lambda n: (not os.path.isdir(os.path.join(d, n)), n.lower()))
    return [(label(n, os.path.join(d, n)), os.path.join(d, n)) for n in names]
def preview(p, h):
    w, real = where(p)
    if w == "link-out": return ["a link out of the hub and its projects:", shown(real), "", "not followed; Enter asks first"]
    if w != "in": return ["no preview outside the hub and its projects", "", "Enter asks first"]
    if os.path.isdir(p):
        items = listing(p)
        return ["(cannot read this folder)"] if items is None else ([l for l, _ in items][:h] or ["(empty folder)"])
    k = kind(p); n = os.path.getsize(p) if os.path.isfile(p) else 0
    if k == "pdf": return ["PDF document, %s" % human(n), "", "Enter shows its pages"]
    if k == "image": return ["image %s, %s" % (dims(p), human(n)), "", "Enter shows it; o opens it"]
    if k in ("binary", "unreadable"): return ["%s file, %s" % (k, human(n)), "", "o opens it in its app"]
    with open(p, "rb") as f: head = f.read(65536)
    return [shown(l.decode("utf-8", "replace").expandtabs(4)) for l in head.splitlines()[:h]]
def search(base, word):   # names under base that hold the word; links are listed, never entered; 3 s at most
    out, wl, t0 = [], word.lower(), time.time()
    for dp, dns, fns in os.walk(base):
        dns[:] = sorted(d for d in dns if d != ".git")
        for n in sorted(dns + fns):
            if wl in n.lower():
                p = os.path.join(dp, n); out.append((label(os.path.relpath(p, base), p), p))
        if len(out) >= 500 or time.time() - t0 > 3: break
    return out

ALLOWED = []   # folders outside the roots a yes let the explorer list (never previewed)
def allowed(real): return any(real == a or real.startswith(a + "/") for a in ALLOWED)
def explore(start):
    w, real = where(start)
    if w != "in" and not wide(real): ALLOWED.append(real)   # ade files asked before it started here
    t = Term(); cur = start; ents = listing(cur) or []; res = None; sel = top = 0; msg = ""; q = ""
    def draw():
        cols, rows = size(); h = max(1, rows - 2); items = res if res is not None else ents
        lw = cols if cols < 70 else max(24, cols * 2 // 5)
        tail = "  · search: " + shown(q) if res is not None else ""
        title = "ade files · " + fit(shown(rel(cur)), max(8, cols - 12 - len(tail))) + tail
        pv = preview(items[sel][1], h) if items and cols >= 70 else []
        out = ["\x1b[H\x1b[2J\x1b[1m" + (title[:cols] if in_program(os.path.realpath(cur)) else hyper(cur, title[:cols])) + "\x1b[0m\r\n"]
        for i in range(h):
            j = top + i; left = items[j][0][:lw - 1].ljust(lw - 1) if j < len(items) else ("(empty folder)" if i == 0 and not items else "").ljust(lw - 1)
            ln = ("\x1b[7m" + left + "\x1b[0m") if j == sel and j < len(items) else left
            if i < len(pv): ln += " │ " + pv[i][:cols - lw - 2]
            out.append(ln.rstrip() + "\r\n")
        out.append((msg or "j/k · Enter open · h up · / search · o app · c code · f reveal · y copy · q quit")[:cols])
        sys.stdout.write("".join(out)); sys.stdout.flush()
    def enter(d, came=None):
        nonlocal cur, ents, sel, top, res, msg
        w, real = where(d)
        if w != "in" and not allowed(real):
            if not t.ask("%s outside the hub and its projects. Open it anyway?" % ("%s is" % shown(d) if w == "out" else "%s is a link to %s," % (shown(d), shown(real)))):
                msg = "refused inside an agent session" if AGENT else "not opened"; return
            if not wide(real): ALLOWED.append(real)   # listed from now on, never previewed; never /, home or a parent of it
        items = listing(d)
        if items is None: msg = "cannot read %s" % shown(d); return
        cur, ents, res, top = d, items, None, 0
        sel = next((i for i, (_, p) in enumerate(items) if p == came), 0)
    sys.stdout.write("\x1b[?1049h\x1b[?25l"); t.raw()
    try:
        while True:
            items = res if res is not None else ents
            sel = max(0, min(sel, len(items) - 1)); _, rows = size(); h = max(1, rows - 2)
            top = min(max(top, sel - h + 1), sel)
            draw(); msg = ""; k = t.key()
            p = items[sel][1] if items else None
            if k in ("q", "quit") or (k == "esc" and res is None): break
            elif k in ("j", "down"): sel += 1
            elif k in ("k", "up"): sel -= 1
            elif k == "esc": res = None; sel = 0
            elif k in ("h", "left", "back"):
                if res is not None: res = None; sel = 0
                elif os.path.dirname(cur) != cur: enter(os.path.dirname(cur), cur)
            elif k == "/":
                q = t.line("/ ") or ""
                if q:
                    found = search(cur, q)
                    if found: res, sel, top = found, 0, 0
                    else: msg = "no name under this folder holds %s" % shown(q)
            elif k in ("enter", "l", "right") and p:
                if os.path.isdir(p): enter(p)
                else:
                    t.cooked(); sys.stdout.write("\x1b[?1049l\x1b[?25h"); sys.stdout.flush()
                    rc = subprocess.call(ADE + ["view", "--", p])
                    if rc not in (0, 130): sys.stdout.write("(ade view exit %d; a key returns) " % rc); sys.stdout.flush(); t.raw(); t.key()
                    sys.stdout.write("\x1b[?1049h\x1b[?25l"); t.raw()
            elif k in ACTS and p: msg = act(t, ACTS[k], p)
    finally:
        t.cooked(); sys.stdout.write("\x1b[?25h\x1b[?1049l"); sys.stdout.flush()

def show(k, p, prog):   # a PDF (pages, n/p, g, /), an image or a binary file, with o f y
    name = os.path.basename(p); tty = sys.stdin.isatty() and sys.stdout.isatty(); mode = gfx() if tty else "none"
    n = os.path.getsize(p); pages = [""]; note = ""
    if k == "pdf":
        if not shutil.which("pdftotext"):
            print("ade: pdftotext is not installed (poppler), so ade cannot show %s; ade setup --tools installs it (o opens it in your PDF app)" % shown(name))
            if not tty: return 2
        else:
            r = subprocess.run(["pdftotext", "-layout", "--", p, "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if r.returncode != 0: print("ade: pdftotext could not read %s" % shown(name)); return 1
            pages = r.stdout.decode("utf-8", "replace").split("\f")
            if len(pages) > 1 and not pages[-1].strip(): pages.pop()
            if mode != "none" and not shutil.which("pdftoppm"): note = "pdftoppm (poppler) is not installed: text pages; ade setup --tools installs it"
    if not tty:
        if k != "pdf": print("%s: %s, %s (ade view on a terminal: o opens it)" % (shown(name), "image " + dims(p) if k == "image" else k + " file", human(n))); return 0
        for i, pg in enumerate(pages): print("--- %s · page %d/%d ---\n%s" % (shown(name), i + 1, len(pages), shown(pg).rstrip("\n")))
        return 0
    t = Term(); i = 0; msg = note; tmp = ""
    try:
        tmp = os.environ.get("ADE_SHOW_TMP") or tempfile.mkdtemp(prefix="ade.", dir=TMP); t.raw()
        while True:
            cols, rows = size(); drawn = False
            head = "%s · page %d/%d" % (shown(name), i + 1, len(pages)) if k == "pdf" else "%s · %s, %s" % (shown(name), "image " + dims(p) if k == "image" else k + " file", human(n))
            sys.stdout.write("\x1b[H\x1b[2J\x1b[1m" + (hyper(p, fit(head, cols)) if prog == "1" and k != "binary" else fit(head, cols)) + "\x1b[0m\r\n")
            if k == "pdf" and mode != "none" and shutil.which("pdftoppm") and pages != [""]:
                for f in glob.glob(os.path.join(tmp, "*.png")): os.remove(f)
                run(["pdftoppm", "-f", str(i + 1), "-l", str(i + 1), "-png", "-r", "110", "--", p, os.path.join(tmp, "page")], stderr=subprocess.DEVNULL)
                got = sorted(glob.glob(os.path.join(tmp, "page*.png")))
                drawn = bool(got) and render(got[0], mode, cols, rows)
            elif k == "image" and mode != "none": drawn = render(p, mode, cols, rows)
            if not drawn:
                if k == "pdf": sys.stdout.write("".join(shown(l.expandtabs(4))[:cols] + "\r\n" for l in pages[i].splitlines()[:rows - 3]))
                elif k == "image": sys.stdout.write("image: %s, %s (o to open)\r\n" % (dims(p), human(n)))
                else: sys.stdout.write("%s file: %s (o opens it in its app, f shows it in its folder)\r\n" % (k, human(n)))
            keys = ("n next · p previous · g go to page · / search · " if k == "pdf" else "") + "o open · c code · f reveal · y copy path · q quit"
            sys.stdout.write("\x1b[%d;1H\x1b[K%s" % (rows, (msg or keys)[:cols])); sys.stdout.flush(); msg = ""
            c = t.key()
            if c in ("q", "quit", "esc"): break
            if k == "pdf" and c in ("n", " ", "right", "j", "down"): i = min(len(pages) - 1, i + 1)
            elif k == "pdf" and c in ("p", "left", "k", "up", "b"): i = max(0, i - 1)
            elif k == "pdf" and c == "g":
                s = (t.line("page: ") or "").strip()
                if s.isdigit() and 1 <= int(s) <= len(pages): i = int(s) - 1
                elif s: msg = "no page %s (1-%d)" % (shown(s), len(pages))
            elif k == "pdf" and c == "/":
                s = (t.line("search: ") or "").strip().lower()
                if s:
                    hit = next((j % len(pages) for j in range(i + 1, i + 1 + len(pages)) if s in pages[j % len(pages)].lower()), None)
                    if hit is None: msg = "not found: %s" % shown(s)
                    else: i = hit; msg = "found on page %d" % (hit + 1)
            elif c in ACTS: msg = act(t, ACTS[c], p)
    finally:
        if tmp: drop(tmp)
        try: t.cooked(); sys.stdout.write("\r\n"); sys.stdout.flush()
        except (OSError, termios.error): pass
    return 0

URL = re.compile(r"https?://[^\s<>\"'`()\[\]{}]+")
MD = re.compile(r"\[[^\]\n]*\]\(([^)\s]+)\)")
PATH = re.compile(r"(?<![\w/.~:-])((?:~/|\.{1,2}/|/)?[\w.@+-]+(?:/[\w.@+-]+)*)(?::(\d+)(?::(\d+))?)?")
def find_links(text, cwd):   # files that exist (path, path:line, path:line:col, Markdown links) and http(s) URLs, in order
    found, seen = [], set()
    def is_file(tok): return os.path.isfile(os.path.join(cwd, os.path.expanduser(tok) if tok.startswith("~/") else tok))
    def add(pos, k, d):
        if (k, d) not in seen: seen.add((k, d)); found.append((pos, k, d))
    for no, line in enumerate(text.splitlines()):
        line = CTL.sub(" ", line); taken = [False] * len(line)
        def take(m):
            if any(taken[m.start():m.end()]): return False
            taken[m.start():m.end()] = [True] * (m.end() - m.start()); return True
        for m in MD.finditer(line):
            take(m); tg = m.group(1).strip("<>")
            if URL.fullmatch(tg): add((no, m.start()), "url", tg)
            else:
                f = tg.split("#", 1)[0]; mm = re.fullmatch(r"(.+?)(?::\d+){0,2}", f)
                if f and mm and is_file(mm.group(1)): add((no, m.start()), "file", f)
        for m in URL.finditer(line):
            if take(m): add((no, m.start()), "url", m.group(0).rstrip(".,;:!?"))
        for m in PATH.finditer(line):
            tok = m.group(1).rstrip(".")
            if ("/" in tok or "." in tok.lstrip(".")) and is_file(tok) and take(m):
                add((no, m.start()), "file", tok + (":" + m.group(2) if m.group(2) else "") + (":" + m.group(3) if m.group(2) and m.group(3) else ""))
    found.sort(); return [(k, d) for _, k, d in found][-60:]
def pick(pane, cwd):
    with open(pane, encoding="utf-8", errors="replace") as f: items = find_links(f.read(), cwd)
    if not items:
        print("no file paths or links in this pane")
        if sys.stdin.isatty():
            try: input("(Enter closes) ")
            except EOFError: pass
        return 0
    while True:
        print("Paths and links in this pane (a file opens in ade view, a link in your browser):")
        for i, (k, d) in enumerate(items, 1): print("  %2d  %s" % (i, shown(d)))
        try: s = input("Open which? (a number; a number then c: in your editor; Enter closes) ").strip()
        except EOFError: return 0
        if not s: return 0
        m = re.fullmatch(r"(\d{1,4}) ?([cC]?)", s)
        if not m or not 1 <= int(m.group(1)) <= len(items): print("no such number: %s" % shown(s)); continue
        k, d = items[int(m.group(1)) - 1]
        subprocess.call(ADE + (["files", "--act", "url", d] if k == "url" else ["view", "--cwd", cwd] + (["--code"] if m.group(2) else []) + ["--", d]))

try:
    if op == "where":
        arg, cwd = A[0], A[1] or os.getcwd()
        def absp(a): return os.path.normpath(os.path.join(cwd, os.path.expanduser(a) if a == "~" or a.startswith("~/") else a))
        p, line, col = absp(arg), 0, 0
        if not os.path.lexists(p):
