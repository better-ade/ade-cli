}
# update_auto: a newer ade-cli patch or minor release (or a security one) installs itself through self_update (the
# manifest's sha256, A11's rename) in a detached job; only when a person runs ade at a terminal, never in an agent
# session; once per version; the next command says how it went (update_auto_report)
update_auto() {
  local ver urg min sum
  [ -n "$ADE_VERSION" ] && [ -f "$UPD_DIR/ade-cli.latest" ] || return 0
  IFS="$TAB" read -r ver urg min sum < "$UPD_DIR/ade-cli.latest" || [ -n "$ver" ] || return 0
  ver_gt "$ver" "$ADE_VERSION" && auto_on || return 0
  agent_context && return 0
  [ -t 0 ] && [ -t 2 ] || return 0
  [ "$(cat "$UPD_DIR/ade-cli.tried" 2> /dev/null)" = "$ver" ] && return 0
  echo "$ver" > "$UPD_DIR/ade-cli.tried"
  if [ "$(major_of "$ver")" != "$(major_of "$ADE_VERSION")" ] || { [ "$min" != - ] && ver_gt "$min" "$ADE_VERSION"; }; then
    echo "ade: ade $ver is out (you have $ADE_VERSION); it asks first: run ade update" | cut -c1-80 >&2
    upd_hub; update_telegram "$UPD_HUB" "ade $ver is out (you have $ADE_VERSION); it needs ade update by hand"
    echo "$ver" > "$UPD_DIR/ade-cli.seen"; return 0
  fi
  mkdir "$UPD_DIR/installing" 2> /dev/null || return 0
  echo "ade: ade $ver is out (you have $ADE_VERSION); installing it in the background" | cut -c1-80 >&2
  echo "$ver" > "$UPD_DIR/ade-cli.seen"
  ( trap '' HUP INT; self_update 0 "$ver" > "$UPD_DIR/auto.log" 2>&1; echo "exit $?" >> "$UPD_DIR/auto.log"; rmdir "$UPD_DIR/installing" ) < /dev/null > /dev/null 2>&1 &
}
update_auto_report() {   # a finished auto-install, once: every line it printed (a failure keeps its reason)
  local f="$UPD_DIR/auto.log" last
  [ -f "$f" ] && [ ! -d "$UPD_DIR/installing" ] || return 0
  last="$(tail -1 "$f")"
  if [ "$last" = "exit 0" ]; then sed '$d' "$f" | no_ctl | sed 's/^ade: //; s/^/ade: auto-update: /' >&2
    upd_hub; update_telegram "$UPD_HUB" "ade updated itself: $(sed '$d' "$f" | tail -1 | no_ctl)"
  else sed '$d' "$f" | no_ctl | sed 's/^ade: //; s/^/ade: the auto-update failed: /' >&2; fi
  rm -f "$f"
}
major_of() { echo "${1%%.*}"; }
update_telegram() {   # <hub> <text>: one line through the orchestrator's channel when the hub has one (bin/chat send)
  [ -n "$1" ] && [ -n "$(conf_get "$1" HUB_CHANNELS)" ] && [ -x "$1/bin/chat" ] || return 0
  hub_run "$1" chat send "$2" < /dev/null > /dev/null 2>&1 || true
}
update_badge() {   # the number of components with a newer release, for ade ui's tab bar
  local hub n=0 c inst ver; hub="$( (find_hub) 2> /dev/null)" || hub=""
  for c in $COMPONENTS; do
    [ -f "$UPD_DIR/$c.latest" ] || continue; inst="$(comp_installed "$c" "$hub" 2> /dev/null)" || continue
    IFS="$TAB" read -r ver _ < "$UPD_DIR/$c.latest"; ver_gt "$ver" "$inst" && n=$((n + 1))
  done
  echo "$n"
}

# ade files, ade view and the link picker (story A15): read-only. The roots are the hub, the checkouts its ACCESS.md
# files list and the project of the working folder; a path outside them, or a link leading out of them, opens only
# after a yes typed at a terminal (never an agent or a pipe). Names and contents are data: no control character
# reaches the screen, and a path reaches a tool after "--", or absolute for the ones without it (xdg-open).
# The tools ade installs (Homebrew or apt, after a yes): .ade/context/hub-interface.md.
FILES_USAGE="usage: ade files [<folder>]"
VIEW_USAGE="usage: ade view [--code] <path[:line[:col]]>"
ROOTS=""
files_roots() {   # [folder]: physical paths of the hub, its checkouts and that folder's git project, one per line
  local hub f c b top
  if hub="$( (find_hub) 2> /dev/null)"; then
    (cd "$hub" && pwd -P)
    for f in "$hub"/projects/*/ACCESS.md "$hub"/ops/*/ACCESS.md; do
      [ -f "$f" ] || continue
      while IFS="$TAB" read -r c b; do
        # shellcheck disable=SC2088  # a literal ~ in ACCESS.md is expanded here on purpose
        case "$c" in "~/"*) c="$HOME/${c#\~/}" ;; esac
        [ -n "$c" ] && [ -d "$c" ] && (cd "$c" && pwd -P)
      done <<EOF
$(access_rows "$f")
EOF
    done
  fi
  top="$(cd "${1:-.}" 2> /dev/null && git rev-parse --show-toplevel 2> /dev/null)" && (cd "$top" && pwd -P)
  return 0
}
on_ssh() { [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; }
# files_confirm <question>: a yes typed at a terminal; anything else exits 2 with nothing opened
files_confirm() {
  agent_context && die 2 "$1: ade asks a person at a terminal first; refused inside a Claude Code session (an agent cannot answer for you); nothing opened"
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || die 2 "$1: ade asks a person at a terminal first; refused without one; nothing opened"
  tty_confirm "$1. Open it anyway?" || die 2 "nothing opened"
}
# files_target <path[:line[:col]]> <folder it is relative to>: FT_PATH FT_LINE, then (after a yes when it leads out of
# the roots) FT_KIND (dir pdf image markdown text binary unreadable) FT_CTL (control characters in it) FT_OPENABLE (o may open it: a document)
# FT_SHOWN and FT_SHOWN_REAL are the names as Python's shown() draws them (control, C1, bidi and zero-width characters
# and bytes that are not UTF-8 become ?): every message that names a file uses them, never the raw name
files_target() {
  local out w
  out="$(files_py where "$1" "$2")" || exit 2
  IFS="$US" read -r FT_PATH FT_LINE w FT_REAL FT_SHOWN FT_SHOWN_REAL FT_COL <<EOF
$out
EOF
  [ "$w" != missing ] || die 2 "no such file or folder: $FT_SHOWN"
  case "$w" in
    out) files_confirm "$FT_SHOWN is outside the hub and its projects" ;;
    link-out) files_confirm "$FT_SHOWN is a link to $FT_SHOWN_REAL, outside the hub and its projects" ;;
  esac
  IFS="$US" read -r FT_KIND FT_CTL FT_OPENABLE <<EOF
$(files_py kind "$FT_PATH")
EOF
  [ "$FT_KIND" != unreadable ] || die 1 "cannot read $FT_SHOWN (not a readable regular file)"
}
hint_once() {   # <tool> <what ade does without it>: one line, the first time only (~/.config/ade/hints)
  [ -f "$CONF_DIR/hints" ] && grep -qxF -- "$1" "$CONF_DIR/hints" && return 0
  echo "ade: $1 is not installed, so $2; ade setup --tools installs it (said once)" >&2
  { [ -f "$CONF_DIR/hints" ] && cat "$CONF_DIR/hints"; echo "$1"; } | write_conf_file hints
}

cmd_files() {
  [ "${1:-}" = --act ] && { shift; files_act "$@"; return; }
  [ $# -le 1 ] || die 2 "$FILES_USAGE"
  local d
  if [ $# -eq 1 ]; then d="$1"; [ -n "$d" ] || die 2 "$FILES_USAGE"; else d="$( (find_hub) 2> /dev/null)" || d="$PWD"; fi
  ROOTS="$(files_roots .)"; files_target "$d" "$PWD"
  [ "$FT_KIND" = dir ] || die 2 "not a folder: $FT_SHOWN (ade view shows a file)"
  files_explore "$FT_PATH"
}
# files_explore <folder>: the built-in browser (read-only, held to the roots), on a terminal only. yazi only when the
# user asks for it with ADE_FILES=yazi: it is neither read-only nor held to the hub and its projects
YAZI_WARNING="yazi is neither read-only nor held to the hub and its projects: it can delete, rename, move and run commands, and walks anywhere without asking"
files_explore() {
  { [ -t 0 ] && [ -t 1 ]; } || die 2 "ade files needs a terminal (ade view <file> prints one file)"
  if [ "${ADE_FILES:-}" = yazi ]; then
    if command -v yazi > /dev/null 2>&1; then echo "ade: ADE_FILES=yazi: $YAZI_WARNING (not read-only)" >&2; yazi -- "$1"; return; fi
    echo "ade: ADE_FILES=yazi, but yazi is not installed; the built-in browser instead" >&2
  fi
  files_py explore "$1"
}

cmd_view() {
  local cwd="" arg="" n=0 code=0
  while [ $# -gt 0 ]; do case "$1" in
    --code) code=1; shift ;;
    --cwd) [ $# -ge 2 ] && [ -n "$2" ] && [ -d "$2" ] || die 2 "$VIEW_USAGE (--cwd needs a folder)"; cwd="$(cd -- "$2" && pwd)"; shift 2 ;;
    --) shift; [ $# -eq 1 ] || die 2 "$VIEW_USAGE"; arg="$1"; n=$((n + 1)); shift ;;
    *) arg="$1"; n=$((n + 1)); shift ;;
  esac; done
  [ "$n" = 1 ] && [ -n "$arg" ] || die 2 "$VIEW_USAGE"
  ROOTS="$(files_roots "${cwd:-.}")"; files_target "$arg" "${cwd:-$PWD}"
  # Visual Studio Code: asked for (--code), or the default for code and text files at a terminal (ADE_VIEWER=code)
  [ "$code" = 1 ] || { [ "${ADE_VIEWER:-}" = code ] && [ "$FT_KIND" = text ] && [ -t 1 ] && code=1; }
  if [ "$code" = 1 ]; then view_code "$FT_LINE" "$FT_COL" && return 0; echo "ade: $CODE_WHY; the built-in viewer instead" >&2; fi
  case "$FT_KIND" in
    dir) files_explore "$FT_PATH" ;;
    text|markdown) view_text ;;
    *)   # the page folder is ade's: made here, removed here even when the window is closed (Python removes it too)
      view_traps; VIEW_TMP="$(mk_tmp)" || die 1 "could not make a temp folder"
      ADE_SHOW_TMP="$VIEW_TMP" files_py show "$FT_KIND" "$FT_PATH" "$FT_OPENABLE"; local rc=$?
      rm_tmp "$VIEW_TMP"; trap - HUP TERM INT; return $rc ;;
  esac
}
# view_text: code at its line (bat, else less -N), Markdown through glow (else plain), from a copy without control
# characters when the file holds any (removed again even when the window is closed: HUP, TERM, INT). Every pager is
# less in secure mode (LESSSECURE=1: no v, !, |, :e; no LESSOPEN preprocessor), whatever PAGER says
VIEW_TMP=""
view_traps() { trap 'rm_tmp "$VIEW_TMP"; exit 129' HUP; trap 'rm_tmp "$VIEW_TMP"; exit 143' TERM; trap 'rm_tmp "$VIEW_TMP"; exit 130' INT; }
view_text() {
  local src="$FT_PATH" b l="$FT_LINE" rc
  if [ "$FT_CTL" = 1 ]; then
    view_traps; VIEW_TMP="$(mk_tmp)" || die 1 "could not make a temp folder"; src="$VIEW_TMP/$(basename "$FT_PATH")"; no_ctl < "$FT_PATH" > "$src"
    echo "ade: this file holds control characters; they are not shown" >&2
  fi
  LESSSECURE=1; LESSOPEN=""; LESSCLOSE=""; export LESSSECURE LESSOPEN LESSCLOSE
  if [ "$FT_KIND" = markdown ] && [ "$l" = 0 ] && command -v glow > /dev/null 2>&1; then PAGER="less -r" glow -p -- "$src"; rc=$?
  elif b="$(tool_bin bat)"; then
    if [ "$l" -gt 0 ]; then "$b" --style=numbers --highlight-line "$l" --pager "less -RF +${l}g" -- "$src"; else "$b" --style=numbers --pager "less -RF" -- "$src"; fi; rc=$?
  elif [ "$FT_KIND" = markdown ] && [ "$l" = 0 ]; then hint_once glow "Markdown is shown as plain text"; less -- "$src"; rc=$?
  else
    hint_once bat "code has no syntax colours (less -N)"
    if [ "$l" -gt 0 ]; then less -N "+${l}g" -- "$src"; else less -N -- "$src"; fi; rc=$?
  fi
  rm_tmp "$VIEW_TMP"; trap - HUP TERM INT; return $rc
}

# code_bin: Visual Studio Code's command (code) as an absolute path, found once (CODE_BIN). Never a copy that lies
# inside the hub or a project being viewed, or a link from there: a repository must not choose the program ade runs.
CODE_BIN=""; CODE_WHY=""
code_bin() {
  local c w; [ -z "$CODE_BIN" ] || return 0
  c="$(command -v code 2> /dev/null)"
  case "$c" in /*) ;; *) CODE_WHY="Visual Studio Code (the code command) is not installed; ade setup --tools installs it"; return 1 ;; esac
  w="$(files_py where "$c" / | awk -F "$US" '{ print $3 }')"
  [ "$w" = out ] || { CODE_WHY="the code command on PATH is inside the hub or project being viewed, so ade does not run it"; return 1; }
  CODE_BIN="$c"
}
# view_code <line> <col>: FT_PATH (files_target checked it) in Visual Studio Code: a folder as a folder, a file at its
# line and column (code --goto <path>:<line>:<col>; the path is absolute and one argument, never a shell string).
# 1 = not opened, CODE_WHY says why (no code command, one inside the project, over SSH with no display)
view_code() {
  local l="${1:-0}" c="${2:-0}"; [ "$l" -gt 0 ] || l=1; [ "$c" -gt 0 ] || c=1
  if on_ssh && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ "${TERM_PROGRAM:-}" != vscode ]; then
    CODE_WHY="over SSH with no display, Visual Studio Code cannot open here"; return 1; fi
  code_bin || return 1
  if [ "$FT_KIND" = dir ]; then "$CODE_BIN" "$FT_PATH"; else "$CODE_BIN" --goto "$FT_PATH:$l:$c"; fi || { CODE_WHY="Visual Studio Code did not open it (code failed)"; return 1; }
}
# files_act open|reveal|copy|url <absolute path, or an http(s) URL>: the default app (never a program), the file
# manager, the clipboard, the browser; over SSH the path and a copy command instead.
# files_act code <absolute path> [line [col]]: Visual Studio Code (view_code); any regular file or folder
ACT_USAGE="usage: ade files --act open|reveal|copy|url <path> | --act code <path> [line [col]]"
files_act() {
  [ $# -eq 2 ] || { [ "${1:-}" = code ] && [ $# -ge 3 ] && [ $# -le 4 ] && matches "$3" '^[0-9]{1,9}$' && matches "${4:-0}" '^[0-9]{1,9}$'; } || die 2 "$ACT_USAGE"
  local act="$1" p="$2" shown
  case "$act" in
    url)   # plain printable ASCII only: no space, control, bidi or zero-width character can hide where it goes
      case "$p" in http://?*|https://?*) ;; *) die 2 "not a web link (http or https)" ;; esac
      [ -z "$(printf '%s' "$p" | LC_ALL=C tr -d '!-~')" ] || die 2 "a web link must be plain ASCII (no spaces, control, bidi or zero-width characters); nothing opened"
      FT_PATH="$p"; FT_SHOWN="$p" ;;
    open|reveal|copy|code) case "$p" in /*) ;; *) die 2 "not an absolute path" ;; esac
      ROOTS="$(files_roots .)"; files_target "$p" / ;;
    *) die 2 "$ACT_USAGE" ;;
  esac
  shown="$FT_SHOWN"
  if [ "$act" = code ]; then
    if view_code "${3:-0}" "${4:-0}"; then echo "opened in Visual Studio Code: $shown"; else echo "$CODE_WHY; the path: $shown"; fi
    return 0
  fi
  if on_ssh; then
    echo "over SSH: $shown"
    [ "$act" = url ] || echo "to copy it to this computer: scp -s $(shq "$(uname -n 2> /dev/null || echo host):$FT_REAL") ."
    return 0
  fi
  [ "$act" = open ] && [ "$FT_OPENABLE" != 1 ] &&
    die 2 "$shown: o opens documents only (PDF, images, text, office, audio, video), never a program or a file that installs, mounts, unpacks or points elsewhere; f shows it in its folder"
  case "$act" in
    copy) clip_copy "$FT_PATH" && echo "copied the path: $shown" ;;
    *) if on_macos; then
        case "$act" in url) open "$FT_PATH" ;; open) open -- "$FT_PATH" ;; reveal) open -R -- "$FT_PATH" ;; esac
      else
        command -v xdg-open > /dev/null 2>&1 || die 2 "xdg-open is not installed (xdg-utils); the path: $shown"
        if [ "$act" = reveal ]; then xdg-open "$(dirname "$FT_PATH")"; else xdg-open "$FT_PATH"; fi
      fi ;;
  esac
}
clip_copy() {   # <path>: onto the clipboard on stdin (pbcopy, wl-copy, xclip, xsel), shell-quoted unless it is plain; none: say so
  local c v="$1"
  [ -z "$(printf '%s' "$v" | LC_ALL=C tr -d 'A-Za-z0-9_./@%+=:,-')" ] || v="$(shq "$v")"
  if on_macos && command -v pbcopy > /dev/null 2>&1; then c=pbcopy
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy > /dev/null 2>&1; then c=wl-copy
  elif command -v xclip > /dev/null 2>&1; then c="xclip -selection clipboard"
  elif command -v xsel > /dev/null 2>&1; then c="xsel --clipboard --input"
  else echo "no clipboard tool here (pbcopy, wl-copy, xclip or xsel); the path: ${FT_SHOWN:-$1}"; return 1; fi
  printf '%s' "$v" | $c   # c: one of the commands above, split into its words on purpose
}

# the tools ade uses: the required ones (checked by install.sh and ade setup) and the viewer extras (one step in ade
# setup); ade setup --tools installs what is missing with Homebrew (macOS) or apt (Ubuntu), after a yes at a terminal;
# bun comes from its own release (bun_install), with neither
REQUIRED_TOOLS="git python3 curl tmux gh gitleaks bun"   # curl before bun: bun_fetch downloads with it (A22)
EXTRA_TOOLS="yazi bat glow poppler chafa code"
tool_bin() { local c; for c in "$1" $([ "$1" = bat ] && echo batcat); do command -v "$c" 2> /dev/null && return 0; done; return 1; }   # Ubuntu names bat batcat
tool_present() { case "$1" in poppler) command -v pdftotext && command -v pdftoppm ;; *) tool_bin "$1" ;; esac > /dev/null 2>&1; }
tools_missing() { local t out=""; for t in "$@"; do tool_present "$t" || out="${out:+$out }$t"; done; echo "$out"; }
tool_what() {
  case "$1" in
    git) echo "required: hubs and projects are git repositories" ;; python3) echo "required: ade reads JSON with it" ;;
    curl) echo "required: ade downloads bun, Claude Code and its updates with it" ;;
    tmux) echo "required: ade ui" ;; gh) echo "required: ade hub new on GitHub" ;;
    gitleaks) echo "required: the hub's secret scan before each save" ;; bun) echo "required: the Telegram plugin runs on it" ;;
    yazi) echo "extra: ade files with ADE_FILES=yazi; not read-only" ;; bat) echo "extra: syntax colours in ade view, else less -N" ;;
    glow) echo "extra: Markdown rendered in ade view, else plain text" ;; poppler) echo "extra: PDF pages in ade view (pdftotext, pdftoppm)" ;;
    chafa) echo "extra: images on more terminals" ;; code) echo "extra: Visual Studio Code, for c in ade files and ade view" ;;
  esac
}
tool_pkg() { case "$1:$2" in brew:python3) echo python ;; brew:code) echo visual-studio-code ;; apt:poppler) echo poppler-utils ;; apt:yazi|apt:glow|apt:code) ;; *) echo "$2" ;; esac; }   # <brew|apt> <tool>
tool_page() {   # <tool>: where to get a tool apt does not have
  case "$1" in yazi) echo "https://github.com/sxyazi/yazi/releases (ade works without it)" ;; glow) echo "https://github.com/charmbracelet/glow/releases (ade works without it)" ;; esac
}
tools_report() {   # ade doctor: each tool, installed or missing
  local t; echo "ade tools:"
  for t in $REQUIRED_TOOLS $EXTRA_TOOLS; do
    if tool_present "$t"; then printf '  %-8s installed\n' "$t"; else printf '  %-8s missing (%s)\n' "$t" "$(tool_what "$t")"; fi
  done
  # Playwright's Chromium (ade shot): the hub's browser, found where the hub finds it; ade setup --tools does not install it
  if shot_py chromium > /dev/null 2>&1; then printf '  %-8s installed\n' chromium
  else printf '  %-8s missing (%s)\n' chromium "extra: ade shot url and ade shot agent; npx -y @playwright/mcp install-browser chromium"; fi
  [ -z "$(tools_missing $REQUIRED_TOOLS $EXTRA_TOOLS)" ] || echo "  ade setup --tools installs what is missing"
}
# install_why <file> <packages>: a failed install in one plain line, from the installer's own message; nothing when
# it is not one of the known ones. Homebrew: Command Line Tools that are too old, and a tap that is not trusted yet
# (Homebrew ignores a third-party tap until the person runs brew trust). ade says it and changes neither.
TOOLS_WHY=""
install_why() {
  local t; [ -n "$1" ] && [ -f "$1" ] || return 0
  t="$(LC_ALL=C tr -cd '\n -~' < "$1" | tr 'A-Z' 'a-z')"
  case "$t" in
    *"command line tools"*) echo "Homebrew needs newer Command Line Tools: run softwareupdate --install -a" ;;
    *"not trusted"*|*"tap trust"*) case "$2" in *" "*) echo "Homebrew does not trust one of its taps yet (see brew trust)" ;; *) echo "Homebrew does not trust the ${2##*/} tap yet" ;; esac ;;
  esac
}
tools_install() {   # <tool>...: the packages (pkgs_install), then bun from its release (bun_install); 1 = one is not installed
  local t bun=0 rc=0 others=(); TOOLS_WHY=""
  for t in "$@"; do if [ "$t" = bun ]; then bun=1; else others+=("$t"); fi; done
  [ "${#others[@]}" = 0 ] || pkgs_install "${others[@]}" || rc=1
  [ "$bun" = 0 ] || bun_install || rc=1
  return "$rc"
}
pkgs_install() {   # <tool>...: one question at a terminal, then brew install or apt-get install -y; 1 = not installed
  local m="" t p pkgs="" cmd pre rc tmp; TOOLS_WHY=""
  if on_macos; then command -v brew > /dev/null 2>&1 && m=brew; elif command -v apt-get > /dev/null 2>&1; then m=apt; fi
  if [ -z "$m" ]; then
    if on_macos; then echo "Homebrew is not installed (https://brew.sh), so ade cannot install: $*"
    else echo "no apt-get here, so ade cannot install: $*; use your package manager"; fi
    return 1
  fi
  for t in "$@"; do p="$(tool_pkg "$m" "$t")"
    if [ -n "$p" ]; then pkgs="${pkgs:+$pkgs }$p"
    elif [ "$t" = code ]; then echo "code: Visual Studio Code is not in apt; get it from https://code.visualstudio.com/download (ade adds no repository; ade works without it)"
    else echo "$t: not in apt; get it from $(tool_page "$t")"; fi
  done
  [ -n "$pkgs" ] || return 1
  # apt (A22): apt-get update first, always (a raw Ubuntu has no package lists yet, so install alone cannot find a
  # package), then apt-get install -y; with sudo unless ade runs as root, and nothing without either
  if [ "$m" = brew ]; then cmd="brew install $pkgs"; pre=""
  elif [ "$(id -u)" = 0 ]; then cmd="apt-get install -y $pkgs"; pre="apt-get update"
  else cmd="sudo apt-get install -y $pkgs"; pre="sudo apt-get update"
    command -v sudo > /dev/null 2>&1 || { echo "there is no sudo here, so ade cannot install: $pkgs; as root, run: apt-get update && apt-get install -y $pkgs"; return 1; }
  fi
  local all="${pre:+$pre && }$cmd"
  if agent_context; then echo "ade installs nothing from an agent session; run it yourself at a terminal: $all"; return 1; fi
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || { echo "to install them, run at a terminal: $all (or ade setup --tools)"; return 1; }
  tty_confirm "Install $pkgs now? This runs: $all" || { echo "nothing installed (later: ade setup --tools)"; return 1; }
  tmp="$(mk_tmp)" || tmp=""
  # pre, cmd: ade's own words (the package names above), split on purpose. Their lines are shown as they come and kept,
  # so a failure can be said in one plain line (install_why); ade repairs nothing itself (no brew trust)
  if [ -n "$pre" ]; then
    if [ -n "$tmp" ]; then $pre < /dev/tty 2>&1 | tee "$tmp/out"; rc="${PIPESTATUS[0]}"; else $pre < /dev/tty; rc=$?; fi
    if [ "$rc" != 0 ]; then [ -z "$tmp" ] || rm_tmp "$tmp"
      TOOLS_WHY="$pre failed (exit $rc), so nothing is installed; check the network and apt's sources"; echo "$TOOLS_WHY"; return 1; fi
  fi
  if [ -n "$tmp" ]; then $cmd < /dev/tty 2>&1 | tee "$tmp/out"; rc="${PIPESTATUS[0]}"; else $cmd < /dev/tty; rc=$?; fi
  if [ "$rc" = 0 ]; then [ -z "$tmp" ] || rm_tmp "$tmp"; echo "installed: $pkgs"; return 0; fi
  TOOLS_WHY="$(install_why "${tmp:+$tmp/out}" "$pkgs")"; [ -z "$tmp" ] || rm_tmp "$tmp"
  [ -n "$TOOLS_WHY" ] || TOOLS_WHY="$cmd failed (exit $rc)"
  echo "$TOOLS_WHY"; return 1
}
# bun (the Telegram plugin runs on it) is a required tool that ade installs itself, with neither Homebrew nor the Xcode
# Command Line Tools: the release zip for this OS and CPU from bun's GitHub release, its sha256 checked against the
# SHASUMS256.txt of that release, the one program in it put at ~/.bun/bin/bun (0755), where the hub's bin/chat finds it
# once ~/.bun/bin is on PATH. No script is piped to a shell, and Homebrew is never asked for bun. A bun already on PATH
# (Homebrew's, or any other) or in ~/.bun/bin is left alone. The version is pinned on the next line and nowhere else.
BUN_VERSION="1.4.4"   # the newest release at least two weeks old on 2026-11-23 (released 2026-10-22)
BUN_RELEASES="https://github.com/oven-sh/bun/releases"
BUN_RC_MARK="# added by ade: bun"
BUN_WHY=""; BUN_DETAILS=""
# bun_path: a bun in ~/.bun/bin that is not on PATH is found by ade and by what it runs (the hub's bin/chat); a bun
# already on PATH stays the one that is found. BUN_PATH_ADDED=1: ade put it there, so the person's own PATH lacks it
# and setup writes the start-file line (bun_rc), whoever installed bun
BUN_PATH_ADDED=""
bun_path() { command -v bun > /dev/null 2>&1 || ! [ -x "$HOME/.bun/bin/bun" ] || { PATH="$HOME/.bun/bin:$PATH"; export PATH; hash -r; BUN_PATH_ADDED=1; }; }
# bun_rc_due: bun is in ~/.bun/bin, the person's PATH lacks it, and this is a person at a terminal (setup then adds the line)
bun_rc_due() { [ "$BUN_PATH_ADDED" = 1 ] && [ -x "$HOME/.bun/bin/bun" ] && ! agent_context; }
bun_asset() {   # the release zip for this OS and CPU, without .zip; 1 = bun has none that ade knows
  local os cpu; os="$(uname -s 2> /dev/null)"; cpu="$(uname -m 2> /dev/null)"
  case "$os" in Darwin) os=darwin ;; Linux) os=linux ;; *) return 1 ;; esac
  case "$cpu" in arm64|aarch64) cpu=aarch64 ;; x86_64|amd64) cpu=x64 ;; *) return 1 ;; esac
  # an Intel shell on Apple silicon (Rosetta): the Apple silicon bun, as bun's own installer picks
  if [ "$os-$cpu" = darwin-x64 ] && [ "$(sysctl -n sysctl.proc_translated 2> /dev/null)" = 1 ]; then cpu=aarch64; fi
  echo "bun-$os-$cpu"
}
bun_get() {   # <url> <file>: https only, redirects too (file:// for tests); curl's own reason in <file>.err
  local proto="=https"; file_urls_ok && proto="=https,file"
  curl --proto "$proto" --proto-redir "$proto" --tlsv1.2 -fsSL --connect-timeout 20 --max-time 900 "$1" -o "$2" 2> "$2.err" < /dev/null
}
bun_fetch() {   # the pinned bun into ~/.bun/bin/bun; 1 = nothing installed, BUN_WHY (one plain line) and BUN_DETAILS say why
  local a tmp url want got dest="$HOME/.bun/bin"; BUN_WHY=""; BUN_DETAILS="bun's releases: github.com/oven-sh/bun/releases"
  a="$(bun_asset)" || { BUN_WHY="bun has no download for this computer ($(uname -s 2> /dev/null) $(uname -m 2> /dev/null))"; BUN_DETAILS="https://bun.sh/docs/installation lists the computers bun runs on"; return 1; }
  tmp="$(mk_tmp)" || { BUN_WHY="ade could not make a temp folder for the download"; return 1; }
  url="$BUN_RELEASES/download/bun-v$BUN_VERSION"
  if ! bun_get "$url/$a.zip" "$tmp/bun.zip"; then BUN_WHY="The download of bun $BUN_VERSION did not finish"; BUN_DETAILS="$(plain "$(tail -1 "$tmp/bun.zip.err" 2> /dev/null)")"
  elif ! bun_get "$url/SHASUMS256.txt" "$tmp/sums"; then BUN_WHY="The download of bun's SHASUMS256.txt did not finish; nothing installed"; BUN_DETAILS="$(plain "$(tail -1 "$tmp/sums.err" 2> /dev/null)")"
  else
    want="$(awk -v f="$a.zip" '$2 == f || $2 == "*" f { print $1; exit }' "$tmp/sums" 2> /dev/null)"; got="$(sha256_of "$tmp/bun.zip" 2> /dev/null)"
    if ! matches "$want" '^[0-9a-f]{64}$'; then BUN_WHY="SHASUMS256.txt names no sha256 for $a.zip; nothing installed"
    elif [ "$got" != "$want" ]; then BUN_WHY="$a.zip does not match its sha256; nothing installed"; BUN_DETAILS="SHASUMS256.txt of bun-v$BUN_VERSION names another sha256 for it"
    elif ! bun_unzip "$tmp/bun.zip" "$a/bun" "$tmp/bun"; then BUN_WHY="$a.zip could not be unpacked; nothing installed"
    elif ! chmod 755 "$tmp/bun" || [ "$("$tmp/bun" --version 2> /dev/null < /dev/null)" != "$BUN_VERSION" ]; then
      BUN_WHY="bun $BUN_VERSION does not run on this computer; nothing installed"; BUN_DETAILS="https://bun.sh/docs/installation lists the computers bun runs on"
    elif ! { mkdir -p "$dest" && cp "$tmp/bun" "$dest/bun.ade-tmp" && chmod 755 "$dest/bun.ade-tmp" && mv -f "$dest/bun.ade-tmp" "$dest/bun"; } 2> /dev/null; then
      rm -f "$dest/bun.ade-tmp"; BUN_WHY="ade could not write ~/.bun/bin/bun; nothing installed"; BUN_DETAILS="check that you can write in ~/.bun"
    fi
  fi
  [ -n "$BUN_DETAILS" ] || BUN_DETAILS="curl gave no reason; check the network"
  rm_tmp "$tmp"; [ -z "$BUN_WHY" ]
}
bun_unzip() {   # <zip> <member> <file>: that one member, as a file, and nothing else from the zip
  python3 -I - "$@" 2> /dev/null <<'PY' && [ -s "$3" ]
import sys, zipfile
z = zipfile.ZipFile(sys.argv[1]); i = z.getinfo(sys.argv[2])
if i.is_dir() or i.file_size > 1 << 30: sys.exit(1)
with z.open(i) as src, open(sys.argv[3], "wb") as dst:
    for block in iter(lambda: src.read(1 << 20), b""): dst.write(block)
PY
}
# bun_rc: ~/.bun/bin is not on PATH: this ade's own PATH (and so what it runs), and one marked line in the person's
# shell start file (~/.zshrc for zsh, ~/.bashrc for bash, ~/.profile otherwise), said first and never added twice
bun_rc() {
  local f line
  case ":$PATH:" in *":$HOME/.bun/bin:"*) [ "$BUN_PATH_ADDED" = 1 ] || return 0 ;; *) PATH="$HOME/.bun/bin:$PATH"; export PATH; hash -r ;; esac
  case "${SHELL:-}" in */zsh) f=.zshrc ;; */bash) f=.bashrc ;; *) f=.profile ;; esac
  ! grep -qF '.bun/bin' "$HOME/$f" 2> /dev/null && ! grep -qF 'BUN_INSTALL' "$HOME/$f" 2> /dev/null || return 0
  # shellcheck disable=SC2016  # the line as it goes into the file: the shell that reads it expands it
  line='export PATH="$HOME/.bun/bin:$PATH"'"   $BUN_RC_MARK"
  # shellcheck disable=SC2088  # a literal ~ for the person to read
  echo "~/.bun/bin is not on your PATH: ade adds one line to ~/$f, so a new"
  echo "terminal finds bun (this ade already does):"; echo "  $line"
  { { [ ! -s "$HOME/$f" ] || [ -z "$(tail -c 1 "$HOME/$f")" ] || echo; } && printf '%s\n' "$line"; } 2> /dev/null >> "$HOME/$f" ||
    echo "ade could not write ~/$f; add that line to it yourself"
}
bun_manual() {   # the manual steps: the same download, check and place, by hand; never a script piped to a shell
  local a; echo "To install bun $BUN_VERSION yourself:"
  if a="$(bun_asset)"; then
    echo "  1. from $BUN_RELEASES/tag/bun-v$BUN_VERSION"; echo "     download $a.zip and SHASUMS256.txt"
    echo "  2. shasum -a 256 $a.zip must print the sha256 that"; echo "     SHASUMS256.txt has for it"
    echo "  3. unzip $a.zip && mkdir -p ~/.bun/bin &&"; echo "     mv $a/bun ~/.bun/bin/bun"
  else echo "  https://bun.sh/docs/installation lists the computers bun runs on"; fi
  echo "then run ${ASK_AGAIN:-ade setup --tools}"
}
# bun_install [kind of failure]: after a yes at a terminal. 0 = installed and found; 1 = it failed and the person chose
# the manual steps (shown) or to go on; 2 = not tried (no yes, no terminal, an agent session). A failure goes through
# failed: try again, the manual steps, stop.
bun_install() {
  local kind="${1:-bun}"
  if agent_context; then echo "ade installs nothing from an agent session; run it yourself at a terminal: ade setup --tools"; return 2; fi
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || { echo "to install bun, run at a terminal: ade setup --tools"; return 2; }
  echo "bun $BUN_VERSION: ade downloads it from github.com/oven-sh/bun, checks its sha256 and"
  # shellcheck disable=SC2088  # a literal ~ for the person to read
  echo "puts it in ~/.bun/bin/bun. Homebrew is not used, and no script is run."
  tty_confirm "Install bun now?" || { echo "nothing installed (later: ade setup --tools)"; return 2; }
  while :; do
    echo "downloading bun $BUN_VERSION from github.com/oven-sh/bun"
    if bun_fetch; then bun_rc; hash -r; echo "installed: bun $BUN_VERSION in ~/.bun/bin/bun"; return 0; fi
    failed "$kind" "$BUN_WHY" "$BUN_DETAILS"
    [ "$CHOICE" = retry ] || { [ "$CHOICE" != manual ] || bun_manual; return 1; }
  done
}
setup_tools() {   # [required|extras]: ade setup --tools; what is missing, after a yes
  local req ext ASK_AGAIN="ade setup --tools"
  req="$(tools_missing $REQUIRED_TOOLS)"; ext="$(tools_missing $EXTRA_TOOLS)"
  case "${1:-}" in required) ext="" ;; extras) req="" ;; esac
  ! bun_rc_due || bun_rc
  [ -n "$req$ext" ] || { echo "tools: everything ade uses is installed"; return 0; }
  [ -n "$req" ] && echo "missing tools ade needs: $req"
  [ -n "$ext" ] && echo "missing viewer extras (ade works without them): $ext"
  case " $ext " in *" yazi "*) echo "  ade files uses yazi only with ADE_FILES=yazi: $YAZI_WARNING." ;; esac
  # shellcheck disable=SC2086  # tool names, one word each
  tools_install $req $ext
}
setup_tools_steps() {   # the first steps of ade setup: the required tools, then the viewer extras as one yes/no
  local req ext
  req="$(tools_missing $REQUIRED_TOOLS)"; ext="$(tools_missing $EXTRA_TOOLS)"
  ! bun_rc_due || bun_rc
  # shellcheck disable=SC2086
  [ -n "$req" ] && { echo "missing tools ade needs: $req"; tools_install $req || true; }
  # shellcheck disable=SC2086
  [ -n "$ext" ] && { echo "The viewer extras (ade files and ade view work without them): $ext"
    case " $ext " in *" yazi "*) echo "  ade files uses yazi only with ADE_FILES=yazi: $YAZI_WARNING." ;; esac
    tools_install $ext || true; }
  return 0
}

