# shot_pane <agent> <tmp>: the one tab of ade ui that the name means (the tab's name, its folder, the folder's last
# part, or the agent's name), its text with colour sequences into <tmp>/pane; SHOT_WIN is the tab's name
shot_pane() {
  local hub s rows n
