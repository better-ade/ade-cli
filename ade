    sys.stderr.write("ade: %s\n" % msg); sys.exit(code)
def shown(s, n=200): return "".join(c if " " <= c <= "~" else "?" for c in s)[:n]

# hiding keys and tokens: the hub's rule, as bin/agent.py has it (bin/lib.sh redact, bin/chat logs), then the additions
# of ade web (A19): Authorization headers, bearer tokens, the value after a name ending in password, secret, token or
# key, the user and password of a URL, AWS key ids, sk_ keys, GitHub tokens, private key blocks
ESC = re.compile(r"\x1b\[([0-?]*)([ -/]*)([@-~])|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)?|\x1b[@-_]?|[\x00-\x08\x0b-\x1f\x7f\x80-\x9f]")
# characters that draw nothing or reorder text (default-ignorable and zero-width ones): removed before any matching, so one cannot split a key
MARKS = re.compile("[\u00ad\u034f\u061c\u115f\u1160\u17b4\u17b5\u180b-\u180f\u200b-\u200f\u2028-\u202e\u2060-\u206f\u3164\ufe00-\ufe0f\ufeff\uffa0\ufff0-\ufff8"
                   "\U0001bca0-\U0001bca3\U0001d173-\U0001d17a\U000e0000-\U000e0fff]")
PK_BEGIN = re.compile(r"-----BEGIN [A-Z0-9 ]{0,40}PRIVATE KEY(?: BLOCK)?-----")
PK_END = re.compile(r"-----END [A-Z0-9 ]{0,40}PRIVATE KEY(?: BLOCK)?-----")
