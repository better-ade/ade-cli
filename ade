def find_links(text, cwd):   # files that exist (path, path:line, path:line:col, Markdown links) and http(s) URLs, in order
    found, seen = [], set()
    def is_file(tok): return os.path.isfile(os.path.join(cwd, os.path.expanduser(tok) if tok.startswith("~/") else tok))
    def add(pos, k, d):
        if (k, d) not in seen: seen.add((k, d)); found.append((pos, k, d))
    for no, line in enumerate(text.splitlines()):
        line = CTL.sub(" ", line); taken = [False] * len(line)
        def take(m):
            if any(taken[m.start():m.end()]): return False
            taken[m.start():m.end()] = [True] * (m.end() - m.start()); return True
        for m in MD.finditer(line):
            take(m); tg = m.group(1).strip("<>")
            if URL.fullmatch(tg): add((no, m.start()), "url", tg)
            else:
