  src="$(fetch "$ADE_SKILLS_REPO" "$ref")" || exit 2
  CONNECT_TMP="$(dirname "$src")"; trap 'rm_tmp "$CONNECT_TMP"' EXIT; CONNECT_SRC="$src"; d="$src/plugins/guard/connectors"
  [ -d "$d" ] && [ ! -L "$d" ] && [ ! -L "$src/plugins/guard" ] && [ ! -L "$src/plugins" ] || die 2 "ade-skills $ref has no plugins/guard/connectors folder (or it is a link); nothing to connect"
  [ -n "$(ls -A "$d")" ] || die 2 "ade-skills $ref has an empty plugins/guard/connectors; refused"
  m="$CONNECT_TMP/release.json"   # at most 64 KiB, and checked again after the download
  ADE_DL_MAX=65536 dl "$ADE_RELEASES_BASE/better-ade/ade-skills/releases/download/$ref/release.json" "$m" ||
    die 2 "there is no release.json for ade-skills $ref (or it is over 64 KiB); recipes are used only when it names their sha256"
  why="$(manifest_py "$m" ade-skills "$ver")" || die 2 "the release.json of ade-skills $ref is not valid: $why"
  shas="$(connect_manifest_py "$m")" || die 2 "the release.json of ade-skills $ref is not valid: $(printf '%s' "$shas" | no_ctl)"
  while read -r svc sha; do   # a recipe the manifest names must be in the checkout
    [ -n "$svc" ] || continue
    [ -e "$d/$svc.json" ] || [ -L "$d/$svc.json" ] || die 2 "release.json of ade-skills $ref names connector-$svc.json, which its checkout does not have; refused"
  done <<EOF
$shas
EOF
  CONNECT_ROWS=""
  for f in "$d"/* "$d"/.[!.]*; do
    [ -e "$f" ] || [ -L "$f" ] || continue; b="$(basename "$f")"; svc="${b%.json}"
