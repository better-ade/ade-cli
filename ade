    esac; shift
  done
  root="$(git rev-parse --show-toplevel 2> /dev/null)" || root="$( (find_hub) 2> /dev/null)" || die 2 "ade shot saves into a project's or a hub's .ade/evidence/: run it inside a git repository or a hub; nothing captured"
  plan="$(shot_py plan "$mode" "$root" "$name" "$target" "$width")" || exit $?
  IFS="$US" read -r name target <<EOF
$plan
EOF
  SHOT_TMP="$(mk_tmp)" || die 1 "could not make a temp folder"; trap 'rm_tmp "$SHOT_TMP"' EXIT; trap 'exit 130' INT TERM HUP
  case "$mode" in
    url) note="$(shot_py url "$target" "$root" "$width" "$full" "$SHOT_TMP")" || exit $? ;;
    screen) shot_screen_gate "$yes" "$root"; shot_screen "$SHOT_TMP/shot.png"; note="$SHOT_NOTE" ;;
    agent) shot_pane "$target" "$SHOT_TMP"; target="$SHOT_WIN"; note="$(shot_py pane "$SHOT_TMP")" || exit $? ;;
  esac
  out="$(ADE_SHOT_CMD="$SHOT_CMD" shot_py save "$root" "$mode" "$name" "$SHOT_TMP/shot.png" "$target" "$note")" || exit $?
  rm_tmp "$SHOT_TMP"; echo "$out"
  [ "$tg" = 0 ] || shot_tg "$out" "$cap"
}

cmd_version() {
  local v="$ADE_VERSION"
  local p="$0" l
  while [ -L "$p" ]; do l="$(readlink "$p")"; case "$l" in /*) p="$l" ;; *) p="$(dirname "$p")/$l" ;; esac; done
  [ -n "$v" ] || v="$(cat "$(cd "$(dirname "$p")" && pwd)/VERSION" 2>/dev/null)"
  echo "ade ${v:-unknown}"
}

