sys.stdin.reconfigure(encoding="utf-8", errors="replace")
op, A = sys.argv[1], sys.argv[2:]
ADE = [os.environ.get("ADE_BASH") or "bash", os.environ.get("ADE_SELF") or "ade"]
HOME = os.path.realpath(os.path.expanduser("~"))
