            in_key = False; text = text[end.end():]; sty = sty[end.end():]
            if not text.strip(): continue
        else:
            begin = PK_BEGIN.search(text)
            if begin and not PK_END.search(text, begin.end()): in_key = True
            elif not begin and PK_END.search(text):
