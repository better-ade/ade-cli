            if not t.ask("%s outside the hub and its projects. Open it anyway?" % ("%s is" % shown(d) if w == "out" else "%s is a link to %s," % (shown(d), shown(real)))):
                msg = "refused inside an agent session" if AGENT else "not opened"; return
            if not wide(real): ALLOWED.append(real)   # listed from now on, never previewed; never /, home or a parent of it
        items = listing(d)
        if items is None: msg = "cannot read %s" % shown(d); return
        cur, ents, res, top = d, items, None, 0
        sel = next((i for i, (_, p) in enumerate(items) if p == came), 0)
    sys.stdout.write("\x1b[?1049h\x1b[?25l"); t.raw()
    try:
        while True:
            items = res if res is not None else ents
            sel = max(0, min(sel, len(items) - 1)); _, rows = size(); h = max(1, rows - 2)
            top = min(max(top, sel - h + 1), sel)
            draw(); msg = ""; k = t.key()
            p = items[sel][1] if items else None
            if k in ("q", "quit") or (k == "esc" and res is None): break
            elif k in ("j", "down"): sel += 1
            elif k in ("k", "up"): sel -= 1
            elif k == "esc": res = None; sel = 0
            elif k in ("h", "left", "back"):
                if res is not None: res = None; sel = 0
                elif os.path.dirname(cur) != cur: enter(os.path.dirname(cur), cur)
            elif k == "/":
                q = t.line("/ ") or ""
                if q:
                    found = search(cur, q)
                    if found: res, sel, top = found, 0, 0
                    else: msg = "no name under this folder holds %s" % shown(q)
            elif k in ("enter", "l", "right") and p:
                if os.path.isdir(p): enter(p)
                else:
                    t.cooked(); sys.stdout.write("\x1b[?1049l\x1b[?25h"); sys.stdout.flush()
                    rc = subprocess.call(ADE + ["view", "--", p])
                    if rc not in (0, 130): sys.stdout.write("(ade view exit %d; a key returns) " % rc); sys.stdout.flush(); t.raw(); t.key()
                    sys.stdout.write("\x1b[?1049h\x1b[?25l"); t.raw()
            elif k in ACTS and p: msg = act(t, ACTS[k], p)
    finally:
        t.cooked(); sys.stdout.write("\x1b[?25h\x1b[?1049l"); sys.stdout.flush()

def show(k, p, prog):   # a PDF (pages, n/p, g, /), an image or a binary file, with o f y
    name = os.path.basename(p); tty = sys.stdin.isatty() and sys.stdout.isatty(); mode = gfx() if tty else "none"
    n = os.path.getsize(p); pages = [""]; note = ""
    if k == "pdf":
        if not shutil.which("pdftotext"):
            print("ade: pdftotext is not installed (poppler), so ade cannot show %s; ade setup --tools installs it (o opens it in your PDF app)" % shown(name))
            if not tty: return 2
        else:
            r = subprocess.run(["pdftotext", "-layout", "--", p, "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if r.returncode != 0: print("ade: pdftotext could not read %s" % shown(name)); return 1
            pages = r.stdout.decode("utf-8", "replace").split("\f")
            if len(pages) > 1 and not pages[-1].strip(): pages.pop()
            if mode != "none" and not shutil.which("pdftoppm"): note = "pdftoppm (poppler) is not installed: text pages; ade setup --tools installs it"
    if not tty:
        if k != "pdf": print("%s: %s, %s (ade view on a terminal: o opens it)" % (shown(name), "image " + dims(p) if k == "image" else k + " file", human(n))); return 0
        for i, pg in enumerate(pages): print("--- %s · page %d/%d ---\n%s" % (shown(name), i + 1, len(pages), shown(pg).rstrip("\n")))
        return 0
    t = Term(); i = 0; msg = note; tmp = ""
    try:
        tmp = os.environ.get("ADE_SHOW_TMP") or tempfile.mkdtemp(prefix="ade.", dir=TMP); t.raw()
        while True:
            cols, rows = size(); drawn = False
            head = "%s · page %d/%d" % (shown(name), i + 1, len(pages)) if k == "pdf" else "%s · %s, %s" % (shown(name), "image " + dims(p) if k == "image" else k + " file", human(n))
            sys.stdout.write("\x1b[H\x1b[2J\x1b[1m" + (hyper(p, fit(head, cols)) if prog == "1" and k != "binary" else fit(head, cols)) + "\x1b[0m\r\n")
            if k == "pdf" and mode != "none" and shutil.which("pdftoppm") and pages != [""]:
                for f in glob.glob(os.path.join(tmp, "*.png")): os.remove(f)
                run(["pdftoppm", "-f", str(i + 1), "-l", str(i + 1), "-png", "-r", "110", "--", p, os.path.join(tmp, "page")], stderr=subprocess.DEVNULL)
                got = sorted(glob.glob(os.path.join(tmp, "page*.png")))
                drawn = bool(got) and render(got[0], mode, cols, rows)
            elif k == "image" and mode != "none": drawn = render(p, mode, cols, rows)
            if not drawn:
                if k == "pdf": sys.stdout.write("".join(shown(l.expandtabs(4))[:cols] + "\r\n" for l in pages[i].splitlines()[:rows - 3]))
                elif k == "image": sys.stdout.write("image: %s, %s (o to open)\r\n" % (dims(p), human(n)))
                else: sys.stdout.write("%s file: %s (o opens it in its app, f shows it in its folder)\r\n" % (k, human(n)))
            keys = ("n next · p previous · g go to page · / search · " if k == "pdf" else "") + "o open · f reveal · y copy path · q quit"
            sys.stdout.write("\x1b[%d;1H\x1b[K%s" % (rows, (msg or keys)[:cols])); sys.stdout.flush(); msg = ""
            c = t.key()
            if c in ("q", "quit", "esc"): break
            if k == "pdf" and c in ("n", " ", "right", "j", "down"): i = min(len(pages) - 1, i + 1)
            elif k == "pdf" and c in ("p", "left", "k", "up", "b"): i = max(0, i - 1)
            elif k == "pdf" and c == "g":
                s = (t.line("page: ") or "").strip()
                if s.isdigit() and 1 <= int(s) <= len(pages): i = int(s) - 1
                elif s: msg = "no page %s (1-%d)" % (shown(s), len(pages))
            elif k == "pdf" and c == "/":
                s = (t.line("search: ") or "").strip().lower()
                if s:
                    hit = next((j % len(pages) for j in range(i + 1, i + 1 + len(pages)) if s in pages[j % len(pages)].lower()), None)
                    if hit is None: msg = "not found: %s" % shown(s)
                    else: i = hit; msg = "found on page %d" % (hit + 1)
            elif c in ACTS: msg = act(t, ACTS[c], p)
    finally:
        if tmp: drop(tmp)
        try: t.cooked(); sys.stdout.write("\r\n"); sys.stdout.flush()
        except (OSError, termios.error): pass
    return 0

URL = re.compile(r"https?://[^\s<>\"'`()\[\]{}]+")
MD = re.compile(r"\[[^\]\n]*\]\(([^)\s]+)\)")
PATH = re.compile(r"(?<![\w/.~:-])((?:~/|\.{1,2}/|/)?[\w.@+-]+(?:/[\w.@+-]+)*)(?::(\d+)(?::(\d+))?)?")
def find_links(text, cwd):   # files that exist (path, path:line, path:line:col, Markdown links) and http(s) URLs, in order
    found, seen = [], set()
    def is_file(tok): return os.path.isfile(os.path.join(cwd, os.path.expanduser(tok) if tok.startswith("~/") else tok))
    def add(pos, k, d):
        if (k, d) not in seen: seen.add((k, d)); found.append((pos, k, d))
    for no, line in enumerate(text.splitlines()):
        line = CTL.sub(" ", line); taken = [False] * len(line)
        def take(m):
            if any(taken[m.start():m.end()]): return False
            taken[m.start():m.end()] = [True] * (m.end() - m.start()); return True
        for m in MD.finditer(line):
            take(m); tg = m.group(1).strip("<>")
            if URL.fullmatch(tg): add((no, m.start()), "url", tg)
            else:
                f = tg.split("#", 1)[0]; mm = re.fullmatch(r"(.+?)(?::\d+){0,2}", f)
                if f and mm and is_file(mm.group(1)): add((no, m.start()), "file", f)
        for m in URL.finditer(line):
            if take(m): add((no, m.start()), "url", m.group(0).rstrip(".,;:!?"))
        for m in PATH.finditer(line):
            tok = m.group(1).rstrip(".")
            if ("/" in tok or "." in tok.lstrip(".")) and is_file(tok) and take(m):
                add((no, m.start()), "file", tok + (":" + m.group(2) if m.group(2) else "") + (":" + m.group(3) if m.group(2) and m.group(3) else ""))
    found.sort(); return [(k, d) for _, k, d in found][-60:]
def pick(pane, cwd):
    with open(pane, encoding="utf-8", errors="replace") as f: items = find_links(f.read(), cwd)
    if not items:
        print("no file paths or links in this pane")
        if sys.stdin.isatty():
            try: input("(Enter closes) ")
            except EOFError: pass
        return 0
    while True:
        print("Paths and links in this pane (a file opens in ade view, a link in your browser):")
        for i, (k, d) in enumerate(items, 1): print("  %2d  %s" % (i, shown(d)))
        try: s = input("Open which? (a number; Enter closes) ").strip()
        except EOFError: return 0
        if not s: return 0
        if not s.isdigit() or not 1 <= int(s) <= len(items): print("no such number: %s" % shown(s)); continue
        k, d = items[int(s) - 1]
        subprocess.call(ADE + (["files", "--act", "url", d] if k == "url" else ["view", "--cwd", cwd, "--", d]))

