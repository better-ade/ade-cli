try:
    d = json.load(sys.stdin); state = d.get("BackendState"); name = ((d.get("Self") or {}).get("DNSName") or "").rstrip(".").lower()
    label = "[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?"
