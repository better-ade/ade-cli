    echo "account $n: ready"; fixed=$((fixed + 1))
  done <<EOF
$lines
EOF
  local svc=""
  while IFS="$US" read -r k n st det dir data <&4; do
    [ -n "$k" ] && [ "$k" != account ] && conn_gap "$k" "$n" "$st" "$det" || continue
    RESULT=skipped; where="$(conn_where "$hub" "$dir")"
    case "$k" in
      provider) if confirm "Sign in to Claude Code with your account now?"; then
          if hub_claude "$hub" auth login && claude_signed_in "$hub"; then RESULT=ready; else RESULT="failed (the sign-in did not finish)"; fi; fi ;;
      key) if confirm "Restore the $n key (a hidden prompt, then a live test)?"; then
