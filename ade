# ade web (story A19, docs/notes/A19-web-view.md): a read-only page of the hub's agents and logs, served by python3's
# standard library on 127.0.0.1, or with --tailnet on this machine's Tailscale address only. The address carries a
# random token; ~/.config/ade/web (0600: the server's pid, then the address) is there while it runs.
WEB_LINK="$CONF_DIR/web"
WEB_USAGE="usage: ade web [--port N] [--tailnet] | ade web --print-link"
# web_link: the running server's address: line 2 of the link file, while the pid on line 1 lives and the address still
# answers (a pid can be another program's after a crash or a restart of the machine); a stale file is removed
web_link() {
  local pid="" url="" at
  [ -f "$WEB_LINK" ] || return 1
  { IFS= read -r pid; IFS= read -r url; } < "$WEB_LINK" 2> /dev/null
  if matches "$pid" '^[0-9]+$' && kill -0 "$pid" 2> /dev/null && matches "$url" '^http://[0-9.]+:[0-9]+/\?k=[A-Za-z0-9_-]+$'; then
    at="${url#http://}"; at="${at%%/*}"
    if ( exec 3<> "/dev/tcp/${at%:*}/${at##*:}" ) 2> /dev/null; then printf '%s\n' "$url"; return 0; fi
  fi
  rm -f -- "$WEB_LINK"; return 1
}
# web_tailnet_ip <text>: exactly one IPv4 address in 100.64.0.0/10, the range Tailscale gives out. The test switch
# ADE_WEB_TEST_TAILNET_LOOPBACK=1 accepts a loopback address in its place (a test has no tailnet), never anything wider.
web_tailnet_ip() {
  local o='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
  matches "$1" "^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.$o\.$o\$" && return 0
  [ "${ADE_WEB_TEST_TAILNET_LOOPBACK:-}" = 1 ] && matches "$1" '^127\.0\.0\.[0-9]$'
}
# web_tailnet: prints "<this machine's Tailscale IPv4> <its MagicDNS name, or ->". tailscale is only asked (status, ip);
# ade never installs it, starts it or signs in to it: it says how and stops.
web_tailnet() {
  local st state name ip
  command -v tailscale > /dev/null 2>&1 || die 1 "Tailscale is not installed (its tailscale command is not on the PATH), and ade never installs it or signs in to it. Get it from https://tailscale.com/download (macOS: the app, or brew install tailscale; Ubuntu: the steps on that page), sign in with: tailscale up, then: ade web --tailnet"
  st="$(tailscale status --json 2> /dev/null | python3 -I -c '
import json, re, sys
try:
    d = json.load(sys.stdin); state = d.get("BackendState"); name = ((d.get("Self") or {}).get("DNSName") or "").rstrip(".").lower()
    label = "[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?"
    print(state if isinstance(state, str) and state.isalnum() else "-", name if re.fullmatch("%s([.]%s)+" % (label, label), name) and len(name) < 254 else "-")
except Exception:
    print("- -")')"
