seen, out = set(), []
for f in files:
    n = f.get("name") if isinstance(f, dict) else None
    if not isinstance(n, str): print("a file entry has no name"); sys.exit(1)
    if n in seen: print("it names %s twice" % re.sub(r"[^\x20-\x7e]", "?", n)[:80]); sys.exit(1)
    seen.add(n)
    if not n.startswith("connector-"): continue
    m = re.fullmatch(r"connector-([a-z][a-z0-9-]{0,31})\.json", n); sha = f.get("sha256")
