        self.status = None; self.blocked = {}; self.session = None; self.answered = False
        profile = tempfile.mkdtemp(prefix="profile.", dir=tmp)   # a fresh one for each start
        args = [exe, "--headless", "--remote-debugging-pipe", "--user-data-dir=" + profile, "--no-first-run", "--no-default-browser-check",
