  if agent_context; then
    [ "$1" = 1 ] || die 2 "$what. From an agent session it runs only with --yes-screen, and only after your own Allow at the session's permission prompt for this command; nothing captured"
    shot_py asks "$2" "$SHOT_CMD" || die 2 "$what. This session's settings do not ask before this command (no permissions.ask rule matching it in the project's .claude/settings.json, or a settings file lets the session skip permissions or cannot be read), so nobody approved it; nothing captured (the hub's settings ask)"
    SHOT_NOTE="approved: the session's permission prompt for this command (--yes-screen)"; return 0
