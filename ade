        out[key] = {"date": day, "lines": tail(os.path.join(HUB, "journal", day + ".md"), HUB, 400)}
    return out

# story M1: the monitor's data. Times in the hub are UTC "YYYY-MM-DDTHH:MM:SSZ"; anything else counts as no time.
