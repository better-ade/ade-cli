          fi; fi ;;
      marketplace)   # restored with its plugin when one of its plugins is missing too
        printf '%s\n' "$lines" | awk -F "$US" -v m="$n" -v d="$dir" '$1 == "plugin" && $3 != "ready" && $5 == d { split($2, x, "@"); if (x[2] == m) f = 1 } END { exit !f }' && continue
        if confirm "Add the marketplace $n from $det$where?"; then mkt_add "$hub" "$n" "$data" "" && RESULT=ready; fi ;;
      plugin) local pm="${n#*@}" prepo
        prepo="$(printf '%s\n' "$lines" | awk -F "$US" -v m="$pm" '$1 == "marketplace" && $2 == m { print $6; exit }')"
        [ -n "$prepo" ] || prepo=local   # a plugin of the built-in ade-skills with no marketplace line
        confirm "Install the plugin $n at $data$where, from the marketplace $pm ($(repo_url "$prepo"))?" &&
          restore_plugin "$hub" "$dir" "${n%@*}" "$pm" "$data" "$prepo" ;;
      channel) if confirm "Restore $n (its bot token at a hidden prompt, then pairing this device again)?"; then
          ask_secret "Bot token for ${det:-the bot} (hidden):"
          if [ -z "$SECRET" ]; then RESULT=skipped
          else printf '%s\n' "$SECRET" | hub_run "$hub" keys set telegram > /dev/null; local rc=$?; SECRET=""
            if [ "$rc" != 0 ]; then RESULT="failed (bin/keys could not store the token)"
            elif hub_run "$hub" chat setup telegram --repair; then RESULT=ready; record_key "$hub" telegram
            else RESULT="failed (bin/chat setup telegram --repair)"; fi
          fi; fi ;;
      service) svc="$svc $n"; continue ;;
    esac
    echo "$k $n$where: $RESULT"
    if [ "$RESULT" = ready ]; then fixed=$((fixed + 1)); else needs="$needs, $k $n$where ($RESULT)"; fi
  done 4<<EOF
$lines
EOF
  if [ -n "$svc" ]; then
    RESULT=skipped
    if confirm "Reinstall the services ($(echo $svc | sed 's/ /, /g')) for this platform (bin/schedule install)?"; then
      if hub_run "$hub" schedule install < /dev/null > /dev/null; then RESULT=ready; for n in $svc; do service_present "$hub" "$n" || RESULT="failed ($n is still not installed)"; done
      else RESULT="failed (bin/schedule install)"; fi
    fi
    echo "services$svc: $RESULT"
    if [ "$RESULT" = ready ]; then fixed=$((fixed + 1)); else needs="$needs, services$svc ($RESULT)"; fi
  fi
  journal_line "$hub" "ade restore: $fixed connection(s) restored${needs:+; still needs the owner: ${needs#, }}"
  if [ -n "$needs" ]; then echo "still needs you: ${needs#, }"; return 1; fi
  echo "every connection is ready"
}

# ade update (story A11): everything current while every session, agent and orchestrator keeps running. ade itself is
# replaced by one rename (bash reads a script as it runs it, so the running file is never written); nothing is killed.
ADE_CLI_BASE="${ADE_CLI_BASE:-https://raw.githubusercontent.com/better-ade/ade-cli}"
RESTART_FILES="bin/chat bin/chat.py bin/brain bin/brain.py"   # the orchestrator's code: a running one needs a restart
ver_gt() { awk -v a="$1" -v b="$2" 'BEGIN { split(a, x, "."); split(b, y, "."); for (i = 1; i <= 3; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 }; exit 1 }'; }
dl() {   # dl <url> [file]: https only (file:// for tests), never more than ADE_UPDATE_TIMEOUT seconds
  local proto="=https"; [ "${ADE_TEST_ALLOW_FILE_URLS:-}" = 1 ] && proto="=https,file"
  if [ -n "${2:-}" ]; then curl --proto "$proto" --proto-redir "$proto" -fsSL --max-time "${ADE_UPDATE_TIMEOUT:-20}" "$1" -o "$2" 2> /dev/null
  else curl --proto "$proto" --proto-redir "$proto" -fsSL --max-time "${ADE_UPDATE_TIMEOUT:-20}" "$1" 2> /dev/null; fi
}
latest_version() { local v; v="$(dl "$ADE_CLI_BASE/main/VERSION" | tr -d ' \r\n')"; matches "$v" '^[0-9]+\.[0-9]+\.[0-9]+$' && echo "$v"; }
UPD_CHANGED=""
ADE_END_MARKER="# ade: end of file (ade update checks this line; keep it last)"
# temp files of an update: a trap removes every one on EXIT, INT and TERM (one path per line in UPD_TMPS)
UPD_TMPS=""
upd_cleanup() { local f; while IFS= read -r f; do [ -n "$f" ] && rm -rf -- "$f"; done <<EOF2
$UPD_TMPS
EOF2
  UPD_TMPS=""; }
upd_track() { UPD_TMPS="$UPD_TMPS$1
"; }
upd_traps() { trap upd_cleanup EXIT; trap 'upd_cleanup; exit 130' INT; trap 'upd_cleanup; exit 143' TERM; }
upd_untrap() { upd_cleanup; trap - EXIT INT TERM; }
# ade_check <file> <version>: the file is a whole ade script (its shebang, bash -n, the end-of-file marker as its last
# line) and, run with bash (never made executable for this), says it is that version; prints the reason when not
ade_check() {
  [ "$(head -1 "$1")" = "#!/bin/bash" ] || { echo "it is not the ade script"; return 1; }
  bash -n "$1" 2> /dev/null || { echo "it does not parse (bash -n)"; return 1; }
  [ "$(tail -1 "$1")" = "$ADE_END_MARKER" ] || { echo "it is cut short (no end-of-file marker)"; return 1; }
  [ "$(bash "$1" version 2> /dev/null < /dev/null)" = "ade $2" ] || { echo "ade version does not say $2"; return 1; }
}
# ade_put <new file> <installed path>: keeps the installed file as .ade.prev beside it (not executable), then renames
# a copy of the new one into place; the copy is made executable only now, after its check
ade_put() {
  local new="$1" self="$2" dir prev put; dir="$(dirname "$self")"
  prev="$(mktemp "$dir/.ade-prev.XXXXXX")" && upd_track "$prev" && put="$(mktemp "$dir/.ade-update.XXXXXX")" && upd_track "$put" || return 1
  cp "$self" "$prev" && chmod 644 "$prev" && cp "$new" "$put" && chmod 755 "$put" || return 1
  mv -f "$prev" "$dir/.ade.prev" && mv -f "$put" "$self"
}
self_update() {   # <check 0|1> [version]: 1 = the new file failed a check (the old one stays)
  local v="${2:-}" self tmp why want
  if [ -z "$ADE_VERSION" ]; then echo "ade: a checkout ($(dirname "$(ade_self)")); update it with git pull"; return 0; fi
  [ -n "$v" ] || v="$(latest_version)" || { echo "ade: could not read the latest version (offline?); ade $ADE_VERSION stays"; return 0; }
  matches "$v" '^[0-9]+\.[0-9]+\.[0-9]+$' || { echo "ade: $v is not a version; ade $ADE_VERSION stays"; return 1; }
  if ! ver_gt "$v" "$ADE_VERSION"; then   # never a downgrade: only --rollback puts an older ade back
    if [ "$v" = "$ADE_VERSION" ]; then echo "ade $ADE_VERSION is current"
    else echo "ade: $v is older than the installed $ADE_VERSION; refused (ade update --rollback puts the kept previous version back)"; fi
    return 0; fi
  [ "$1" = 1 ] && { echo "ade $ADE_VERSION -> $v"; return 0; }
  self="$(ade_self)"; upd_traps
  # the download and its check happen in a private temp folder, never in a folder on PATH
  tmp="$(mk_tmp)" || { upd_untrap; echo "ade: no temp folder; ade $ADE_VERSION stays"; return 1; }; upd_track "$tmp"
  # A12: from MANIFEST_SINCE on the release's own release.json (component ade-cli, version $v) names the sha256; the
  # file always comes from its tag (a url in the manifest is ignored), and anything short of a match installs nothing
  if ! want="$(release_sha "$v" "$tmp")"; then upd_untrap; echo "ade: $want; nothing installed, ade $ADE_VERSION stays"; return 1; fi
  if ! dl "$ADE_CLI_BASE/v$v/ade" "$tmp/raw"; then upd_untrap; echo "ade: could not download ade $v; ade $ADE_VERSION stays"; return 1; fi
  if [ -n "$want" ] && [ "$(sha256_of "$tmp/raw")" != "$want" ]; then
    upd_untrap; echo "ade: the download of ade $v does not match its sha256 in release.json; nothing installed, ade $ADE_VERSION stays"; return 1; fi
  sed "s/^ADE_VERSION=\"\"/ADE_VERSION=\"$v\"/" "$tmp/raw" > "$tmp/ade"; chmod 600 "$tmp/ade"
  if ! why="$(ade_check "$tmp/ade" "$v")"; then upd_untrap; echo "ade: the new ade $v failed its check ($why); ade $ADE_VERSION stays"; return 1; fi
  ade_put "$tmp/ade" "$self" || { upd_untrap; echo "ade: could not rename the new ade into place; ade $ADE_VERSION stays"; return 1; }
  upd_untrap
  echo "ade $ADE_VERSION -> $v (renamed into place; a running ade keeps its code until it restarts; ade update --rollback returns to $ADE_VERSION)"
  UPD_CHANGED="$UPD_CHANGED, ade $v"
}
self_rollback() {   # ade update --rollback: the kept previous version (.ade.prev) back into place; the current one is kept instead
  local self prev pv why; [ -n "$ADE_VERSION" ] || die 2 "a checkout ($(dirname "$(ade_self)")) has no kept version; use git"
  self="$(ade_self)"; prev="$(dirname "$self")/.ade.prev"
  [ -f "$prev" ] || die 1 "no previous version is kept ($prev); nothing changed"
  pv="$(sed -n 's/^ADE_VERSION="\([^"]*\)".*/\1/p' "$prev" 2> /dev/null | head -1)"
  matches "$pv" '^[0-9]+\.[0-9]+\.[0-9]+$' || die 1 "the kept previous version has no version stamp; nothing changed"
  # a version older than the end-of-file marker has none: its shebang, bash -n and its own version line are checked
  [ "$(head -1 "$prev")" = "#!/bin/bash" ] && bash -n "$prev" 2> /dev/null && [ "$(bash "$prev" version 2> /dev/null < /dev/null)" = "ade $pv" ] ||
    die 1 "the kept previous version ($pv) failed its check; nothing changed"
  upd_traps; local tmp; tmp="$(mk_tmp)" || { upd_untrap; die 1 "no temp folder; nothing changed"; }; upd_track "$tmp"
  cp "$prev" "$tmp/ade" || { upd_untrap; die 1 "could not copy $prev; nothing changed"; }
  ade_put "$tmp/ade" "$self" || { upd_untrap; die 1 "could not rename the previous ade into place; nothing changed"; }
  upd_untrap; echo "ade $ADE_VERSION -> $pv (rolled back; ade update --rollback again returns to $ADE_VERSION)"
}
RESTART_NEEDED=0
hub_update() {   # <hub> <check>: git pull --ff-only, then bin/method sync; 1 = refused (the hub is unchanged)
  local h="$1" up old new rs st f
  git -C "$h" rev-parse --show-toplevel > /dev/null 2>&1 || { echo "hub: not a git repository; skipped"; return 0; }
  up="$(git -C "$h" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2> /dev/null)" || { echo "hub: no upstream branch; skipped"; return 0; }
  old="$(git -C "$h" rev-parse HEAD)"
  if [ "$2" = 1 ]; then
    rs="$(git -C "$h" ls-remote "${up%%/*}" "refs/heads/${up#*/}" 2> /dev/null < /dev/null | awk '{ print $1; exit }')"
    if [ -z "$rs" ]; then echo "hub: could not reach ${up%%/*}"; elif [ "$rs" = "$old" ]; then echo "hub: current"
    else echo "hub: new commits on $up (git pull --ff-only, then bin/method sync)"; fi; return 0
  fi
  # untracked files (a journal entry, a scratch note) never block; git merge --ff-only refuses to overwrite one itself
  st="$(git -C "$h" status --porcelain --untracked-files=no 2> /dev/null)"
  [ -z "$st" ] || { echo "hub: it has local changes (git status); commit or stash them, then ade update again; the hub is unchanged"; return 1; }
  git -C "$h" fetch -q 2> /dev/null < /dev/null || { echo "hub: could not fetch (offline?); unchanged"; return 0; }
  git -C "$h" merge-base --is-ancestor HEAD "$up" ||
    { echo "hub: not a fast-forward (it has commits $up does not); merge or rebase it yourself; the hub is unchanged"; return 1; }
  git -C "$h" merge -q --ff-only "$up" > /dev/null 2>&1 ||
    { echo "hub: git merge --ff-only failed (an untracked file in the way?); the hub is unchanged"; return 1; }
  new="$(git -C "$h" rev-parse HEAD)"
  if [ "$new" = "$old" ]; then echo "hub: current"
  else echo "hub: updated ($(git -C "$h" rev-list --count "$old..$new") commit(s))"; UPD_CHANGED="$UPD_CHANGED, the hub"
    for f in $RESTART_FILES; do git -C "$h" diff --name-only "$old" "$new" | grep -qxF -- "$f" && RESTART_NEEDED=1; done; fi
  [ -x "$h/bin/method" ] && { hub_run "$h" method sync < /dev/null > /dev/null 2>&1 || echo "hub: bin/method sync failed"; }
  return 0
}
ade_plugins() { python3 -c 'import json, sys
try: d = json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
for k in sorted(d.get("plugins", d) or {}):
    if k.endswith("@ade-skills"): print(k)' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json" 2> /dev/null; }
orch_idle() { hub_run "$1" sessions 2> /dev/null < /dev/null | awk '$1 == "main" { for (i = 2; i <= NF; i++) if ($i == "idle") f = 1 } END { exit !f }'; }
restart_parts() {   # <hub>: a running orchestrator on new code restarts only when idle; a busy one is left for later
  local h="$1" st since p="$CONF_DIR/restart-pending"
  [ "$RESTART_NEEDED" = 1 ] || { [ -f "$p" ] && grep -qxF -- "$h" "$p"; } || return 0
  read -r st since <<EOF
$(orch_state "$h" < /dev/null)
EOF
  if [ "$st" = running ] && ! orch_idle "$h"; then
    { [ -f "$p" ] && grep -vxF -- "$h" "$p"; echo "$h"; } | write_conf_file restart-pending
    echo "orchestrator: busy on the old bin/chat; it restarts when it is idle (the next ade update), never interrupted"; return 0
  fi
  if [ "$st" = running ]; then
    if chat "$h" stop < /dev/null > /dev/null && chat "$h" start < /dev/null > /dev/null; then
      echo "orchestrator: idle, restarted on the new bin/chat"; journal_line "$h" "ade update: restarted the orchestrator for the new bin/chat (it was idle)"
    else echo "orchestrator: the restart failed; run ade orchestrator start"; fi
  fi
  [ -f "$p" ] && grep -vxF -- "$h" "$p" | write_conf_file restart-pending
  return 0
}
cmd_update() {
  local check=0 rc=0 hub="" p plugins s line
  local usage="usage: ade update [--check | --rollback | --auto on|off]"
  while [ $# -gt 0 ]; do case "$1" in --check) check=1; shift ;; --rollback) [ $# -eq 1 ] && [ "$check" = 0 ] || die 2 "$usage"; self_rollback; return ;;
    --auto) [ $# -eq 2 ] && [ "$check" = 0 ] || die 2 "$usage"
      case "$2" in on|off) echo "$2" | write_conf_file auto-update ;; *) die 2 "$usage" ;; esac
      if [ "$2" = on ]; then echo "auto-update on: ade patch and minor releases install themselves (from a terminal, never in an agent session)"
      else echo "auto-update off: ade only tells you about a new release (ade update installs it)"; fi; return 0 ;;
    *) die 2 "$usage" ;; esac; done
  UPD_CHANGED=""; RESTART_NEEDED=0
  self_update "$check" || rc=1
  hub="$( (find_hub) 2> /dev/null)" || hub=""
  [ -n "$hub" ] && { hub_update "$hub" "$check" || rc=1; }
  plugins="$(ade_plugins)"
  if command -v claude > /dev/null 2>&1; then
    for p in $plugins; do
      if [ "$check" = 1 ]; then echo "plugin $p: claude plugin update"
      elif claude plugin update "$p" < /dev/null > /dev/null 2>&1; then echo "plugin $p: updated"; else echo "plugin $p: update failed"; fi
    done
    [ "$check" = 0 ] && [ -n "$plugins" ] && UPD_CHANGED="$UPD_CHANGED, plugins"
    if [ "$check" = 1 ]; then echo "Claude Code: claude update (running sessions keep their version until they restart)"
    else ( unset ADE_NO_CLAUDE_UPDATE; rm -f "$CONF_DIR/claude-updated"; claude_update "$hub" ) && UPD_CHANGED="$UPD_CHANGED, Claude Code (on restart)"; fi
  fi
  if [ -n "$hub" ] && s="$(ui_live "$hub")"; then
    if [ "$check" = 1 ]; then echo "ade ui: reloads its theme and keys (tmux source-file; stays attached)"
    else ui_conf "$hub" "$s" | write_conf_file "ui-$s.tmux.conf"; ui_tmux source-file "$CONF_DIR/ui-$s.tmux.conf" < /dev/null && echo "ade ui: reloaded (still attached)"; fi
  fi
  [ "$check" = 1 ] && return 0
  [ -n "$hub" ] && restart_parts "$hub"
  if [ -n "$hub" ] && [ -n "$UPD_CHANGED" ] && [ -x "$hub/bin/notify" ]; then
    line="ade update: ${UPD_CHANGED#, }; applies on your next prompt"; case "$UPD_CHANGED" in *plugins*) line="$line (run /reload-plugins for the plugins)" ;; esac
    hub_run "$hub" notify all "$line" < /dev/null > /dev/null 2>&1 || echo "ade: bin/notify failed"
  fi
  return $rc
}

# release manifests and update notifications (story A12): release.json of each better-ade component in use, fetched
# at most once a day by a detached job (one 2 s budget for all of them; offline = try tomorrow), so no command ever
# waits for the network; the next command reads the cache: a banner once per new version (security: every command).
# ade-cli patch and minor releases install themselves in a detached job started from a terminal (never an agent),
# majors and min_supported jumps ask first; ade update --auto off (or ADE_NO_AUTO_UPDATE=1) keeps notify-only.
MANIFEST_SINCE=0.2.0   # the first ade-cli release with release.json: from it on, no valid manifest = nothing installed
ADE_RELEASES_BASE="${ADE_RELEASES_BASE:-https://github.com}"
UPD_DIR="$CONF_DIR/updates"
COMPONENTS="ade-cli ade-brain ade-method ade-skills ade-agent-registry"
ver_ge() { ! ver_gt "$2" "$1"; }
sha256_of() { if command -v shasum > /dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1; else sha256sum "$1" | cut -d' ' -f1; fi; }
# manifest_py <release.json> <component> <version|latest> [file name]: checks that the manifest is for exactly that
# component (and version); prints the file's sha256 when a name is given, else "version urgency min summary" (tabs;
# "-" for an empty field; no control character). Any url in it is ignored: the file always comes from its tag.
# 1 with the reason on stdout when it is not such a manifest.
manifest_py() {
  python3 - "$@" <<'PY' 2> /dev/null
import json, os, re, sys
p, comp, ver = sys.argv[1:4]; name = sys.argv[4] if len(sys.argv) > 4 else ""
SEMVER = re.compile(r"[0-9]{1,9}\.[0-9]{1,9}\.[0-9]{1,9}")
def no(why):
    print(why); sys.exit(1)
try:
    if os.path.getsize(p) > 65536: no("it is larger than 64 KiB")
    d = json.load(open(p))
except (OSError, ValueError):
    no("it is not valid JSON")
if not isinstance(d, dict): no("it is not a JSON object")
if d.get("component") != comp: no("it is not the manifest of %s" % comp)
v = d.get("version")
if not isinstance(v, str) or not SEMVER.fullmatch(v): no("its version is not X.Y.Z")
if ver != "latest" and v != ver: no("it is the manifest of another version than %s" % ver)
if name:
    for f in d.get("files") if isinstance(d.get("files"), list) else []:
        if isinstance(f, dict) and f.get("name") == name:
            sha = f.get("sha256")
            if isinstance(sha, str) and re.fullmatch(r"[0-9a-f]{64}", sha): print(sha); sys.exit(0)
    no("it names no sha256 for %s" % name)
clean = lambda s: re.sub(r"\s+", " ", re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", s)).strip()[:160] or "-"
urg = d.get("urgency") if d.get("urgency") in ("normal", "security") else "normal"
mins = d.get("min_supported") if isinstance(d.get("min_supported"), str) and SEMVER.fullmatch(d["min_supported"]) else "-"
summ = clean(d["summary"]) if isinstance(d.get("summary"), str) else "-"
print("\t".join((v, urg, mins, summ)))
PY
}
# release_sha <version> <tmp folder>: the sha256 of ade in the per-version release.json, which must exist from
# MANIFEST_SINCE on; prints the reason and returns 1 when it cannot be had (nothing may be installed then)
release_sha() {
  local v="$1" out
  ver_ge "$v" "$MANIFEST_SINCE" || return 0   # an older release has no manifest: shebang, bash -n and ade version only
  dl "$ADE_RELEASES_BASE/better-ade/ade-cli/releases/download/v$v/release.json" "$2/release.json" ||
    { echo "there is no release.json for ade $v (every release from $MANIFEST_SINCE on has one)"; return 1; }
  out="$(manifest_py "$2/release.json" ade-cli "$v" ade)" || { echo "its release.json is not valid: $out"; return 1; }
  echo "$out"
}
comp_installed() {   # <component> <hub>: the installed version (X.Y.Z), or nothing when it is not in use here
  local v="" top
  case "$1" in
    ade-cli) v="$ADE_VERSION" ;;
    ade-brain) [ -n "$2" ] && [ -f "$2/VERSION" ] && v="$(tr -d ' \r\n' < "$2/VERSION")" ;;
    ade-method) top="$(git rev-parse --show-toplevel 2> /dev/null)" && [ -f "$top/.ade/method-version" ] && v="$(tr -d ' \r\n' < "$top/.ade/method-version")" ;;
    ade-skills) [ -n "$(ade_plugins)" ] && v="$ADE_SKILLS_REF" ;;
    ade-agent-registry) top="$(git rev-parse --show-toplevel 2> /dev/null)" && [ -d "$top/.ade/agents" ] && v="$ADE_REGISTRY_REF" ;;
  esac
  v="${v#v}"; matches "$v" '^[0-9]+\.[0-9]+\.[0-9]+$' && echo "$v"
}
fetch_manifest() {   # <component>: its latest release.json, checked, into $UPD_DIR/<c>.latest; TERM stops the request
  local c="$1" tmp proto="=https" line cp=""
  [ "${ADE_TEST_ALLOW_FILE_URLS:-}" = 1 ] && proto="=https,file"
  tmp="$(mktemp "$UPD_DIR/.$c.XXXXXX")" || return 1
  trap '[ -z "$cp" ] || kill "$cp" 2> /dev/null; rm -f "$tmp"; exit 1' TERM
  curl --proto "$proto" --proto-redir "$proto" -fsSL --connect-timeout 2 --max-time 2 \
    "$ADE_RELEASES_BASE/better-ade/$c/releases/latest/download/release.json" -o "$tmp" 2> /dev/null < /dev/null & cp=$!
  if wait "$cp" && line="$(manifest_py "$tmp" "$c" latest)"; then printf '%s\n' "$line" > "$tmp.ok" && mv -f "$tmp.ok" "$UPD_DIR/$c.latest"; fi
  rm -f "$tmp" "$tmp.ok"
}
update_fetch_all() {   # the detached job: every component in use, side by side, within one 2-second budget
  local hub c pids="" w
  hub="$( (find_hub) 2> /dev/null)" || hub=""
  for c in $COMPONENTS; do
    comp_installed "$c" "$hub" > /dev/null 2>&1 || continue
    fetch_manifest "$c" & pids="$pids $!"
  done
  [ -n "$pids" ] || return 0
  # shellcheck disable=SC2086  # pids is a list on purpose
  { sleep 2; kill $pids 2> /dev/null; } & w=$!
  # shellcheck disable=SC2086
  wait $pids 2> /dev/null; kill "$w" 2> /dev/null; wait "$w" 2> /dev/null
}
auto_on() { [ "${ADE_NO_AUTO_UPDATE:-}" != 1 ] && [ "$(cat "$CONF_DIR/auto-update" 2> /dev/null)" != off ]; }
UPD_HUB=""; UPD_HUB_SET=0
upd_hub() { [ "$UPD_HUB_SET" = 1 ] || { UPD_HUB="$( (find_hub) 2> /dev/null)" || UPD_HUB=""; UPD_HUB_SET=1; }; }
update_check() {   # before a command: what the cache says (no request here), and once a day the detached fetch
  [ "${ADE_NO_UPDATE_CHECK:-}" = 1 ] && return 0
  ( umask 077; mkdir -p "$UPD_DIR" ) 2> /dev/null || return 0
  local now t
  update_auto_report
  now="$(date +%s)"; t="$(cat "$UPD_DIR/checked" 2> /dev/null)"; matches "$t" '^[0-9]+$' || t=0
  # a fetch job that died left its lock: after a minute it is stale
  [ -n "$(find "$UPD_DIR/fetching" -maxdepth 0 -mmin +1 2> /dev/null)" ] && rmdir "$UPD_DIR/fetching" 2> /dev/null
  if [ $((now - t)) -ge 86400 ] && mkdir "$UPD_DIR/fetching" 2> /dev/null; then
    echo "$now" > "$UPD_DIR/checked"
    ( trap '' HUP INT; update_fetch_all; rmdir "$UPD_DIR/fetching" ) < /dev/null > /dev/null 2>&1 &
  fi
  update_auto
  update_banners
  return 0
}
update_banners() {   # one line per component with a newer cached release, once per version (security: every command)
  local c ver urg min sum seen inst line
  for c in $COMPONENTS; do
    [ -f "$UPD_DIR/$c.latest" ] || continue
    IFS="$TAB" read -r ver urg min sum < "$UPD_DIR/$c.latest" || [ -n "$ver" ] || continue
    [ "$sum" = - ] && sum=""
    seen="$(cat "$UPD_DIR/$c.seen" 2> /dev/null)"
    [ "$urg" = security ] || [ "$ver" != "$seen" ] || continue
    upd_hub; inst="$(comp_installed "$c" "$UPD_HUB" 2> /dev/null)" || continue
    if ver_gt "$ver" "$inst"; then
      # one line of at most 80 columns (A18): the versions and the command, never the release's own text
      line="ade: $c $ver is out (you have $inst)$([ "$urg" = security ] && echo ' [security update]'): run ade update"
      [ "${#line}" -le 80 ] || line="ade: a newer $c is out: run ade update"; echo "$line" >&2
      [ "$ver" != "$seen" ] && update_telegram "$UPD_HUB" "$c $ver is out (you have $inst)${sum:+: $sum}"
    fi
    echo "$ver" > "$UPD_DIR/$c.seen"
  done
}
# update_auto: a newer ade-cli patch or minor release (or a security one) installs itself through self_update (the
# manifest's sha256, A11's rename) in a detached job; only when a person runs ade at a terminal, never in an agent
# session; once per version; the next command says how it went (update_auto_report)
update_auto() {
  local ver urg min sum
  [ -n "$ADE_VERSION" ] && [ -f "$UPD_DIR/ade-cli.latest" ] || return 0
  IFS="$TAB" read -r ver urg min sum < "$UPD_DIR/ade-cli.latest" || [ -n "$ver" ] || return 0
  ver_gt "$ver" "$ADE_VERSION" && auto_on || return 0
  agent_context && return 0
  [ -t 0 ] && [ -t 2 ] || return 0
  [ "$(cat "$UPD_DIR/ade-cli.tried" 2> /dev/null)" = "$ver" ] && return 0
  echo "$ver" > "$UPD_DIR/ade-cli.tried"
  if [ "$(major_of "$ver")" != "$(major_of "$ADE_VERSION")" ] || { [ "$min" != - ] && ver_gt "$min" "$ADE_VERSION"; }; then
    echo "ade: ade $ver is out (you have $ADE_VERSION); it asks first: run ade update" | cut -c1-80 >&2
    upd_hub; update_telegram "$UPD_HUB" "ade $ver is out (you have $ADE_VERSION); it needs ade update by hand"
    echo "$ver" > "$UPD_DIR/ade-cli.seen"; return 0
  fi
  mkdir "$UPD_DIR/installing" 2> /dev/null || return 0
  echo "ade: ade $ver is out (you have $ADE_VERSION); installing it in the background" | cut -c1-80 >&2
  echo "$ver" > "$UPD_DIR/ade-cli.seen"
  ( trap '' HUP INT; self_update 0 "$ver" > "$UPD_DIR/auto.log" 2>&1; echo "exit $?" >> "$UPD_DIR/auto.log"; rmdir "$UPD_DIR/installing" ) < /dev/null > /dev/null 2>&1 &
}
update_auto_report() {   # a finished auto-install, once: every line it printed (a failure keeps its reason)
  local f="$UPD_DIR/auto.log" last
  [ -f "$f" ] && [ ! -d "$UPD_DIR/installing" ] || return 0
  last="$(tail -1 "$f")"
  if [ "$last" = "exit 0" ]; then sed '$d' "$f" | no_ctl | sed 's/^ade: //; s/^/ade: auto-update: /' >&2
    upd_hub; update_telegram "$UPD_HUB" "ade updated itself: $(sed '$d' "$f" | tail -1 | no_ctl)"
  else sed '$d' "$f" | no_ctl | sed 's/^ade: //; s/^/ade: the auto-update failed: /' >&2; fi
  rm -f "$f"
}
major_of() { echo "${1%%.*}"; }
update_telegram() {   # <hub> <text>: one line through the orchestrator's channel when the hub has one (bin/chat send)
  [ -n "$1" ] && [ -n "$(conf_get "$1" HUB_CHANNELS)" ] && [ -x "$1/bin/chat" ] || return 0
  hub_run "$1" chat send "$2" < /dev/null > /dev/null 2>&1 || true
}
update_badge() {   # the number of components with a newer release, for ade ui's tab bar
  local hub n=0 c inst ver; hub="$( (find_hub) 2> /dev/null)" || hub=""
  for c in $COMPONENTS; do
    [ -f "$UPD_DIR/$c.latest" ] || continue; inst="$(comp_installed "$c" "$hub" 2> /dev/null)" || continue
    IFS="$TAB" read -r ver _ < "$UPD_DIR/$c.latest"; ver_gt "$ver" "$inst" && n=$((n + 1))
  done
  echo "$n"
}

# ade files, ade view and the link picker (story A15): read-only. The roots are the hub, the checkouts its ACCESS.md
# files list and the project of the working folder; a path outside them, or a link leading out of them, opens only
# after a yes typed at a terminal (never an agent or a pipe). Names and contents are data: no control character
# reaches the screen, and a path reaches a tool after "--", or absolute for the ones without it (xdg-open).
# The tools ade installs (Homebrew or apt, after a yes): .ade/context/hub-interface.md.
FILES_USAGE="usage: ade files [<folder>]"
VIEW_USAGE="usage: ade view <path[:line[:col]]>"
ROOTS=""
files_roots() {   # [folder]: physical paths of the hub, its checkouts and that folder's git project, one per line
  local hub f c b top
  if hub="$( (find_hub) 2> /dev/null)"; then
    (cd "$hub" && pwd -P)
    for f in "$hub"/projects/*/ACCESS.md "$hub"/ops/*/ACCESS.md; do
      [ -f "$f" ] || continue
      while IFS="$TAB" read -r c b; do
        # shellcheck disable=SC2088  # a literal ~ in ACCESS.md is expanded here on purpose
        case "$c" in "~/"*) c="$HOME/${c#\~/}" ;; esac
        [ -n "$c" ] && [ -d "$c" ] && (cd "$c" && pwd -P)
      done <<EOF
$(access_rows "$f")
EOF
    done
  fi
  top="$(cd "${1:-.}" 2> /dev/null && git rev-parse --show-toplevel 2> /dev/null)" && (cd "$top" && pwd -P)
  return 0
}
on_ssh() { [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; }
# files_confirm <question>: a yes typed at a terminal; anything else exits 2 with nothing opened
files_confirm() {
  agent_context && die 2 "$1: ade asks a person at a terminal first; refused inside a Claude Code session (an agent cannot answer for you); nothing opened"
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || die 2 "$1: ade asks a person at a terminal first; refused without one; nothing opened"
  tty_confirm "$1. Open it anyway?" || die 2 "nothing opened"
}
# files_target <path[:line[:col]]> <folder it is relative to>: FT_PATH FT_LINE, then (after a yes when it leads out of
# the roots) FT_KIND (dir pdf image markdown text binary unreadable) FT_CTL (control characters in it) FT_OPENABLE (o may open it: a document)
# FT_SHOWN and FT_SHOWN_REAL are the names as Python's shown() draws them (control, C1, bidi and zero-width characters
# and bytes that are not UTF-8 become ?): every message that names a file uses them, never the raw name
files_target() {
  local out w
  out="$(files_py where "$1" "$2")" || exit 2
  IFS="$US" read -r FT_PATH FT_LINE w FT_REAL FT_SHOWN FT_SHOWN_REAL <<EOF
$out
EOF
  [ "$w" != missing ] || die 2 "no such file or folder: $FT_SHOWN"
  case "$w" in
    out) files_confirm "$FT_SHOWN is outside the hub and its projects" ;;
    link-out) files_confirm "$FT_SHOWN is a link to $FT_SHOWN_REAL, outside the hub and its projects" ;;
  esac
  IFS="$US" read -r FT_KIND FT_CTL FT_OPENABLE <<EOF
$(files_py kind "$FT_PATH")
EOF
  [ "$FT_KIND" != unreadable ] || die 1 "cannot read $FT_SHOWN (not a readable regular file)"
}
hint_once() {   # <tool> <what ade does without it>: one line, the first time only (~/.config/ade/hints)
  [ -f "$CONF_DIR/hints" ] && grep -qxF -- "$1" "$CONF_DIR/hints" && return 0
  echo "ade: $1 is not installed, so $2; ade setup --tools installs it (said once)" >&2
  { [ -f "$CONF_DIR/hints" ] && cat "$CONF_DIR/hints"; echo "$1"; } | write_conf_file hints
}

cmd_files() {
  [ "${1:-}" = --act ] && { shift; files_act "$@"; return; }
  [ $# -le 1 ] || die 2 "$FILES_USAGE"
  local d
  if [ $# -eq 1 ]; then d="$1"; [ -n "$d" ] || die 2 "$FILES_USAGE"; else d="$( (find_hub) 2> /dev/null)" || d="$PWD"; fi
  ROOTS="$(files_roots .)"; files_target "$d" "$PWD"
  [ "$FT_KIND" = dir ] || die 2 "not a folder: $FT_SHOWN (ade view shows a file)"
  files_explore "$FT_PATH"
}
# files_explore <folder>: the built-in browser (read-only, held to the roots), on a terminal only. yazi only when the
# user asks for it with ADE_FILES=yazi: it is neither read-only nor held to the hub and its projects
YAZI_WARNING="yazi is neither read-only nor held to the hub and its projects: it can delete, rename, move and run commands, and walks anywhere without asking"
files_explore() {
  { [ -t 0 ] && [ -t 1 ]; } || die 2 "ade files needs a terminal (ade view <file> prints one file)"
  if [ "${ADE_FILES:-}" = yazi ]; then
    if command -v yazi > /dev/null 2>&1; then echo "ade: ADE_FILES=yazi: $YAZI_WARNING (not read-only)" >&2; yazi -- "$1"; return; fi
    echo "ade: ADE_FILES=yazi, but yazi is not installed; the built-in browser instead" >&2
  fi
  files_py explore "$1"
}

cmd_view() {
  local cwd="" arg="" n=0
  while [ $# -gt 0 ]; do case "$1" in
    --cwd) [ $# -ge 2 ] && [ -n "$2" ] && [ -d "$2" ] || die 2 "$VIEW_USAGE (--cwd needs a folder)"; cwd="$(cd -- "$2" && pwd)"; shift 2 ;;
    --) shift; [ $# -eq 1 ] || die 2 "$VIEW_USAGE"; arg="$1"; n=$((n + 1)); shift ;;
    *) arg="$1"; n=$((n + 1)); shift ;;
  esac; done
  [ "$n" = 1 ] && [ -n "$arg" ] || die 2 "$VIEW_USAGE"
  ROOTS="$(files_roots "${cwd:-.}")"; files_target "$arg" "${cwd:-$PWD}"
  case "$FT_KIND" in
    dir) files_explore "$FT_PATH" ;;
    text|markdown) view_text ;;
    *)   # the page folder is ade's: made here, removed here even when the window is closed (Python removes it too)
      view_traps; VIEW_TMP="$(mk_tmp)" || die 1 "could not make a temp folder"
      ADE_SHOW_TMP="$VIEW_TMP" files_py show "$FT_KIND" "$FT_PATH" "$FT_OPENABLE"; local rc=$?
      rm_tmp "$VIEW_TMP"; trap - HUP TERM INT; return $rc ;;
  esac
}
# view_text: code at its line (bat, else less -N), Markdown through glow (else plain), from a copy without control
# characters when the file holds any (removed again even when the window is closed: HUP, TERM, INT). Every pager is
# less in secure mode (LESSSECURE=1: no v, !, |, :e; no LESSOPEN preprocessor), whatever PAGER says
VIEW_TMP=""
view_traps() { trap 'rm_tmp "$VIEW_TMP"; exit 129' HUP; trap 'rm_tmp "$VIEW_TMP"; exit 143' TERM; trap 'rm_tmp "$VIEW_TMP"; exit 130' INT; }
view_text() {
  local src="$FT_PATH" b l="$FT_LINE" rc
  if [ "$FT_CTL" = 1 ]; then
    view_traps; VIEW_TMP="$(mk_tmp)" || die 1 "could not make a temp folder"; src="$VIEW_TMP/$(basename "$FT_PATH")"; no_ctl < "$FT_PATH" > "$src"
    echo "ade: this file holds control characters; they are not shown" >&2
  fi
  LESSSECURE=1; LESSOPEN=""; LESSCLOSE=""; export LESSSECURE LESSOPEN LESSCLOSE
  if [ "$FT_KIND" = markdown ] && [ "$l" = 0 ] && command -v glow > /dev/null 2>&1; then PAGER="less -r" glow -p -- "$src"; rc=$?
  elif b="$(tool_bin bat)"; then
    if [ "$l" -gt 0 ]; then "$b" --style=numbers --highlight-line "$l" --pager "less -RF +${l}g" -- "$src"; else "$b" --style=numbers --pager "less -RF" -- "$src"; fi; rc=$?
  elif [ "$FT_KIND" = markdown ] && [ "$l" = 0 ]; then hint_once glow "Markdown is shown as plain text"; less -- "$src"; rc=$?
  else
    hint_once bat "code has no syntax colours (less -N)"
    if [ "$l" -gt 0 ]; then less -N "+${l}g" -- "$src"; else less -N -- "$src"; fi; rc=$?
  fi
  rm_tmp "$VIEW_TMP"; trap - HUP TERM INT; return $rc
}

# files_act open|reveal|copy|url <absolute path, or an http(s) URL>: the default app (never a program), the file
# manager, the clipboard, the browser; over SSH the path and a copy command instead
files_act() {
  [ $# -eq 2 ] || die 2 "usage: ade files --act open|reveal|copy|url <path>"
  local act="$1" p="$2" shown
  case "$act" in
    url)   # plain printable ASCII only: no space, control, bidi or zero-width character can hide where it goes
      case "$p" in http://?*|https://?*) ;; *) die 2 "not a web link (http or https)" ;; esac
      [ -z "$(printf '%s' "$p" | LC_ALL=C tr -d '!-~')" ] || die 2 "a web link must be plain ASCII (no spaces, control, bidi or zero-width characters); nothing opened"
      FT_PATH="$p"; FT_SHOWN="$p" ;;
    open|reveal|copy) case "$p" in /*) ;; *) die 2 "not an absolute path" ;; esac
      ROOTS="$(files_roots .)"; files_target "$p" / ;;
    *) die 2 "usage: ade files --act open|reveal|copy|url <path>" ;;
  esac
  shown="$FT_SHOWN"
  if on_ssh; then
    echo "over SSH: $shown"
    [ "$act" = url ] || echo "to copy it to this computer: scp -s $(shq "$(uname -n 2> /dev/null || echo host):$FT_REAL") ."
    return 0
  fi
  [ "$act" = open ] && [ "$FT_OPENABLE" != 1 ] &&
    die 2 "$shown: o opens documents only (PDF, images, text, office, audio, video), never a program or a file that installs, mounts, unpacks or points elsewhere; f shows it in its folder"
  case "$act" in
    copy) clip_copy "$FT_PATH" && echo "copied the path: $shown" ;;
    *) if on_macos; then
        case "$act" in url) open "$FT_PATH" ;; open) open -- "$FT_PATH" ;; reveal) open -R -- "$FT_PATH" ;; esac
      else
        command -v xdg-open > /dev/null 2>&1 || die 2 "xdg-open is not installed (xdg-utils); the path: $shown"
        if [ "$act" = reveal ]; then xdg-open "$(dirname "$FT_PATH")"; else xdg-open "$FT_PATH"; fi
      fi ;;
  esac
}
clip_copy() {   # <path>: onto the clipboard on stdin (pbcopy, wl-copy, xclip, xsel), shell-quoted unless it is plain; none: say so
  local c v="$1"
  [ -z "$(printf '%s' "$v" | LC_ALL=C tr -d 'A-Za-z0-9_./@%+=:,-')" ] || v="$(shq "$v")"
  if on_macos && command -v pbcopy > /dev/null 2>&1; then c=pbcopy
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy > /dev/null 2>&1; then c=wl-copy
  elif command -v xclip > /dev/null 2>&1; then c="xclip -selection clipboard"
  elif command -v xsel > /dev/null 2>&1; then c="xsel --clipboard --input"
  else echo "no clipboard tool here (pbcopy, wl-copy, xclip or xsel); the path: ${FT_SHOWN:-$1}"; return 1; fi
  printf '%s' "$v" | $c   # c: one of the commands above, split into its words on purpose
}

# the tools ade uses: the required ones (checked by install.sh and ade setup) and the viewer extras (one step in ade
# setup); ade setup --tools installs what is missing with Homebrew (macOS) or apt (Ubuntu), after a yes at a terminal
REQUIRED_TOOLS="git python3 tmux gh"
EXTRA_TOOLS="yazi bat glow poppler chafa"
tool_bin() { local c; for c in "$1" $([ "$1" = bat ] && echo batcat); do command -v "$c" 2> /dev/null && return 0; done; return 1; }   # Ubuntu names bat batcat
tool_present() { case "$1" in poppler) command -v pdftotext && command -v pdftoppm ;; *) tool_bin "$1" ;; esac > /dev/null 2>&1; }
tools_missing() { local t out=""; for t in "$@"; do tool_present "$t" || out="${out:+$out }$t"; done; echo "$out"; }
tool_what() {
  case "$1" in
    git) echo "required: hubs and projects are git repositories" ;; python3) echo "required: ade reads JSON with it" ;;
    tmux) echo "required: ade ui" ;; gh) echo "required: ade hub new on GitHub" ;;
    yazi) echo "extra: ade files with ADE_FILES=yazi; not read-only" ;; bat) echo "extra: syntax colours in ade view, else less -N" ;;
    glow) echo "extra: Markdown rendered in ade view, else plain text" ;; poppler) echo "extra: PDF pages in ade view (pdftotext, pdftoppm)" ;;
    chafa) echo "extra: images on more terminals" ;;
  esac
}
tool_pkg() { case "$1:$2" in brew:python3) echo python ;; apt:poppler) echo poppler-utils ;; apt:yazi|apt:glow) ;; *) echo "$2" ;; esac; }   # <brew|apt> <tool>
tools_report() {   # ade doctor: each tool, installed or missing
  local t; echo "ade tools:"
  for t in $REQUIRED_TOOLS $EXTRA_TOOLS; do
    if tool_present "$t"; then printf '  %-8s installed\n' "$t"; else printf '  %-8s missing (%s)\n' "$t" "$(tool_what "$t")"; fi
  done
  [ -z "$(tools_missing $REQUIRED_TOOLS $EXTRA_TOOLS)" ] || echo "  ade setup --tools installs what is missing"
}
tools_install() {   # <tool>...: one question at a terminal, then brew install or apt-get install -y; 1 = not installed
  local m="" t p pkgs="" cmd rc
  if on_macos; then command -v brew > /dev/null 2>&1 && m=brew; elif command -v apt-get > /dev/null 2>&1; then m=apt; fi
  if [ -z "$m" ]; then
    if on_macos; then echo "Homebrew is not installed (https://brew.sh), so ade cannot install: $*"
    else echo "no apt-get here, so ade cannot install: $*; use your package manager"; fi
    return 1
  fi
  for t in "$@"; do p="$(tool_pkg "$m" "$t")"
    if [ -n "$p" ]; then pkgs="${pkgs:+$pkgs }$p"; else echo "$t: not in apt; get it from https://github.com/$( [ "$t" = yazi ] && echo sxyazi/yazi || echo charmbracelet/glow)/releases (ade works without it)"; fi
  done
  [ -n "$pkgs" ] || return 1
  if [ "$m" = brew ]; then cmd="brew install $pkgs"; elif [ "$(id -u)" = 0 ]; then cmd="apt-get install -y $pkgs"; else cmd="sudo apt-get install -y $pkgs"; fi
  if agent_context; then echo "ade installs nothing from an agent session; run it yourself at a terminal: $cmd"; return 1; fi
  { [ -t 0 ] && : < /dev/tty; } 2> /dev/null || { echo "to install them, run at a terminal: $cmd (or ade setup --tools)"; return 1; }
  tty_confirm "Install $pkgs now? This runs: $cmd" || { echo "nothing installed (later: ade setup --tools)"; return 1; }
  $cmd < /dev/tty; rc=$?   # cmd: ade's own words (the package names above), split on purpose
  if [ "$rc" = 0 ]; then echo "installed: $pkgs"; return 0; fi
  echo "$cmd failed (exit $rc)$([ "$m" = apt ] && echo '; when apt cannot find a package, run apt-get update first')"; return 1
}
setup_tools() {   # [required|extras]: ade setup --tools; what is missing, after one yes
  local req ext
  req="$(tools_missing $REQUIRED_TOOLS)"; ext="$(tools_missing $EXTRA_TOOLS)"
  case "${1:-}" in required) ext="" ;; extras) req="" ;; esac
  [ -n "$req$ext" ] || { echo "tools: everything ade uses is installed"; return 0; }
  [ -n "$req" ] && echo "missing tools ade needs: $req"
  [ -n "$ext" ] && echo "missing viewer extras (ade works without them): $ext"
  case " $ext " in *" yazi "*) echo "  ade files uses yazi only with ADE_FILES=yazi: $YAZI_WARNING." ;; esac
  # shellcheck disable=SC2086  # tool names, one word each
  tools_install $req $ext
}
setup_tools_steps() {   # the first steps of ade setup: the required tools, then the viewer extras as one yes/no
  local req ext
  req="$(tools_missing $REQUIRED_TOOLS)"; ext="$(tools_missing $EXTRA_TOOLS)"
  # shellcheck disable=SC2086
  [ -n "$req" ] && { echo "missing tools ade needs: $req"; tools_install $req || true; }
  # shellcheck disable=SC2086
  [ -n "$ext" ] && { echo "The viewer extras (ade files and ade view work without them): $ext"
    case " $ext " in *" yazi "*) echo "  ade files uses yazi only with ADE_FILES=yazi: $YAZI_WARNING." ;; esac
    tools_install $ext || true; }
  return 0
}

# files_py <op> [args]: where, kind, explore, show, pick. Run with -I (never a module from the folder being browsed);
# stdin stays the terminal. It opens files for reading only and writes only in its own temp folder.
files_py() {
  local src; IFS= read -r -d '' src <<'PY' || true
import base64, glob, os, re, select, shutil, signal, subprocess, sys, tempfile, termios, time
for s in (sys.stdout, sys.stderr): s.reconfigure(encoding="utf-8", errors="replace")
CHILD = []   # the tool running now (pdftoppm, chafa): stopped before a temp folder is removed
def _closed(n, _):   # a closed window (HUP) or a kill (TERM): the finally blocks still run, once
    for _s in (signal.SIGHUP, signal.SIGTERM): signal.signal(_s, signal.SIG_IGN)
    raise SystemExit(128 + n)
def run(cmd, **kw):   # a tool, remembered while it runs (an interruption leaves it for drop() to stop)
    c = subprocess.Popen(cmd, **kw); CHILD.append(c); rc = c.wait(); CHILD.remove(c); return rc
