class Timeout(Exception): pass
class Chrome:
    """one headless Chromium on a DevTools pipe (--remote-debugging-pipe: fd 3 in, fd 4 out, JSON messages ending in NUL).
    No port is opened. Every request the page makes is held (Fetch) and let go only when allowed() says so."""
    def __init__(self, exe, tmp, width, height, allowed, deadline):
        self.allowed = allowed; self.deadline = deadline; self.n = 0; self.buf = bytearray(); self.loaded = False
        self.status = None; self.blocked = {}; self.session = None
        profile = os.path.join(tmp, "profile"); os.mkdir(profile, 0o700)
        args = [exe, "--headless", "--remote-debugging-pipe", "--user-data-dir=" + profile, "--no-first-run", "--no-default-browser-check",
                "--disable-gpu", "--hide-scrollbars", "--mute-audio", "--disable-extensions", "--disable-background-networking",
                "--disable-sync", "--disable-component-update", "--window-size=%d,%d" % (width, height)]
        # its own sandbox stays on where this computer can make a user namespace; where it cannot (a container), or for
        # root, Chromium runs only with --no-sandbox (the choice the ADE Computer's chromium wrapper makes)
        if sys.platform.startswith("linux"):
            try: ns = os.geteuid() != 0 and subprocess.call(["unshare", "-U", "true"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0
            except OSError: ns = False
            if not ns: args.append("--no-sandbox")
        args.append("about:blank")
        r_in, w_in = os.pipe(); r_out, w_out = os.pipe(); import fcntl
        keep = []   # whatever sits on fd 3 and 4 here is moved aside while Chromium is started, then put back
        ends = [fcntl.fcntl(fd, fcntl.F_DUPFD_CLOEXEC, 10) for fd in (r_in, w_in, r_out, w_out)]
        for fd in (r_in, w_in, r_out, w_out): os.close(fd)
        r_in, self.w, self.r, w_out = ends
        for fd in (3, 4):
            try: keep.append((fd, fcntl.fcntl(fd, fcntl.F_DUPFD_CLOEXEC, 10)))
            except OSError: pass
        os.dup2(r_in, 3, inheritable=True); os.dup2(w_out, 4, inheritable=True)
        try:
            self.p = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, pass_fds=(3, 4), start_new_session=True)
        finally:
            os.close(3); os.close(4); os.close(r_in); os.close(w_out)
            for fd, saved in keep: os.dup2(saved, fd); os.close(saved)
    def send(self, method, params=None):
        self.n += 1; m = {"id": self.n, "method": method, "params": params or {}}
        if self.session and not method.startswith(("Target.", "Browser.")): m["sessionId"] = self.session
        data = json.dumps(m).encode("utf-8") + b"\0"
        while data: data = data[os.write(self.w, data):]
        return self.n
    def read(self, until):
        """the next message, or None once `until` has passed"""
        while True:
            i = self.buf.find(b"\0")
            if i >= 0:
                raw = bytes(self.buf[:i]); del self.buf[:i + 1]
                try: return json.loads(raw.decode("utf-8", "replace"))
                except ValueError: continue
            left = until - time.time()
            if left <= 0 or not select.select([self.r], [], [], left)[0]: return None
            b = os.read(self.r, 1 << 20)
            if not b: raise Timeout("the browser closed before it answered")
            self.buf += b
            if len(self.buf) > 256 << 20: raise Timeout("the browser sent more than a shot can be")
    def event(self, m):
        me = m.get("method"); p = m.get("params") or {}
        if me == "Fetch.requestPaused":
            why = self.allowed(str((p.get("request") or {}).get("url", "")))
            if not why: self.send("Fetch.continueRequest", {"requestId": p.get("requestId")})
            else: self.blocked[why] = self.blocked.get(why, 0) + 1; self.send("Fetch.failRequest", {"requestId": p.get("requestId"), "errorReason": "BlockedByClient"})
        elif me == "Page.javascriptDialogOpening": self.send("Page.handleJavaScriptDialog", {"accept": False})
        elif me == "Page.loadEventFired": self.loaded = True
        elif me == "Network.responseReceived" and self.status is None and p.get("type") == "Document":
            s = (p.get("response") or {}).get("status")
            if isinstance(s, int): self.status = s
    def call(self, method, params=None):
        i = self.send(method, params)
        while True:
            m = self.read(self.deadline)
            if m is None: raise Timeout("the browser did not answer in time (%s)" % method)
            if m.get("id") == i:
                if "error" in m: raise Timeout("the browser refused %s" % method)
                return m.get("result") or {}
            self.event(m)
    def wait(self, seconds, loaded=False):
        end = min(self.deadline, time.time() + seconds)
        while not (loaded and self.loaded):
            m = self.read(end)
            if m is None: break
            self.event(m)
    def close(self):
        try:
            if self.p.poll() is None: self.send("Browser.close")
        except OSError: pass
        try: self.p.wait(3)
        except subprocess.TimeoutExpired: pass
        try: os.killpg(self.p.pid, signal.SIGKILL)   # it and every helper it started (its own session)
        except OSError: pass
        try: self.p.wait(5)
        except Exception: pass
        for fd in (self.r, self.w):
            try: os.close(fd)
            except OSError: pass

def capture(url, tmp, width, full, file_root, element=None):
    """a PNG of the address -> (bytes, notes for the sidecar)"""
    exe = chromium()
    if not exe: die(1, NO_CHROMIUM)
    try: total = min(300, max(5, int(os.environ.get("ADE_SHOT_TIMEOUT", "45"))))
    except ValueError: total = 45
    root = os.path.realpath(file_root) if file_root else None
    OUT, KEY, META, OTHER = ("a file outside the project", "a key, .env or .git file of the project", "a link-local or metadata address",
                             "an address that is not http, https or file")
    def allowed(u):
        """None when the page may have it, else why not"""
        s = u.split(":", 1)[0].lower()
        if s in ("data", "blob", "about"): return None
        try: sp = urllib.parse.urlsplit(u); host = sp.hostname
        except ValueError: return OTHER
        if s in ("http", "https", "ws", "wss"):
            if meta_host(host): return META
            return OTHER if element else None
        if s != "file": return OTHER
        if not root or sp.netloc not in ("", "localhost"): return OUT
        path = os.path.realpath(urllib.parse.unquote(sp.path))
        if not inside(path, root): return OUT
        return KEY if keyfile(path, root) and not element else None
    def bye(n, _): raise KeyboardInterrupt
    for s in (signal.SIGTERM, signal.SIGHUP): signal.signal(s, bye)
    c = None; notes = []
    try:
        c = Chrome(exe, tmp, width, 800, allowed, time.time() + total)
        c.session = None; t = c.call("Target.createTarget", {"url": "about:blank"}).get("targetId")
        c.session = c.call("Target.attachToTarget", {"targetId": t, "flatten": True}).get("sessionId")
        if not c.session: raise Timeout("the browser opened no page")
        try: c.call("Browser.setDownloadBehavior", {"behavior": "deny"})   # a page never leaves a file behind
        except Timeout: pass
        c.call("Page.enable"); c.call("Network.enable"); c.call("Fetch.enable", {"patterns": [{"urlPattern": "*"}]})
        c.call("Emulation.setDeviceMetricsOverride", {"width": width, "height": 800, "deviceScaleFactor": 1, "mobile": False})
        err = c.call("Page.navigate", {"url": url}).get("errorText")
        if err: die(1, "the page did not load (%s); nothing saved" % shown(str(err), 80))
        c.wait(total / 2.0, loaded=True)
        if not c.loaded: notes.append("note: the page was still loading after %d s; shot as it was" % (total // 2))
        else: c.wait(0.3)
        shot = {"format": "png"}
        if element:
            v = c.call("Runtime.evaluate", {"expression": "(function(){var r=document.getElementById('t').getBoundingClientRect();return JSON.stringify([Math.ceil(r.right),Math.ceil(r.bottom)])})()", "returnByValue": True})
            try: w, h = [int(x) for x in json.loads((v.get("result") or {}).get("value"))]
            except Exception: raise Timeout("the browser did not measure the text")
            shot.update(captureBeyondViewport=True, clip={"x": 0, "y": 0, "width": max(1, min(w, 8000)), "height": max(1, min(h, 16384)), "scale": 1})
        elif full:
            size = c.call("Page.getLayoutMetrics").get("cssContentSize") or {}
            try: h = int(math.ceil(float(size.get("height", 800))))
            except (TypeError, ValueError): h = 800
            if h > 16384: notes.append("note: the page is %d px tall; cut at 16384" % h)
            shot.update(captureBeyondViewport=True, clip={"x": 0, "y": 0, "width": width, "height": max(1, min(h, 16384)), "scale": 1})
            notes.append("full page: yes")
        try: data = base64.b64decode(c.call("Page.captureScreenshot", shot).get("data") or "", validate=True)
        except ValueError: data = b""
        if data[:8] != b"\x89PNG\r\n\x1a\n": raise Timeout("the browser did not return a PNG")
        if c.status is not None and url.startswith("http"): notes.insert(0, "http status: %d" % c.status)
        if c.blocked: notes.append("blocked requests: %d (%s)" % (sum(c.blocked.values()), "; ".join("%s: %d" % (k, c.blocked[k]) for k in (OUT, KEY, META, OTHER) if k in c.blocked)))
        return data, notes
    except Timeout as e: die(1, "%s; nothing saved" % e)
    except OSError as e: die(1, "the browser stopped before the shot was taken (%s); nothing saved" % (e.strerror or e.__class__.__name__))
    except KeyboardInterrupt: die(130, "stopped; nothing saved")
    finally:
        if c: c.close()

