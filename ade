#!/bin/bash
# ade: one command for ADE in any terminal. Hub commands run the hub's own bin/ scripts (the single source of truth);
# project commands copy ade-method and registry files at their pinned tags. Bash 3.2 and Linux bash.
set -u
# names ade uses for typed answers and secrets: never inherited, so an exported one cannot carry a key to a child
unset SECRET ANSWER HUB_ANSWER
ADE_VERSION=""   # install.sh stamps this; a repo checkout reads VERSION beside the script
ADE_METHOD_REPO="${ADE_METHOD_REPO:-https://github.com/better-ade/ade-method}"
ADE_METHOD_REF="${ADE_METHOD_REF:-v2.0.0}"
ADE_REGISTRY_REPO="${ADE_REGISTRY_REPO:-https://github.com/better-ade/ade-agent-registry}"
ADE_REGISTRY_REF="${ADE_REGISTRY_REF:-v1.1.0}"

die() { echo "ade: $2" >&2; exit "$1"; }

usage() {
  cat <<'HELP'
usage: ade <command> [args]

Hub commands (run the hub's bin/ scripts):
  work        start or resume a work session (bin/work)
  status      list sessions (bin/sessions)
  dispatch    hand a task to an agent (bin/dispatch)
  notify      send a notification (bin/notify)
  chat        chat with the hub (bin/chat)
  method      the hub's method tools (bin/method)
  keys        manage provider keys (bin/keys)
  models      show or set models (bin/models)
  roles       show or set roles (bin/roles)
  doctor      check the hub's health (bin/doctor)
  sync        sync the hub (bin/sync)
  context     the hub's context store (bin/context)
  agent-run   run an agent (bin/agent)

Orchestrators (one per hub, run by the hub's bin/chat):
  orchestrator  new <name> --hub <path> [--channel telegram] | start | stop | list | logs <name> [-n N] | remove

Hubs:
  ui          ade ui [--detach]: one tmux window, a tab per agent (keys: prefix ? in it)
  dash        ade dash [--once]: the fleet panel (agents, tickets, last events)
  setup       ade setup [--check | --test [provider|telegram] | --top | --telegram]: sign in, providers, Telegram, hub, guided session
  claude      ade claude [<folder>] [-- claude args]: the orchestrator at the hub root; with a folder, ade work <folder>
  hub         ade hub new <name> [--private|--public] [--dir <folder>] [--no-github] [--persona P --client C --owner O]
              | ade hub list | ade hub use <path>
  (none)      ade alone: the hub, its sessions and what to do next

Project commands (no hub needed):
  init        copy ade-method at its pinned tag into this project (git top level, or --here); never overwrites
  agent       ade agent list | ade agent add <name>: specialists from ade-agent-registry
  skills      ade skills list | add <plugin> | enable <skill> | disable <skill> | search <word>: skills and plugins on the fly
  open        open in the ADE app (inside the ADE app only)
  version     print the version
  help        this list

The hub is $ADE_HUB, else the nearest folder above with bin/lib.sh and hub.conf, else the path in ~/.config/ade/hub.
HELP
}

# matches <text> <ERE>: the whole text (newlines included) matches; never a per-line grep
matches() { [[ $1 =~ $2 ]]; }

is_hub() { [ -f "$1/bin/lib.sh" ] && [ -f "$1/hub.conf" ]; }

find_hub() {
  if [ -n "${ADE_HUB:-}" ]; then is_hub "$ADE_HUB" || die 2 "ADE_HUB=$ADE_HUB is not a hub (no bin/lib.sh and hub.conf)"
    echo "$ADE_HUB"; return; fi
  local d="$PWD"
  while [ -n "$d" ]; do is_hub "$d" && { echo "$d"; return; }; [ "$d" = / ] && break; d="$(dirname "$d")"; done
  local cfg="$HOME/.config/ade/hub" h=""
  if [ -f "$cfg" ]; then
    IFS= read -r h < "$cfg"; h="$(printf '%s' "$h" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    # shellcheck disable=SC2088  # a literal ~ in the file is expanded here on purpose
    case "$h" in "~") h="$HOME" ;; "~/"*) h="$HOME/${h#\~/}" ;; esac
    if [ -n "$h" ]; then is_hub "$h" && { echo "$h"; return; }
      # shellcheck disable=SC2088  # the message names the file as the user writes it
      die 2 "~/.config/ade/hub points to $h, which is not a hub"; fi
  fi
  die 2 "no hub found: set ADE_HUB, run ade inside a hub, or put the hub's path in ~/.config/ade/hub (no hub yet: ade hub new <name>)"
}

run_hub() {   # $1 = script name under bin/
  local script="$1" hub; shift; hub="$(find_hub)" || exit $?
  [ "$script" = work ] && claude_update "$hub"
  [ -e "$hub/bin/$script" ] || die 2 "this hub has no bin/$script; update it"
  [ -x "$hub/bin/$script" ] || die 2 "bin/$script is not executable"
  HUB="$hub"; export HUB   # a stale HUB in the caller's environment would win in the hub's lib.sh
  exec "$hub/bin/$script" "$@"
}

# mk_tmp: a fresh temp folder under the temp root, or failure (never an empty or current path);
# rm_tmp <path>: removes only a folder mk_tmp made (under the temp root, named ade.*)
TMP_ROOT="${TMPDIR:-/tmp}"; TMP_ROOT="${TMP_ROOT%/}"
mk_tmp() { local d; d="$(mktemp -d "$TMP_ROOT/ade.XXXXXX" 2> /dev/null)" && [ -n "$d" ] && [ -d "$d" ] || return 1; printf '%s' "$d"; }
rm_tmp() { case "${1:-}" in "$TMP_ROOT"/ade.?*) [ -d "$1" ] && rm -rf -- "$1" ;; esac; return 0; }

# fetch <repo> <ref>: a temp checkout of repo at ref; prints its path
fetch() {
  local tmp err; tmp="$(mk_tmp)" || die 1 "could not make a temp folder"
  if [ -d "$1" ]; then err="$(git clone -q --branch "$2" "$1" "$tmp/src" 2>&1)"
  else err="$(git -c advice.detachedHead=false clone -q --depth 1 --branch "$2" "$1" "$tmp/src" 2>&1)"; fi \
    || { rm_tmp "$tmp"; die 1 "could not fetch $1 at $2: $(printf '%s\n' "$err" | tail -1)"; }
  echo "$tmp/src"
}

# put <src> <dest>: copy unless dest exists; counts KEPT, exits 1 on a failed copy
KEPT=0
put() {
  if [ -e "$2" ]; then echo "kept $2 (already there)"; KEPT=$((KEPT + 1))
  else { mkdir -p "$(dirname "$2")" && cp "$1" "$2"; } 2>/dev/null || die 1 "could not copy $2"; echo "copied $2"; fi
}

# project_root [args]: cd to the git top level, or stay here with --here; outside git without --here, exit 2
project_root() {
  local a top; for a in "$@"; do [ "$a" = --here ] && return 0; done
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || die 2 "not inside a git repository: run ade in a project, or pass --here"
  cd "$top" || die 1 "cannot enter $top"
}

cmd_init() {
  project_root "$@"
  local src f list old=""; src="$(fetch "$ADE_METHOD_REPO" "$ADE_METHOD_REF")" || exit $?
  trap 'rm_tmp "$(dirname "$src")"' EXIT
  list="$(dirname "$src")/list"; : > "$list"   # src<TAB>dest, read without a subshell so put's counts and exits hold
  [ -f "$src/rules.md" ] && printf '%s\t%s\n' "$src/rules.md" .ade/rules.md >> "$list"
  for f in "$src"/agents/*.md; do [ -f "$f" ] && printf '%s\t%s\n' "$f" ".ade/agents/$(basename "$f")" >> "$list"; done
  for f in "$src"/bmad/custom/*.toml; do [ -f "$f" ] && printf '%s\t%s\n' "$f" "_bmad/custom/$(basename "$f")" >> "$list"; done
  if [ -d "$src/templates/context" ]; then
    (cd "$src/templates/context" && find . -type f | sort) | while IFS= read -r f; do
      printf '%s\t%s\n' "$src/templates/context/${f#./}" ".ade/context/${f#./}"; done >> "$list"
  fi
  [ -f "$src/templates/standards.md" ] && printf '%s\t%s\n' "$src/templates/standards.md" docs/standards.md >> "$list"
  while IFS="$(printf '\t')" read -r f dest; do put "$f" "$dest"; done < "$list"
  [ -f .ade/method-version ] && old="$(cat .ade/method-version)"
  if [ "$KEPT" -gt 0 ] && [ -n "$old" ] && [ "$old" != "$ADE_METHOD_REF" ]; then
    echo "kept files are from $old: .ade/method-version left at $old"
  else
    { mkdir -p .ade && echo "$ADE_METHOD_REF" > .ade/method-version; } || die 1 "could not write .ade/method-version"
    echo "ade-method $ADE_METHOD_REF recorded in .ade/method-version"
  fi
}

# registry rows as name<TAB>file<TAB>description
registry_rows() {
  python3 -c 'import json,sys
for r in json.load(open(sys.argv[1])).get("roles", []):
    print("%s\t%s\t%s" % (r.get("name",""), r.get("file",""), r.get("description","")))' "$1/registry.json" \
    || die 1 "could not read registry.json"
}

cmd_agent() {
  local sub="${1:-}" src rows name file desc
  case "$sub" in
    list|add) ;;
    *) die 2 "usage: ade agent list | ade agent add <name>" ;;
  esac
  [ "$sub" = add ] && { [ -z "${2:-}" ] || [ "$2" = --here ]; } && die 2 "usage: ade agent add <name> [--here]"
  [ "$sub" = add ] && project_root "$@"
  src="$(fetch "$ADE_REGISTRY_REPO" "$ADE_REGISTRY_REF")" || exit $?
  rows="$(registry_rows "$src")" || exit $?
  if [ "$sub" = list ]; then
    echo "$rows" | while IFS="$(printf '\t')" read -r name file desc; do printf '%-20s %s\n' "$name" "$desc"; done
  else
    file="$(echo "$rows" | awk -F '\t' -v n="$2" '$1 == n { print $2; exit }')"
    if [ -z "$file" ] || [ ! -f "$src/$file" ]; then rm_tmp "$(dirname "$src")"; die 2 "no specialist named $2; ade agent list shows them"; fi
    put "$src/$file" ".ade/agents/$2.md"
  fi
  rm_tmp "$(dirname "$src")"
}

# skills on the fly (story A7): BMAD skills via .claude/settings.json skillOverrides (absent = on, "name-only",
# "off"), ade-skills plugins via the marketplace file and the project's enabledPlugins
ADE_SKILLS_REPO="${ADE_SKILLS_REPO:-https://github.com/better-ade/ade-skills}"
ADE_SKILLS_REF="${ADE_SKILLS_REF:-v0.1.0}"   # pinned like the other repos; ADE_SKILLS_REF overrides
SKILLS_USAGE="usage: ade skills list | add <plugin> | enable <skill> | disable <skill> | search <word>"

# skills_py <op> <project> [args]: the one place that reads and writes the settings (atomic; other keys kept)
skills_py() {
  PYTHONIOENCODING=utf-8 python3 - "$@" <<'PY'
import difflib, json, os, sys
op, proj = sys.argv[1], sys.argv[2]; args = sys.argv[3:]
sp = os.path.join(proj, ".claude", "settings.json")
def settings():
    if not os.path.exists(sp): return {}
    try: d = json.load(open(sp))
    except ValueError: sys.exit("ade: %s is not valid JSON; fix it first" % sp)
    if not isinstance(d, dict): sys.exit("ade: %s is not a JSON object" % sp)
    return d
def skills(d):
    root = os.path.join(proj, ".claude", "skills"); names = set(d.get("skillOverrides", {}) or {})
    if os.path.isdir(root):
        names |= {n for n in os.listdir(root) if os.path.isfile(os.path.join(root, n, "SKILL.md"))}
    return sorted(names)
def plugins(mkt):
    return [(p.get("name", ""), p.get("description", "")) for p in json.load(open(mkt)).get("plugins", []) if p.get("name")]
def closest(word, names):
    c = difflib.get_close_matches(word, names, n=3, cutoff=0.5)
    return " (closest: %s)" % ", ".join(c) if c else ""
def write(d):
    os.makedirs(os.path.dirname(sp), exist_ok=True)
    with open(sp + ".ade-tmp", "w") as f: json.dump(d, f, indent=2); f.write("\n")
    os.replace(sp + ".ade-tmp", sp)
if op == "list":
    d = settings(); ov = d.get("skillOverrides", {}) or {}; en = d.get("enabledPlugins", {}) or {}
    print("BMAD skills (.claude/settings.json skillOverrides):")
    for s in skills(d): print("  %-32s %s" % (s, ov.get(s, "on")))
    if not skills(d): print("  (none in .claude/skills)")
    print("ade-skills plugins:")
    for n, desc in plugins(args[0]):
        print("  %-32s %-14s %s" % (n, "installed" if en.get(n + "@ade-skills") else "not installed", desc))
elif op in ("enable", "disable"):
    name, never = args[0], args[1].split()
    d = settings(); known = skills(d)
    if name not in known: sys.stderr.write("ade: no skill named %s in this project%s\n" % (name, closest(name, known))); sys.exit(2)
    if op == "enable" and name in never:
        sys.stderr.write("ade: %s is on ade-method's never list (bmad.never in ade.json): it stays off\n" % name); sys.exit(2)
    ov = d.get("skillOverrides")
    if op == "enable":
        if isinstance(ov, dict) and name in ov: del ov[name]; write(d)
        print("%s: on" % name)
    else:
        if not isinstance(ov, dict): ov = d["skillOverrides"] = {}
        if ov.get(name) == "off": print("%s: off (already; disable never raises it)" % name)
        else:
            if ov.get(name) != "name-only": ov[name] = "name-only"; write(d)
            print("%s: name-only" % name)
elif op == "plugin":
    names = [n for n, _ in plugins(args[0])]
    if args[1] not in names: sys.stderr.write("ade: no ade-skills plugin named %s%s\n" % (args[1], closest(args[1], names))); sys.exit(2)
elif op == "search":
    w = args[1].lower(); hits = [(n, desc) for n, desc in plugins(args[0]) if w in n.lower() or w in desc.lower()]
    for n, desc in hits: print("%-20s %s" % (n, desc))
    sys.exit(0 if hits else 1)
elif op == "never":
    try: print(" ".join(json.load(open(args[0])).get("bmad", {}).get("never", [])))
    except (OSError, ValueError): sys.exit("ade: could not read ade-method's ade.json")
PY
}

# skills_folder <project>: the hub folder (projects/x or ops/x) that holds this project, else nothing
skills_folder() {
  local hub top="$1" d f c; hub="$(find_hub 2> /dev/null)" || return 0
  case "$top/" in "$hub"/projects/*/*|"$hub"/ops/*/*) f="${top#"$hub"/}"; echo "${f%%/*}/$(echo "$f" | cut -d/ -f2)"; return 0 ;; esac
  for d in "$hub"/projects/*/ "$hub"/ops/*/; do
    [ -f "$d/ACCESS.md" ] || continue
    for c in $(awk -F'|' '/^\|/ { c = $3; gsub(/^[ \t]+|[ \t]+$/, "", c); if (c ~ /^[\/~]/) print c }' "$d/ACCESS.md"); do
      # shellcheck disable=SC2088  # a literal ~ in ACCESS.md is expanded here on purpose
      case "$c" in "~/"*) c="$HOME/${c#\~/}" ;; esac
      [ -d "$c" ] && [ "$(cd "$c" && pwd -P)" = "$top" ] && { f="${d%/}"; echo "${f#"$hub"/}"; return 0; }
    done
  done
}
# skills_hint <project> <text>: through the hub's bin/notify to that folder's sessions (C6), else printed here
skills_hint() {
  local f hub; f="$(skills_folder "$1")"
  echo "$2"
  if [ -n "$f" ] && hub="$(find_hub 2> /dev/null)" && [ -x "$hub/bin/notify" ]; then
    hub_run "$hub" notify "$f" "$2" > /dev/null 2>&1 && echo "told the running sessions of $f (ade notify)"
  fi
  return 0
}

cmd_skills() {
  local sub="${1:-}" top src mkt; [ $# -gt 0 ] && shift
  top="$(git rev-parse --show-toplevel 2> /dev/null)" || top="$(pwd -P)"
  case "$sub" in
    --pin) echo "$ADE_SKILLS_REF"; return 0 ;;
    list|search|add)
      case "$sub" in list) [ $# -eq 0 ] || die 2 "$SKILLS_USAGE" ;; *) [ $# -eq 1 ] && [ -n "$1" ] || die 2 "$SKILLS_USAGE" ;; esac
      if src="$(fetch "$ADE_SKILLS_REPO" "$ADE_SKILLS_REF" 2> /dev/null)"; then
        mkt="$src/.claude-plugin/marketplace.json"; SKILLS_TMP="$(dirname "$src")"; trap 'rm_tmp "$SKILLS_TMP"' EXIT
        [ -f "$mkt" ] || die 1 "ade-skills has no .claude-plugin/marketplace.json at $ADE_SKILLS_REF"
      else   # offline: the marketplace Claude Code installed, when there is one
        mkt="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/marketplaces/ade-skills/.claude-plugin/marketplace.json"
        [ -f "$mkt" ] || die 1 "could not fetch $ADE_SKILLS_REPO at $ADE_SKILLS_REF, and no installed ade-skills marketplace"
        echo "ade: ade-skills unreachable; using the installed marketplace ($mkt)" >&2
      fi
      case "$sub" in
        list) skills_py list "$top" "$mkt"; exit $? ;;
        search) skills_py search "$top" "$mkt" "$1"; exit $? ;;
      esac
      skills_py plugin "$top" "$mkt" "$1" || exit $?
      command -v claude > /dev/null 2>&1 || die 2 "claude is not on PATH; install Claude Code first"
      if ! claude plugin marketplace list 2>/dev/null | grep -q 'ade-skills'; then
        local msrc="$ADE_SKILLS_REPO"; [ "$msrc" = https://github.com/better-ade/ade-skills ] && msrc=better-ade/ade-skills
        claude plugin marketplace add "$msrc" || die 1 "could not add the ade-skills marketplace"
      fi
      claude plugin install "$1@ade-skills" --scope project || exit $?
      skills_hint "$top" "plugin $1 installed in $(basename "$top"): run /reload-plugins in its open sessions to load it" ;;
    enable|disable)
      [ $# -eq 1 ] && [ -n "$1" ] || die 2 "$SKILLS_USAGE"
      local never=""
      if [ "$sub" = enable ]; then
        src="$(fetch "$ADE_METHOD_REPO" "$ADE_METHOD_REF")" || exit $?
        never="$(skills_py never "$top" "$src/ade.json")"; local rc=$?; rm_tmp "$(dirname "$src")"; [ "$rc" = 0 ] || exit 1
      fi
      skills_py "$sub" "$top" "$1" "$never" || exit $?
      skills_hint "$top" "skill $1 changed in $(basename "$top"): it applies on the next prompt (Claude Code reloads its settings)" ;;
    *) die 2 "$SKILLS_USAGE" ;;
  esac
}

cmd_open() {
  [ -n "${ADE_HOOK_BIN:-}" ] || die 2 "ade open works inside the ADE app"
  exec "$ADE_HOOK_BIN" open "$@"
}

# claude_update [hub]: before ade launches Claude Code, `claude update` at most once per 24 h per machine (stamp
# ~/.config/ade/claude-updated, written per attempt), cut off after ADE_CLAUDE_UPDATE_TIMEOUT s (default 60); offline or
# failing prints one line and the installed version runs. ADE_NO_CLAUDE_UPDATE=1 skips it.
claude_update() {
  [ "${ADE_NO_CLAUDE_UPDATE:-}" = 1 ] && return 0
  local cl="" now t=0 stamp="$HOME/.config/ade/claude-updated" lim="${ADE_CLAUDE_UPDATE_TIMEOUT:-60}" pid w rc
  [ -n "${1:-}" ] && cl="$(conf_get "$1" HUB_CLAUDE)"; cl="${cl:-claude}"
  command -v "$cl" > /dev/null 2>&1 || return 0
  now="$(date +%s)"; [ -f "$stamp" ] && t="$(cat "$stamp" 2> /dev/null)"; [[ $t =~ ^[0-9]+$ ]] || t=0
  [ $((now - t)) -lt 86400 ] && return 0
  [[ $lim =~ ^[0-9]+$ ]] || lim=60
  echo "$now" | write_conf_file claude-updated
  "$cl" update > /dev/null 2>&1 < /dev/null & pid=$!
  ( sleep "$lim"; kill "$pid" 2> /dev/null ) > /dev/null 2>&1 & w=$!
  wait "$pid" 2> /dev/null; rc=$?; kill "$w" 2> /dev/null; wait "$w" 2> /dev/null
  if [ "$rc" = 0 ]; then echo "ade: Claude Code is up to date" >&2
  else echo "ade: Claude Code update skipped (offline, failed or over ${lim}s); using the installed version" >&2; fi
  return 0
}

# conf_get <hub> <KEY>: a hub.conf value (sourced in a subshell, as the hub's own scripts read it)
conf_get() {
  case "$2" in *[!A-Z0-9_]*|"") return 1 ;; esac
  ( . "$1/hub.conf" > /dev/null 2>&1; eval "printf '%s' \"\${$2:-}\"" )
}

# ~/.config/ade: the folder 0700, every file in it 0600; write_conf_file <name> < content replaces one atomically
CONF_DIR="$HOME/.config/ade"
write_conf_file() {
  local tmp; ( umask 077; mkdir -p "$CONF_DIR" ) && chmod 700 "$CONF_DIR" || die 1 "cannot create $CONF_DIR"
  tmp="$(umask 077; mktemp "$CONF_DIR/.$1.XXXXXX")" || die 1 "cannot write $CONF_DIR/$1"
  { cat > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$CONF_DIR/$1"; } || { rm -f "$tmp"; die 1 "cannot write $CONF_DIR/$1"; }
}

# orchestrators: ~/.config/ade/orchestrators, one "name<TAB>hub" line each (story A2, .ade/context/hub-interface.md)
ORCH="$CONF_DIR/orchestrators"
orch_hub() { [ -f "$ORCH" ] && awk -F '\t' -v n="$1" '$1 == n { print $2; exit }' "$ORCH"; }
# chat <hub> <args>: the hub's own bin/chat, with HUB exported to that hub; its exit code is returned unchanged
chat() {
  local hub="$1"; shift
  [ -e "$hub/bin/chat" ] || die 2 "this hub has no bin/chat; update it"
  [ -x "$hub/bin/chat" ] || die 2 "bin/chat is not executable"
  ( HUB="$hub"; export HUB; "$hub/bin/chat" "$@" )
}
# orch_state <hub>: "running <since>", "stopped -", "missing -" or "unknown -", from the hub's bin/chat status
orch_state() {
  local first st since
  is_hub "$1" && [ -x "$1/bin/chat" ] || { echo "missing -"; return; }
  first="$(chat "$1" status 2>/dev/null | head -1)"
  st="${first%% *}"; since="$(printf '%s\n' "$first" | sed -n 's/.* since \([^ ]*\).*/\1/p')"
  case "$st" in running|stopped) echo "$st ${since:--}" ;; *) echo "unknown -" ;; esac
}

ORCH_USAGE="usage: ade orchestrator new <name> --hub <path> [--channel telegram] | start|stop|remove <name> | list | logs <name> [-n N]"
cmd_orchestrator() {
  local sub="${1:-}" name hub ch n st since chans channels=""; [ $# -gt 0 ] && shift
  case "$sub" in
    new)
      name="${1:-}"; [ $# -gt 0 ] && shift; hub=""
      while [ $# -gt 0 ]; do case "$1" in
        --hub) [ $# -ge 2 ] || die 2 "--hub needs a path"; hub="$2"; shift 2 ;;
        --channel) [ $# -ge 2 ] || die 2 "--channel needs a name"
          [[ $2 =~ ^[a-z][a-z0-9-]{0,31}$ ]] || die 2 "channel names are lower-case letters, digits and - (e.g. telegram)"
          channels="$channels $2"; shift 2 ;;
        *) die 2 "$ORCH_USAGE" ;;
      esac; done
      [[ $name =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die 2 "orchestrator names are lower-case letters, digits and - (a letter or digit first, at most 64)"
      [ -n "$hub" ] || die 2 "$ORCH_USAGE"
      is_hub "$hub" || die 2 "$hub is not a hub (no bin/lib.sh and hub.conf)"
      hub="$(cd "$hub" && pwd -P)"
      [ -z "$(orch_hub "$name")" ] || die 2 "an orchestrator named $name already exists"
      n="$([ -f "$ORCH" ] && awk -F '\t' -v h="$hub" '$2 == h { print $1; exit }' "$ORCH")"
      [ -z "$n" ] || die 2 "$hub already has an orchestrator ($n); one per hub"
      for ch in $channels; do ADE_ORCHESTRATOR="$name" chat "$hub" setup "$ch" || exit $?; done
      { [ -f "$ORCH" ] && cat "$ORCH"; printf '%s\t%s\n' "$name" "$hub"; } | write_conf_file orchestrators
      echo "orchestrator $name registered for $hub"
      [ -n "$channels" ] || echo "no channel yet: run bin/chat setup telegram in the hub to add one" ;;
    start|stop)
      [ -n "${1:-}" ] && [ $# -eq 1 ] || die 2 "$ORCH_USAGE"
      hub="$(orch_hub "$1")"; [ -n "$hub" ] || die 2 "no orchestrator named $1; ade orchestrator list shows them"
      is_hub "$hub" || die 2 "the hub of $1 ($hub) is gone"
      [ "$sub" = start ] && claude_update "$hub"
      chat "$hub" "$sub"; exit $? ;;
    list)
      [ $# -eq 0 ] || die 2 "$ORCH_USAGE"
      printf '%-16s %-8s %-12s %-20s %s\n' NAME STATUS CHANNELS SINCE HUB
      [ -f "$ORCH" ] || return 0
      while IFS="$(printf '\t')" read -r name hub; do
        [ -n "$name" ] || continue
        read -r st since <<EOF
$(orch_state "$hub" < /dev/null)
EOF
        chans="-"; [ "$st" = missing ] || chans="$(conf_get "$hub" HUB_CHANNELS < /dev/null | tr ' ' ',')"
        printf '%-16s %-8s %-12s %-20s %s\n' "$name" "$st" "${chans:--}" "$since" "$hub"
      done < "$ORCH" ;;
    logs)
      name="${1:-}"; [ $# -gt 0 ] && shift; n=50
      [ -n "$name" ] || die 2 "$ORCH_USAGE"
      if [ $# -gt 0 ]; then { [ "$1" = -n ] && [ $# -eq 2 ]; } || die 2 "$ORCH_USAGE"; n="$2"; fi
      matches "$n" '^[1-9][0-9]{0,5}$' || die 2 "-n needs a number of lines"
      hub="$(orch_hub "$name")"; [ -n "$hub" ] || die 2 "no orchestrator named $name; ade orchestrator list shows them"
      is_hub "$hub" || die 2 "the hub of $name ($hub) is gone"
      chat "$hub" logs -n "$n"; exit $? ;;
    remove)
      [ -n "${1:-}" ] && [ $# -eq 1 ] || die 2 "$ORCH_USAGE"
      hub="$(orch_hub "$1")"; [ -n "$hub" ] || die 2 "no orchestrator named $1; ade orchestrator list shows them"
      read -r st since <<EOF
$(orch_state "$hub")
EOF
      if [ "$st" = running ]; then chat "$hub" stop || die 1 "could not stop $1; it stays registered"; fi
      awk -F '\t' -v n="$1" '$1 != n' "$ORCH" | write_conf_file orchestrators
      echo "orchestrator $1 removed (its hub $hub is untouched)" ;;
    *) die 2 "$ORCH_USAGE" ;;
  esac
}

# hubs: ~/.config/ade/hub is the default; ~/.config/ade/hubs lists every hub ade made or was pointed at (story A3)
ADE_HUB_TEMPLATE="${ADE_HUB_TEMPLATE:-better-ade/ade-brain}"
ADE_HUB_TEMPLATE_URL="${ADE_HUB_TEMPLATE_URL:-https://github.com/$ADE_HUB_TEMPLATE}"
hub_label() { local n; n="$(conf_get "$1" HUB_NAME)"; echo "${n:-$(basename "$1")}"; }
default_hub() { local h=""; [ -f "$CONF_DIR/hub" ] && IFS= read -r h < "$CONF_DIR/hub"; printf '%s' "$h"; }
remember_hub() {   # <path>: make it the default and add it to the known list once
  local p="$1"
  { [ -f "$CONF_DIR/hubs" ] && grep -vxF -- "$p" "$CONF_DIR/hubs"; echo "$p"; } | write_conf_file hubs
  echo "$p" | write_conf_file hub
}

cmd_hub() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift
  case "$sub" in
    new) hub_new "$@" ;;
    list)
      [ $# -eq 0 ] || die 2 "usage: ade hub list"
      local d p; d="$(default_hub)"
      { [ -f "$CONF_DIR/hubs" ] && cat "$CONF_DIR/hubs"; [ -n "$d" ] && echo "$d"; } | awk 'NF && !seen[$0]++' |
        while IFS= read -r p; do
          if [ "$p" = "$d" ]; then printf '* '; else printf '  '; fi
          if is_hub "$p"; then echo "$p"; else echo "$p (missing)"; fi
        done ;;
    use)
      [ $# -eq 1 ] || die 2 "usage: ade hub use <path>"
      is_hub "$1" || die 2 "$1 is not a hub (no bin/lib.sh and hub.conf)"
      local p; p="$(cd "$1" && pwd -P)"; remember_hub "$p"; echo "default hub: $p" ;;
    *) die 2 "usage: ade hub new <name> [--private|--public] [--dir <folder>] [--no-github] | ade hub list | ade hub use <path>" ;;
  esac
}

hub_ask() { printf '%s ' "$1"; IFS= read -r HUB_ANSWER || { echo; die 1 "stopped: no answer"; }; [ -t 0 ] || echo
  [ -n "$HUB_ANSWER" ] || die 2 "an answer is needed"; }

hub_new() {
  local name="${1:-}" vis=--private dir="$HOME/hubs" gh=1 target persona="" client="" owner=""; [ $# -gt 0 ] && shift
  while [ $# -gt 0 ]; do case "$1" in
    --private|--public) vis="$1"; shift ;;
    --persona|--client|--owner) [ $# -ge 2 ] && [ -n "$2" ] || die 2 "$1 needs a value"
      case "$1" in --persona) persona="$2" ;; --client) client="$2" ;; *) owner="$2" ;; esac; shift 2 ;;
    --dir) [ $# -ge 2 ] || die 2 "--dir needs a folder"; dir="$2"; shift 2 ;;
    --no-github) gh=0; shift ;;
    *) die 2 "usage: ade hub new <name> [--private|--public] [--dir <folder>] [--no-github] [--persona P --client C --owner O]" ;;
  esac; done
  matches "$name" '^[a-z0-9][a-z0-9-]{0,63}$' || die 2 "hub names are lower-case letters, digits and - (start with a letter or digit, at most 64; e.g. acme-sre)"
  case "$dir" in /*) ;; *) dir="$PWD/$dir" ;; esac
  target="$dir/$name"
  [ ! -e "$target" ] || die 2 "$target already exists; pick another name or --dir"
  if [ "$gh" = 1 ]; then
    command -v gh > /dev/null 2>&1 || die 2 "gh (GitHub CLI) is not installed: install it, or pass --no-github for a local hub"
    mkdir -p "$dir" || die 1 "cannot create $dir"
    (cd "$dir" && gh repo create "$name" --template "$ADE_HUB_TEMPLATE" "$vis" --clone) || die 1 "gh could not create $name"
  else
    mkdir -p "$dir" || die 1 "cannot create $dir"
    git clone -q "$ADE_HUB_TEMPLATE_URL" "$target" || die 1 "could not clone $ADE_HUB_TEMPLATE_URL"
    git -C "$target" remote remove origin 2> /dev/null
  fi
  [ -x "$target/bin/init" ] || die 1 "$target has no bin/init; is $ADE_HUB_TEMPLATE the hub template?"
  echo "hub $name created in $target"
  # bin/init needs a persona, the client and the owner: the flags, else asked here
  if [ -z "$persona" ]; then echo "Personas:"; (cd "$target" && ./bin/init --list) 2> /dev/null | sed 's/^/  /'
    hub_ask "Persona for this hub (one of the names above):"; persona="$HUB_ANSWER"; fi
  [ -n "$client" ] || { hub_ask "Client or team this hub works for:"; client="$HUB_ANSWER"; }
  [ -n "$owner" ] || { hub_ask "Owner (your name, as it should appear in the hub):"; owner="$HUB_ANSWER"; }
  (cd "$target" && HUB="$target" && export HUB && ./bin/init --persona "$persona" --client "$client" --owner "$owner" --name "$name") ||
    die 1 "bin/init did not finish: run it again with cd $target && bin/init --persona <p> --client <c> --owner <o> --name $name"
  is_hub "$target" || die 1 "bin/init wrote no hub.conf: run it again with cd $target && bin/init"
  target="$(cd "$target" && pwd -P)"; remember_hub "$target"
  echo "default hub: $target"; echo "next: ade (what to do next)"
}

# ade with no arguments: what to do next (story A3)
cmd_home() {
  local hub err
  if ! hub="$(find_hub 2> /dev/null)"; then
    err="$(find_hub 2>&1 > /dev/null)"; printf '%s' "$err" | grep -q "no hub found" || echo "$err" >&2
    echo 'no hub yet: run `ade hub new <name>`'; return 0
  fi
  echo "hub: $(hub_label "$hub") ($hub)"
  [ -x "$hub/bin/sessions" ] && (HUB="$hub"; export HUB; "$hub/bin/sessions")
  echo "next:"
  echo "  ade claude           open the orchestrator (Claude Code at the hub root)"
  echo "  ade work <folder>    start a focus agent on a folder"
  echo "  ade help             every command"
}

# ade claude [<folder>] [-- args]: Claude Code at the hub root as the orchestrator (story A4)
ADE_SKILLS_MARKETPLACE="better-ade/ade-skills"
enable_ade_plugin() {   # <settings.json>: list the ade-skills marketplace and enable ade@ade-skills; other keys kept
  mkdir -p "$(dirname "$1")" || return 1
  python3 - "$1" "$ADE_SKILLS_MARKETPLACE" <<'PY'
import json, os, sys
p, repo = sys.argv[1], sys.argv[2]
d = {}
if os.path.exists(p):
    try:
        d = json.load(open(p))
    except ValueError:
        sys.exit("ade: %s is not valid JSON; fix it, then run ade claude again" % p)
    if not isinstance(d, dict):
        sys.exit("ade: %s is not a JSON object" % p)
before = json.dumps(d, sort_keys=True)
d.setdefault("extraKnownMarketplaces", {}).setdefault("ade-skills", {"source": {"source": "github", "repo": repo}})
d.setdefault("enabledPlugins", {}).setdefault("ade@ade-skills", True)
if json.dumps(d, sort_keys=True) != before:
    tmp = p + ".ade-tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2); f.write("\n")
    os.replace(tmp, p)
PY
}

# skips_permissions <args>: any spelling that turns permission checks off (sets SKIP_ARG); case and = forms included
skips_permissions() {
  local a l; for a in "$@"; do l="$(printf '%s' "$a" | tr 'A-Z' 'a-z')"
    case "$l" in *skip-permissions*|*bypasspermissions*) SKIP_ARG="$a"; return 0 ;; esac; done; return 1
}

cmd_claude() {
  local a hub model name cl cfg
  skips_permissions "$@" && die 2 "ade claude never skips permissions (refused: $SKIP_ARG)"
  if [ $# -gt 0 ] && [ "$1" != -- ]; then run_hub work "$@"; fi
  [ $# -gt 0 ] && shift
  hub="$(find_hub)" || exit $?
  model="$(conf_get "$hub" HUB_ROOT_MODEL)"; name="$(hub_label "$hub")"
  cl="$(conf_get "$hub" HUB_CLAUDE)"; cl="${cl:-claude}"; cfg="$(conf_get "$hub" HUB_CLAUDE_CONFIG_DIR)"
  command -v "$cl" > /dev/null 2>&1 || die 2 "$cl is not on PATH; install Claude Code first (ade setup does it)"
  claude_update "$hub"
  enable_ade_plugin "$hub/.claude/settings.json" || exit 1
  cd "$hub" || die 1 "cannot enter $hub"
  HUB="$hub"; export HUB; [ -z "$cfg" ] || { CLAUDE_CONFIG_DIR="$cfg"; export CLAUDE_CONFIG_DIR; }
  set -- --remote-control "$name" "$@"; [ -z "$model" ] || set -- --model "$model" "$@"   # opus[1m] never globbed
  exec "$cl" "$@"
}

# ade setup: sign in, providers with live tests, Telegram, the hub, then a guided session (story A5).
# Keys and tokens: read with a hidden prompt into a shell variable (never exported) and written only to the hub's
# bin/keys set <tool> on stdin; never argv, a file, a log or a child's environment.
ADE_CLAUDE_INSTALLER="${ADE_CLAUDE_INSTALLER:-https://claude.ai/install.sh}"
CLAUDE_INSTALL_CMD="curl -fsSL https://claude.ai/install.sh | bash"
KEY_PROVIDERS="anthropic deepseek glm muse gemini"   # the ones that can be signed in with a key
LIVE_PROVIDERS="anthropic gemini deepseek glm muse"
LIVE_TASK="Reply with the word READY and nothing else."

ask() {   # ask <prompt>: one answer line into ANSWER; no answer (end of input) stops setup
  printf '%s ' "$1"; IFS= read -r ANSWER || { echo; die 1 "setup stopped: no answer"; }
  [ -t 0 ] || echo
}
ask_secret() {   # ask_secret <prompt>: a hidden answer into SECRET (not echoed, not exported)
  local rc=0
  if [ -t 0 ]; then
    # echo goes off before the prompt shows, so keys typed (or pasted) the moment it appears are never echoed
    stty -echo 2> /dev/null; trap 'stty echo 2> /dev/null' EXIT INT TERM
    printf '%s ' "$1"; IFS= read -rs SECRET || rc=1
    stty echo 2> /dev/null; trap - EXIT INT TERM
  else printf '%s ' "$1"; IFS= read -r SECRET || rc=1; fi
  echo; [ "$rc" = 0 ] || die 1 "setup stopped: no answer"
}
yes_no() { ask "$1 [y/N]"; case "$ANSWER" in y|Y|yes|Yes) return 0 ;; *) return 1 ;; esac; }
hub_run() { local hub="$1" s="$2"; shift 2; [ -x "$hub/bin/$s" ] || die 2 "this hub has no bin/$s; update it"; ( HUB="$hub"; export HUB; "$hub/bin/$s" "$@" ); }

store_key() {   # store_key <hub> <tool>: hidden prompt, then the hub's bin/keys set <tool> on stdin; 1 = skipped
  local hub="$1" tool="$2"
  ask_secret "Paste the $tool key (hidden; empty skips):"
  [ -n "$SECRET" ] || { SECRET=""; return 1; }
  printf '%s\n' "$SECRET" | hub_run "$hub" keys set "$tool" > /dev/null; local rc=$?
  SECRET=""; [ "$rc" = 0 ] || die 1 "bin/keys could not store the $tool key"
  echo "$tool key stored in the hub's key store"
}

# live_test <hub> <provider>: one tiny read-only task in a throwaway folder through the hub's bin/agent --live-test.
# Prints "<p>: ready (Ns)" or "<p>: failed (<reason>)"; returns 0 only when ready.
SCRUB_VARS="ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_CUSTOM_HEADERS CLAUDE_CODE_OAUTH_TOKEN
  CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX DEEPSEEK_API_KEY GEMINI_API_KEY GOOGLE_API_KEY ZAI_API_KEY GLM_API_KEY
  TELEGRAM_BOT_TOKEN"
# redact: hide key-shaped strings and Telegram bot tokens in text ade prints
redact() { sed -E 's#bot[0-9]+:[A-Za-z0-9_-]+#bot<hidden>#g; s#(sk|pk|ak|key)-[A-Za-z0-9_-]{8,}#<hidden key>#g; s#[A-Za-z0-9_-]{32,}#<hidden>#g'; }
live_test() {
  local hub="$1" p="$2" tmp out rc t0 why
  tmp="$(mk_tmp)" || { echo "$p: failed (no temp folder)"; return 1; }
  t0=$(date +%s)
  # run from the throwaway folder only; no provider key or backend switch from this shell reaches the test
  out="$(cd "$tmp" && { unset $SCRUB_VARS; printf '%s\n' "$LIVE_TASK" | AGENT_TIMEOUT=120 hub_run "$hub" agent --live-test "$p" --dir "$tmp"; } 2>&1)"; rc=$?
  rm_tmp "$tmp"
  if [ "$rc" = 0 ] && printf '%s\n' "$out" | tr -d '\r' | grep -qx '[[:space:]]*READY[[:space:]]*'; then
    echo "$p: ready ($(( $(date +%s) - t0 ))s)"; return 0; fi
  why="$(printf '%s\n' "$out" | tr -d '\r' | grep -v '^[[:space:]]*$' | tail -1 | redact | cut -c1-200)"
  [ "$rc" = 0 ] && [ -n "$why" ] && why="no READY line; it said: $why"
  echo "$p: failed (${why:-exit $rc})"; return 1
}

claude_signed_in() { claude auth status > /dev/null 2>&1; }
key_stored() { hub_run "$1" keys 2> /dev/null | grep -Eq "^$2 +stored"; }

# sign_in <hub> <provider> [account|key]: account = Claude Code's own login (ade stores nothing); else a key
SIGNED=""
sign_in() {
  local hub="$1" p="$2" how="${3:-}"
  case " $SIGNED " in *" $p "*) return 0 ;; esac
  if [ "$p" = anthropic ]; then
    if [ -z "$how" ]; then
      if claude_signed_in || key_stored "$hub" anthropic; then SIGNED="$SIGNED $p"; return 0; fi
      ask "Claude Code: sign in with your Claude account (a) or an Anthropic API key (k)? [a/k]"
      case "$ANSWER" in k|K) how=key ;; *) how=account ;; esac
    fi
    if [ "$how" = account ]; then
      claude_signed_in || claude auth login || { echo "anthropic: sign-in did not finish"; return 1; }
      SIGNED="$SIGNED $p"; return 0
    fi
  fi
  if [ "$p" = gemini ] && command -v "${ADE_GEMINI_CLI:-gemini}" > /dev/null 2>&1; then
    ask "Gemini: sign in with your Google account in the Gemini CLI (a) or a Gemini API key (k)? [a/k]"
    case "$ANSWER" in k|K) ;; *) echo "The Gemini CLI opens: pick \"Login with Google\", then leave it (/quit); ade stores nothing."
      "${ADE_GEMINI_CLI:-gemini}" || { echo "gemini: sign-in did not finish"; return 1; }; SIGNED="$SIGNED $p"; return 0 ;; esac
  fi
  store_key "$hub" "$p" || { echo "$p: skipped (no key)"; return 1; }
  SIGNED="$SIGNED $p"
}

unsign() { SIGNED=" $(printf '%s' " $SIGNED " | sed "s/ $1 / /g") "; }   # a failed provider asks for its key again
READY=""
provider_ready() {   # sign in, then the live test once per provider; READY collects the ones that passed
  case " $READY " in *" $2 "*) echo "$2: ready (tested above)"; return 0 ;; esac
  sign_in "$@" || return 1
  live_test "$1" "$2" || { unsign "$2"; return 1; }
  READY="$READY $2"
}

# conf_set <hub> <KEY> <value>: replace or add one hub.conf line (shell-quoted), atomically
conf_set() {
  python3 - "$1/hub.conf" "$2" "$3" <<'PY' || die 1 "could not write hub.conf"
import os, re, shlex, sys
p, k, v = sys.argv[1:4]
lines = open(p).read().splitlines(); line = "%s=%s" % (k, shlex.quote(v)); done = False
for i, l in enumerate(lines):
    if re.match(r"^%s=" % re.escape(k), l):
        lines[i] = line; done = True
if not done:
    lines.append(line)
open(p + ".ade-tmp", "w").write("\n".join(lines) + "\n"); os.replace(p + ".ade-tmp", p)
PY
}

setup_top() {   # the everything agent: exactly one; GLM and Muse only after their live check passes
  local hub="$1" p how
  while :; do
    echo "Your everything agent (the orchestrator, one only; change it later with ade setup --top):"
    echo "  1) Claude Code with your Claude account (Pro, Max, Team, Enterprise)"
    echo "  2) Claude Code with an Anthropic API key"
    echo "  3) DeepSeek"
    echo "  4) GLM (needs the live check)"
    echo "  5) Muse (needs the live check)"
    ask "Pick one [1-5]:"
    how=""; case "$ANSWER" in
      1) p=anthropic; how=account ;; 2) p=anthropic; how=key ;; 3) p=deepseek ;; 4) p=glm ;; 5) p=muse ;;
      *) echo "pick one number from 1 to 5"; continue ;;
    esac
    sign_in "$hub" "$p" $how || continue
    if live_test "$hub" "$p"; then READY="$READY $p"; conf_set "$hub" HUB_ROOT_PROVIDER "$p"
      local old; old="$(conf_get "$hub" HUB_PROVIDERS_ALLOWED)"   # the new top plus the old list
      conf_set "$hub" HUB_PROVIDERS_ALLOWED "$(printf '%s\n' $p $old | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//')"
      echo "everything agent: $p"; return 0; fi
    unsign "$p"
    case "$p" in glm|muse) echo "$p cannot be the everything agent until its live check passes" ;;
      *) echo "$p failed its live test; pick it again once fixed, or another" ;; esac
  done
}

setup_focus() {   # focus agents: several; each signed in and live-tested; only ready ones enter the roles
  local hub="$1" n p allowed="" top
  echo "Your focus agents (pick any; each is signed in and live-tested):"
  echo "  1) Claude Code   2) Gemini (Gemini CLI)   3) DeepSeek   4) GLM (needs the live check)   5) Muse (needs the live check)"
  ask "Numbers separated by spaces (empty for none):"
  for n in $(printf '%s' "$ANSWER" | tr ',' ' '); do
    case "$n" in 1) p=anthropic ;; 2) p=gemini ;; 3) p=deepseek ;; 4) p=glm ;; 5) p=muse ;; *) echo "skipped $n (not 1-5)"; continue ;; esac
    provider_ready "$hub" "$p" || true
  done
  top="$(conf_get "$hub" HUB_ROOT_PROVIDER)"
  for p in $top $READY; do case " $allowed " in *" $p "*) ;; *) allowed="${allowed:+$allowed }$p" ;; esac; done
  conf_set "$hub" HUB_PROVIDERS_ALLOWED "$allowed"
  echo "providers in the roles: $allowed (HUB_PROVIDERS_ALLOWED); bin/roles shows which model each role gets"
}

setup_telegram() {
  local hub="$1"
  yes_no "Do you want to reach your everything agent from Telegram?" || { echo "Telegram skipped (later: ade setup --telegram)"; return 0; }
  echo "1. In Telegram, open @BotFather and send /newbot."
  echo "2. Give the bot a name; BotFather replies with its token."
  echo "3. Paste the token below; it goes only to the hub's key store."
  ask_secret "Bot token (hidden):"
  [ -n "$SECRET" ] || { echo "Telegram skipped (no token)"; return 0; }
  printf '%s\n' "$SECRET" | hub_run "$hub" keys set telegram > /dev/null; local rc=$?; SECRET=""
  [ "$rc" = 0 ] || die 1 "bin/keys could not store the Telegram token"
  hub_run "$hub" chat setup telegram
}

setup_check() {   # one line per step; reads only
  local hub="" n=0 keys="" p ch d
  if command -v claude > /dev/null 2>&1; then echo "claude code: installed ($(command -v claude))"; else echo "claude code: missing"; fi
  hub="$(find_hub 2> /dev/null)" || hub=""
  if command -v claude > /dev/null 2>&1 && claude_signed_in; then echo "sign-in: signed in (account)"
  else
    [ -n "$hub" ] && for p in $KEY_PROVIDERS; do key_stored "$hub" "$p" && keys="${keys:+$keys, }$p"; done
    if [ -n "$keys" ]; then echo "sign-in: signed in (key: $keys)"; else echo "sign-in: not signed in"; fi
  fi
  if [ -z "$hub" ]; then echo "hub: none (ade hub new <name>)"; echo "projects: none"; echo "channel: none"; return 0; fi
  echo "hub: $hub"
  for d in "$hub"/projects/*/; do [ -d "$d" ] && n=$((n + 1)); done; echo "projects: $n"
  ch="$(conf_get "$hub" HUB_CHANNELS)"; echo "channel: ${ch:-none}"
}

setup_test() {   # --test [provider|telegram]: re-run live tests; changes nothing
  local hub what="${1:-}" p rc=0; hub="$(find_hub)" || exit $?
  case "$what" in
    telegram) hub_run "$hub" chat test telegram; return $? ;;
    "") what="$(conf_get "$hub" HUB_PROVIDERS_ALLOWED)"; [ -n "$what" ] || what=anthropic ;;
    *) case " $LIVE_PROVIDERS " in *" $what "*) ;; *) die 2 "unknown provider $what (known: $LIVE_PROVIDERS, telegram)" ;; esac ;;
  esac
  for p in $what; do live_test "$hub" "$p" || rc=1; done
  return $rc
}

SETUP_PROMPT="Run the ADE setup guide for this hub. Ask me in plain words about my projects and my work first. Then propose a plan and carry it out one step at a time, and ask before each change (wait for my yes): 1) ade init in each project; 2) ade agent add for the specialists each project needs; 3) ade skills add for useful ade-skills plugins; 4) set the role models with bin/models; 5) offer the Telegram channel with bin/chat setup telegram. Say what each step changes before you run it."

cmd_setup() {
  local mode="${1:-}" hub name
  case "$mode" in
    --check) [ $# -eq 1 ] || die 2 "usage: ade setup --check"; setup_check; return 0 ;;
    --test) [ $# -le 2 ] && { [ $# -eq 1 ] || [ -n "$2" ]; } || die 2 "usage: ade setup --test [provider|telegram]"; setup_test "${2:-}"; exit $? ;;
    --top|--telegram) [ $# -eq 1 ] || die 2 "usage: ade setup $mode"; hub="$(find_hub)" || exit $?
      if [ "$mode" = --top ]; then setup_top "$hub"; else setup_telegram "$hub"; fi; return ;;
    "") ;;
    *) die 2 "usage: ade setup [--check | --test [provider|telegram] | --top | --telegram]" ;;
  esac
  if ! command -v claude > /dev/null 2>&1; then
    local proto="=https"; [ "${ADE_TEST_ALLOW_FILE_URLS:-}" = 1 ] && proto="=https,file"   # file:// only for tests
    case "$ADE_CLAUDE_INSTALLER" in https://*) ;; file://*) [ "$proto" != "=https" ] || die 1 "the installer must be an https URL (got $ADE_CLAUDE_INSTALLER)" ;;
      *) die 1 "the installer must be an https URL (got $ADE_CLAUDE_INSTALLER)" ;; esac
    yes_no "Claude Code is not installed. Install it now? This runs: curl -fsSL $ADE_CLAUDE_INSTALLER | bash" ||
      die 1 "install Claude Code yourself, then run ade setup again: $CLAUDE_INSTALL_CMD"
    curl --proto "$proto" --proto-redir "$proto" --tlsv1.2 -fsSL "$ADE_CLAUDE_INSTALLER" | bash || die 1 "the Claude Code installer failed; try: $CLAUDE_INSTALL_CMD"
    PATH="$HOME/.local/bin:$PATH"; command -v claude > /dev/null 2>&1 || die 1 "claude is still not on PATH; open a new terminal and run ade setup again"
    claude_update
  fi
  local herr; herr="$(find_hub 2>&1 > /dev/null)"
  if [ -n "$herr" ] && ! printf '%s' "$herr" | grep -q "no hub found"; then echo "$herr" >&2; exit 2; fi
  if ! hub="$(find_hub 2> /dev/null)"; then
    echo "No hub yet: ade makes one now (ade hub new)."
    ask "Name for your hub (lower-case letters, digits and -, e.g. acme-sre):"; name="$ANSWER"
    if yes_no "Create it as a private GitHub repository (needs gh)?"; then (hub_new "$name") || exit $?
    else (hub_new "$name" --no-github) || exit $?; fi
    hub="$(find_hub)" || exit $?
  fi
  setup_top "$hub"
  setup_focus "$hub"
  setup_telegram "$hub"
  echo "Starting the guided session (ade claude); it asks before each change."
  cmd_claude -- --permission-mode default "$SETUP_PROMPT"
}

# ade ui / ade dash: a tmux workspace with a tab per agent, on ade's own tmux server (tmux -L ade), so its key table
# and theme never touch the user's tmux (story A6; hub calls in .ade/context/hub-interface.md)
ADE_TMUX_SOCKET="${ADE_TMUX_SOCKET:-ade}"
ui_tmux() { tmux -L "$ADE_TMUX_SOCKET" "$@"; }
# ui_session <hub>: ade-<name>-<6 hex of the hub path's checksum>, so two hubs with one name never share a session
ui_session() { echo "ade-$(hub_label "$1" | tr -c 'A-Za-z0-9-\n' '-')-$(printf '%s' "$1" | cksum | awk '{ printf "%06x", $1 % 16777216 }')"; }
ade_self() {   # the absolute path of this script, for the commands tmux runs
  local p="$0" l; while [ -L "$p" ]; do l="$(readlink "$p")"; case "$l" in /*) p="$l" ;; *) p="$(dirname "$p")/$l" ;; esac; done
  echo "$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
}
need_tmux() {
  command -v tmux > /dev/null 2>&1 && return 0
  local how="install tmux with your package manager"
  if [ "$(uname)" = Darwin ]; then how="brew install tmux"
  elif command -v apt-get > /dev/null 2>&1; then how="sudo apt-get install tmux"
  elif command -v dnf > /dev/null 2>&1; then how="sudo dnf install tmux"
  elif command -v pacman > /dev/null 2>&1; then how="sudo pacman -S tmux"; fi
  die 2 "ade ui needs tmux: $how"
}
# ui_live <hub>: the session name when ade's tmux server runs that hub's session (quietly nothing otherwise)
ui_live() { command -v tmux > /dev/null 2>&1 || return 1; local s; s="$(ui_session "$1")"; ui_tmux has-session -t "=$s" 2> /dev/null && echo "$s"; }
# ade work while ade ui runs: bin/work opens the agent as a tab (AGENT_TERMINAL=tmux); an explicit AGENT_TERMINAL wins
work_in_ui() {
  local hub s; [ -z "${AGENT_TERMINAL:-}" ] || return 0
  hub="$(find_hub 2> /dev/null)" || return 0; s="$(ui_live "$hub")" || return 0
  AGENT_TERMINAL=tmux; ADE_UI_SESSION="$s"; export AGENT_TERMINAL ADE_UI_SESSION
}
sq() {   # a path quoted for a tmux command; anything tmux or the shell could expand is refused
  case "$1" in *"'"*|*'"'*|*'$'*|*'\'*|*'#'*|*'`'*) die 2 "ade ui does not support this path (quotes, \$, \\, # or backticks): $1" ;; esac
  printf "'%s'" "$1"
}

# theme: ~/.config/ade/theme (key=colour lines); a colour must be a tmux colour word or #rrggbb, else the default stays
THEME_KEYS="bg fg accent orchestrator busy idle blocked unread"
theme_get() {
  local v="" d; case "$1" in bg) d="#1e1e2e" ;; fg) d="#cdd6f4" ;; accent) d="#89b4fa" ;; orchestrator) d="#cba6f7" ;;
    busy) d="#f9e2af" ;; idle) d="#a6e3a1" ;; blocked) d="#f38ba8" ;; unread) d="#fab387" ;; *) return 1 ;; esac
  [ -f "$CONF_DIR/theme" ] && v="$(sed -n "s/^$1=//p" "$CONF_DIR/theme" | tail -1)"
  matches "$v" '^(#[0-9a-fA-F]{6}|[a-z]+[0-9]*)$' || v="$d"; printf '%s' "$v"
}
theme_env() { local k; for k in $THEME_KEYS; do printf 'ADE_THEME_%s=%s\n' "$k" "$(theme_get "$k")"; done; }

# ui_data <hub> <dir> [session]: what the bar and the dash render, as files in <dir>
ui_data() {
  local hub="$1" d="$2" s="${3:-}" n
  hub_run "$hub" sessions > "$d/sessions" 2> /dev/null || : > "$d/sessions"
  : > "$d/unread"
  if [ -x "$hub/bin/inbox" ]; then
    for n in main $(awk 'NR > 1 { print $1 }' "$d/sessions"); do printf '%s\t%s\n' "$n" "$(hub_run "$hub" inbox --count "$n" 2> /dev/null | head -1)" >> "$d/unread"; done
  fi
  if [ -x "$hub/bin/dispatch" ] && hub_run "$hub" dispatch --list > "$d/tickets" 2> /dev/null; then :; else echo "unavailable" > "$d/tickets"; fi
  if [ -n "$s" ]; then ui_tmux list-windows -t "=$s" -F "#{window_index}	#{window_name}	#{window_active}" > "$d/windows" 2> /dev/null || : > "$d/windows"; fi
  theme_env > "$d/theme"
  printf '%s\n' "${AGENT_STATE:-$HOME/.agent-hub/$(hub_label "$hub")}/events.jsonl" > "$d/events_path"
  hub_label "$hub" > "$d/name"
}

# ui_bar <hub> <session>: the tab bar, from data cached for 2 s in ~/.config/ade/ui-cache/<session> (every attached
# client redraws every 2 s; the hub's scripts run once per period, not once per client)
ui_bar() {
  local c="$CONF_DIR/ui-cache/$2" now t=0; now="$(date +%s)"
  [ -f "$c/at" ] && t="$(cat "$c/at" 2> /dev/null)"; [[ $t =~ ^[0-9]+$ ]] || t=0
  local keep="${ADE_UI_CACHE_SECONDS:-2}"; [[ $keep =~ ^[0-9]+$ ]] || keep=2
  if [ $((now - t)) -ge "$keep" ] || [ ! -f "$c/sessions" ]; then
    ( umask 077; mkdir -p "$c" ) || return 1; ui_data "$1" "$c" "$2"; echo "$now" > "$c/at"
  else ui_tmux list-windows -t "=$2" -F "#{window_index}	#{window_name}	#{window_active}" > "$c/windows" 2> /dev/null; fi
  ui_render bar "$c"
}

ui_render() {   # ui_render bar|dash <dir>
  PYTHONIOENCODING=utf-8 python3 - "$1" "$2" "${ADE_NOW:-}" <<'PY'
import datetime, json, os, sys
mode, d, now = sys.argv[1], sys.argv[2], sys.argv[3]
def read(n):
    try: return open(os.path.join(d, n), encoding="utf-8").read().splitlines()
    except OSError: return []
theme = {l.split("=", 1)[0][len("ADE_THEME_"):]: l.split("=", 1)[1] for l in read("theme") if "=" in l}
rows = []
head = (read("sessions") or [""])[0].split()
tok_i = head.index("TOKENS") if "TOKENS" in head else None   # usage, when the hub's bin/sessions reports it
for l in read("sessions")[1:]:
    f = l.split()
    if len(f) >= 7:
        name, folder, started, role, status = f[0], f[1], f[4], f[5], f[6]
        ticket = "" if name == folder.rsplit("/", 1)[-1] else name
        tok = f[tok_i] if tok_i is not None and len(f) > tok_i and f[tok_i] != "-" else ""
        rows.append(dict(name=name, folder=folder, started=started, role="" if role == "-" else role, status=status, ticket=ticket, tokens=tok))
show_tok = any(r["tokens"] for r in rows)
unread = {}
for l in read("unread"):
    k, _, v = l.partition("\t")
    unread[k] = int(v) if v.strip().isdigit() else 0
ICON = {"busy": "⟳", "idle": "○", "blocked": "⚠"}
def state(s): return s if s in ICON else "idle"
def ts(s):
    try: return datetime.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ")
    except ValueError: return None
t_now = ts(now) if now else datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)
def age(s):
    t = ts(s)
    if not t or not t_now: return "-"
    m = max(0, int((t_now - t).total_seconds() // 60))
    return "%dm" % m if m < 60 else "%dh%02dm" % (m // 60, m % 60)
def find(win):
    folder, _, ticket = win.partition(":")
    for r in rows:
        if r["folder"] == folder and (r["ticket"] == ticket or not ticket):
            return r
    return None
if mode == "bar":
    out = []
    for l in read("windows"):
        p = l.split("\t")
        if len(p) < 3: continue
        idx, win, active = p
        bg = theme["accent"] if active == "1" else theme["bg"]
        fg_txt = theme["bg"] if active == "1" else None
        if idx == "0":
            label, col, n = "● 0 orchestrator", theme["orchestrator"], unread.get("main", 0)
        else:
            r = find(win)
            st = state(r["status"]) if r else "idle"
            folder, _, ticket = win.partition(":")
            parts = [folder] + ([r["role"]] if r and r["role"] else []) + ([ticket] if ticket else [])
            label, col, n = "%s %s %s" % (ICON[st], idx, " · ".join(parts)), theme[st], unread.get(r["name"], 0) if r else 0
        tab = "#[bg=%s]#[fg=%s]%s" % (bg, col, label)
        if n > 0: tab += " #[fg=%s]✉%d" % (theme["unread"], n)
        out.append(tab + " ")
    out.append("#[bg=%s]#[fg=%s][+ new]" % (theme["bg"], theme["accent"]))
    print(" ".join(out))
else:
    name = (read("name") or ["hub"])[0]
    color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    def c(s, code): return "\033[%sm%s\033[0m" % (code, s) if color else s
    print(c("ADE fleet · %s" % name, "1"))
    print(""); print(c("AGENTS", "1"))
    try: width = int(os.environ.get("COLUMNS") or 0) or os.get_terminal_size().columns
    except OSError: width = 80
    narrow = width < 70   # the sidebar: one compact line per agent, ticket and event
    if rows and not narrow: print(("    %-24s %-10s %-8s %-7s" % ("FOLDER", "ROLE", "TICKET", "RUN") + ("  TOKENS" if show_tok else "")).rstrip())
    if not rows: print("  (no focus agents running)")
    for r in rows:
        st = state(r["status"])
        mark = "  ✉%d" % unread[r["name"]] if unread.get(r["name"], 0) > 0 else ""
        if narrow: print("  %s %s" % (ICON[st], " · ".join(x for x in (r["folder"], r["role"], r["ticket"], age(r["started"]), r["tokens"]) if x)) + mark)
        else: print(("  %s %-24s %-10s %-8s %-7s" % (ICON[st], r["folder"], r["role"] or "-", r["ticket"] or "-", age(r["started"]))
                     + ("  %-6s" % (r["tokens"] or "-") if show_tok else "")).rstrip() + mark)
    print(""); print(c("TICKETS", "1"))
    t = read("tickets")
    if t == ["unavailable"]: print("  (this hub's bin/dispatch has no --list yet)")
    elif not t: print("  (none ready or waiting)")
    for l in t:
        p = l.split("\t")
        if len(p) == 3 and p != ["unavailable"]:
            if narrow: print("  %s %s %s" % (p[0], p[1], p[2]))
            else: print("  %-8s %-8s %s%s" % (p[0], p[1], p[2], "   approve: prefix a" if p[0] == "waiting" else ""))
    print(""); print(c("EVENTS (last 8)", "1"))
    ev = []
    path = (read("events_path") or [""])[0]
    try:
        for l in open(path, encoding="utf-8").read().splitlines()[-8:]:
            try: e = json.loads(l)
            except ValueError: continue
            tm = ts(str(e.get("time", "")))
            text = " ".join(str(e.get("text", "")).split())[:80]
            hm = tm.strftime("%H:%M") if tm else "--:--"
            who = str(e.get("from", "?")).rstrip("/").rsplit("/", 1)[-1] or "?"; kind = str(e.get("kind", "?"))
            # a plain sentence: "api pushed feat/1.2", "db idle", "web blocked: <reason>"
            if kind in ("idle", "ended"): line = "%s %s" % (who, kind)
            elif kind == "blocked": line = "%s blocked: %s" % (who, text) if text else "%s blocked" % who
            else: line = ("%s %s %s" % (who, kind, text)).rstrip()
            ev.append(("  %s %s" % (hm, line))[:width - 1])
    except OSError:
        pass
    print("\n".join(ev) if ev else "  (no events)")
PY
}

UI_KEYS="  prefix n   new agent: pick a folder, then a role
  prefix a   approve a waiting ticket (type its ref back)
  prefix t   tickets ready and waiting
  prefix p   preview the current agent's plan
  prefix f   show or hide the fleet sidebar (ade dash)
  prefix ?   this help
  prefix 0-9, Left, Right   switch tabs
  prefix d   detach (agents keep running)"

ui_conf() {   # ui_conf <hub> <session>: the tmux config ade ui loads
  local hub="$1" s="$2" run
  run="ADE_HUB=$(sq "$hub") $(sq "$(ade_self)")"
  cat <<CONF
# written by ade ui for $s; ade's own tmux server (tmux -L $ADE_TMUX_SOCKET)
set -g status on
set -g status-interval 2
set -g status-style "bg=$(theme_get bg),fg=$(theme_get fg)"
set -g status-left-length 600
set -g status-right ""
set -g window-status-format ""
set -g window-status-current-format ""
set -g status-left "#($run ui --bar $s)"
set -g destroy-unattached off
set -g mouse on
set -g set-titles on
bind-key -T prefix n run-shell "$run ui --menu new"
bind-key -T prefix a run-shell "$run ui --menu approve"
bind-key -T prefix t display-popup -E -w 80% -h 60% "$run ui --tickets"
bind-key -T prefix p run-shell "$run ui --menu preview #{window_index}"
bind-key -T prefix f run-shell "$run ui --sidebar"
bind-key -T prefix ? display-popup -E -w 66 -h 16 "$run ui --keys"
bind-key -T prefix Left previous-window
bind-key -T prefix Right next-window
CONF
}

ui_menu() {   # ui_menu new|role <folder>|approve|preview <index>
  local hub run d f r items; hub="$(find_hub)" || exit $?; run="ADE_HUB=$(sq "$hub") $(sq "$(ade_self)")"
  set -- "$@"; local what="${1:-}"; [ $# -gt 0 ] && shift
  case "$what" in
    new)
      set --; for d in "$hub"/projects/*/ "$hub"/ops/*/; do [ -d "$d" ] || continue; f="${d%/}"; f="${f#"$hub"/}"
        [[ $f =~ ^(projects|ops)/[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || continue   # never a name tmux or the shell could run
        set -- "$@" "$f" "" "run-shell \"$run ui --menu role $f\""; done
      [ $# -gt 0 ] || { ui_tmux display-message "no folders in this hub (projects/ or ops/)"; return 0; }
      ui_tmux display-menu -T "New agent: folder" "$@" ;;
    role)
      f="${1:-}"; matches "$f" '^(projects|ops)/[A-Za-z0-9_-][A-Za-z0-9._-]*$' || die 2 "not a folder: $f"
      items="$(hub_run "$hub" roles 2> /dev/null | awk '/^[a-z][a-z0-9-]* / { print $1 }')"
      [ -n "$items" ] || items="builder routine reviewer architect triage"
      set --; for r in $items; do set -- "$@" "$r" "" "run-shell -b \"$run work --role $r $f\""; done
      set -- "$@" "(no role)" "" "run-shell -b \"$run work $f\""
      ui_tmux display-menu -T "New agent: role for $f" "$@" ;;
    approve)
      d="$(mk_tmp)" || die 1 "could not make a temp folder"; ui_data "$hub" "$d"; set --
      while IFS="$(printf '\t')" read -r st r f; do
        [ "$st" = waiting ] || continue
        matches "$r" '^[A-Za-z0-9][A-Za-z0-9._/-]*$' && matches "$f" '^(projects|ops)/[A-Za-z0-9_-][A-Za-z0-9._-]*$' || continue
        set -- "$@" "$r  $f" "" "display-popup -E -w 80% -h 50% \"$run dispatch --approve $r $f\""
      done < "$d/tickets"; rm_tmp "$d"
      [ $# -gt 0 ] || { ui_tmux display-message "no ticket is waiting for you"; return 0; }
      ui_tmux display-menu -T "Approve a ticket" "$@" ;;
    preview)
      f="$(ui_tmux display-message -p -t ":${1:-0}" '#{window_name}' 2> /dev/null)"; f="${f%%:*}"
      [ "${1:-0}" != 0 ] && [ -n "$f" ] || f=.
      ui_tmux display-popup -E -w 90% -h 90% "$run ui --preview $f" ;;
    *) die 2 "usage: ade ui --menu new|role <folder>|approve|preview <index>" ;;
  esac
}

ui_preview() {   # the agent's plan: <folder>/PLAN.md, else its STATE.md; glow when installed, else plain text
  local hub p f; hub="$(find_hub)" || exit $?; f="${1:-.}"
  case "$f" in */..*|..*|/*) die 2 "not a folder: $f" ;; esac
  for p in "$hub/$f/PLAN.md" "$hub/$f/STATE.md"; do [ -f "$p" ] && break; done
  [ -f "$p" ] || { echo "no plan for $f yet (no PLAN.md or STATE.md)"; [ -t 0 ] && read -r _; return 0; }
  p="$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
  if command -v glow > /dev/null 2>&1; then glow -p "$p"; else cat "$p"; [ -t 0 ] && { printf '\n(Enter closes) '; read -r _; }; fi
  return 0
}

ui_sidebar() {
  local id; need_tmux
  id="$(ui_tmux list-panes -F '#{pane_id} #{pane_title}' 2> /dev/null | awk '$2 == "ade-dash" { print $1; exit }')"
  if [ -n "$id" ]; then ui_tmux kill-pane -t "$id"; return; fi
  id="$(ui_tmux split-window -h -d -l 44 -P -F '#{pane_id}' "$(sq "$(ade_self)") dash")" || die 1 "could not open the sidebar"
  ui_tmux select-pane -t "$id" -T ade-dash
}

cmd_ui() {
  local hub s d conf detach=0
  case "${1:-}" in
    --bar) [ -n "${2:-}" ] || die 2 "usage: ade ui --bar <session>"; hub="$(find_hub)" || exit $?
      ui_bar "$hub" "$2"; return 0 ;;
    --tab-name) matches "${2:-}" '^(projects|ops)/[A-Za-z0-9_-][A-Za-z0-9._-]*$' || die 2 "usage: ade ui --tab-name <folder> [ticket]"
      echo "$2${3:+:$3}"; return 0 ;;
    --menu) shift; ui_menu "$@"; return ;;
    --preview) ui_preview "${2:-}"; return ;;
    --sidebar) ui_sidebar; return ;;
    --keys) echo "ade ui keys:"; echo "$UI_KEYS"; [ -t 0 ] && read -r _; return 0 ;;
    --tickets) hub="$(find_hub)" || exit $?; d="$(mk_tmp)" || die 1 "could not make a temp folder"; ui_data "$hub" "$d"
      ui_render dash "$d" | awk '/^TICKETS/ { on = 1 } /^EVENTS/ { on = 0 } on'; rm_tmp "$d"; [ -t 0 ] && read -r _; return 0 ;;
    --session) hub="$(find_hub)" || exit $?; ui_session "$hub"; return 0 ;;
    --detach) detach=1 ;;
    "") ;;
    *) die 2 "usage: ade ui [--detach]" ;;
  esac
  need_tmux; hub="$(find_hub)" || exit $?; s="$(ui_session "$hub")"
  sq "$hub" > /dev/null; sq "$(ade_self)" > /dev/null   # checked here: inside $(...) a refusal would only end a subshell
  if ! ui_tmux has-session -t "=$s" 2> /dev/null; then
    claude_update "$hub"
    conf="$CONF_DIR/ui-$s.tmux.conf"; ui_conf "$hub" "$s" | write_conf_file "ui-$s.tmux.conf"
    ui_tmux new-session -d -s "$s" -n orchestrator -c "$hub" \
      "exec env AGENT_TERMINAL=tmux ADE_UI_SESSION=$s ADE_HUB=$(sq "$hub") $(sq "$(ade_self)") claude" || die 1 "tmux could not start $s"
    ui_tmux source-file "$conf" || die 1 "tmux could not load $conf"
    ui_tmux set-environment -t "=$s" AGENT_TERMINAL tmux; ui_tmux set-environment -t "=$s" ADE_UI_SESSION "$s"
    ui_tmux set-environment -t "=$s" ADE_HUB "$hub"
  fi
  [ "$detach" = 1 ] && { echo "ade ui: session $s (attach with: ade ui)"; return 0; }
  TMUX=""; export TMUX; exec tmux -L "$ADE_TMUX_SOCKET" attach-session -t "=$s"
}

cmd_dash() {
  local hub d once=0; [ "${1:-}" = --once ] && once=1
  [ $# -eq 0 ] || [ "$once" = 1 ] || die 2 "usage: ade dash [--once]"
  hub="$(find_hub)" || exit $?; DASH_DIR="$(mk_tmp)" || die 1 "could not make a temp folder"; d="$DASH_DIR"; trap 'rm_tmp "$DASH_DIR"' EXIT
  while :; do
    ui_data "$hub" "$d"
    if [ "$once" = 1 ]; then ui_render dash "$d"; return 0; fi
    printf '\033[H\033[2J'; ui_render dash "$d"; sleep 2
  done
}

cmd_version() {
  local v="$ADE_VERSION"
  local p="$0" l
  while [ -L "$p" ]; do l="$(readlink "$p")"; case "$l" in /*) p="$l" ;; *) p="$(dirname "$p")/$l" ;; esac; done
  [ -n "$v" ] || v="$(cat "$(cd "$(dirname "$p")" && pwd)/VERSION" 2>/dev/null)"
  echo "ade ${v:-unknown}"
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  work) work_in_ui; run_hub work "$@" ;;
  dispatch|notify|chat|method|keys|models|roles|doctor|sync|context) run_hub "$cmd" "$@" ;;
  ui) cmd_ui "$@" ;;
  dash) cmd_dash "$@" ;;
  status) run_hub sessions "$@" ;;
  agent-run) run_hub agent "$@" ;;
  init) cmd_init "$@" ;;
  agent) cmd_agent "$@" ;;
  skills) cmd_skills "$@" ;;
  "") cmd_home ;;
  claude) cmd_claude "$@" ;;
  setup) cmd_setup "$@" ;;
  hub) cmd_hub "$@" ;;
  orchestrator) cmd_orchestrator "$@" ;;
  open) cmd_open "$@" ;;
  version|--version|-v) cmd_version ;;
  help|--help|-h) usage ;;
  *) usage >&2; die 2 "unknown command: $cmd" ;;
esac
