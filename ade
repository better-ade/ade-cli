$ok
EOF
    rows="$(recipes_py "$src" "${list[@]}")"; rc=$?
    [ "$rc" != 3 ] || die 2 "the recipes of ade-skills $ref are refused together: $(printf '%s' "${rows#folder"$US$US"}" | no_ctl)"
    [ "$rc" = 0 ] || die 1 "could not read the recipes"
