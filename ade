# --- pane: a tmux pane's text (capture-pane -p -e) as a page: colours kept, every other sequence dropped, keys hidden ---
BASE = ["#000000", "#cd3131", "#0dbc79", "#e5e510", "#2472c8", "#bc3fbc", "#11a8cd", "#e5e5e5",
        "#666666", "#f14c4c", "#23d18b", "#f5f543", "#3b8eea", "#d670d6", "#29b8db", "#ffffff"]
def colour256(n):
    if n < 16: return BASE[n]
    if n < 232:
        n -= 16; v = [0, 95, 135, 175, 215, 255]; return "#%02x%02x%02x" % (v[n // 36], v[n // 6 % 6], v[n % 6])
    g = 8 + 10 * (n - 232); return "#%02x%02x%02x" % (g, g, g)
def sgr(params, st):
    """the style after a colour sequence; st = (fg, bg, bold, dim, italic, underline, reverse), colours made here only"""
    fg, bg, bold, dim, ita, und, rev = st
    try: ps = [int(x) if x else 0 for x in re.split("[;:]", params)] if params else [0]
    except ValueError: return st
    i = 0
    while i < len(ps):
        p = ps[i]
        if p == 0: fg = bg = None; bold = dim = ita = und = rev = False
        elif p == 1: bold = True
        elif p == 2: dim = True
        elif p == 3: ita = True
        elif p == 4: und = True
        elif p == 7: rev = True
        elif p == 22: bold = dim = False
        elif p == 23: ita = False
        elif p == 24: und = False
        elif p == 27: rev = False
        elif 30 <= p <= 37: fg = BASE[p - 30]
        elif 90 <= p <= 97: fg = BASE[p - 82]
        elif 40 <= p <= 47: bg = BASE[p - 40]
        elif 100 <= p <= 107: bg = BASE[p - 92]
        elif p == 39: fg = None
        elif p == 49: bg = None
        elif p in (38, 48):
            col = None
            if ps[i + 1:i + 2] == [5] and len(ps) > i + 2: col = colour256(ps[i + 2] & 255); i += 2
            elif ps[i + 1:i + 2] == [2] and len(ps) > i + 4: col = "#%02x%02x%02x" % tuple(x & 255 for x in ps[i + 2:i + 5]); i += 4
            else: break
            if p == 38: fg = col
            else: bg = col
        i += 1
    return (fg, bg, bold, dim, ita, und, rev)
def css(st):
    if st == HID: return "color:#c586c0"
    fg, bg, bold, dim, ita, und, rev = st
    if rev: fg, bg = bg or "#1e1e1e", fg or "#d4d4d4"
    out = []
    if fg: out.append("color:" + fg)
    if bg: out.append("background:" + bg)
    if bold: out.append("font-weight:bold")
    if dim: out.append("opacity:0.6")
    if ita: out.append("font-style:italic")
    if und: out.append("text-decoration:underline")
    return ";".join(out)
def pane_html(raw):
