  rows="$(ui_tmux list-windows -t "=$s" -F "#{window_index}$TAB#{window_name}" 2> /dev/null)" || die 2 "ade ui is not running for this hub, so there is no agent tab to capture (ade ui starts it); nothing captured"
  rows="$(printf '%s\n' "$rows" | awk -F '\t' -v n="$1" '{ f = $2; sub(/:.*/, "", f); b = f; sub(/.*\//, "", b); a = ""; if (index($2, ":")) { a = $2; sub(/^[^:]*:/, "", a) } } $2 == n || f == n || b == n || a == n')"
  n="$(printf '%s\n' "$rows" | grep -c .)"
  [ "$n" != 0 ] || die 2 "no tab of ade ui is named $1 (ade status lists the agents); nothing captured"
