# shot_screen <png>: the whole desktop into the file; ade changes no system setting
shot_screen() {
  if on_macos; then
    screencapture -x "$1" 2> /dev/null && [ -s "$1" ] && return 0
    die 1 "macOS did not let this terminal capture the screen. Allow it in System Settings > Privacy & Security > Screen Recording (your terminal app), then run it again; ade changes no setting"
  fi
  [ -n "${DISPLAY:-}" ] || die 1 "there is no X display here (DISPLAY is not set); ade shot screen captures an X display, as in an ADE Computer; nothing captured"
  if command -v import > /dev/null 2>&1; then import -window root "$1" 2> /dev/null
  elif command -v xwd > /dev/null 2>&1; then xwd -root -silent > "$1.xwd" 2> /dev/null && shot_py xwd "$1.xwd" "$1"
  else die 1 "ade shot screen needs xwd (sudo apt-get install x11-utils) or ImageMagick's import on Linux; nothing captured"; fi
  [ -s "$1" ] || die 1 "the X display $(plain "$DISPLAY") could not be captured; nothing saved"
