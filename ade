def clean_name(name, default):
    if name == "": name = default
    elif re.search(r"[/\\\x00-\x1f\x7f]", name) or name[0] in ".-" or len(name) > 200:
        die(2, "a shot's name is letters, digits, . _ and - (no path, no leading . or -); nothing captured")
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", name, flags=re.ASCII).strip("-.")[:60].strip("-.")
    if not name: die(2, "a shot's name is letters, digits, . _ and - (no path, no leading . or -); nothing captured")
    return name
def inside(path, root): return path == root or path.startswith(root.rstrip("/") + "/")
def keyfile(path, root):
    """a file of the project that the hub never sends either: .env, a key, anything under .git"""
    parts = os.path.relpath(path, root).split(os.sep); n = parts[-1]
    return ".git" in parts[:-1] or n == ".env" or n.startswith(".env.") or n.endswith((".env", ".pem", ".key")) or n.startswith("id_")
def meta_host(host):
    """a link-local or cloud metadata address: 169.254.0.0/16, fe80::/10, fd00:ec2::254, metadata.google.internal"""
    import ipaddress
    h = (host or "").strip("[]").rstrip(".").lower()
    if h == "metadata.google.internal": return True
    try: ip = ipaddress.ip_address(h)
    except ValueError: return False
    if ip.version == 6 and ip.ipv4_mapped: ip = ip.ipv4_mapped
    return ip.is_link_local or ip == ipaddress.ip_address("fd00:ec2::254")
def address(a, root):
    """the address to open, or exit 2: http, https or file only; a file only a regular file inside the project"""
    no = "ade shot url takes an http, https or file address (a file only inside this project); nothing captured"
    if not a or len(a) > 2048 or re.search(r"[\s\x00-\x1f\x7f\\]", a) or not re.match(r"(https?|file)://", a): die(2, no)
    try: u = urllib.parse.urlsplit(a); host = u.hostname; u.port
    except ValueError: die(2, no)
    if u.scheme in ("http", "https"):
        if not host or u.username is not None or u.password is not None or "@" in u.netloc: die(2, no + " (no user or password in the address)")
        if meta_host(host): die(2, "ade shot url does not open a link-local or metadata address; nothing captured")
        return a, host
    if u.netloc not in ("", "localhost") or u.query or u.fragment: die(2, no)
    raw = urllib.parse.unquote(u.path)
    if "\x00" in raw or not raw.startswith("/") or os.path.islink(raw) or not os.path.isfile(raw): die(2, no)
    real = os.path.realpath(raw)
    if not inside(real, os.path.realpath(root)): die(2, no)
    if keyfile(real, os.path.realpath(root)): die(2, "ade shot url does not open a .env, a key or a .git file of the project; nothing captured")
