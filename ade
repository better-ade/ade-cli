        pv = preview(items[sel][1], h) if items and cols >= 70 else []
        out = ["\x1b[H\x1b[2J\x1b[1m" + (title[:cols] if in_program(os.path.realpath(cur)) else hyper(cur, title[:cols])) + "\x1b[0m\r\n"]
        for i in range(h):
