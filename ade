}
# web_tailnet_ip <text>: exactly one IPv4 address in 100.64.0.0/10, the range Tailscale gives out. The test switch
# ADE_WEB_TEST_TAILNET_LOOPBACK=1 accepts a loopback address in its place (a test has no tailnet), never anything wider.
web_tailnet_ip() {
