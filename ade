def hide(text, sty=None):
    """text with keys and tokens hidden -> (text, its style per character, how many were hidden); already-hidden text is not counted twice"""
    sty = list(sty) if sty is not None else [None] * len(text); n = 0
    for p, r in HIDE:
        out = []; so = []; last = 0
        for m in p.finditer(text):
            rep = m.expand(r); out.append(text[last:m.start()]); so.extend(sty[last:m.start()])
            if HID not in sty[m.start():m.end()]: n += 1
            out.append(rep); so.extend([HID] * len(rep)); last = m.end()
        out.append(text[last:]); so.extend(sty[last:]); text = "".join(out); sty = so
