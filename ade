        termios.tcsetattr(s.fd, termios.TCSANOW, a)
    def cooked(s): termios.tcsetattr(s.fd, termios.TCSANOW, s.old)
    def ready(s): return select.select([s.fd], [], [], 0.05)[0]
    def key(s):
        b = os.read(s.fd, 1)
        if not b or b in (b"\x04", b"\x03"): return "quit"
        if b == b"\x1b":
            if s.ready() and os.read(s.fd, 1) in (b"[", b"O") and s.ready():
                return {b"A": "up", b"B": "down", b"C": "right", b"D": "left"}.get(os.read(s.fd, 1), "")
            return "esc"
